@inject NavigationManager Navigation
@using BlazorWasmPortfolioGhAction.Services.Localization

@code {
    protected override void OnInitialized()
    {
        var returnUrl = Uri.EscapeDataString(Navigation.Uri);
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        CulturePath.Split(relative, out var lang, out var remainder);

        if (IsBrokerProtectedPath(remainder))
        {
            Navigation.NavigateTo(
                CulturePath.AppRouteWithQuery(lang, "trading/login", $"returnUrl={returnUrl}"));
            return;
        }

        Navigation.NavigateTo(
            CulturePath.AppRouteWithQuery(lang, "admin", $"returnUrl={returnUrl}"));
    }

    private static bool IsBrokerProtectedPath(string remainder) =>
        remainder.StartsWith("trading/broker", StringComparison.OrdinalIgnoreCase)
        || remainder.StartsWith("trading/tcbs", StringComparison.OrdinalIgnoreCase);
}
