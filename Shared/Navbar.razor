<header class="navbar">
    <div class="navbar-container">
        <a href="/" class="navbar-brand" @onclick="CloseMenu" aria-label="Go to homepage">
            <span class="brand-symbol">&lt;/</span>
            <span class="brand-initials">khoi</span>
            <span class="brand-symbol">&gt;</span>
        </a>
        <button type="button" class="menu-toggle @(_isMenuOpen ? "open" : "")"
                @onclick="ToggleMenu"
                aria-label="@(_isMenuOpen ? "Close navigation menu" : "Open navigation menu")"
                aria-expanded="@(_isMenuOpen.ToString().ToLowerInvariant())"
                aria-controls="main-navigation">
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
        </button>
        <nav id="main-navigation" class="navbar-links @(_isMenuOpen ? "open" : "")">
            <a href="#about" @onclick='async () => await NavigateToSection("about")'>About</a>
            <a href="#experience" @onclick='async () => await NavigateToSection("experience")'>Experience</a>
            <a href="#projects" @onclick='async () => await NavigateToSection("projects")'>Projects</a>
            <a href="#technologies" @onclick='async () => await NavigateToSection("technologies")'>Technologies</a>
            <a href="#education" @onclick='async () => await NavigateToSection("education")'>Education</a>
            <a href="#contact" @onclick='async () => await NavigateToSection("contact")'>Contact</a>
            <NavLink href="resume" @onclick="CloseMenu">Resume</NavLink>
            <NavLink href="Utility" @onclick="CloseMenu">Tools</NavLink>
            <NavLink href="cryptoManager" @onclick="CloseMenu">Crypto</NavLink>
        </nav>
    </div>
</header>

@code {
    private bool _isMenuOpen;
    private void ToggleMenu() => _isMenuOpen = !_isMenuOpen;
    private void CloseMenu() => _isMenuOpen = false;

    [Inject] NavigationManager NavigationManager { get; set; } = default!;
    [Inject] IJSRuntime JS { get; set; } = default!;

    private async Task NavigateToSection(string sectionId)
    {
        _isMenuOpen = false;
        var currentUri = new Uri(NavigationManager.Uri);
        var isHome = currentUri.AbsolutePath == "/" || currentUri.AbsolutePath == "";

        if (isHome)
        {
            await JS.InvokeVoidAsync("scrollToSection", sectionId);
        }
        else
        {
            NavigationManager.NavigateTo($"/#{sectionId}");
        }
    }
}