@inherits CultureAwareComponent
@inject IStringLocalizer<SharedResources> L
@implements IAsyncDisposable

<header class="navbar">
    <div class="navbar-container">
        <a href="@HomeHref" class="navbar-brand" @onclick="CloseMenu" aria-label="@L["Nav_GoHome"] khoi">
            <span class="brand-symbol">&lt;/</span>
            <span class="brand-initials">khoi</span>
            <span class="brand-symbol">&gt;</span>
        </a>
        <div class="navbar-right">
            <button type="button" class="lang-toggle" @onclick="ToggleLanguageAsync"
                    title="@L["Nav_Language"]">
                @(CultureService.IsEnglish ? L["Nav_SwitchToVi"] : L["Nav_SwitchToEn"])
            </button>
            <button type="button" class="theme-toggle" @onclick="ToggleTheme"
                    aria-label="@(_isDark ? L["Nav_SwitchLight"] : L["Nav_SwitchDark"])"
                    title="@(_isDark ? L["Nav_LightMode"] : L["Nav_DarkMode"])">
                <i class="bi @(_isDark ? "bi-sun-fill" : "bi-moon-stars-fill")" aria-hidden="true"></i>
            </button>
            <button type="button" class="menu-toggle @(_isMenuOpen ? "open" : "")"
                    @onclick="ToggleMenu"
                    aria-label="@(_isMenuOpen ? L["Nav_CloseMenu"] : L["Nav_OpenMenu"])"
                    aria-expanded="@(_isMenuOpen.ToString().ToLowerInvariant())"
                    aria-controls="main-navigation">
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
            </button>
            <nav id="main-navigation" class="navbar-links @(_isMenuOpen ? "open" : "")">
                <NavLink href="@HomeHref" Match="NavLinkMatch.All" @onclick="CloseMenu">@L["Nav_Home"]</NavLink>
                <NavLink href="@LangHref("resume")" @onclick="CloseMenu">@L["Nav_Resume"]</NavLink>
                <NavLink href="@LangHref("Utility")" @onclick="CloseMenu">@L["Nav_Tools"]</NavLink>
                <NavLink href="@LangHref("trading/vndesk")" @onclick="CloseMenu">@L["Nav_Trading"]</NavLink>
            </nav>
        </div>
    </div>
</header>

@code {
    private const string CloseHandlerId = "navbar";

    private bool _isMenuOpen;
    private bool _isDark;
    private bool _closeRegistered;

    [Inject] IJSRuntime JS { get; set; } = default!;
    [Inject] NavigationManager Navigation { get; set; } = default!;

    private DotNetObjectReference<Navbar>? _dotNetRef;

    private string HomeHref => CultureService.UrlLang;
    private string LangHref(string path) => CulturePath.Combine(CultureService.UrlLang, path);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _isDark = await JS.InvokeAsync<string>("themeManager.get") == "dark";
                StateHasChanged();
            }
            catch { }
        }

        if (_isMenuOpen && !_closeRegistered)
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("tradingAuth.registerCloseOnOutside",
                    CloseHandlerId, "#main-navigation", ".menu-toggle", _dotNetRef);
                _closeRegistered = true;
            }
            catch { }
        }
        else if (!_isMenuOpen && _closeRegistered)
        {
            try
            {
                await JS.InvokeVoidAsync("tradingAuth.unregisterCloseOnOutside", CloseHandlerId);
            }
            catch { }
            _closeRegistered = false;
        }
    }

    private async Task ToggleTheme()
    {
        try
        {
            await JS.InvokeVoidAsync("themeManager.toggle");
            _isDark = !_isDark;
        }
        catch { }
    }

    private async Task ToggleLanguageAsync()
    {
        var nextLang = CultureService.IsEnglish ? "vn" : "en";
        await CultureService.SetCultureAsync(nextLang);

        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        var target = CulturePath.Toggle(relative, nextLang);
        Navigation.NavigateTo(target, forceLoad: true);
    }

    private void ToggleMenu() => _isMenuOpen = !_isMenuOpen;
    private void CloseMenu() => _isMenuOpen = false;

    [JSInvokable]
    public void CloseMenuFromJs()
    {
        _isMenuOpen = false;
        _closeRegistered = false;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("tradingAuth.unregisterCloseOnOutside", CloseHandlerId); }
        catch { }
        _dotNetRef?.Dispose();
    }
}
