@inherits CultureAwareLayout
@using System
@inject IStringLocalizer<SharedResources> L
@inject IJSRuntime JS
@inject NavigationManager Navigation
@implements IDisposable

<CultureUrlGuard />
<div id="route-progress" class="route-progress" role="status" aria-live="polite" aria-label="@L["Nav_LoadingPage"]">
    <div class="route-progress-bar"></div>
</div>
<button type="button" class="skip-link" @onclick="SkipToContent">@L["SkipToContent"]</button>
<Navbar />

<main id="main-content" tabindex="-1">
    @Body
</main>

<button type="button" class="progress" aria-label="@L["Footer_BackToTop"]" @onclick="ScrollToTopAsync">
    <i class="bi bi-arrow-up" aria-hidden="true"></i>
</button>

<Footer />

@code {
    private string? _lastPath;

    private static string PathOnly(NavigationManager nav)
    {
        var rel = nav.ToBaseRelativePath(nav.Uri);
        var idx = rel.IndexOf('?');
        return idx >= 0 ? rel[..idx] : rel;
    }

    private async Task SkipToContent()
    {
        try { await JS.InvokeVoidAsync("skipToContent"); }
        catch { }
    }

    private async Task ScrollToTopAsync()
    {
        try { await JS.InvokeVoidAsync("scrollToTop"); }
        catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { await JS.InvokeVoidAsync("initializeScrollProgress"); }
            catch { }
        }
    }

    protected override void OnInitialized()
    {
        _lastPath = PathOnly(Navigation);
        Navigation.LocationChanged += OnLocationChanged;
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        var path = PathOnly(Navigation);
        if (path == _lastPath) return; // query-only change — skip progress bar
        _lastPath = path;
        try
        {
            await JS.InvokeVoidAsync("routeProgress.show");
            await Task.Delay(300);
            await JS.InvokeVoidAsync("routeProgress.hide");
        }
        catch { }
    }

    public override void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        base.Dispose();
    }
}
