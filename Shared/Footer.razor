@inherits CultureAwareComponent
@inject IStringLocalizer<SharedResources> L
@inject IJSRuntime JS

<footer class="footer">
    <div class="footer-container">
        <div class="footer-main">
            <div class="footer-identity">
                <p class="footer-name">Khoi Nguyen Minh Duc</p>
                <p class="footer-role">@L["Footer_Role"]</p>
            </div>
            <button type="button" class="back-to-top" @onclick="ScrollToTopAsync" aria-label="@L["Footer_BackToTop"]">
                @L["Footer_BackToTop"] <i class="bi bi-arrow-up" aria-hidden="true"></i>
            </button>
        </div>
        <div class="footer-bottom">
            <p>© @_currentYear Khoi Nguyen Minh Duc</p>
            <p>@L["Footer_BuiltWith"]</p>
        </div>
    </div>
</footer>

@code {
    private readonly int _currentYear = DateTime.Now.Year;

    private async Task ScrollToTopAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("scrollToTop");
        }
        catch
        {
            // Ignore error if JS interop fails
        }
    }
}
