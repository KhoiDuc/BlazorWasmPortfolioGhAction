@implements IDisposable
@inject NavigationManager navigationManager
@inject IState<ContentState> contentState
@inject IDispatcher Dispatcher
@using BlazorWasmPortfolioGhAction.Store.State
@using BlazorWasmPortfolioGhAction.Shared.Model
@using BlazorWasmPortfolioGhAction.Store.Actions
@using Fluxor
@inject IJSRuntime JSRuntime

<div class="sidebar-inner">
    <!-- User Profile Header -->
    <div class="nav-profile" @onclick="GoHome">
        <div class="profile-avatar-wrapper">
            <img src="images/avt-men.png" alt="Khoi Nguyen" class="profile-avatar" />
            <span class="status-indicator" title="Online / Available"></span>
        </div>
        <div class="profile-info">
            <span class="profile-name">Khoi Nguyen</span>
            <span class="profile-role">Full-Stack .NET Dev</span>
        </div>
    </div>

    <!-- Navigation Links Container -->
    <nav class="nav-scroll-area">
        <!-- Main Navigation Section -->
        <div class="nav-section-title">PORTFOLIO</div>

        <NavLink class="nav-item-link" href="" Match="NavLinkMatch.All" @onclick="HandleLinkClick" aria-label="Home">
            <i class="fa-solid fa-house nav-icon"></i>
            <span class="nav-text">Home</span>
        </NavLink>

        <NavLink class="nav-item-link" href="MyResume" @onclick="HandleLinkClick" aria-label="My Resume">
            <i class="fa-regular fa-file-lines nav-icon"></i>
            <span class="nav-text">My Resume</span>
        </NavLink>

        <NavLink class="nav-item-link" href="Dissertation/Transcript" @onclick="HandleLinkClick">
            <i class="fa-solid fa-graduation-cap nav-icon"></i>
            <span class="nav-text">Transcript</span>
        </NavLink>

        <NavLink class="nav-item-link" href="Dissertation/Degree" @onclick="HandleLinkClick">
            <i class="fa-solid fa-award nav-icon"></i>
            <span class="nav-text">Degree</span>
        </NavLink>

        <NavLink class="nav-item-link" href="Dissertation/CV" @onclick="HandleLinkClick">
            <i class="fa-solid fa-id-card nav-icon"></i>
            <span class="nav-text">Curriculum Vitae</span>
        </NavLink>

        <!-- Interactive Tools Section -->
        <div class="nav-section-title mt-3">TOOLS &amp; APPS</div>

        <NavLink class="nav-item-link" href="Utility" @onclick="HandleLinkClick">
            <i class="fa-solid fa-screwdriver-wrench nav-icon"></i>
            <span class="nav-text">Utility Suite</span>
        </NavLink>

        <NavLink class="nav-item-link" href="cryptoManager" @onclick="HandleLinkClick">
            <i class="fa-brands fa-bitcoin nav-icon"></i>
            <span class="nav-text">Crypto Manager</span>
        </NavLink>

        <!-- Dynamic Wiki Sections -->
        @if (contentState.Value.Contents != null && contentState.Value.Contents.Any())
        {
            <div class="nav-section-title mt-3">KNOWLEDGE BASE</div>

            var count = 0;
            @foreach (var typeGroup in contentState.Value.Contents
                .OrderBy(c => c.page)
                .ThenBy(c => c.section)
                .ThenBy(c => c.subSection)
                .GroupBy(c => c.page))
            {
                var type = typeGroup.Key;
                <div class="wiki-page-group">
                    <NavLink class="nav-item-link wiki-page-link" href=@($"/{type}/all/all") @onclick="HandleLinkClick">
                        <i class="fa-solid fa-book-bookmark nav-icon"></i>
                        <span class="nav-text">@type</span>
                    </NavLink>

                    @foreach (var sectionGroup in typeGroup.GroupBy(c => c.section))
                    {
                        var localCount = count;
                        var sectionName = sectionGroup.Key ?? "General";
                        var isExpanded = showSubSections != null && localCount < showSubSections.Length && showSubSections[localCount];

                        <div class="nav-accordion-item @(isExpanded ? "expanded" : "")">
                            <button type="button" class="nav-accordion-header" @onclick="(() => ToggleSection(localCount))">
                                <span class="accordion-title">
                                    <i class="fa-solid fa-folder@(isExpanded ? "-open" : "") accordion-folder-icon"></i>
                                    @sectionName
                                </span>
                                <i class="fa-solid fa-chevron-@(isExpanded ? "down" : "right") accordion-arrow"></i>
                            </button>

                            @if (isExpanded)
                            {
                                <div class="nav-accordion-body">
                                    <NavLink class="nav-sub-link" href=@($"/{type}/{sectionName}/all") @onclick="HandleLinkClick">
                                        <span class="sub-dot"></span>
                                        <span>All @sectionName</span>
                                    </NavLink>
                                    @foreach (var contentHolder in sectionGroup)
                                    {
                                        <NavLink class="nav-sub-link" href=@($"/{type}/{sectionName}/{contentHolder.subSection}") @onclick="HandleLinkClick">
                                            <span class="sub-dot"></span>
                                            <span class="text-truncate">@contentHolder.subSection</span>
                                        </NavLink>
                                    }
                                </div>
                            }
                        </div>
                        count++;
                    }
                </div>
            }
        }
        else if (contentState.Value.Contents == null)
        {
            <div class="nav-loading">
                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                <span>Loading wiki...</span>
            </div>
        }

        <!-- Authorize Actions -->
        <AuthorizeView>
            <Authorized>
                <div class="nav-section-title mt-3">ADMIN</div>
                <NavLink class="nav-item-link" href="add" @onclick="HandleLinkClick">
                    <i class="fa-solid fa-plus nav-icon"></i>
                    <span class="nav-text">Add Section</span>
                </NavLink>
            </Authorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    [Parameter]
    public EventCallback OnNavigate { get; set; }

    private bool[]? showSubSections;
    private int uniqueSectionsCount;

    protected override void OnInitialized()
    {
        contentState.StateChanged += HandleStateChanged;
        showSubSections = Array.Empty<bool>();
    }

    private void HandleStateChanged(object? sender, EventArgs e)
    {
        if (contentState.Value.FileCount == contentState.Value.LoadedFilesCount && contentState.Value.Contents != null)
        {
            uniqueSectionsCount = contentState.Value.Contents.GroupBy(x => x.section).Count();
            showSubSections = new bool[uniqueSectionsCount];
            Array.Fill(showSubSections, false);
            InvokeAsync(StateHasChanged);
        }
    }

    private void ToggleSection(int index)
    {
        if (showSubSections == null || index >= showSubSections.Length) return;

        bool currentState = showSubSections[index];
        Array.Fill(showSubSections, false);
        showSubSections[index] = !currentState;
        StateHasChanged();
    }

    private async Task HandleLinkClick()
    {
        if (showSubSections != null)
        {
            Array.Fill(showSubSections, false);
        }
        if (OnNavigate.HasDelegate)
        {
            await OnNavigate.InvokeAsync();
        }
    }

    private void GoHome()
    {
        navigationManager.NavigateTo("/");
        HandleLinkClick();
    }

    public void Dispose()
    {
        contentState.StateChanged -= HandleStateChanged;
    }
}
