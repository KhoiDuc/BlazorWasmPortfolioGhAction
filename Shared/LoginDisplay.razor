@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication

@inject NavigationManager Navigation

<AuthorizeView>
    <Authorized>
        <button type="button" class="login-display-btn" @onclick="BeginLogout">Logout</button>
    </Authorized>
    <NotAuthorized>
        <a class="login-display-btn" href="authentication/login" title="Sign in with Microsoft account">
            <i class="bi bi-microsoft" aria-hidden="true"></i> Login
        </a>
    </NotAuthorized>
</AuthorizeView>

@code {
    private void BeginLogout(MouseEventArgs args)
    {
        Navigation.NavigateToLogout("authentication/logout");
    }
}
