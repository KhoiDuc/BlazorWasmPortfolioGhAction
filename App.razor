@inherits CultureAwareComponent
@inject IStringLocalizer<SharedResources> L

<Fluxor.Blazor.Web.StoreInitializer />
<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    @if (RequiresBrokerRole(routeData) && !context.User.IsInRole("Broker"))
                    {
                        <RedirectToLogin />
                    }
                    else if (context.User.Identity?.IsAuthenticated != true)
                    {
                        <RedirectToLogin />
                    }
                    else
                    {
                        <p role="alert">@L["App_NotAuthorized"]</p>
                    }
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <NotFound />
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@code {
    protected override async Task OnInitializedAsync()
    {
        // Sync scoped CultureService with culture already applied in Program.cs
        await CultureService.InitializeAsync();
    }

    private static bool RequiresBrokerRole(RouteData routeData)
    {
        var authorize = routeData.PageType?
            .GetCustomAttributes(typeof(Microsoft.AspNetCore.Authorization.AuthorizeAttribute), inherit: true)
            .Cast<Microsoft.AspNetCore.Authorization.AuthorizeAttribute>()
            .FirstOrDefault();

        return authorize?.Roles?.Split(',').Any(r => r.Trim().Equals("Broker", StringComparison.OrdinalIgnoreCase)) == true;
    }
}
