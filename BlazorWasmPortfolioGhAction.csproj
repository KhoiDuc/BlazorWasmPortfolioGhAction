		<PackageReference Include="Meziantou.Framework.QRCode" Version="2.0.1" />
		<PackageReference Include="Microsoft.AspNetCore.WebUtilities" Version="10.0.0" />
		<PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.0" />
		<PackageReference Include="Soenneker.Blazor.CreditCards" Version="4.0.543" />
		<PackageReference Include="Soenneker.Blazor.Turnstile" Version="4.0.2778" />
		<PackageReference Include="ZXing.Net" Version="0.16.11" />
		<!-- MSAL disabled — was for learning only
