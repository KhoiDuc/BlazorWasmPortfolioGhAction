@using System.IO
@using System.Text
@using System.Text.RegularExpressions

<div class="tool-card">
    <div class="tool-header">
        <h3>Hidden Character Finder</h3>
        <p>Reveal non-printable Unicode characters hidden in copied strings.</p>
    </div>

    <div class="tool-form">
        <div class="tool-field">
            <label class="tool-label" for="hcf-input">Paste string here</label>
            <textarea id="hcf-input" class="tool-textarea" rows="8" @bind="s"></textarea>
        </div>
        <div class="tool-actions">
            <button type="button" class="tool-btn tool-btn-primary" @onclick="Encode">Show characters</button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(output))
    {
        <div class="tool-result hcf-output">
            @((MarkupString)output)
        </div>
    }

    <p class="tool-hint">
        Based on <a href="https://www.soscisurvey.de/tools/view-chars.php" target="_blank" rel="noopener">soscisurvey view-chars</a>
    </p>
</div>

@code {
    string s = "a …	​﻿⟶b";
    string output = string.Empty;

    private void Encode() => output = text2html(s);

    private string parseWhitespace(string c)
    {
        return c switch
        {
            "\r" => "<span class='symbol S2Tooltip anchor'>CR</span>",
            "\n" => "<span class='symbol S2Tooltip anchor'>LF</span>",
            "\t" => "<span class='symbol S2Tooltip anchor'>⟶</span>&#8203;",
            " " => "<span class='white S2Tooltip anchor'>·</span>&#8203;",
            _ => string.Empty
        };
    }

    private bool isRegularUnicodeCharacter(string c)
    {
        var pattern = @"[\p{L}\p{M}\p{N}\p{P}\p{S}]";
        return Regex.Matches(c, pattern).Count > 0;
    }

    private string htmlChar(string c)
    {
        var desc = "";
        var hex = "";
        var bytes = Encoding.UTF8.GetBytes(c);

        if (bytes.Length == 1)
        {
            var c1 = char.Parse(c);
            desc = Convert.ToByte(c1) + "<br>\r\n" + string.Format("0x{0,2:X2}", Convert.ToByte(c1));
            hex = string.Format("{0,2:X2}", Convert.ToByte(c1));
        }
        else
        {
            if (BitConverter.IsLittleEndian)
                Array.Reverse(bytes);

            desc = $"&amp;#{bytes.Select(x => (int)x).Sum()};<br>";
            hex = "\\u" + BitConverter.ToString(bytes).Replace("-", string.Empty);
        }

        var symbol = parseWhitespace(c);
        if (symbol == string.Empty)
        {
            symbol = isRegularUnicodeCharacter(c)
                ? "<span class='S2Tooltip anchor'>" + c + "</span>"
                : "<span class='hex S2Tooltip anchor'>" + hex + "</span>";
        }

        return symbol +
            "<span class='S2Tooltip container'>" +
            "<span class='S2Tooltip tiptext rounded shadow'>" + desc + "</span>" +
            "</span>";
    }

    private string text2html(string input)
    {
        var html = "<div class='output'>\r\n";
        var sl = input.Length;
        var nlc = 0;

        for (var i = 0; i < sl; i++)
        {
            var c = input.Substring(i, 1);

            if (c == "\r")
            {
                if (nlc == 0) { nlc = 1; html += htmlChar(c); }
                else if (nlc == 1) { html += "<br>\r\n" + htmlChar(c); nlc = 1; }
                else if (nlc == 2) { html += htmlChar(c) + "<br>\r\n"; nlc = 0; }
            }
            else if (c == "\n")
            {
                if (nlc == 0) { nlc = 2; html += htmlChar(c); }
                else if (nlc == 2) { html += "<br>\r\n" + htmlChar(c); nlc = 2; }
                else if (nlc == 1) { html += htmlChar(c) + "<br>\r\n"; nlc = 0; }
            }
            else
            {
                html += htmlChar(c);
            }
        }

        return html + "</div>\r\n";
    }
}
