<ToolShell ResourceKey="ascii" Title="ASCII Converter" Icon="bi-keyboard" Description="Get ASCII values (dec, hex, oct) for a character.">
    <div class="tool-form">
        <div class="tool-field">
            <label class="tool-label" for="ascii">Character</label>
            <div class="conv-row">
                <input id="ascii" class="tool-input" @bind="AsciiValue" placeholder="'" style="max-width: 120px;" />
                <button class="tool-btn tool-btn-primary" @onclick="GetAsciiValues">Get ASCII Values</button>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(Char))
        {
            <table class="tool-table">
                <thead>
                    <tr><th>Char</th><th>Dec</th><th>Hex</th><th>Oct</th></tr>
                </thead>
                <tbody>
                    <tr>
                        <td>@Char</td>
                        <td>@Dec</td>
                        <td>@Hex</td>
                        <td>@Oct</td>
                    </tr>
                </tbody>
            </table>
        }
    </div>
    <hr class="tool-divider" />
    <p class="tool-hint">Inspired by <a href="http://asciivalue.com/" target="_blank">ASCIIvalue</a></p>
</ToolShell>

@code {
    string AsciiValue = "'";
    string Char = string.Empty;
    string Dec = string.Empty;
    string Hex = string.Empty;
    string Oct = string.Empty;

    void GetAsciiValues()
    {
        Char = AsciiValue;
        Dec = "N/A";
        Hex = String.Concat(AsciiValue.Select(x => ((int)x).ToString("x2")));
        Oct = "N/A";
    }
}