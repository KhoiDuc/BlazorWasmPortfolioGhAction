@using System.Text
@using System.Globalization
@inject IJSRuntime JSRuntime

<ToolShell Title="String Converter" Icon="bi-fonts" Description="Transform text between different cases.">
    <div class="tool-form">
        <div class="tool-field">
            <label class="tool-label">Conversion mode</label>
            <div class="tool-radio-group">
                @foreach (var option in Options)
                {
                    <label class="tool-radio">
                        <input type="radio" name="caseMode" value="@option" checked="@(choice.Name == option)" @onchange="@(() => choice.Name = option)" />
                        @option
                    </label>
                }
            </div>
        </div>
        <div class="tool-field">
            <label class="tool-label" for="stringconverter">Input</label>
            <textarea id="stringconverter" class="tool-textarea" rows="4" @bind="Input"></textarea>
            <div class="tool-actions" style="margin-top: 0.6rem;">
                <button class="tool-btn tool-btn-primary" @onclick="Convert">Convert</button>
                <button class="tool-btn tool-btn-danger" @onclick="Clear">
                    <i class="bi bi-trash" aria-hidden="true"></i> Clear
                </button>
            </div>
        </div>
        <div class="tool-field">
            <label class="tool-label">Output</label>
            <div class="conv-row">
                <textarea class="tool-textarea" rows="4" @bind="Output" readonly></textarea>
            </div>
            <div class="tool-actions" style="margin-top: 0.6rem;">
                <button class="tool-btn" @onclick="Copy">
                    <i class="bi bi-clipboard" aria-hidden="true"></i> Copy
                </button>
            </div>
        </div>
    </div>
</ToolShell>

@code {
    string Input = "the quick brown fox jumps over the lazy dog";
    string Output = string.Empty;

    Choice choice = new Choice() { Name = "Sentence case" };
    List<string> Options = new List<string> { "Sentence case", "lower case", "UPPER CASE", "Capitalized Case", "aLtErNaTiNg cAsE", "Title Case", "InVeRsE CaSe", "Remove Whitespace" };

    private void Convert()
    {
        TextInfo ti = CultureInfo.CurrentCulture.TextInfo;
        switch (choice.Name)
        {
            case "Sentence case": Output = Input.FirstCharToUpper(); break;
            case "lower case": Output = Input.ToLower(); break;
            case "UPPER CASE": Output = Input.ToUpper(); break;
            case "Capitalized Case": Output = ti.ToTitleCase(Input); break;
            case "Title Case": Output = ti.ToTitleCase(Input); break;
            case "InVeRsE CaSe": Output = Input.Invert(); break;
            case "Remove Whitespace": Output = String.Concat(Input.Where(c => !Char.IsWhiteSpace(c))); break;
        }
    }

    private void Clear() { Input = string.Empty; }

    async Task Copy()
    {
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", Output);
    }

    public class Choice { public string Name { get; set; } = ""; }
}