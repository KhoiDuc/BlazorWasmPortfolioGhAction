@using System.Web;
@using System.Collections.Specialized;

<div class="tool-card">
    <div class="tool-header">
        <h3>URL Splitter</h3>
        <p>Parse a URL into hostname, pathname, and query parameters.</p>
    </div>
    <div class="tool-form">
        <div class="tool-field">
            <label class="tool-label" for="path">Full URL</label>
            <input type="text" id="path" class="tool-input" @bind="Path" />
            <span class="tool-hint">Length: @pathLength</span>
        </div>
        <div class="tool-actions">
            <button type="button" class="tool-btn tool-btn-primary" @onclick="Split">Split URL</button>
        </div>
        <div class="tool-field">
            <label class="tool-label" for="hostname">Hostname</label>
            <input type="text" id="hostname" class="tool-input" @bind="hostname" disabled />
        </div>
        <div class="tool-field">
            <label class="tool-label" for="pathname">Pathname</label>
            <input type="text" id="pathname" class="tool-input" @bind="pathName" disabled />
        </div>
    </div>

    @if (queryString.Count > 0)
    {
        <div class="tool-table-wrapper">
            <table class="tool-table">
                <thead>
                    <tr><th>Key</th><th>Value</th></tr>
                </thead>
                <tbody>
                    @foreach (string key in queryString)
                    {
                        <tr>
                            <td>@key</td>
                            <td>@queryString[key]</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [Parameter]
    public string Path { get; set; } = string.Empty;

    int pathLength;
    string hostname = string.Empty;
    string pathName = string.Empty;
    NameValueCollection queryString = new();

    protected override void OnInitialized()
    {
        Path = "https://www.alexhedley.com/path?query=this&param=that";
        pathLength = Path.Length;
        queryString = new NameValueCollection();
    }

    private void Split()
    {
        pathLength = Path.Length;
        var uri = new Uri(Path);
        hostname = uri.Host;
        pathName = uri.AbsolutePath;
        queryString = HttpUtility.ParseQueryString(uri.Query);
    }
}
