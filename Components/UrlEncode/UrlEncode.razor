@using System.Net;

<ToolShell Title="URL Encode / Decode" Icon="bi-link" Description="Percent-encode or decode URL strings.">
    <div class="tool-form">
        <div class="tool-field">
            <label class="tool-label" for="urlEncode">Plain URL</label>
            <input id="urlEncode" class="tool-input" @bind="url" />
            <div class="tool-actions">
                <button type="button" class="tool-btn tool-btn-success" @onclick="Encode">Encode</button>
            </div>
        </div>
        <div class="tool-field">
            <label class="tool-label" for="urlDecode">Encoded URL</label>
            <input id="urlDecode" class="tool-input" @bind="dUrl" />
            <div class="tool-actions">
                <button type="button" class="tool-btn tool-btn-success" @onclick="Decode">Decode</button>
            </div>
        </div>
    </div>
    <p class="tool-hint">Inspired by <a href="https://meyerweb.com/eric/tools/dencoder/" target="_blank" rel="noopener">meyerweb URL Decoder/Encoder</a></p>
</ToolShell>

@code {
    string url = "http://www.alexhedley.com";
    string dUrl = "";

    private void Encode() => dUrl = WebUtility.UrlEncode(url);
    private void Decode() => url = WebUtility.UrlDecode(dUrl);
}
