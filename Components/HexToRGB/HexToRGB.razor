@using System
@using System.Drawing

<div class="tool-card">
    <div class="tool-header">
        <h3>Hex to RGB Converter</h3>
        <p>Pick a color to extract RGB values.</p>
    </div>
    <div class="tool-form">
        <div class="tool-field">
            <label class="tool-label" for="colour">Color picker</label>
            <div class="hexrgb-picker-row">
                <input type="color" id="colour" class="hexrgb-swatch" @bind="Colour" />
                <code class="tool-inline-code">@ColourId</code>
                <button class="tool-btn tool-btn-primary" @onclick="ConvertColour">Convert</button>
            </div>
        </div>
        <div class="tool-field">
            <label class="tool-label">RGB Values</label>
            <div class="hexrgb-rgb-row">
                <div class="hexrgb-channel">
                    <span class="hexrgb-dot" style="background:#ef4444"></span>
                    <label class="tool-hint" for="rgbRed">R</label>
                    <input type="number" class="tool-input" id="rgbRed" @bind="Red" />
                </div>
                <div class="hexrgb-channel">
                    <span class="hexrgb-dot" style="background:#22c55e"></span>
                    <label class="tool-hint" for="rgbGreen">G</label>
                    <input type="number" class="tool-input" id="rgbGreen" @bind="Green" />
                </div>
                <div class="hexrgb-channel">
                    <span class="hexrgb-dot" style="background:#3b82f6"></span>
                    <label class="tool-hint" for="rgbBlue">B</label>
                    <input type="number" class="tool-input" id="rgbBlue" @bind="Blue" />
                </div>
            </div>
        </div>
    </div>
    <hr class="tool-divider" />
    <p class="tool-hint">See: <a href="https://github.com/AlexHedley/HEXtoObjCColor" target="_blank">HEXtoObjCColor</a></p>
</div>

@code {
    string Colour = "#26264C";
    string ColourId = "#";
    int Red = 0;
    int Green = 0;
    int Blue = 0;

    void ConvertColour()
    {
        ColourId = Colour;
        System.Drawing.Color color = ColorTranslator.FromHtml(Colour);
        Red = Convert.ToInt16(color.R);
        Green = Convert.ToInt16(color.G);
        Blue = Convert.ToInt16(color.B);
    }
}