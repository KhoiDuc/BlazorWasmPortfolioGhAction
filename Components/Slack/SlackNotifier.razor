@using BlazorWasmPortfolioGhAction.Services
@inject IDevOpsService DevOpsService
@inject IJSRuntime JSRuntime

<ToolShell Title="Slack Notifier" Icon="bi-slack" Description="Send messages to Slack channels via webhook.">

    @if (!string.IsNullOrWhiteSpace(SuccessMessage))
    {
        <div class="tool-alert tool-alert-success">
            <i class="bi bi-check-circle" aria-hidden="true"></i>
            @SuccessMessage
            <button type="button" class="slack-dismiss" @onclick="(() => SuccessMessage = null)" aria-label="Dismiss">&times;</button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="tool-alert tool-alert-danger">
            <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
            @ErrorMessage
            <button type="button" class="slack-dismiss" @onclick="(() => ErrorMessage = null)" aria-label="Dismiss">&times;</button>
        </div>
    }

    <div class="slack-layout">
        <div class="tool-card slack-form-card">
            <div class="tool-form">
                <div class="tool-field">
                    <label class="tool-label" for="channel">Channel <span class="slack-req">*</span></label>
                    <input type="text" id="channel" class="tool-input" @bind="Channel" placeholder="#general or @@username" />
                    <span class="tool-hint">Channel name (with #) or username (with @@)</span>
                </div>

                <div class="tool-field">
                    <label class="tool-label" for="message">Message <span class="slack-req">*</span></label>
                    <textarea id="message" class="tool-textarea" rows="6" @bind="MessageText" placeholder="Your Slack message..."></textarea>
                </div>

                <div class="tool-field">
                    <label class="tool-checkbox">
                        <input type="checkbox" @bind="UseMarkdown" />
                        Enable Markdown formatting
                    </label>
                </div>

                <div class="tool-actions">
                    <button type="button" class="tool-btn tool-btn-primary" @onclick="SendMessage">
                        <i class="bi bi-slack" aria-hidden="true"></i> Send to Slack
                    </button>
                    <button type="button" class="tool-btn" @onclick="ClearForm">
                        <i class="bi bi-eraser" aria-hidden="true"></i> Clear
                    </button>
                </div>
            </div>
        </div>

        <div class="tool-card slack-sidebar">
            <div class="tool-result-label">Preview</div>
            <div class="slack-preview">
                <div class="slack-preview-row"><strong>To:</strong> @(string.IsNullOrWhiteSpace(Channel) ? "Not set" : Channel)</div>
                <div class="slack-preview-row"><strong>Message:</strong></div>
                <small class="slack-preview-msg">@MessageText</small>
            </div>

            <hr class="tool-divider" />

            <div class="tool-result-label">Setup</div>
            <ol class="slack-steps">
                <li>Open Slack workspace settings</li>
                <li>App Directory → Search "Incoming Webhooks"</li>
                <li>Add to Workspace → Select channel → Copy Webhook URL</li>
                <li>Paste in appsettings.json:</li>
            </ol>
            <pre class="tool-code">"DevOps": {
  "SlackWebhookUrl": "https://hooks..."
}</pre>

            <hr class="tool-divider" />

            <div class="tool-hint">
                <strong>Config status:</strong><br />
                @if (IsConfigured)
                {
                    <span class="slack-status-ok"><i class="bi bi-check-circle" aria-hidden="true"></i> Slack webhook configured</span>
                }
                else
                {
                    <span class="slack-status-warn"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> Missing Slack webhook URL</span>
                }
            </div>

            <hr class="tool-divider" />

            <div class="tool-result-label">Markdown examples</div>
            <ul class="slack-md-list">
                <li><code class="tool-inline-code">*bold*</code></li>
                <li><code class="tool-inline-code">_italic_</code></li>
                <li><code class="tool-inline-code">`code`</code></li>
                <li><code class="tool-inline-code">```code block```</code></li>
                <li><code class="tool-inline-code">&lt;https://link.com|Link text&gt;</code></li>
            </ul>
        </div>
    </div>
</ToolShell>

@code {
    private string Channel = string.Empty;
    private string MessageText = string.Empty;
    private bool UseMarkdown = true;
    private string? SuccessMessage;
    private string? ErrorMessage;

    [Inject]
    private IConfiguration Configuration { get; set; } = null!;

    private bool IsConfigured => !string.IsNullOrWhiteSpace(Configuration["DevOps:SlackWebhookUrl"]);

    private async Task SendMessage()
    {
        SuccessMessage = null;
        ErrorMessage = null;

        if (string.IsNullOrWhiteSpace(Channel))
        {
            ErrorMessage = "Channel name is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(MessageText))
        {
            ErrorMessage = "Message cannot be empty.";
            return;
        }

        var result = await DevOpsService.SendSlackMessageAsync(Channel, MessageText);
        if (result)
        {
            SuccessMessage = $"Message sent to {Channel}!";
            Channel = MessageText = string.Empty;
        }
        else
        {
            ErrorMessage = IsConfigured
                ? "Failed to send message. Check webhook URL or channel."
                : "Slack webhook not configured.";
        }
    }

    private void ClearForm()
    {
        Channel = MessageText = string.Empty;
        SuccessMessage = ErrorMessage = null;
    }
}