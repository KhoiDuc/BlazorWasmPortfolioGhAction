@using BlazorWasmPortfolioGhAction.Services
@inject IDevOpsService DevOpsService
@inject IJSRuntime JSRuntime

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h2><i class="fab fa-slack"></i> Slack Notifier</h2>
            <p class="text-muted small">Send messages to Slack channels via webhook.</p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @SuccessMessage
            <button type="button" class="btn-close" @onclick="(() => SuccessMessage = null)"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @ErrorMessage
            <button type="button" class="btn-close" @onclick="(() => ErrorMessage = null)"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    <div class="mb-3">
                        <label for="channel" class="form-label">Channel <span class="text-danger">*</span></label>
                        <input type="text" id="channel" class="form-control" @bind="Channel" placeholder="#general or @@username" />
                        <div class="form-text">Channel name (with #) or username (with @@)</div>
                    </div>

                    <div class="mb-3">
                        <label for="message" class="form-label">Message <span class="text-danger">*</span></label>
                        <textarea id="message" class="form-control" rows="6" @bind="MessageText" placeholder="Your Slack message..."></textarea>
                    </div>

                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="markdown" @bind="UseMarkdown" />
                            <label class="form-check-label" for="markdown">
                                Enable Markdown formatting
                            </label>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-primary" @onclick="SendMessage">
                            <i class="fab fa-slack"></i> Send to Slack
                        </button>
                        <button type="button" class="btn btn-outline-secondary" @onclick="ClearForm">
                            <i class="fas fa-eraser"></i> Clear
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-info-circle"></i> Preview</h5>
                </div>
                <div class="card-body">
                    <div class="bg-light p-3 rounded mb-3 border-start border-4" style="border-color: #36C5F0;">
                        <strong>To:</strong> @(string.IsNullOrWhiteSpace(Channel) ? "Not set" : Channel)<br />
                        <strong>Message:</strong><br />
                        <small>@MessageText</small>
                    </div>

                    <hr class="my-3" />

                    <h6><i class="fas fa-cog"></i> Setup</h6>
                    <ol class="small">
                        <li>Open Slack workspace settings</li>
                        <li>App Directory → Search "Incoming Webhooks"</li>
                        <li>Add to Workspace → Select channel → Copy Webhook URL</li>
                        <li>Paste in appsettings.json:
                            <pre class="bg-light p-2 rounded mt-2"><code>"DevOps": {
  "SlackWebhookUrl": "https://hooks..."
}</code></pre>
                        </li>
                    </ol>

                    <hr class="my-3" />

                    <div class="small text-muted">
                        <strong>Config status:</strong><br />
                        @if (IsConfigured)
                        {
                            <span class="text-success"><i class="fas fa-check-circle"></i> Slack webhook configured</span>
                        }
                        else
                        {
                            <span class="text-warning"><i class="fas fa-exclamation-triangle"></i> Missing Slack webhook URL</span>
                        }
                    </div>

                    <hr class="my-3" />

                    <h6>Markdown examples</h6>
                    <ul class="small">
                        <li><code>*bold*</code></li>
                        <li><code>_italic_</code></li>
                        <li><code>`code`</code></li>
                        <li><code>```code block```</code></li>
                        <li><code>&lt;https://link.com|Link text&gt;</code></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string Channel = string.Empty;
    private string MessageText = string.Empty;
    private bool UseMarkdown = true;
    private string? SuccessMessage;
    private string? ErrorMessage;

    [Inject]
    private IConfiguration Configuration { get; set; } = null!;

    private bool IsConfigured => !string.IsNullOrWhiteSpace(Configuration["DevOps:SlackWebhookUrl"]);

    private async Task SendMessage()
    {
        SuccessMessage = null;
        ErrorMessage = null;

        if (string.IsNullOrWhiteSpace(Channel))
        {
            ErrorMessage = "Channel name is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(MessageText))
        {
            ErrorMessage = "Message cannot be empty.";
            return;
        }

        var result = await DevOpsService.SendSlackMessageAsync(Channel, MessageText);
        if (result)
        {
            SuccessMessage = $"Message sent to {Channel}!";
            Channel = MessageText = string.Empty;
        }
        else
        {
            ErrorMessage = IsConfigured
                ? "Failed to send message. Check webhook URL or channel."
                : "Slack webhook not configured.";
        }
    }

    private void ClearForm()
    {
        Channel = MessageText = string.Empty;
        SuccessMessage = ErrorMessage = null;
    }
}
