@using BlazorWasmPortfolioGhAction.Models.GitHub
@using BlazorWasmPortfolioGhAction.Services
@using BlazorWasmPortfolioGhAction.Shared
@inject IDevOpsService DevOpsService
@inject IStringLocalizer<SharedResources> L

<ToolShell ResourceKey="githubtrending" Title="GitHub Trending Repos" Icon="bi-graph-up-arrow" Description="Discover recently popular repositories on GitHub.">

    <div class="tool-form">
        <div class="tool-field">
            <label class="tool-label" for="gh-trend-lang">Language (optional)</label>
            <input id="gh-trend-lang" type="text" @bind="language" class="tool-input" placeholder="e.g. csharp, javascript, python" />
        </div>
        <div class="tool-field">
            <label class="tool-label" for="gh-trend-range">Time range</label>
            <select id="gh-trend-range" @bind="timeRange" class="tool-input">
                <option value="day">Last day</option>
                <option value="week">Last week</option>
                <option value="month">Last month</option>
            </select>
        </div>
        <div class="tool-actions">
            <button type="button" @onclick="LoadTrending" class="tool-btn tool-btn-primary" disabled="@isLoading">
                @if (isLoading) { <span>@L["Common_Loading"]</span> } else { <span>Load trending</span> }
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <LoadingSpinner LabelKey="Common_LoadingData" />
    }

    @if (results != null && results.Count > 0)
    {
        <div class="tool-result-list">
            <p class="tool-hint">Found @results.Count trending repositories (showing top 15)</p>
            @foreach (var repo in results.Take(15))
            {
                <div class="tool-repo-card">
                    <h4>
                        <a href="@repo.HtmlUrl" target="_blank" rel="noopener">@repo.Name</a>
                        @if (!string.IsNullOrEmpty(repo.Language))
                        {
                            <span class="tool-badge">@repo.Language</span>
                        }
                    </h4>
                    <p class="tool-repo-description">@repo.Description</p>
                    <div class="tool-repo-stats">
                        <span><i class="bi bi-star" aria-hidden="true"></i> @repo.Stars.ToString("N0")</span>
                        <span><i class="bi bi-diagram-2" aria-hidden="true"></i> @repo.Forks.ToString("N0")</span>
                        <span>Updated @repo.UpdatedAt.ToString("MMM d, yyyy")</span>
                    </div>
                    @if (repo.Topics?.Count > 0)
                    {
                        <div class="tool-badge-row">
                            @foreach (var topic in repo.Topics.Take(3))
                            {
                                <span class="tool-badge">@topic</span>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }
    else if (loadPerformed && results?.Count == 0)
    {
        <div class="tool-alert tool-alert-info">No trending repositories found.</div>
    }
</ToolShell>

@code {
    private string language = string.Empty;
    private string timeRange = "day";
    private List<GitHubRestRepo>? results = null;
    private bool isLoading = false;
    private bool loadPerformed = false;

    private async Task LoadTrending()
    {
        isLoading = true;
        loadPerformed = true;

        var trending = await DevOpsService.GetGitHubTrendingAsync(language, timeRange);
        results = trending ?? [];
        isLoading = false;
    }
}
