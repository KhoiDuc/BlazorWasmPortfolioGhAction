@using BlazorWasmPortfolioGhAction.Services
@inject IDevOpsService DevOpsService

<div class="devops-container">
    <h3>GitHub Trending Repos</h3>
    
    <div class="form-group">
        <label>Language (optional):</label>
        <input type="text" @bind="language" class="form-control" placeholder="e.g. csharp, javascript, python" />
    </div>

    <div class="form-group">
        <label>Time Range:</label>
        <select @bind="timeRange" class="form-control">
            <option value="day">Last Day</option>
            <option value="week">Last Week</option>
            <option value="month">Last Month</option>
        </select>
    </div>

    <div class="form-actions">
        <button @onclick="LoadTrending" class="btn btn-primary" disabled="@isLoading">
            @if (isLoading) { <span>Loading...</span> } else { <span>Load Trending</span> }
        </button>
    </div>

    @if (results != null && results.Count > 0)
    {
        <div class="results-container">
            <p class="results-count">Found @results.Count trending repositories</p>
            @foreach (var repo in results.Take(15))
            {
                <div class="repo-card trending">
                    <h4>
                        <a href="@repo.HtmlUrl" target="_blank">@repo.Name</a>
                        @if (!string.IsNullOrEmpty(repo.Language))
                        {
                            <span class="language-badge">@repo.Language</span>
                        }
                    </h4>
                    <p class="repo-description">@repo.Description</p>
                    <div class="repo-stats">
                        <span>⭐ @repo.Stars.ToString("N0")</span>
                        <span>🔀 @repo.Forks.ToString("N0")</span>
                        <span class="updated">Updated: @repo.UpdatedAt.ToString("MMM d, yyyy")</span>
                    </div>
                    @if (repo.Topics?.Count > 0)
                    {
                        <div class="topics">
                            @foreach (var topic in repo.Topics.Take(3))
                            {
                                <span class="topic-badge">@topic</span>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }
    else if (loadPerformed && results?.Count == 0)
    {
        <p class="text-warning">No trending repositories found.</p>
    }
</div>

@code {
    private string language = string.Empty;
    private string timeRange = "day";
    private List<GitHubRepo>? results = null;
    private bool isLoading = false;
    private bool loadPerformed = false;

    private async Task LoadTrending()
    {
        isLoading = true;
        loadPerformed = true;
        
        var trending = await DevOpsService.GetGitHubTrendingAsync(language, timeRange);
        results = trending ?? new List<GitHubRepo>();
        isLoading = false;
    }
}
