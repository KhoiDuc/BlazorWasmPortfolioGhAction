@using BlazorWasmPortfolioGhAction.Store.Services
@inject IGitHubGraphQLQueryService GitHubService

<div class="tool-card">
    <div class="tool-header">
        <h3><i class="bi bi-github" aria-hidden="true"></i> GitHub User Search (GraphQL)</h3>
        <p>Search GitHub users via GraphQL API (mock data when MockApi is enabled).</p>
    </div>

    <div class="tool-form">
        <div class="tool-field">
            <label class="tool-label" for="gh-user-search">Search query</label>
            <div class="tool-inline-search">
                <input id="gh-user-search" type="text" class="tool-input" placeholder="Search GitHub users..." @bind="searchText" @onkeyup.enter="SearchUsers" />
                <button type="button" class="tool-btn tool-btn-primary" @onclick="SearchUsers">
                    <i class="bi bi-search" aria-hidden="true"></i> Search
                </button>
            </div>
        </div>
    </div>

    <RateLimitDisplay />

    @if (isLoading)
    {
        <div class="tool-alert tool-alert-info">Searching users...</div>
    }

    @if (users?.Any() == true)
    {
        <div class="tool-result-list">
            @foreach (var user in users)
            {
                <UserCard User="user" />
            }
        </div>
    }
</div>

@if (showUserDetails)
{
    <UserDetailsModal UserDetail="selectedUser" OnClose="() => showUserDetails = false" />
}

@code {
    private string searchText = "";
    private List<GitHubUser> users = new();
    private GitHubUserDetail? selectedUser;
    private bool isLoading;
    private bool showUserDetails;

    private async Task SearchUsers()
    {
        try
        {
            isLoading = true;
            var result = await GitHubService.SearchUsersAsync(searchText, "YOUR_TOKEN");
            users = result.IsSuccess && result.Value != null ? result.Value : new();
        }
        catch { }
        finally
        {
            isLoading = false;
        }
    }
}
