@page "/search/users"
@using BlazorWasmPortfolioGhAction.Store.Services

@inject ISearchUsersService SearchUsersService

<div class="tool-card">
    <div class="tool-header">
        <h3><i class="bi bi-search" aria-hidden="true"></i> Search GitHub Users</h3>
        <p>Search users via GraphQL API with client-side pagination.</p>
    </div>

    <div class="tool-form">
        <div class="tool-field">
            <label class="tool-label" for="access-token">Access token</label>
            <input id="access-token" @bind="AccessToken" placeholder="Access token" class="tool-input" />
        </div>
        <div class="tool-field">
            <label class="tool-label" for="search-text">Search text</label>
            <div class="tool-inline-search">
                <input id="search-text" @bind="SearchText" placeholder="Search text" class="tool-input" @onkeydown="OnKeyDownAsync" />
                <button type="button" @onclick="StartSearchAsync" class="tool-btn tool-btn-primary" disabled="@string.IsNullOrEmpty(SearchText)">Search</button>
            </div>
        </div>
    </div>

    <ul class="tool-result-list">
        @foreach (var user in _users)
        {
            <li class="tool-user-card tool-user-card-static">
                <div class="tool-user-info">
                    <strong>@user.Login</strong>
                    <span class="tool-user-name">@user.Name</span>
                </div>
            </li>
        }
    </ul>

    <div class="tool-actions tool-pagination">
        <button type="button" @onclick="() => UpdateUsersPage(_currentPage - 1)" class="tool-btn tool-btn-secondary" disabled="@(_currentPage <= 1)">Previous</button>
        <span>Page @_currentPage of @_totalPageCount</span>
        <button type="button" @onclick="() => UpdateUsersPage(_currentPage + 1)" class="tool-btn tool-btn-secondary" disabled="@(_currentPage >= _totalPageCount)">Next</button>
    </div>
</div>
