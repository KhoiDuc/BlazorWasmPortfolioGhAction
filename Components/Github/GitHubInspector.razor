@using BlazorWasmPortfolioGhAction.Services
@inject IDevOpsService DevOpsService

<div class="devops-container">
    <h3>GitHub User/Repo Inspector</h3>
    
    <div class="form-group">
        <label>Inspect Type:</label>
        <select @bind="inspectType" class="form-control">
            <option value="user">User</option>
            <option value="repo">Repository</option>
        </select>
    </div>

    @if (inspectType == "user")
    {
        <div class="form-group">
            <label>GitHub Username:</label>
            <input type="text" @bind="username" class="form-control" placeholder="e.g. torvalds, octocat" />
        </div>
        <button @onclick="InspectUser" class="btn btn-primary" disabled="@isLoading">Inspect User</button>
    }
    else
    {
        <div class="form-group">
            <label>Owner:</label>
            <input type="text" @bind="owner" class="form-control" placeholder="e.g. dotnet" />
        </div>
        <div class="form-group">
            <label>Repository:</label>
            <input type="text" @bind="repo" class="form-control" placeholder="e.g. runtime" />
        </div>
        <button @onclick="InspectRepo" class="btn btn-primary" disabled="@isLoading">Inspect Repo</button>
    }

    @if (user != null)
    {
        <div class="inspect-card">
            <img src="@user.AvatarUrl" alt="@user.Login" class="avatar" />
            <h3>@user.Name (@user.Login)</h3>
            @if (!string.IsNullOrEmpty(user.Bio))
            {
                <p>@user.Bio</p>
            }
            <div class="user-stats">
                <div><strong>Repos:</strong> @user.PublicRepos</div>
                <div><strong>Followers:</strong> @user.Followers</div>
                <div><strong>Following:</strong> @user.Following</div>
                <div><strong>Joined:</strong> @user.CreatedAt.ToString("MMM d, yyyy")</div>
            </div>
            @if (!string.IsNullOrEmpty(user.Company))
            {
                <p><strong>Company:</strong> @user.Company</p>
            }
            @if (!string.IsNullOrEmpty(user.Location))
            {
                <p><strong>Location:</strong> @user.Location</p>
            }
            <a href="@user.HtmlUrl" target="_blank" class="btn btn-secondary btn-sm">View on GitHub</a>
        </div>
    }

    @if (repoInfo != null)
    {
        <div class="inspect-card">
            <h3>
                <a href="@repoInfo.HtmlUrl" target="_blank">@repoInfo.FullName</a>
            </h3>
            @if (!string.IsNullOrEmpty(repoInfo.Description))
            {
                <p>@repoInfo.Description</p>
            }
            <div class="repo-stats">
                <span>⭐ Stars: @repoInfo.Stars</span>
                <span>🔀 Forks: @repoInfo.Forks</span>
                @if (!string.IsNullOrEmpty(repoInfo.Language))
                {
                    <span>Language: @repoInfo.Language</span>
                }
            </div>
            @if (repoInfo.Topics?.Count > 0)
            {
                <div class="topics">
                    @foreach (var topic in repoInfo.Topics)
                    {
                        <span class="topic-badge">@topic</span>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private string inspectType = "user";
    private string username = string.Empty;
    private string owner = string.Empty;
    private string repo = string.Empty;
    private GitHubUser? user = null;
    private GitHubRepo? repoInfo = null;
    private bool isLoading = false;

    private async Task InspectUser()
    {
        if (string.IsNullOrWhiteSpace(username)) return;
        isLoading = true;
        user = await DevOpsService.GetGitHubUserAsync(username);
        repoInfo = null;
        isLoading = false;
    }

    private async Task InspectRepo()
    {
        if (string.IsNullOrWhiteSpace(owner) || string.IsNullOrWhiteSpace(repo)) return;
        isLoading = true;
        repoInfo = await DevOpsService.GetGitHubRepoAsync(owner, repo);
        user = null;
        isLoading = false;
    }
}
