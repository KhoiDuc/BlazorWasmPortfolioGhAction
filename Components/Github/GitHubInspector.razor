@using BlazorWasmPortfolioGhAction.Models.GitHub
@using BlazorWasmPortfolioGhAction.Services
@using BlazorWasmPortfolioGhAction.Shared
@inject IDevOpsService DevOpsService
@inject IStringLocalizer<SharedResources> L

<ToolShell ResourceKey="githubinspector" Title="GitHub User/Repo Inspector" Icon="bi-person-badge" Description="Look up GitHub users or repositories by name.">

    <div class="tool-form">
        <div class="tool-field">
            <label class="tool-label" for="gh-inspect-type">Inspect type</label>
            <select id="gh-inspect-type" @bind="inspectType" class="tool-input">
                <option value="user">User</option>
                <option value="repo">Repository</option>
            </select>
        </div>

        @if (inspectType == "user")
        {
            <div class="tool-field">
                <label class="tool-label" for="gh-username">GitHub username</label>
                <input id="gh-username" type="text" @bind="username" class="tool-input" placeholder="e.g. torvalds, octocat" />
            </div>
            <div class="tool-actions">
                <button type="button" @onclick="InspectUser" class="tool-btn tool-btn-primary" disabled="@isLoading">@L["Common_Searching"]</button>
            </div>
        }
        else
        {
            <div class="tool-field">
                <label class="tool-label" for="gh-owner">Owner</label>
                <input id="gh-owner" type="text" @bind="owner" class="tool-input" placeholder="e.g. dotnet" />
            </div>
            <div class="tool-field">
                <label class="tool-label" for="gh-repo">Repository</label>
                <input id="gh-repo" type="text" @bind="repo" class="tool-input" placeholder="e.g. runtime" />
            </div>
            <div class="tool-actions">
                <button type="button" @onclick="InspectRepo" class="tool-btn tool-btn-primary" disabled="@isLoading">@L["Common_Searching"]</button>
            </div>
        }
    </div>

    @if (isLoading)
    {
        <LoadingSpinner LabelKey="Common_Searching" />
    }

    @if (user != null)
    {
        <div class="tool-inspect-card">
            <img src="@user.AvatarUrl" alt="@user.Login avatar" class="tool-inspect-avatar" loading="lazy" decoding="async" />
            <h3>@user.Name (@user.Login)</h3>
            @if (!string.IsNullOrEmpty(user.Bio))
            {
                <p class="tool-repo-description">@user.Bio</p>
            }
            <div class="tool-user-stats">
                <span><strong>Repos:</strong> @user.PublicRepos</span>
                <span><strong>Followers:</strong> @user.Followers</span>
                <span><strong>Following:</strong> @user.Following</span>
                <span><strong>Joined:</strong> @user.CreatedAt.ToString("MMM d, yyyy")</span>
            </div>
            @if (!string.IsNullOrEmpty(user.Company))
            {
                <p class="tool-hint"><strong>Company:</strong> @user.Company</p>
            }
            @if (!string.IsNullOrEmpty(user.Location))
            {
                <p class="tool-hint"><strong>Location:</strong> @user.Location</p>
            }
            <div class="tool-actions">
                <a href="@user.HtmlUrl" target="_blank" rel="noopener" class="tool-btn tool-btn-secondary">View on GitHub</a>
            </div>
        </div>
    }

    @if (repoInfo != null)
    {
        <div class="tool-inspect-card">
            <h3><a href="@repoInfo.HtmlUrl" target="_blank" rel="noopener">@repoInfo.FullName</a></h3>
            @if (!string.IsNullOrEmpty(repoInfo.Description))
            {
                <p class="tool-repo-description">@repoInfo.Description</p>
            }
            <div class="tool-repo-stats">
                <span><i class="bi bi-star" aria-hidden="true"></i> @repoInfo.Stars</span>
                <span><i class="bi bi-diagram-2" aria-hidden="true"></i> @repoInfo.Forks</span>
                @if (!string.IsNullOrEmpty(repoInfo.Language))
                {
                    <span>@repoInfo.Language</span>
                }
            </div>
            @if (repoInfo.Topics?.Count > 0)
            {
                <div class="tool-badge-row">
                    @foreach (var topic in repoInfo.Topics)
                    {
                        <span class="tool-badge">@topic</span>
                    }
                </div>
            }
        </div>
    }
</ToolShell>

@code {
    private string inspectType = "user";
    private string username = string.Empty;
    private string owner = string.Empty;
    private string repo = string.Empty;
    private GitHubRestUser? user = null;
    private GitHubRestRepo? repoInfo = null;
    private bool isLoading = false;

    private async Task InspectUser()
    {
        if (string.IsNullOrWhiteSpace(username)) return;
        isLoading = true;
        user = await DevOpsService.GetGitHubUserAsync(username);
        repoInfo = null;
        isLoading = false;
    }

    private async Task InspectRepo()
    {
        if (string.IsNullOrWhiteSpace(owner) || string.IsNullOrWhiteSpace(repo)) return;
        isLoading = true;
        repoInfo = await DevOpsService.GetGitHubRepoAsync(owner, repo);
        user = null;
        isLoading = false;
    }
}
