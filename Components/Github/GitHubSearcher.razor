@using BlazorWasmPortfolioGhAction.Models.GitHub
@using BlazorWasmPortfolioGhAction.Services
@inject IDevOpsService DevOpsService

<div class="tool-card">
    <div class="tool-header">
        <h3><i class="bi bi-search" aria-hidden="true"></i> GitHub Repo Search</h3>
        <p>Search public repositories via the GitHub REST API.</p>
    </div>

    <div class="tool-form">
        <div class="tool-field">
            <label class="tool-label" for="gh-search-query">Search query</label>
            <input id="gh-search-query" type="text" @bind="searchQuery" class="tool-input" placeholder="e.g. blazor, dotnet, react" />
        </div>
        <div class="tool-field">
            <label class="tool-label" for="gh-search-lang">Language (optional)</label>
            <input id="gh-search-lang" type="text" @bind="language" class="tool-input" placeholder="e.g. csharp, javascript, python" />
        </div>
        <div class="tool-field">
            <label class="tool-label" for="gh-search-sort">Sort by</label>
            <select id="gh-search-sort" @bind="sortBy" class="tool-input">
                <option value="0">Stars</option>
                <option value="1">Forks</option>
                <option value="2">Updated</option>
            </select>
        </div>
        <div class="tool-actions">
            <button type="button" @onclick="Search" class="tool-btn tool-btn-primary" disabled="@isLoading">
                @if (isLoading) { <span>Searching...</span> } else { <span>Search</span> }
            </button>
        </div>
    </div>

    @if (results != null && results.Count > 0)
    {
        <div class="tool-result-list">
            <p class="tool-hint">Found @results.Count repositories (showing top 10)</p>
            @foreach (var repo in results.Take(10))
            {
                <div class="tool-repo-card">
                    <h4>
                        <a href="@repo.HtmlUrl" target="_blank" rel="noopener">@repo.Name</a>
                        @if (!string.IsNullOrEmpty(repo.Language))
                        {
                            <span class="tool-badge">@repo.Language</span>
                        }
                    </h4>
                    <p class="tool-repo-description">@repo.Description</p>
                    <div class="tool-repo-stats">
                        <span><i class="bi bi-star" aria-hidden="true"></i> @repo.Stars</span>
                        <span><i class="bi bi-diagram-2" aria-hidden="true"></i> @repo.Forks</span>
                        <span>Updated @repo.UpdatedAt.ToString("MMM d, yyyy")</span>
                    </div>
                </div>
            }
        </div>
    }
    else if (searchPerformed && results?.Count == 0)
    {
        <div class="tool-alert tool-alert-info">No repositories found. Try different search terms.</div>
    }
</div>

@code {
    private string searchQuery = string.Empty;
    private string language = string.Empty;
    private int sortBy = 0;
    private List<GitHubRestRepo>? results = null;
    private bool isLoading = false;
    private bool searchPerformed = false;

    private async Task Search()
    {
        if (string.IsNullOrWhiteSpace(searchQuery)) return;

        isLoading = true;
        searchPerformed = true;

        var result = await DevOpsService.SearchGitHubReposAsync(
            searchQuery,
            string.IsNullOrWhiteSpace(language) ? null : language,
            sortBy);

        results = result?.Items ?? [];
        isLoading = false;
    }
}
