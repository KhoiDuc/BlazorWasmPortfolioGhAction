@using BlazorWasmPortfolioGhAction.Services
@inject IDevOpsService DevOpsService

<ToolShell ResourceKey="gist" Title="Create GitHub Gist" Icon="bi-file-earmark-code" Description="Create a public or secret gist via the GitHub API (requires token in appsettings).">

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="tool-alert tool-alert-danger">@errorMessage</div>
    }

    @if (!string.IsNullOrEmpty(createdGistUrl))
    {
        <div class="tool-alert tool-alert-success">
            <p>Gist created successfully!</p>
            <a href="@createdGistUrl" target="_blank" rel="noopener" class="tool-btn tool-btn-secondary">View gist</a>
        </div>
    }

    <div class="tool-form">
        <div class="tool-field">
            <label class="tool-label" for="gist-desc">Description</label>
            <input id="gist-desc" type="text" @bind="gistDescription" class="tool-input" placeholder="Brief description of your gist" />
        </div>
        <div class="tool-field">
            <label class="tool-label" for="gist-file">File name</label>
            <input id="gist-file" type="text" @bind="fileName" class="tool-input" placeholder="e.g. example.cs, script.js" />
        </div>
        <div class="tool-field">
            <label class="tool-label" for="gist-content">File content</label>
            <textarea id="gist-content" @bind="fileContent" class="tool-textarea" rows="10" placeholder="Paste your code here..."></textarea>
        </div>
        <div class="tool-field">
            <label class="tool-checkbox">
                <input type="checkbox" @bind="isPublic" />
                Public gist
            </label>
        </div>
        <div class="tool-actions">
            <button type="button" @onclick="CreateGist" class="tool-btn tool-btn-primary" disabled="@isLoading">
                @if (isLoading) { <span>Creating...</span> } else { <span>Create gist</span> }
            </button>
        </div>
    </div>
</ToolShell>

@code {
    private string gistDescription = string.Empty;
    private string fileName = string.Empty;
    private string fileContent = string.Empty;
    private bool isPublic = true;
    private bool isLoading = false;
    private string errorMessage = string.Empty;
    private string createdGistUrl = string.Empty;

    private async Task CreateGist()
    {
        errorMessage = string.Empty;
        createdGistUrl = string.Empty;

        if (string.IsNullOrWhiteSpace(fileName))
        {
            errorMessage = "File name is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(fileContent))
        {
            errorMessage = "File content is required.";
            return;
        }

        isLoading = true;

        try
        {
            var files = new Dictionary<string, string> { { fileName, fileContent } };
            var gist = await DevOpsService.CreateGistAsync(gistDescription, files, isPublic);
            createdGistUrl = gist?.HtmlUrl ?? string.Empty;
            if (string.IsNullOrEmpty(createdGistUrl))
                errorMessage = "Failed to create gist. Check DevOps:GitHubToken in appsettings.";

            gistDescription = string.Empty;
            fileName = string.Empty;
            fileContent = string.Empty;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error creating gist: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
