@using BlazorWasmPortfolioGhAction.Store.Services

<div class="tool-modal-backdrop" @onclick="Close">
    <div class="tool-modal tool-modal-lg" role="dialog" aria-modal="true" aria-labelledby="user-detail-title" @onclick:stopPropagation="true">
        <div class="tool-modal-header">
            <h5 id="user-detail-title" class="tool-modal-title">@UserDetail?.Login</h5>
            <button type="button" class="tool-modal-close" aria-label="Close" @onclick="Close">&times;</button>
        </div>
        <div class="tool-modal-body">
            @if (UserDetail != null)
            {
                <div class="tool-user-detail-grid">
                    <div class="tool-inspect-card">
                        <div class="tool-user-avatar tool-user-avatar-lg" aria-hidden="true">@Initial</div>
                        <h5>@UserDetail.Name</h5>
                        <p class="tool-user-bio">@UserDetail.Bio</p>
                    </div>
                    <div class="tool-user-stats">
                        <div class="tool-stat-card">
                            <span class="tool-stat-label">Followers</span>
                            <strong class="tool-stat-value">@UserDetail.FollowersCount</strong>
                        </div>
                        <div class="tool-stat-card">
                            <span class="tool-stat-label">Following</span>
                            <strong class="tool-stat-value">@UserDetail.FollowingCount</strong>
                        </div>
                    </div>
                    <div class="tool-user-repos">
                        <UserRepositories Login="UserDetail.Login" />
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public GitHubUserDetail? UserDetail { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private string Initial => UserDetail?.Login?.Length > 0 ? UserDetail.Login[0].ToString().ToUpper() : "?";

    private async Task Close() => await OnClose.InvokeAsync();
}
