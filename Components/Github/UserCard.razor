@using BlazorWasmPortfolioGhAction.Store.Services

<button type="button" class="tool-user-card" @onclick="() => OnUserSelected?.Invoke(User)">
    <div class="tool-user-avatar" aria-hidden="true">@Initial</div>
    <div class="tool-user-info">
        <strong>@User.Login</strong>
        @if (!string.IsNullOrEmpty(User.Name))
        {
            <span class="tool-user-name">@User.Name</span>
        }
    </div>
</button>

@code {
    [Parameter]
    public GitHubUser User { get; set; } = null!;

    [Parameter]
    public Action<GitHubUser>? OnUserSelected { get; set; }

    private string Initial => User?.Login?.Length > 0 ? User.Login[0].ToString().ToUpper() : "?";
}
