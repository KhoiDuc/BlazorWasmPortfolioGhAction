@using System.Text
@inject IJSRuntime JSRuntime
@inject HttpClient HttpClient

<ToolShell ResourceKey="unicode" Title="Unicode Picker" Icon="bi-translate" Description="Browse and search Unicode characters.">
    <div class="tool-alert tool-alert-warning">
        <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
        Takes a while to load the full Unicode table.
    </div>
    <div class="unicode-placeholder">
        <i class="bi bi-fonts" aria-hidden="true"></i>
        <p>Unicode table grid is currently disabled.</p>
    </div>
    <hr class="tool-divider" />
    <p class="tool-hint">Useful resources:</p>
    <ul class="tool-link-list">
        <li><a href="https://shapecatcher.com" target="_blank">shapecatcher.com — Unicode Character Recognition</a></li>
        <li><a href="https://util.unicode.org/UnicodeJsps/character.jsp" target="_blank">Unicode Utilities: Character Properties</a></li>
        <li><a href="https://www.compart.com/en/unicode/U+0000" target="_blank">compart.com — Unicode Table</a></li>
    </ul>
</ToolShell>

@code {
    List<string?> UnicodeCharacters = new List<string?>();
}