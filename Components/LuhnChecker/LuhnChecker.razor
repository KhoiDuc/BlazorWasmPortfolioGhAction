@using System.Linq;

<div class="tool-card">
    <div class="tool-header">
        <h3>Luhn Checker</h3>
        <p>Validate credit card numbers using the Luhn algorithm.</p>
    </div>
    <div class="tool-form">
        <div class="tool-field">
            <label class="tool-label" for="luhnCheck">Card number</label>
            <div class="conv-row">
                <input id="luhnCheck" class="tool-input" @bind="check" placeholder="378282246310005" />
                <button class="tool-btn tool-btn-danger" @onclick="ClearSingle" title="Clear">
                    <i class="bi bi-trash" aria-hidden="true"></i>
                </button>
            </div>
        </div>
        <div class="tool-actions">
            <button class="tool-btn tool-btn-success" @onclick="CheckSingle">
                <i class="bi bi-check2-circle" aria-hidden="true"></i> Check
            </button>
        </div>
        @if (!string.IsNullOrEmpty(check))
        {
            <div class="luhn-result @(valid ? "tool-alert tool-alert-success" : "tool-alert tool-alert-danger")">
                <i class="bi @(valid ? "bi-check-circle-fill" : "bi-x-circle-fill")" aria-hidden="true"></i>
                @(valid ? "Valid" : "Invalid")
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string check { get; set; } = "";
    [Parameter] public bool valid { get; set; }

    protected override async Task OnInitializedAsync()
    {
        valid = false;
    }

    private void CheckSingle() { valid = LuhnCheck(check); }
    private void ClearSingle() { check = string.Empty; }

    private static bool LuhnCheck(string digits)
    {
        if (string.IsNullOrEmpty(digits)) return false;
        return digits.All(char.IsDigit) && digits.Reverse()
            .Select(c => c - 48)
            .Select((thisNum, i) => i % 2 == 0
                ? thisNum
                : ((thisNum *= 2) > 9 ? thisNum - 9 : thisNum)
            ).Sum() % 10 == 0;
    }
}