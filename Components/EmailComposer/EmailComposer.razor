@inject IJSRuntime JSRuntime
@inject IConfiguration Configuration
@inject IScriptLoaderService ScriptLoader
@using BlazorWasmPortfolioGhAction.Services
@using System.Text.RegularExpressions

<ToolShell ResourceKey="emailcomposer" Title="Email Composer" Icon="bi-envelope" Description="Compose and send email via EmailJS when configured in appsettings.json.">

    @if (Sent)
    {
        <div class="tool-alert tool-alert-success">
            <i class="bi bi-check-circle" aria-hidden="true"></i>
            <strong>Preview:</strong> Email payload generated. Check console for JSON.
            <button type="button" class="email-dismiss" @onclick="DismissAlert" aria-label="Dismiss">&times;</button>
        </div>
    }

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="tool-alert tool-alert-danger">
            <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
            @ErrorMessage
            <button type="button" class="email-dismiss" @onclick="(() => ErrorMessage = null)" aria-label="Dismiss">&times;</button>
        </div>
    }

    <div class="email-layout">
        <div class="tool-card email-form-card">
            <div class="tool-form">
                <div class="tool-field">
                    <label class="tool-label" for="to">To <span class="email-req">*</span></label>
                    <input type="email" id="to" class="tool-input" @bind="To" placeholder="recipient@example.com" />
                    @if (ShowToError)
                    {
                        <span class="email-error">Enter a valid email address.</span>
                    }
                </div>

                <div class="tool-field">
                    <label class="tool-label" for="cc">CC</label>
                    <input type="text" id="cc" class="tool-input" @bind="Cc" placeholder="cc1@example.com, cc2@example.com" />
                    <span class="tool-hint">Comma-separated email addresses.</span>
                </div>

                <div class="tool-field">
                    <label class="tool-label" for="bcc">BCC</label>
                    <input type="text" id="bcc" class="tool-input" @bind="Bcc" placeholder="bcc@example.com" />
                    <span class="tool-hint">Comma-separated email addresses.</span>
                </div>

                <div class="tool-field">
                    <label class="tool-label" for="subject">Subject <span class="email-req">*</span></label>
                    <input type="text" id="subject" class="tool-input" @bind="Subject" placeholder="Email subject" />
                    @if (ShowSubjectError)
                    {
                        <span class="email-error">Subject is required.</span>
                    }
                </div>

                <div class="tool-field">
                    <span class="tool-label">Body <span class="email-req">*</span></span>
                    <div class="tool-actions email-body-toggle">
                        <button type="button" class="tool-btn email-toggle-btn @(IsHtml ? "email-toggle-active" : "")" @onclick="(() => IsHtml = true)">Rich Text</button>
                        <button type="button" class="tool-btn email-toggle-btn @(!IsHtml ? "email-toggle-active" : "")" @onclick="(() => IsHtml = false)">Plain Text</button>
                    </div>
                    @if (IsHtml)
                    {
                        <div class="email-tinymce">
                            <Editor Id="email-body-editor"
                                    Inline="false"
                                    CloudChannel="5"
                                    Disable="false"
                                    Conf="@EditorConf"
                                    ApiKey="@TinyApiKey"
                                    ClassName="emailEditor"
                                    @bind-Value="Body" />
                        </div>
                    }
                    else
                    {
                        <textarea class="tool-textarea" rows="10" @bind="Body" placeholder="Write your email..."></textarea>
                    }
                </div>

                <div class="tool-field">
                    <span class="tool-label">Attachments</span>
                    <InputFile OnChange="OnAttachmentChange" multiple class="tool-input" />
                    @if (Attachments.Any())
                    {
                        <ul class="email-attachments">
                            @foreach (var att in Attachments)
                            {
                                <li class="email-attachment-item">
                                    <span class="email-attachment-name"><i class="bi bi-paperclip" aria-hidden="true"></i> @att.Name <small class="email-attachment-size">(@FormatSize(att.Size))</small></span>
                                    <button class="tool-btn tool-btn-danger email-attachment-remove" @onclick="(() => RemoveAttachment(att))" aria-label="Remove @att.Name">
                                        <i class="bi bi-x" aria-hidden="true"></i>
                                    </button>
                                </li>
                            }
                        </ul>
                        <span class="tool-hint">Attachments are preview-only. EmailJS free tier does not support attachments.</span>
                    }
                </div>

                <div class="tool-actions">
                    <button type="button" class="tool-btn tool-btn-primary" @onclick="SendEmail">
                        <i class="bi bi-send" aria-hidden="true"></i> Send
                    </button>
                    <button type="button" class="tool-btn" @onclick="ClearForm">
                        <i class="bi bi-eraser" aria-hidden="true"></i> Clear
                    </button>
                </div>
            </div>
        </div>

        <div class="tool-card email-sidebar">
            <div class="tool-result-label">Setup Guide</div>
            <ol class="email-steps">
                <li>
                    <strong>Create EmailJS account</strong><br />
                    Go to <a href="https://www.emailjs.com" target="_blank">emailjs.com</a> → Sign up (free, 200 emails/month).
                </li>
                <li>
                    <strong>Add Email Service</strong><br />
                    Dashboard → Email Services → Add New Service → Choose <strong>Gmail</strong> → Authorize → Copy <code class="tool-inline-code">Service ID</code>.
                </li>
                <li>
                    <strong>Create Template</strong><br />
                    Dashboard → Email Templates → Create New Template. Map variables:
                    <ul class="email-sub-list">
                        <li><code class="tool-inline-code">{{to_email}}</code> → recipient</li>
                        <li><code class="tool-inline-code">{{subject}}</code> → subject</li>
                        <li><code class="tool-inline-code">{{message}}</code> → body</li>
                        <li><code class="tool-inline-code">{{cc_email}}</code> → CC</li>
                        <li><code class="tool-inline-code">{{bcc_email}}</code> → BCC</li>
                    </ul>
                    Copy <code class="tool-inline-code">Template ID</code>.
                </li>
                <li>
                    <strong>Get Public Key</strong><br />
                    Dashboard → Account → API Keys → Copy <code class="tool-inline-code">Public Key</code>.
                </li>
                <li>
                    <strong>Fill config</strong><br />
                    Open <code class="tool-inline-code">wwwroot/appsettings.json</code> → Fill <code class="tool-inline-code">EmailJs</code> section:
                    <pre class="tool-code">"EmailJs": {
  "ServiceId": "service_xxx",
  "TemplateId": "template_xxx",
  "PublicKey": "xxx"
}</pre>
                </li>
                <li>
                    <strong>Done!</strong><br />
                    Rebuild app. Send button will call EmailJS API directly from browser.
                </li>
            </ol>

            <hr class="tool-divider" />

            <div class="tool-hint">
                <strong>Why EmailJS?</strong><br />
                Blazor WASM cannot use SmtpClient (no raw TCP sockets in browser). EmailJS uses HTTP REST API — designed for client-side apps.
            </div>

            <hr class="tool-divider" />

            <div class="tool-hint">
                <strong>Current config status:</strong><br />
                @if (IsConfigured)
                {
                    <span class="email-status-ok"><i class="bi bi-check-circle" aria-hidden="true"></i> EmailJs configured</span>
                }
                else
                {
                    <span class="email-status-warn"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> EmailJs not configured — fill appsettings.json</span>
                }
            </div>
        </div>
    </div>
</ToolShell>

@code {
    private string To = string.Empty;
    private string Cc = string.Empty;
    private string Bcc = string.Empty;
    private string Subject = string.Empty;
    private string Body = string.Empty;
    private bool IsHtml = true;
    private bool Sent = false;
    private string? ErrorMessage;
    private bool ShowToError;
    private bool ShowSubjectError;
    private string ToError => ShowToError ? "is-invalid" : string.Empty;
    private string SubjectError => ShowSubjectError ? "is-invalid" : string.Empty;

    private List<AttachmentPreview> Attachments = new();
    private record AttachmentPreview(string Name, long Size, string ContentType);

    private string TinyApiKey => Configuration["EmailJs:ApiKey"] ?? string.Empty;
    private bool IsConfigured =>
        !string.IsNullOrWhiteSpace(Configuration["EmailJs:ServiceId"]) &&
        !string.IsNullOrWhiteSpace(Configuration["EmailJs:TemplateId"]) &&
        !string.IsNullOrWhiteSpace(Configuration["EmailJs:PublicKey"]);

    private const int MaxAttachmentSize = 10 * 1024 * 1024;
    private const int MaxAttachments = 5;

    private readonly Dictionary<string, object> EditorConf = new()
    {
        { "menubar", "edit insert format tools help" },
        { "toolbar", "undo redo | bold italic underline | alignleft aligncenter alignright | bullist numlist | forecolor backcolor | link | removeformat" },
        { "plugins", "autolink link lists advlist autoresize wordcount" },
        { "toolbar_mode", "floating" },
        { "toolbar_location", "top" },
        { "width", "100%" },
        { "min_height", 250 },
        { "autoresize_bottom_margin", 30 },
        { "skin", "oxide-dark" },
        { "content_css", "dark" },
        { "browser_spellcheck", "true" },
        { "paste_as_text", "true" },
        { "resize", "true" }
    };

    private static readonly Regex EmailRegex = new(@"^[^@\s]+@[^@\s]+\.[^@\s]+$", RegexOptions.Compiled);

    protected override async Task OnInitializedAsync()
    {
        if (IsHtml)
            await ScriptLoader.EnsureTinyMceAsync();
    }

    private async Task OnAttachmentChange(InputFileChangeEventArgs e)
    {
        var files = e.GetMultipleFiles(MaxAttachments);
        foreach (var file in files)
        {
            if (file.Size > MaxAttachmentSize)
            {
                ErrorMessage = $"File '{file.Name}' exceeds 10MB limit.";
                continue;
            }
            Attachments.Add(new AttachmentPreview(file.Name, file.Size, file.ContentType));
        }
    }

    private void RemoveAttachment(AttachmentPreview att) => Attachments.RemoveAll(a => a == att);

    private async Task SendEmail()
    {
        ShowToError = false;
        ShowSubjectError = false;
        ErrorMessage = null;

        if (string.IsNullOrWhiteSpace(To) || !EmailRegex.IsMatch(To.Trim()))
        {
            ShowToError = true;
            return;
        }

        if (!string.IsNullOrWhiteSpace(Cc))
        {
            var ccEmails = Cc.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            if (ccEmails.Any(e => !EmailRegex.IsMatch(e)))
            {
                ErrorMessage = "One or more CC email addresses are invalid.";
                return;
            }
        }

        if (!string.IsNullOrWhiteSpace(Bcc))
        {
            var bccEmails = Bcc.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            if (bccEmails.Any(e => !EmailRegex.IsMatch(e)))
            {
                ErrorMessage = "One or more BCC email addresses are invalid.";
                return;
            }
        }

        if (string.IsNullOrWhiteSpace(Subject))
        {
            ShowSubjectError = true;
            return;
        }

        if (string.IsNullOrWhiteSpace(Body))
        {
            ErrorMessage = "Email body is required.";
            return;
        }

        if (!IsConfigured)
        {
            var payload = new
            {
                service_id = Configuration["EmailJs:ServiceId"] ?? "NOT_CONFIGURED",
                template_id = Configuration["EmailJs:TemplateId"] ?? "NOT_CONFIGURED",
                user_id = Configuration["EmailJs:PublicKey"] ?? "NOT_CONFIGURED",
                template_params = new
                {
                    to_email = To.Trim(),
                    cc_email = Cc,
                    bcc_email = Bcc,
                    subject = Subject,
                    message = Body,
                    from_name = "Portfolio Contact"
                }
            };

            var json = System.Text.Json.JsonSerializer.Serialize(payload, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
            await JSRuntime.InvokeVoidAsync("console.log", "Email payload (preview — configure EmailJs in appsettings.json):", json);
            Sent = true;
            return;
        }

        try
        {
            await JSRuntime.InvokeVoidAsync("emailJsBridge.send",
                Configuration["EmailJs:PublicKey"],
                Configuration["EmailJs:ServiceId"],
                Configuration["EmailJs:TemplateId"],
                new
                {
                    to_email = To.Trim(),
                    cc_email = Cc,
                    bcc_email = Bcc,
                    subject = Subject,
                    message = Body,
                    from_name = "Portfolio Contact"
                });
            Sent = true;
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Failed to send email: {ex.Message}";
        }
    }

    private void ClearForm()
    {
        To = Cc = Bcc = Subject = Body = string.Empty;
        Attachments.Clear();
        Sent = false;
        ErrorMessage = null;
        ShowToError = ShowSubjectError = false;
    }

    private void DismissAlert() => Sent = false;

    private static string FormatSize(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:F1} KB",
        _ => $"{bytes / (1024.0 * 1024):F1} MB"
    };
}