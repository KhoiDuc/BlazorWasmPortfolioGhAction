@using GoogleMapsComponents
@using GoogleMapsComponents.Maps
@using BlazorWasmPortfolioGhAction.Components.ToolShell

<ToolShell Title="Google Maps" Icon="bi-geo-alt" Description="Interactive map with draggable markers (requires Google Maps API key).">
    <div class="tool-map-frame">
        <AdvancedGoogleMap @ref="@_map1" Id="map1" Options="@mapOptions">
            @foreach (var markerRef in Markers)
            {
                <MarkerComponent @key="markerRef.Id"
                                 Lat="@markerRef.Lat"
                                 Lng="@markerRef.Lng"
                                 Clickable="@markerRef.Clickable"
                                 Draggable="@markerRef.Draggable"
                                 OnClick="@(() => markerRef.Active = !markerRef.Active)"
                                 OnMove="pos => markerRef.UpdatePosition(pos)" />
            }
        </AdvancedGoogleMap>
    </div>
    @if (Markers.Count > 0)
    {
        <p class="tool-hint">Marker: @Markers[0].Lat.ToString("F5"), @Markers[0].Lng.ToString("F5")</p>
    }
</ToolShell>

@code {
    private List<MarkerData> Markers = [new MarkerData { Id = 1, Lat = 13.505892, Lng = 100.8162 }];
    private AdvancedGoogleMap? _map1;
    private MapOptions mapOptions = new()
    {
        Zoom = 13,
        Center = new LatLngLiteral { Lat = 13.505892, Lng = 100.8162 },
        MapId = "DEMO_MAP_ID",
        MapTypeId = MapTypeId.Roadmap
    };

    public class MarkerData
    {
        public int Id { get; set; }
        public double Lat { get; set; }
        public double Lng { get; set; }
        public bool Clickable { get; set; } = true;
        public bool Draggable { get; set; }
        public bool Active { get; set; }

        public void UpdatePosition(LatLngLiteral position)
        {
            Lat = position.Lat;
            Lng = position.Lng;
        }
    }
}
