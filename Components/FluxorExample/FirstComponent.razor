@using BlazorWasmPortfolioGhAction.Contexts
@inject TemperatureStore temperatureStore

<ToolShell Title="First Component" Icon="bi-thermometer" Description="Temperature store demo.">
    <p class="tool-result-label">Temperature: <span class="tool-inline-code">@temperatureStore.Temperature</span></p>
    <button class="tool-btn tool-btn-primary" type="button" @onclick=@(() => temperatureStore.UpdateTemperature())>Update temperature</button>
</ToolShell>