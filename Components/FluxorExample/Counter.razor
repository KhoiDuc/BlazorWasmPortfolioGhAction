@using BlazorWasmPortfolioGhAction.Store.CounterUseCase
@using Fluxor
@inherits Fluxor.Blazor.Web.Components.FluxorComponent
@inject IState<CounterState> _counterState
@inject IDispatcher _dispatcher

<ToolShell Title="Fluxor Counter" Icon="bi-plus-slash-minus" Description="Counter using Fluxor state management.">
    <p class="tool-result-label">Current count: @_counterState.Value.Count</p>
    <button class="tool-btn tool-btn-primary" @onclick="IncrementCount">Click me</button>
</ToolShell>

@code {
    private void IncrementCount() { _dispatcher.Dispatch(new IncrementCounterAction()); }
}