@using BlazorWasmPortfolioGhAction.Services.OnlineTools
@inherits CultureAwareComponent
@inject IStringLocalizer<SharedResources> L
@inject FontViewService FontViewSvc
@inject IClipboardService Clipboard
@inject IJSRuntime JS
@implements IAsyncDisposable

<ToolShell ResourceKey="fontview" Title="FontView" Icon="bi-file-font"
           Description="Load a font file and preview text in it.">
    <div class="tool-form fontview-tool">
        @if (_error is not null)
        {
            <div class="tool-alert tool-alert-warning" role="alert">@_error</div>
        }

        @if (_loading)
        {
            <div class="fontview-loading">
                <div class="fontview-spinner" aria-hidden="true"></div>
                <span class="tool-hint">@L["FontView_Loading"]</span>
            </div>
        }

        @if (_font is null && !_loading)
        {
            <div class="fontview-upload">
                <label class="fontview-dropzone">
                    <InputFile Accept=".ttf,.otf,.woff,.woff2"
                               OnChange="OnFileChange" class="fontview-file-input" />
                    <i class="bi bi-cloud-arrow-up" aria-hidden="true"></i>
                    <span>@L["FontView_DropHint"]</span>
                    <small>TTF · OTF · WOFF · WOFF2</small>
                </label>
            </div>
        }

        @if (_font is not null)
        {
            <div class="tool-actions fontview-toolbar">
                <label class="fontview-control">
                    <span class="fontview-control-label">@L["FontView_Color"]</span>
                    <input type="color" @bind="_color" @bind:event="oninput" />
                </label>
                <label class="fontview-control">
                    <span class="fontview-control-label">@L["FontView_FontSize"]</span>
                    <input type="range" min="12" max="96" @bind="_fontSize" @bind:event="oninput" />
                    <span class="fontview-size-value">@_fontSize<span>px</span></span>
                </label>
                <button type="button" class="tool-btn" @onclick="Reset">
                    <i class="bi bi-arrow-repeat" aria-hidden="true"></i> @L["FontView_NewFont"]
                </button>
            </div>

            <div class="fontview-info">
                <div class="fontview-info-name">
                    <strong>@_font.Family</strong>
                    @if (!string.IsNullOrWhiteSpace(_font.Subfamily))
                    {
                        <span class="badge fontview-sub">@_font.Subfamily</span>
                    }
                </div>
                <span class="tool-hint">
                    @_font.NumGlyphs glyphs · @(Math.Max(1, _loadedBytes!.Length / 1024)) KB
                </span>
            </div>

            <div class="fontview-tester" style="--fv-font:'@_fontFaceId'; --fv-color:@_color; --fv-size:@(_fontSize)px">
                <div class="fontview-tester-input">
                    <textarea class="tool-input fontview-textarea"
                              placeholder="@L["FontView_TextPlaceholder"]"
                              rows="3"
                              @bind="_testText" @bind:event="oninput"></textarea>
                </div>
                <div class="fontview-tester-output">
                    <p class="fontview-tester-text">@(_testText)</p>
                </div>
            </div>

            <div class="fontview-samples" style="--fv-font:'@_fontFaceId'; --fv-color:@_color">
                <div class="fontview-sample">
                    <p class="fontview-sample-label tool-hint">Aa</p>
                    <p class="fontview-sample-text fontview-xl">Aa Bb Cc Dd Ee</p>
                </div>
                <div class="fontview-sample">
                    <p class="fontview-sample-label tool-hint">Alphabet</p>
                    <p class="fontview-sample-text fontview-md">ABCDEFGHIJKLMNOPQRSTUVWXYZ<br />abcdefghijklmnopqrstuvwxyz</p>
                </div>
                <div class="fontview-sample">
                    <p class="fontview-sample-label tool-hint">Numbers</p>
                    <p class="fontview-sample-text fontview-md">0123456789</p>
                </div>
                <div class="fontview-sample">
                    <p class="fontview-sample-label tool-hint">Pangram</p>
                    <p class="fontview-sample-text fontview-lg">The quick brown fox jumps over the lazy dog</p>
                </div>
            </div>

            @if (_copied)
            {
                <div class="fontview-toast" role="status">
                    <i class="bi bi-check2-circle" aria-hidden="true"></i>
                    @L["FontView_Copied"]
                </div>
            }

            <div class="fontview-grid">
                @foreach (var grp in GroupedGlyphs)
                {
                    <section class="fontview-section" id="@SectionId(grp.Key)">
                        <button type="button" class="fontview-section-head"
                                @onclick="() => ToggleSection(grp.Key)">
                            <i class="bi @(IsSectionExpanded(grp.Key) ? "bi-chevron-down" : "bi-chevron-right")" aria-hidden="true"></i>
                            <span>@LocalizeCategory(grp.Key)</span>
                            <span class="fontview-count">@grp.Count()</span>
                        </button>
                        @if (IsSectionExpanded(grp.Key))
                        {
                            <div class="fontview-cells">
                                @foreach (var g in grp)
                                {
                                    var ch = char.ConvertFromUtf32(g.Unicode);
                                    <button type="button" class="fontview-cell"
                                            style="--fv-font:'@_fontFaceId'; --fv-color:@_color"
                                            title="@($"{g.Name} · U+{g.Hex}")"
                                            @onclick="() => CopyGlyph(ch)">
                                        @ch
                                    </button>
                                }
                            </div>
                        }
                    </section>
                }
            </div>
        }
    </div>
</ToolShell>

@code {
    private FontViewFont? _font;
    private byte[]? _loadedBytes;
    private string? _fontFaceId;
    private string _color = "#111111";
    private int _fontSize = 32;
    private string _testText = "The quick brown fox jumps over the lazy dog";
    private string? _error;
    private bool _loading;
    private bool _copied;
    private bool _jsLoaded;
    private CancellationTokenSource? _copyCts;

    private readonly HashSet<string> ExpandedSections = new(StringComparer.OrdinalIgnoreCase);

    private IEnumerable<IGrouping<string, FontViewGlyph>> GroupedGlyphs
    {
        get
        {
            if (_font is null) return Enumerable.Empty<IGrouping<string, FontViewGlyph>>();
            return _font.Glyphs
                .GroupBy(Categorize)
                .OrderBy(g => CategoryOrder.IndexOf(g.Key));
        }
    }

    private static readonly List<string> CategoryOrder =
        ["Uppercase", "Lowercase", "Number", "Punctuation", "Symbol", "Other"];

    private static string Categorize(FontViewGlyph g)
    {
        if (g.Unicode > 0xFFFF) return "Other";
        var ch = (char)g.Unicode;
        var cat = char.GetUnicodeCategory(ch);
        return cat switch
        {
            System.Globalization.UnicodeCategory.UppercaseLetter or
            System.Globalization.UnicodeCategory.TitlecaseLetter => "Uppercase",
            System.Globalization.UnicodeCategory.LowercaseLetter => "Lowercase",
            System.Globalization.UnicodeCategory.DecimalDigitNumber or
            System.Globalization.UnicodeCategory.OtherNumber or
            System.Globalization.UnicodeCategory.LetterNumber => "Number",
            System.Globalization.UnicodeCategory.ConnectorPunctuation or
            System.Globalization.UnicodeCategory.DashPunctuation or
            System.Globalization.UnicodeCategory.OpenPunctuation or
            System.Globalization.UnicodeCategory.ClosePunctuation or
            System.Globalization.UnicodeCategory.InitialQuotePunctuation or
            System.Globalization.UnicodeCategory.FinalQuotePunctuation or
            System.Globalization.UnicodeCategory.OtherPunctuation => "Punctuation",
            System.Globalization.UnicodeCategory.MathSymbol or
            System.Globalization.UnicodeCategory.CurrencySymbol or
            System.Globalization.UnicodeCategory.ModifierSymbol or
            System.Globalization.UnicodeCategory.OtherSymbol => "Symbol",
            _ => "Other"
        };
    }

    private string LocalizeCategory(string key) => key switch
    {
        "Uppercase" => L["FontView_Cat_Uppercase"],
        "Lowercase" => L["FontView_Cat_Lowercase"],
        "Number" => L["FontView_Cat_Number"],
        "Punctuation" => L["FontView_Cat_Punctuation"],
        "Symbol" => L["FontView_Cat_Symbol"],
        _ => L["FontView_Cat_Other"]
    };

    private bool IsSectionExpanded(string key) => ExpandedSections.Contains(key);

    private static string SectionId(string key) => $"fv-section-{key.ToLowerInvariant()}";

    private async Task EnsureJsAsync()
    {
        if (_jsLoaded) return;
        await JS.InvokeVoidAsync("scriptLoader.load", "js/font-view-tools.js");
        _jsLoaded = true;
    }

    private async Task LoadFontBytes(byte[] bytes)
    {
        _loading = true;
        _error = null;
        _loadedBytes = bytes;
        try
        {
            await EnsureJsAsync();
            _font = await FontViewSvc.LoadFontAsync(bytes);
            if (_font is null)
            {
                _error = L["FontView_ParseError"];
                return;
            }

            _fontFaceId = await FontViewSvc.RegisterFontFaceAsync(bytes, _font.Family);

            var cats = _font.Glyphs.GroupBy(Categorize).Select(g => g.Key).ToList();
            ExpandedSections.Clear();
            foreach (var c in cats) ExpandedSections.Add(c);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnFileChange(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;
        using var stream = file.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        await LoadFontBytes(ms.ToArray());
    }

    private async Task CopyGlyph(string ch)
    {
        await Clipboard.CopyTextAsync(ch);
        _copied = true;
        _copyCts?.Cancel();
        _copyCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(1500, _copyCts.Token);
            _copied = false;
        }
        catch (TaskCanceledException) { }
    }

    private void ToggleSection(string key)
    {
        if (!ExpandedSections.Add(key))
            ExpandedSections.Remove(key);
    }

    private void Reset()
    {
        _font = null;
        _loadedBytes = null;
        _fontFaceId = null;
        _error = null;
        _copied = false;
        ExpandedSections.Clear();
    }

    public ValueTask DisposeAsync()
    {
        _copyCts?.Cancel();
        return ValueTask.CompletedTask;
    }
}