@using System.IO
@using System.Security.Cryptography
@using System.Diagnostics.CodeAnalysis
@using System.Text
@using BlazorWasmPortfolioGhAction.Utils.OnlineTools

<ToolShell ResourceKey="hashdata" Title="Compute hash" Icon="bi-shield-lock">
    <div class="tool-form">
        <div class="tool-field">
            <label class="tool-label" for="hash-algorithm">Algorithm</label>
            <select id="hash-algorithm" class="tool-select" @bind="algorithm">
                <option value="sha1">SHA1</option>
                <option value="sha256">SHA256</option>
                <option value="sha384">SHA384</option>
                <option value="sha512">SHA512</option>
            </select>
        </div>
        <div class="tool-field">
            <label class="tool-label" for="hash-text">Text</label>
            <textarea id="hash-text" class="tool-textarea" rows="6" @bind="text"></textarea>
        </div>
        <div class="tool-field">
            <label class="tool-label" for="hash-encoding">Encoding</label>
            <select id="hash-encoding" class="tool-select" @bind="encoding">
                <option value="utf-8">UTF-8</option>
                <option value="utf-16">UTF-16</option>
                <option value="utf-32">UTF-32</option>
                <option value="ascii">ASCII</option>
            </select>
        </div>
        <div class="tool-field">
            <label class="tool-label">Or upload a file</label>
            <InputFile OnChange="@OnInputFileChange" />
        </div>
        <div class="tool-actions">
            <button type="button" class="tool-btn tool-btn-secondary" @onclick="Hash">Hash</button>
            <button type="button" class="tool-btn tool-btn-primary" @onclick="HashAll">Compute all</button>
        </div>
        @if (resultBase64 != null || resultHexa != null)
        {
            <ResultValueList Values="GetResults()" />
        }
        @if (allResults.Count > 0)
        {
            <div class="tool-field">
                <label class="tool-label">All algorithms</label>
                <ResultValueList Values="allResults" />
            </div>
        }
    </div>
</ToolShell>

@code {
    string? text;
    string? encoding;
    string? algorithm;
    string? resultBase64;
    string? resultHexa;
    List<ResultValue> allResults = new();

    private async Task OnInputFileChange(InputFileChangeEventArgs e)
    {
        using var stream = e.File.OpenReadStream();
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);

        Hash(ms.ToArray());
        allResults = new();
    }

    void Hash()
    {
        allResults = new();
        Hash(GetEncoding().GetBytes(text ?? ""));
    }

    [SuppressMessage("Security", "CA5350: Hash uses a weak cryptographic algorithm SHA1")]
    void Hash(byte[] data)
    {
        try
        {
            var hash = algorithm switch
            {
                "sha256" => SHA256.HashData(data),
                "sha384" => SHA384.HashData(data),
                "sha512" => SHA512.HashData(data),
                _ => SHA1.HashData(data),
            };

            resultBase64 = Convert.ToBase64String(hash);
            resultHexa = Convert.ToHexString(hash);
        }
        catch (Exception ex)
        {
            resultBase64 = ex.Message;
            resultHexa = null;
        }
    }

    [SuppressMessage("Security", "CA5350: Hash uses a weak cryptographic algorithm SHA1")]
    void HashAll()
    {
        resultBase64 = null;
        resultHexa = null;
        var data = GetEncoding().GetBytes(text ?? "");
        allResults = new()
        {
            new("SHA1", Convert.ToHexString(SHA1.HashData(data)).ToLowerInvariant()),
            new("SHA256", Convert.ToHexString(SHA256.HashData(data)).ToLowerInvariant()),
            new("SHA384", Convert.ToHexString(SHA384.HashData(data)).ToLowerInvariant()),
            new("SHA512", Convert.ToHexString(SHA512.HashData(data)).ToLowerInvariant()),
        };
    }

    IReadOnlyList<ResultValue> GetResults()
    {
        var result = new List<ResultValue>();
        if (resultBase64 != null)
            result.Add(new ResultValue("Base64", resultBase64));

        if (resultHexa != null)
            result.Add(new ResultValue("Hexadecimal", resultHexa));

        return result;
    }

    Encoding GetEncoding() => encoding switch
    {
        "ascii" => Encoding.ASCII,
        "utf-16" => Encoding.Unicode,
        "utf-32" => Encoding.UTF32,
        _ => Encoding.UTF8,
    };
}