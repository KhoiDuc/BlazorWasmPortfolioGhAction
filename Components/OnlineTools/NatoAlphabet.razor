<ToolShell ResourceKey="natoalphabet" Title="String to NATO alphabet" Icon="bi-alphabet">
    <div class="tool-form">
        <p class="tool-hint">Convert text to the NATO phonetic alphabet (ICAO). Spaces are represented as <code>/</code>.</p>
        <div class="tool-field">
            <label class="tool-label" for="nato-value">Value</label>
            <textarea id="nato-value" class="tool-textarea" rows="4" @oninput="OnInputChanged">@value</textarea>
        </div>
        <ResultValueSingle CopyLabel="NATO alphabet" Value="@result" />
    </div>
</ToolShell>

@code {
    private string value = string.Empty;
    private string result = string.Empty;

    protected override void OnInitialized()
    {
        Compute();
    }

    private void OnInputChanged(ChangeEventArgs e)
    {
        value = e.Value?.ToString() ?? string.Empty;
        Compute();
    }

    private void Compute()
    {
        result = TextEncodingUtils.ToNatoAlphabet(value);
    }
}
