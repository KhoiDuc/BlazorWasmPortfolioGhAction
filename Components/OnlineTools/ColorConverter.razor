@using System.Globalization
@using System.Text.RegularExpressions
@using BlazorWasmPortfolioGhAction.Utils
@using BlazorWasmPortfolioGhAction.Utils.OnlineTools
@inject NavigationManager NavigationManager

<ToolShell ResourceKey="colorconverter" Title="Color Converter" Icon="bi-palette2" Description="Convert color between hex, rgb, hsl, hwb, oklab, lch and cmyk. Every field is interactive.">
    <div class="tool-form color-converter">
        <div class="color-row tool-field">
            <label class="tool-label" for="colorPicker">Color picker</label>
            <input id="colorPicker" type="color" class="tool-input color-picker-input" @oninput="OnColorPickerChanged" value="@ColorPickerText" />
        </div>

        <div class="color-row tool-field">
            <label class="tool-label" for="hex">Hex</label>
            <input id="hex" class="tool-input" @oninput="OnHexChanged" value="@HexText" spellcheck="false" />
        </div>

        <div class="color-row tool-field">
            <label class="tool-label" for="rgb">RGB</label>
            <input id="rgb" class="tool-input" @oninput="OnRgbChanged" value="@RgbText" spellcheck="false" />
        </div>

        <div class="color-row tool-field">
            <label class="tool-label" for="hsl">HSL</label>
            <input id="hsl" class="tool-input" @oninput="OnHslChanged" value="@HslText" spellcheck="false" />
        </div>

        <div class="color-row tool-field">
            <label class="tool-label" for="hwb">HWB</label>
            <input id="hwb" class="tool-input" @oninput="OnHwbChanged" value="@HwbText" spellcheck="false" />
        </div>

        <div class="color-row tool-field">
            <label class="tool-label" for="lch">LCH</label>
            <input id="lch" class="tool-input" @oninput="OnLchChanged" value="@LchText" spellcheck="false" />
        </div>

        <div class="color-row tool-field">
            <label class="tool-label" for="oklab">Oklab</label>
            <input id="oklab" class="tool-input" @oninput="OnOklabChanged" value="@OklabText" spellcheck="false" />
        </div>

        <div class="color-row tool-field">
            <label class="tool-label" for="cmyk">CMYK</label>
            <input id="cmyk" class="tool-input" @oninput="OnCmykChanged" value="@CmykText" spellcheck="false" />
        </div>

        @if (errorMessage != null)
        {
            <div class="tool-alert tool-alert-danger">@errorMessage</div>
        }
    </div>
</ToolShell>

@code {
    private const string DefaultColor = "#1ea54c";

    [Parameter, SupplyParameterFromQuery(Name = "value")]
    public string? Value { get; set; }

    private bool initialized;
    private string? errorMessage;
    private RgbColor currentColor;

    private string ColorPickerText { get; set; } = DefaultColor;
    private string HexText { get; set; } = DefaultColor;
    private string RgbText { get; set; } = string.Empty;
    private string HslText { get; set; } = string.Empty;
    private string HwbText { get; set; } = string.Empty;
    private string LchText { get; set; } = string.Empty;
    private string OklabText { get; set; } = string.Empty;
    private string CmykText { get; set; } = string.Empty;

    protected override void OnInitialized()
    {
        NavigationManager.SetParametersFromQueryString(this);
        ApplyInitialColor();
    }

    protected override void OnParametersSet()
    {
        if (!initialized)
        {
            initialized = true;
            ApplyInitialColor();
            return;
        }

        if (string.IsNullOrWhiteSpace(Value))
            return;

        if (ColorConvertUtils.TryParseAnyColor(Value.Trim(), out var colorFromQuery) && colorFromQuery != currentColor)
            SetColor(colorFromQuery, updateUrl: false);
    }

    private void ApplyInitialColor()
    {
        var initialValue = string.IsNullOrWhiteSpace(Value) ? DefaultColor : Value.Trim();
        if (!ColorConvertUtils.TryParseAnyColor(initialValue, out var parsedColor))
        {
            parsedColor = new RgbColor(30, 165, 76);
            errorMessage = string.IsNullOrWhiteSpace(Value) ? null : "Unable to parse the color from the URL query parameter.";
        }

        SetColor(parsedColor, updateUrl: string.IsNullOrWhiteSpace(Value));
    }

    private void OnColorPickerChanged(ChangeEventArgs e)
    {
        ColorPickerText = e.Value?.ToString() ?? string.Empty;
        TryApply(ColorPickerText, ColorConvertUtils.TryParseHex, "Invalid color picker value.");
    }

    private void OnHexChanged(ChangeEventArgs e)
    {
        HexText = e.Value?.ToString() ?? string.Empty;
        TryApply(HexText, ColorConvertUtils.TryParseHex, "Invalid hex color. Expected #RRGGBB or #RGB.");
    }

    private void OnRgbChanged(ChangeEventArgs e)
    {
        RgbText = e.Value?.ToString() ?? string.Empty;
        TryApply(RgbText, ColorConvertUtils.TryParseRgb, "Invalid rgb value. Expected rgb(r, g, b).");
    }

    private void OnHslChanged(ChangeEventArgs e)
    {
        HslText = e.Value?.ToString() ?? string.Empty;
        TryApply(HslText, ColorConvertUtils.TryParseHsl, "Invalid hsl value. Expected hsl(h, s%, l%).");
    }

    private void OnHwbChanged(ChangeEventArgs e)
    {
        HwbText = e.Value?.ToString() ?? string.Empty;
        TryApply(HwbText, ColorConvertUtils.TryParseHwb, "Invalid hwb value. Expected hwb(h w% b%).");
    }

    private void OnLchChanged(ChangeEventArgs e)
    {
        LchText = e.Value?.ToString() ?? string.Empty;
        TryApply(LchText, ColorConvertUtils.TryParseLch, "Invalid lch value. Expected lch(l% c h).");
    }

    private void OnOklabChanged(ChangeEventArgs e)
    {
        OklabText = e.Value?.ToString() ?? string.Empty;
        TryApply(OklabText, ColorConvertUtils.TryParseOklab, "Invalid oklab value. Expected oklab(l% a b).");
    }

    private void OnCmykChanged(ChangeEventArgs e)
    {
        CmykText = e.Value?.ToString() ?? string.Empty;
        TryApply(CmykText, ColorConvertUtils.TryParseCmyk, "Invalid cmyk value. Expected device-cmyk(c% m% y% k%).");
    }

    private void TryApply(string input, TryParseColor parser, string error)
    {
        if (parser(input, out var parsedColor))
        {
            SetColor(parsedColor, updateUrl: true);
            return;
        }

        errorMessage = error;
    }

    private void SetColor(RgbColor color, bool updateUrl)
    {
        currentColor = color;
        errorMessage = null;
        SyncFieldsFromColor();

        if (updateUrl)
        {
            Value = HexText;
            NavigationManager.UpdateUrlUsingParameters(this, replaceHistory: true);
        }
    }

    private void SyncFieldsFromColor()
    {
        var (h, s, l) = ColorConvertUtils.RgbToHsl(currentColor);
        var (_, w, b) = ColorConvertUtils.RgbToHwb(currentColor);
        var (lchL, lchC, lchH) = ColorConvertUtils.RgbToLch(currentColor);
        var (oklabL, oklabA, oklabB) = ColorConvertUtils.RgbToOklab(currentColor);
        var (c, m, y, k) = ColorConvertUtils.RgbToCmyk(currentColor);

        ColorPickerText = ColorConvertUtils.FormatHex(currentColor);
        HexText = ColorConvertUtils.FormatHex(currentColor);
        RgbText = $"rgb({currentColor.R}, {currentColor.G}, {currentColor.B})";
        HslText = $"hsl({ColorConvertUtils.RoundToInt(h)}, {ColorConvertUtils.RoundToInt(s)}%, {ColorConvertUtils.RoundToInt(l)}%)";
        HwbText = $"hwb({ColorConvertUtils.RoundToInt(h)} {ColorConvertUtils.RoundToInt(w)}% {ColorConvertUtils.RoundToInt(b)}%)";
        LchText = $"lch({ColorConvertUtils.FormatNumber(lchL)}% {ColorConvertUtils.FormatNumber(lchC)} {ColorConvertUtils.FormatNumber(lchH)})";
        OklabText = $"oklab({ColorConvertUtils.FormatNumber(oklabL * 100)}% {ColorConvertUtils.FormatNumber(oklabA)} {ColorConvertUtils.FormatNumber(oklabB)})";
        CmykText = $"device-cmyk({ColorConvertUtils.RoundToInt(c)}% {ColorConvertUtils.RoundToInt(m)}% {ColorConvertUtils.RoundToInt(y)}% {ColorConvertUtils.RoundToInt(k)}%)";
    }

    private delegate bool TryParseColor(string text, out RgbColor color);
}