@using System.Text
@using BlazorWasmPortfolioGhAction.Services
@using BlazorWasmPortfolioGhAction.Services.OnlineTools
@using Microsoft.CodeAnalysis
@using Microsoft.CodeAnalysis.CSharp
@inject CsharpRoslynCompiler Compiler
@inject IClipboardService Clipboard
@inject IJSRuntime JS

<ToolShell ResourceKey="csharpcompiler" Title="C# Online Compiler" Icon="bi-filetype-cs"
           Description="Compile and run C# in the browser with Roslyn — no server required.">
    <div class="tool-form csharp-compiler">
        <div class="tool-actions csharp-toolbar">
            <button type="button" class="tool-btn tool-btn-primary" @onclick="RunAsync" disabled="@_busy">
                <i class="bi bi-play-fill" aria-hidden="true"></i> @(_busy ? "Running…" : "Run")
            </button>
            <label class="tool-label" for="csharp-lang">Language</label>
            <select id="csharp-lang" class="tool-select" @bind="_languageVersion" disabled="@_busy">
                <option value="@LanguageVersion.CSharp12">C# 12</option>
                <option value="@LanguageVersion.CSharp13">C# 13</option>
                <option value="@LanguageVersion.Latest">Latest</option>
            </select>
            <label class="tool-label" for="csharp-opt">Optimization</label>
            <select id="csharp-opt" class="tool-select" @bind="_optimization" disabled="@_busy">
                <option value="@OptimizationLevel.Debug">Debug</option>
                <option value="@OptimizationLevel.Release">Release</option>
            </select>
            <button type="button" class="tool-btn" @onclick="ResetSample" disabled="@_busy">Reset sample</button>
            <button type="button" class="tool-btn" @onclick="Download" disabled="@_busy">Download .cs</button>
        </div>

        @if (_initError is not null)
        {
            <div class="tool-alert tool-alert-danger">@_initError</div>
        }

        <div class="tool-field">
            <label class="tool-label" for="csharp-source">Source</label>
            <textarea id="csharp-source" class="tool-textarea csharp-source" rows="16" spellcheck="false"
                      @bind="_source" @bind:event="oninput" disabled="@_busy"></textarea>
        </div>

        <div class="csharp-panels">
            <div class="tool-field">
                <label class="tool-label">Diagnostics</label>
                <pre class="tool-textarea csharp-panel">@DiagnosticsText</pre>
            </div>
            <div class="tool-field">
                <div class="tool-result-header">
                    <label class="tool-label">Output</label>
                    <button type="button" class="tool-btn" @onclick="CopyOutput" disabled="@string.IsNullOrEmpty(_output)">Copy</button>
                </div>
                <pre class="tool-textarea csharp-panel">@_output</pre>
            </div>
        </div>
    </div>
</ToolShell>

<style>
    .csharp-compiler .csharp-toolbar { flex-wrap: wrap; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem; }
    .csharp-compiler .csharp-source { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 0.9rem; }
    .csharp-compiler .csharp-panels { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .csharp-compiler .csharp-panel { min-height: 8rem; white-space: pre-wrap; font-family: ui-monospace, Consolas, monospace; font-size: 0.85rem; }
    @@media (max-width: 768px) { .csharp-compiler .csharp-panels { grid-template-columns: 1fr; } }
</style>

@code {
    private const string Sample = """
        using System;

        public class Program
        {
            public static void Main()
            {
                Console.WriteLine("Hello from Roslyn in the browser!");
                for (var i = 1; i <= 5; i++)
                    Console.WriteLine($"  {i}² = {i * i}");
            }
        }
        """;

    private string _source = Sample;
    private string _output = "";
    private IReadOnlyList<CsharpCompilationMessage> _messages = [];
    private LanguageVersion _languageVersion = LanguageVersion.Latest;
    private OptimizationLevel _optimization = OptimizationLevel.Debug;
    private bool _busy;
    private bool _ready;
    private string? _initError;

    private string DiagnosticsText =>
        _messages.Count == 0
            ? (_ready ? "No diagnostics." : "Loading compiler references…")
            : string.Join("\n", _messages.Select(m => $"[{m.Severity}] {m.Message}"));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Compiler.EnsureInitializedAsync();
            _ready = true;
        }
        catch (Exception ex)
        {
            _initError = $"Failed to load compiler references: {ex.Message}";
        }
    }

    private async Task RunAsync()
    {
        if (!_ready || _busy) return;
        _busy = true;
        _output = "";
        _messages = [];
        try
        {
            var (ok, output, messages) = await Compiler.CompileAndRunAsync(_source, _languageVersion, _optimization);
            _messages = messages;
            _output = string.IsNullOrEmpty(output)
                ? (ok ? "(no console output)" : "(failed)")
                : output;
        }
        catch (Exception ex)
        {
            _output = ex.ToString();
        }
        finally
        {
            _busy = false;
        }
    }

    private void ResetSample()
    {
        _source = Sample;
        _output = "";
        _messages = [];
    }

    private async Task CopyOutput()
    {
        if (!string.IsNullOrEmpty(_output))
            await Clipboard.CopyTextAsync(_output);
    }

    private async Task Download()
    {
        var bytes = Encoding.UTF8.GetBytes(_source);
        var b64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("eval",
            $@"(function(){{var a=document.createElement('a');a.href='data:text/plain;base64,{b64}';a.download='Program.cs';a.click();}})()");
    }
}
