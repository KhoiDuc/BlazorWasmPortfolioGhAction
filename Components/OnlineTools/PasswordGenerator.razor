@using System.Security.Cryptography
@inject IClipboardService Clipboard

<ToolShell ResourceKey="passwordgenerator" Title="Password Generator" Icon="bi-key" Description="Generate secure passwords with customizable rules and requirements.">
    <div class="tool-form">
        <div class="tool-field">
            <label class="tool-label" for="pw-length">Length</label>
            <input id="pw-length" type="number" class="tool-input" style="width: 8em;" min="4" max="128" @bind="passwordLength" />
        </div>
        <div class="tool-field">
            <label class="tool-label" for="pw-count">Count</label>
            <input id="pw-count" type="number" class="tool-input" style="width: 8em;" min="1" max="50" @bind="passwordCount" />
        </div>

        <div class="tool-actions">
            <button type="button" class="tool-btn tool-btn-primary" @onclick="GeneratePasswords">Generate</button>
            @if (passwords.Any())
            {
                <button type="button" class="tool-btn tool-btn-secondary" @onclick="CopyAll">Copy all</button>
            }
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="tool-alert tool-alert-danger">@errorMessage</div>
        }

        @if (passwords.Any())
        {
            <div class="tool-field">
                <label class="tool-label">Generated Passwords (@passwords.Count)</label>
                <div class="tool-table-wrapper">
                    <table class="tool-table">
                        <thead>
                            <tr>
                                <th>Password</th>
                                <th>Strength</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var password in passwords)
                            {
                                <tr>
                                    <td><code>@password</code></td>
                                    <td><span class="pw-strength @GetStrengthClass(password)">@GetStrengthLabel(password)</span></td>
                                    <td><CopyResultButton Value="@password" Label="password" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <hr class="tool-divider" />
        <h4 class="tool-label">Character Types</h4>
        <div class="tool-checkbox-group">
            <label class="tool-checkbox">
                <input type="checkbox" @bind="includeLowercase" />
                Lowercase (a-z)
            </label>
            <label class="tool-checkbox">
                <input type="checkbox" @bind="includeUppercase" />
                Uppercase (A-Z)
            </label>
            <label class="tool-checkbox">
                <input type="checkbox" @bind="includeNumbers" />
                Numbers (0-9)
            </label>
            <label class="tool-checkbox">
                <input type="checkbox" @bind="includeSymbols" />
                Symbols (@defaultSymbols)
            </label>
            <label class="tool-checkbox">
                <input type="checkbox" @bind="useCustomSymbols" />
                Custom symbols
            </label>
        </div>
        <div class="tool-field">
            <label class="tool-label" for="pw-custom-symbols">Custom symbols</label>
            <input id="pw-custom-symbols" type="text" class="tool-input" placeholder="!#$%^&*()"
                   @bind="customSymbols" disabled="@(!useCustomSymbols)" />
        </div>

        <hr class="tool-divider" />
        <h4 class="tool-label">Advanced Rules</h4>
        <div class="tool-checkbox-group">
            <label class="tool-checkbox">
                <input type="checkbox" @bind="excludeAmbiguous" />
                Exclude ambiguous characters (l, 1, I, O, 0, o)
            </label>
            <label class="tool-checkbox">
                <input type="checkbox" @bind="excludeSimilar" />
                Exclude similar characters (i, l, 1, L, o, 0, O)
            </label>
            <label class="tool-checkbox">
                <input type="checkbox" @bind="noRepeating" />
                No repeating characters
            </label>
            <label class="tool-checkbox">
                <input type="checkbox" @bind="noSequential" />
                No sequential characters (abc, 123, etc.)
            </label>
            <label class="tool-checkbox">
                <input type="checkbox" @bind="beginWithLetter" />
                Begin with a letter
            </label>
            <label class="tool-checkbox">
                <input type="checkbox" @bind="requireAll" />
                Require all selected types
            </label>
        </div>

        <hr class="tool-divider" />
        <h4 class="tool-label">Minimum Requirements</h4>
        <div class="tool-field">
            <label class="tool-label" for="pw-min-lower">Min lowercase</label>
            <input id="pw-min-lower" type="number" class="tool-input" style="width: 8em;" min="0" max="@passwordLength"
                   @bind="minLowercase" disabled="@(!includeLowercase)" />
        </div>
        <div class="tool-field">
            <label class="tool-label" for="pw-min-upper">Min uppercase</label>
            <input id="pw-min-upper" type="number" class="tool-input" style="width: 8em;" min="0" max="@passwordLength"
                   @bind="minUppercase" disabled="@(!includeUppercase)" />
        </div>
        <div class="tool-field">
            <label class="tool-label" for="pw-min-numbers">Min numbers</label>
            <input id="pw-min-numbers" type="number" class="tool-input" style="width: 8em;" min="0" max="@passwordLength"
                   @bind="minNumbers" disabled="@(!includeNumbers)" />
        </div>
        <div class="tool-field">
            <label class="tool-label" for="pw-min-symbols">Min symbols</label>
            <input id="pw-min-symbols" type="number" class="tool-input" style="width: 8em;" min="0" max="@passwordLength"
                   @bind="minSymbols" disabled="@(!includeSymbols && !useCustomSymbols)" />
        </div>

        <p class="tool-hint">
            Strength: Very Weak · Weak · Fair · Strong · Very Strong
        </p>
    </div>
</ToolShell>

<style>
    .pw-strength { font-size: 0.75rem; padding: 2px 8px; border-radius: 4px; font-weight: 500; white-space: nowrap; }
    .pw-strength.very-weak { background: #ff4444; color: white; }
    .pw-strength.weak { background: #ff8800; color: white; }
    .pw-strength.fair { background: #ffcc00; color: #333; }
    .pw-strength.strong { background: #44bb44; color: white; }
    .pw-strength.very-strong { background: #00aa00; color: white; }
</style>

@code {
    private int passwordLength = 16;
    private int passwordCount = 5;

    private bool includeLowercase = true;
    private bool includeUppercase = true;
    private bool includeNumbers = true;
    private bool includeSymbols = true;
    private bool useCustomSymbols;
    private string customSymbols = "!@#$%^&*";
    private const string defaultSymbols = "!@#$%^&*()_+-=[]{}|;:',.<>?/~`";

    private bool excludeAmbiguous;
    private bool excludeSimilar;
    private bool noRepeating;
    private bool noSequential;
    private bool beginWithLetter;
    private bool requireAll = true;

    private int minLowercase = 1;
    private int minUppercase = 1;
    private int minNumbers = 1;
    private int minSymbols = 1;

    private List<string> passwords = new();
    private string errorMessage = string.Empty;

    private const string LowercaseChars = "abcdefghijklmnopqrstuvwxyz";
    private const string UppercaseChars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    private const string NumberChars = "0123456789";
    private const string AmbiguousChars = "l1IO0o";
    private const string SimilarChars = "il1Lo0O";

    protected override void OnInitialized()
    {
        GeneratePasswords();
    }

    private async Task CopyAll()
    {
        await Clipboard.CopyTextAsync(string.Join(Environment.NewLine, passwords));
    }

    private void GeneratePasswords()
    {
        errorMessage = string.Empty;
        passwords.Clear();

        if (!includeLowercase && !includeUppercase && !includeNumbers && !includeSymbols && !useCustomSymbols)
        {
            errorMessage = "Please select at least one character type.";
            return;
        }

        var minTotal = (includeLowercase ? minLowercase : 0) +
                       (includeUppercase ? minUppercase : 0) +
                       (includeNumbers ? minNumbers : 0) +
                       ((includeSymbols || useCustomSymbols) ? minSymbols : 0);

        if (minTotal > passwordLength)
        {
            errorMessage = "Minimum requirements exceed password length.";
            return;
        }

        try
        {
            for (int i = 0; i < passwordCount; i++)
            {
                var password = GenerateSinglePassword();
                if (password != null)
                {
                    passwords.Add(password);
                }
                else
                {
                    errorMessage = "Could not generate password with current rules. Try relaxing some constraints.";
                    break;
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private string? GenerateSinglePassword()
    {
        var charPool = BuildCharacterPool();
        if (string.IsNullOrEmpty(charPool))
            return null;

        var maxAttempts = 1000;
        for (int attempt = 0; attempt < maxAttempts; attempt++)
        {
            var password = GeneratePasswordCandidate(charPool);
            if (ValidatePassword(password))
                return password;
        }

        return null;
    }

    private string BuildCharacterPool()
    {
        var pool = new System.Text.StringBuilder();

        if (includeLowercase)
            pool.Append(FilterChars(LowercaseChars));
        if (includeUppercase)
            pool.Append(FilterChars(UppercaseChars));
        if (includeNumbers)
            pool.Append(FilterChars(NumberChars));
        if (includeSymbols && !useCustomSymbols)
            pool.Append(FilterChars(defaultSymbols));
        if (useCustomSymbols && !string.IsNullOrEmpty(customSymbols))
            pool.Append(FilterChars(customSymbols));

        return pool.ToString();
    }

    private string FilterChars(string chars)
    {
        var result = chars;
        if (excludeAmbiguous)
            result = new string(result.Where(c => !AmbiguousChars.Contains(c)).ToArray());
        if (excludeSimilar)
            result = new string(result.Where(c => !SimilarChars.Contains(c)).ToArray());
        return result;
    }

    private string GeneratePasswordCandidate(string charPool)
    {
        var password = new char[passwordLength];
        var usedChars = new HashSet<char>();

        for (int i = 0; i < passwordLength; i++)
        {
            char selectedChar;
            int attempts = 0;
            do
            {
                selectedChar = charPool[RandomNumberGenerator.GetInt32(charPool.Length)];
                attempts++;
                if (attempts > 100) break;
            }
            while (noRepeating && usedChars.Contains(selectedChar));

            password[i] = selectedChar;
            if (noRepeating)
                usedChars.Add(selectedChar);
        }

        return new string(password);
    }

    private bool ValidatePassword(string password)
    {
        if (beginWithLetter && !char.IsLetter(password[0]))
            return false;

        if (noSequential && HasSequentialChars(password))
            return false;

        if (requireAll)
        {
            if (includeLowercase && password.Count(char.IsLower) < minLowercase)
                return false;
            if (includeUppercase && password.Count(char.IsUpper) < minUppercase)
                return false;
            if (includeNumbers && password.Count(char.IsDigit) < minNumbers)
                return false;

            var symbols = useCustomSymbols ? customSymbols : defaultSymbols;
            if ((includeSymbols || useCustomSymbols) && password.Count(c => symbols.Contains(c)) < minSymbols)
                return false;
        }

        return true;
    }

    private bool HasSequentialChars(string password)
    {
        for (int i = 0; i < password.Length - 2; i++)
        {
            if (password[i + 1] == password[i] + 1 && password[i + 2] == password[i] + 2)
                return true;
            if (password[i + 1] == password[i] - 1 && password[i + 2] == password[i] - 2)
                return true;
        }
        return false;
    }

    private int CalculateStrength(string password)
    {
        int score = 0;

        if (password.Length >= 8) score += 1;
        if (password.Length >= 12) score += 1;
        if (password.Length >= 16) score += 1;
        if (password.Length >= 24) score += 1;

        if (password.Any(char.IsLower)) score += 1;
        if (password.Any(char.IsUpper)) score += 1;
        if (password.Any(char.IsDigit)) score += 1;
        if (password.Any(c => !char.IsLetterOrDigit(c))) score += 1;

        if (HasSequentialChars(password)) score -= 1;
        if (password.Distinct().Count() < password.Length / 2) score -= 1;

        return Math.Max(0, Math.Min(5, score));
    }

    private string GetStrengthLabel(string password) => CalculateStrength(password) switch
    {
        0 or 1 => "Very Weak",
        2 => "Weak",
        3 => "Fair",
        4 => "Strong",
        _ => "Very Strong"
    };

    private string GetStrengthClass(string password) => CalculateStrength(password) switch
    {
        0 or 1 => "very-weak",
        2 => "weak",
        3 => "fair",
        4 => "strong",
        _ => "very-strong"
    };
}
