@using System.Globalization
@using BlazorWasmPortfolioGhAction.Utils
@using BlazorWasmPortfolioGhAction.Utils.OnlineTools
@inject NavigationManager NavigationManager
@implements IDisposable

<ToolShell ResourceKey="dateconverter" Title="Date Converter" Icon="bi-calendar3" Description="Convert between date strings, Unix timestamps, .NET ticks, and MongoDB ObjectIds. Live clock and date-to-timestamp builder included.">
    <div class="tool-form">
        <div class="tool-field">
            <span class="tool-label">Current time</span>
            <div class="dc-now-panel">
                <div class="dc-now-row"><strong>@nowLocal</strong></div>
                <div class="dc-now-row"><span>UTC:</span> @nowUtc</div>
                <div class="dc-now-row"><span>Unix (s):</span> <code>@nowUnixSec</code></div>
                <div class="dc-now-row"><span>Unix (ms):</span> <code>@nowUnixMs</code></div>
                <button type="button" class="tool-btn tool-btn-secondary" @onclick="RefreshNow">
                    <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh
                </button>
            </div>
        </div>

        <hr class="tool-divider" />

        <div class="tool-field">
            <span class="tool-label">Date/time &rarr; Unix timestamp</span>
            <div class="dc-builder">
                <input type="date" class="tool-input" @bind="pickerDate" />
                <input type="time" class="tool-input" step="1" @bind="pickerTime" />
                <button type="button" class="tool-btn tool-btn-primary" @onclick="BuildTimestamp">Convert</button>
            </div>
            @if (!string.IsNullOrEmpty(builderResult))
            {
                <div class="tool-alert tool-alert-success">@builderResult</div>
            }
        </div>

        <hr class="tool-divider" />

        <div class="tool-field">
            <label class="tool-label" for="inputFormat">Input format</label>
            <select id="inputFormat" class="tool-select" @onchange="OnInputFormatChanged" value="@InputFormat">
                <option value="@DateConvertUtils.InputFormatAuto">Auto</option>
                <option value="@DateConvertUtils.InputFormatDateTimeString">Date/time string (including RFC formats)</option>
                <option value="@DateConvertUtils.InputFormatUnixSeconds">Unix timestamp (seconds)</option>
                <option value="@DateConvertUtils.InputFormatUnixMilliseconds">Unix timestamp (milliseconds)</option>
                <option value="@DateConvertUtils.InputFormatUnixMicroseconds">Unix timestamp (microseconds)</option>
                <option value="@DateConvertUtils.InputFormatDotNetTicks">Timestamp (.NET ticks)</option>
                <option value="@DateConvertUtils.InputFormatMongoObjectId">MongoDB ObjectId</option>
            </select>
        </div>

        <div class="tool-field">
            <label class="tool-label" for="inputValue">Value</label>
            <input id="inputValue" class="tool-input" @oninput="OnInput" value="@Text" placeholder="Enter a date/time, unix timestamp, .NET ticks, MongoDB ObjectId, RFC value, ..." />
        </div>

        @if (errorMessage != null)
        {
            <div class="tool-alert tool-alert-danger">@errorMessage</div>
        }

        @if (parsedValue.HasValue)
        {
            <div class="tool-alert tool-alert-success">Parsed as @parsedSource</div>
            <ResultValueList Values="@values" />
        }
    </div>
</ToolShell>

@code {
    [Parameter, SupplyParameterFromQuery]
    public string? Text { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "format")]
    public string? InputFormat { get; set; } = DateConvertUtils.InputFormatAuto;

    private DateTimeOffset? parsedValue;
    private string? parsedSource;
    private string? errorMessage;
    private IReadOnlyList<ResultValue> values = [];

    // Live clock
    private string nowLocal = "";
    private string nowUtc = "";
    private long nowUnixSec;
    private long nowUnixMs;
    private System.Threading.Timer? clockTimer;

    // Date→timestamp builder
    private DateOnly pickerDate = DateOnly.FromDateTime(DateTime.Now);
    private TimeOnly pickerTime = TimeOnly.FromDateTime(DateTime.Now);
    private string? builderResult;

    protected override void OnInitialized()
    {
        NavigationManager.SetParametersFromQueryString(this);
        RefreshNow();
        clockTimer = new System.Threading.Timer(_ => InvokeAsync(() => { RefreshNow(); StateHasChanged(); }), null, 1000, 1000);
        Compute();
    }

    private void OnInput(ChangeEventArgs e)
    {
        Text = e.Value as string;
        Compute();
    }

    private void OnInputFormatChanged(ChangeEventArgs e)
    {
        InputFormat = DateConvertUtils.NormalizeInputFormat(e.Value as string);
        Compute();
    }

    private void Compute()
    {
        InputFormat = DateConvertUtils.NormalizeInputFormat(InputFormat);
        NavigationManager.UpdateUrlUsingParameters(this, replaceHistory: true);

        parsedValue = null;
        parsedSource = null;
        errorMessage = null;
        values = [];

        var input = Text?.Trim();
        if (string.IsNullOrEmpty(input))
            return;

        if (!DateConvertUtils.TryParseInput(input, InputFormat!, out var dateTimeOffset, out var source))
        {
            errorMessage = InputFormat == DateConvertUtils.InputFormatAuto
                ? "Unable to parse the value as a date/time, unix timestamp, timestamp, or MongoDB ObjectId."
                : $"Unable to parse the value as {DateConvertUtils.GetInputFormatDisplayName(InputFormat!)}.";
            return;
        }

        parsedValue = dateTimeOffset;
        parsedSource = source;
        values = DateConvertUtils.BuildDisplayValues(dateTimeOffset);
    }

    private void RefreshNow()
    {
        var now = DateTimeOffset.Now;
        nowLocal = now.LocalDateTime.ToString("yyyy-MM-dd HH:mm:ss");
        nowUtc = now.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss");
        nowUnixSec = now.ToUnixTimeSeconds();
        nowUnixMs = now.ToUnixTimeMilliseconds();
    }

    private void BuildTimestamp()
    {
        var dto = new DateTimeOffset(pickerDate.ToDateTime(pickerTime));
        builderResult = $"Local: {dto.LocalDateTime:yyyy-MM-dd HH:mm:ss}\nUTC: {dto.UtcDateTime:yyyy-MM-dd HH:mm:ss}\nUnix (s): {dto.ToUnixTimeSeconds()}\nUnix (ms): {dto.ToUnixTimeMilliseconds()}";
    }

    public void Dispose()
    {
        clockTimer?.Dispose();
    }
}

<style>
    .dc-now-panel { display: flex; flex-direction: column; gap: 0.25rem; }
    .dc-now-row { display: flex; gap: 0.5rem; align-items: center; }
    .dc-now-row span { color: var(--color-text-muted); min-width: 5.5em; }
    .dc-now-row code { font-family: monospace; }
    .dc-builder { display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center; }
</style>
