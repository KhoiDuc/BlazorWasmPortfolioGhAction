@using Meziantou.Framework
@using Meziantou.Framework.Scheduling
@using System.Globalization
@inject NavigationManager NavigationManager

<ToolShell ResourceKey="rrule" Title="Recurrence Rule (RFC 5545)" Icon="bi-calendar-event">
    <div class="tool-form">
        <p class="tool-hint"><a href="https://icalendar.org/iCalendar-RFC-5545/3-8-5-3-recurrence-rule.html" target="_blank" rel="noopener">Recurrence Rule documentation</a></p>
        <div class="tool-field">
            <label class="tool-label" for="rrule-text">Rule</label>
            <input id="rrule-text" class="tool-textarea" list="RecurrenceRuleSamples" @bind="Text" spellcheck="false" />
            <datalist id="RecurrenceRuleSamples">
                <option>FREQ=DAILY;INTERVAL=1</option>
                <option>FREQ=WEEKLY;BYDAY=FR;INTERVAL=2</option>
                <option>FREQ=MONTHLY;BYMONTHDAY=1;INTERVAL=1</option>
                <option>FREQ=MONTHLY;BYSETPOS=-1;BYDAY=MO,TU,WE,TH,FR;INTERVAL=1</option>
            </datalist>
        </div>
        <div class="tool-actions">
            <button type="button" class="tool-btn tool-btn-secondary" @onclick="Compute">Get occurences</button>
        </div>
        @if (result != null)
        {
            <ResultValueList Values="result" />
        }
    </div>
</ToolShell>

@code {
    [Parameter, SupplyParameterFromQuery]
    public string? Text { get; set; }

    IReadOnlyList<ResultValue>? result;

    protected override void OnParametersSet()
    {
        Compute();
    }

    void Compute()
    {
        Text ??= "FREQ=DAILY;INTERVAL=1";
        try
        {
            var schedule = RecurrenceRule.Parse(Text);
#pragma warning disable RS0030 // Do not use banned APIs
            result = schedule
                .GetNextOccurrences(DateTime.Now)
                .Take(50)
                .Select((value, index) => new ResultValue($"Occurrence {index + 1}", value.ToString("o", CultureInfo.InvariantCulture)))
                .ToArray();
#pragma warning restore RS0030
        }
        catch (Exception ex)
        {
            result = [new ResultValue("Error", ex.Message)];
        }

        NavigationManager.UpdateUrlUsingParameters(this, replaceHistory: true);
    }
}
