@using System.Text
@using System.Text.Encodings.Web
@using Meziantou.Framework
@using BlazorWasmPortfolioGhAction.Utils
@using BlazorWasmPortfolioGhAction.Utils.OnlineTools
@inject NavigationManager NavigationManager

<ToolShell ResourceKey="textdiff" Title="Text Comparison" Icon="bi-file-diff" Description="Compare two texts with multiple diff algorithms.">
    <div class="tool-form">
        <div class="tool-field">
            <label class="tool-label" for="leftText">Text 1</label>
            <textarea id="leftText" class="tool-textarea" @oninput="OnLeftTextChanged" spellcheck="false">@LeftText</textarea>
        </div>

        <div class="tool-field">
            <label class="tool-label" for="rightText">Text 2</label>
            <textarea id="rightText" class="tool-textarea" @oninput="OnRightTextChanged" spellcheck="false">@RightText</textarea>
        </div>

        <div class="tool-field">
            <label class="tool-label" for="algorithm">Algorithm</label>
            <select id="algorithm" class="tool-select" @onchange="OnAlgorithmChanged" value="@Algorithm">
                @foreach (var value in Enum.GetValues<TextDiffAlgorithm>())
                {
                    <option value="@value">@value</option>
                }
            </select>
        </div>

        <div class="tool-field">
            <label class="tool-label" for="chunkMode">Chunk mode</label>
            <select id="chunkMode" class="tool-select" @onchange="OnChunkModeChanged" value="@ChunkMode">
                <option value="line">Lines</option>
                <option value="word">Words</option>
                <option value="character">Characters</option>
                <option value="line-word">Lines + words</option>
            </select>
        </div>

        <div class="tool-checkbox-group diff-options">
            <label class="tool-checkbox"><input type="checkbox" checked="@IgnoreCase" @onchange="OnIgnoreCaseChanged" /> Ignore case</label>
            <label class="tool-checkbox"><input type="checkbox" checked="@IgnoreWhitespace" @onchange="OnIgnoreWhitespaceChanged" /> Ignore whitespace</label>
            <label class="tool-checkbox"><input type="checkbox" checked="@IgnoreEndOfLine" @onchange="OnIgnoreEndOfLineChanged" /> Ignore line ending</label>
        </div>

        @if (ErrorMessage != null)
        {
            <div class="tool-alert tool-alert-danger">@ErrorMessage</div>
        }
        else
        {
            <div class="tool-alert @(HasDifferences ? "tool-alert-danger" : "tool-alert-success")">
                @(HasDifferences ? "Differences found" : "No differences")
            </div>
            <pre class="diff-output tool-result">@DiffMarkup</pre>
        }
    </div>
</ToolShell>

@code {
    [Parameter, SupplyParameterFromQuery(Name = "left")]
    public string? LeftText { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "right")]
    public string? RightText { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "algorithm")]
    public string? Algorithm { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "chunk")]
    public string? ChunkMode { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "ignoreCase")]
    public bool IgnoreCase { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "ignoreWhitespace")]
    public bool IgnoreWhitespace { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "ignoreEndOfLine")]
    public bool IgnoreEndOfLine { get; set; }

    private string? ErrorMessage;
    private MarkupString DiffMarkup;
    private bool HasDifferences;

    protected override void OnInitialized()
    {
        NavigationManager.SetParametersFromQueryString(this);
        ComputeDiff();
    }

    private void OnLeftTextChanged(ChangeEventArgs e)
    {
        LeftText = e.Value?.ToString();
        ComputeDiff();
    }

    private void OnRightTextChanged(ChangeEventArgs e)
    {
        RightText = e.Value?.ToString();
        ComputeDiff();
    }

    private void OnAlgorithmChanged(ChangeEventArgs e)
    {
        Algorithm = e.Value?.ToString();
        ComputeDiff();
    }

    private void OnChunkModeChanged(ChangeEventArgs e)
    {
        ChunkMode = e.Value?.ToString();
        ComputeDiff();
    }

    private void OnIgnoreCaseChanged(ChangeEventArgs e)
    {
        IgnoreCase = DiffMarkupUtils.ToBoolean(e.Value);
        ComputeDiff();
    }

    private void OnIgnoreWhitespaceChanged(ChangeEventArgs e)
    {
        IgnoreWhitespace = DiffMarkupUtils.ToBoolean(e.Value);
        ComputeDiff();
    }

    private void OnIgnoreEndOfLineChanged(ChangeEventArgs e)
    {
        IgnoreEndOfLine = DiffMarkupUtils.ToBoolean(e.Value);
        ComputeDiff();
    }

    private void ComputeDiff()
    {
        LeftText ??= "";
        RightText ??= "";

        var algorithm = DiffMarkupUtils.ParseAlgorithm(Algorithm);
        var chunkMode = DiffMarkupUtils.ParseChunkMode(ChunkMode);

        Algorithm = algorithm.ToString();
        ChunkMode = DiffMarkupUtils.ToQueryValue(chunkMode);

        ErrorMessage = null;
        DiffMarkup = default;
        HasDifferences = false;

        try
        {
            var options = new TextDiffOptions
            {
                Algorithm = algorithm,
                IgnoreCase = IgnoreCase,
                IgnoreWhitespace = IgnoreWhitespace,
                IgnoreEndOfLine = IgnoreEndOfLine,
            };

            var result = DiffMarkupUtils.ComputeDiffMarkup(LeftText, RightText, options, chunkMode);
            DiffMarkup = result.Markup;
            HasDifferences = result.HasDifferences;
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.ToString();
        }

        NavigationManager.UpdateUrlUsingParameters(this, replaceHistory: true);
    }
}
