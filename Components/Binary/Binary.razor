@using System.Text
@using BlazorWasmPortfolioGhAction.Services
@inject IClipboardService Clipboard

<div class="tool-card">
    <div class="tool-header">
        <h3>Binary ↔ Text</h3>
        <p>Convert between binary strings and ASCII text.</p>
    </div>
    <div class="tool-form">
        <div class="tool-field">
            <label class="tool-label" for="binary">Binary input</label>
            <textarea id="binary" class="tool-textarea" rows="5" @bind="Input"></textarea>
        </div>
        <div class="tool-actions">
            <button type="button" class="tool-btn tool-btn-success" @onclick="Swap"><i class="bi bi-arrow-down-up" aria-hidden="true"></i> Swap</button>
            <button type="button" class="tool-btn tool-btn-danger" @onclick="Clear"><i class="bi bi-trash" aria-hidden="true"></i> Clear</button>
        </div>
        <div class="tool-field">
            <label class="tool-label" for="outputBinary">Text output</label>
            <textarea id="outputBinary" class="tool-textarea" rows="5" @bind="Output"></textarea>
        </div>
        <div class="tool-actions">
            <button type="button" class="tool-btn tool-btn-secondary" @onclick="Copy"><i class="bi bi-clipboard" aria-hidden="true"></i> Copy</button>
        </div>
    </div>
</div>

@code {
    string Input = "01101111 01101110 01100101 00100000 01101100 01101001 01101110 01100101";
    string Output = string.Empty;

    void Swap()
    {
        Input = string.Concat(Input.Where(c => !char.IsWhiteSpace(c)));
        var data = GetBytesFromBinaryString(Input);
        Output = Encoding.ASCII.GetString(data);
    }

    private void Clear() => Input = string.Empty;

    async Task Copy()
    {
        if (!string.IsNullOrEmpty(Output))
            await Clipboard.CopyTextAsync(Output);
    }

    private byte[] GetBytesFromBinaryString(string binary)
    {
        var list = new List<byte>();
        for (int i = 0; i < binary.Length; i += 8)
        {
            string t = binary.Substring(i, 8);
            list.Add(Convert.ToByte(t, 2));
        }
        return list.ToArray();
    }
}
