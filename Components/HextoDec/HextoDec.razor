<ToolShell Title="HEX to DEC" Icon="bi-123" Description="Convert between hexadecimal and decimal.">
    <div class="tool-form">
        <div class="tool-field">
            <label class="tool-label" for="hex">Hexadecimal</label>
            <div class="hextodec-row">
                <input id="hex" class="tool-input" @bind="hex" placeholder="1A" />
                <button class="tool-btn tool-btn-primary" @onclick="ConvertToDecimal">
                    <i class="bi bi-arrow-down-square" aria-hidden="true"></i> To Decimal
                </button>
            </div>
        </div>
        <div class="tool-field">
            <label class="tool-label" for="dec">Decimal</label>
            <div class="hextodec-row">
                <input id="dec" class="tool-input" @bind="dec" placeholder="26" />
                <button class="tool-btn tool-btn-primary" @onclick="ConvertToHex">
                    <i class="bi bi-arrow-up-square" aria-hidden="true"></i> To Hex
                </button>
            </div>
        </div>
    </div>
</ToolShell>

@code {
    string hex = "12";
    int dec = 0;

    private void ConvertToDecimal()
    {
        dec = int.Parse(hex, System.Globalization.NumberStyles.HexNumber);
    }

    private void ConvertToHex()
    {
        hex = dec.ToString("X");
    }
}