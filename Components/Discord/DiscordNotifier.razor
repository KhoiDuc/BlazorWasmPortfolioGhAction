@using BlazorWasmPortfolioGhAction.Services
@inject IDevOpsService DevOpsService
@inject IJSRuntime JSRuntime

<ToolShell Title="Discord Notifier" Icon="bi-discord" Description="Send rich messages to Discord webhooks.">

    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <div class="tool-alert tool-alert-success">
            <i class="bi bi-check-circle" aria-hidden="true"></i>
            @Message
            <button type="button" class="discord-dismiss" @onclick="(() => Message = null)" aria-label="Dismiss">&times;</button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="tool-alert tool-alert-danger">
            <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
            @ErrorMessage
            <button type="button" class="discord-dismiss" @onclick="(() => ErrorMessage = null)" aria-label="Dismiss">&times;</button>
        </div>
    }

    <div class="discord-layout">
        <div class="tool-card discord-form-card">
            <div class="tool-form">
                <div class="tool-field">
                    <span class="tool-label">Message Type</span>
                    <div class="tool-radio-group">
                        <label class="tool-radio">
                            <input type="radio" name="msgtype" value="simple" @onchange="OnMessageTypeChanged" checked />
                            Simple
                        </label>
                        <label class="tool-radio">
                            <input type="radio" name="msgtype" value="embed" @onchange="OnMessageTypeChanged" />
                            Embed
                        </label>
                    </div>
                </div>

                @if (MessageType == "simple")
                {
                    <div class="tool-field">
                        <label class="tool-label" for="message">Message <span class="discord-req">*</span></label>
                        <textarea id="message" class="tool-textarea" rows="5" @bind="SimpleMessage" placeholder="Your message here..."></textarea>
                    </div>
                }
                else
                {
                    <div class="tool-field">
                        <label class="tool-label" for="title">Title <span class="discord-req">*</span></label>
                        <input type="text" id="title" class="tool-input" @bind="EmbedTitle" placeholder="Embed title" />
                    </div>

                    <div class="tool-field">
                        <label class="tool-label" for="description">Description <span class="discord-req">*</span></label>
                        <textarea id="description" class="tool-textarea" rows="5" @bind="EmbedDescription" placeholder="Embed description"></textarea>
                    </div>

                    <div class="tool-field">
                        <label class="tool-label" for="color">Color</label>
                        <div class="discord-color-row">
                            <input type="color" id="color" class="tool-input discord-color-swatch" @bind="EmbedColor" />
                            <input type="text" class="tool-input" @bind="EmbedColor" placeholder="#5865F2" />
                        </div>
                        <span class="tool-hint">Hex color code (default: Discord blurple #5865F2)</span>
                    </div>
                }

                <div class="tool-actions">
                    <button type="button" class="tool-btn tool-btn-primary" @onclick="SendMessage">
                        <i class="bi bi-discord" aria-hidden="true"></i> Send to Discord
                    </button>
                    <button type="button" class="tool-btn" @onclick="ClearForm">
                        <i class="bi bi-eraser" aria-hidden="true"></i> Clear
                    </button>
                </div>
            </div>
        </div>

        <div class="tool-card discord-sidebar">
            <div class="tool-result-label">Preview</div>

            @if (MessageType == "simple")
            {
                <div class="discord-preview discord-preview-simple">
                    @SimpleMessage
                </div>
            }
            else
            {
                <div class="discord-preview discord-preview-embed" style="--embed-color: @EmbedColor;">
                    <h6 class="discord-preview-title">@EmbedTitle</h6>
                    <small class="discord-preview-desc">@EmbedDescription</small>
                </div>
            }

            <hr class="tool-divider" />

            <div class="tool-result-label">Setup</div>
            <ol class="discord-steps">
                <li>Open Discord server settings</li>
                <li>Integrations → Webhooks → New Webhook</li>
                <li>Name it, select channel, copy URL</li>
                <li>Paste URL in appsettings.json:</li>
            </ol>
            <pre class="tool-code">"DevOps": {
  "DiscordWebhookUrl": "https://..."
}</pre>

            <hr class="tool-divider" />

            <div class="tool-hint">
                <strong>Config status:</strong><br />
                @if (IsConfigured)
                {
                    <span class="discord-status-ok"><i class="bi bi-check-circle" aria-hidden="true"></i> Discord webhook configured</span>
                }
                else
                {
                    <span class="discord-status-warn"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> Missing Discord webhook URL</span>
                }
            </div>
        </div>
    </div>
</ToolShell>

@code {
    private string MessageType = "simple";
    private string SimpleMessage = string.Empty;
    private string EmbedTitle = string.Empty;
    private string EmbedDescription = string.Empty;
    private string EmbedColor = "#5865F2";
    private string? Message;
    private string? ErrorMessage;
    private bool IsSuccess;

    [Inject]
    private IConfiguration Configuration { get; set; } = null!;

    private bool IsConfigured => !string.IsNullOrWhiteSpace(Configuration["DevOps:DiscordWebhookUrl"]);

    private void OnMessageTypeChanged(ChangeEventArgs e)
    {
        MessageType = e.Value?.ToString() ?? "simple";
    }

    private async Task SendMessage()
    {
        Message = null;
        ErrorMessage = null;
        IsSuccess = false;

        if (MessageType == "simple")
        {
            if (string.IsNullOrWhiteSpace(SimpleMessage))
            {
                ErrorMessage = "Message cannot be empty.";
                return;
            }

            var result = await DevOpsService.SendDiscordMessageAsync(SimpleMessage);
            if (result)
            {
                Message = "Message sent successfully!";
                IsSuccess = true;
                SimpleMessage = string.Empty;
            }
            else
            {
                ErrorMessage = IsConfigured
                    ? "Failed to send message. Check webhook URL."
                    : "Discord webhook not configured.";
            }
        }
        else
        {
            if (string.IsNullOrWhiteSpace(EmbedTitle) || string.IsNullOrWhiteSpace(EmbedDescription))
            {
                ErrorMessage = "Title and description are required.";
                return;
            }

            var colorValue = EmbedColor.StartsWith("#") ? EmbedColor[1..] : EmbedColor;
            var result = await DevOpsService.SendDiscordMessageAsync(EmbedDescription, EmbedTitle, EmbedDescription);
            if (result)
            {
                Message = "Embed sent successfully!";
                IsSuccess = true;
                EmbedTitle = EmbedDescription = string.Empty;
            }
            else
            {
                ErrorMessage = IsConfigured
                    ? "Failed to send embed. Check webhook URL."
                    : "Discord webhook not configured.";
            }
        }
    }

    private void ClearForm()
    {
        SimpleMessage = EmbedTitle = EmbedDescription = string.Empty;
        EmbedColor = "#5865F2";
        MessageType = "simple";
        Message = ErrorMessage = null;
        IsSuccess = false;
    }
}