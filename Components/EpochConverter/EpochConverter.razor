@using Humanizer

<ToolShell Title="Epoch Converter" Icon="bi-clock-history" Description="Convert Unix timestamp to human-readable date.">
    <div class="tool-form">
        <div class="tool-field">
            <label class="tool-label" for="timestamp">Timestamp (seconds)</label>
            <div class="epoch-row">
                <input type="number" id="timestamp" class="tool-input" @bind="Timestamp" />
                <button class="tool-btn" @onclick="Refresh" title="Current timestamp">
                    <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
                </button>
                <button class="tool-btn tool-btn-primary" @onclick="TimestampToHuman">Convert</button>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(GMT))
        {
            <div class="epoch-results">
                <div class="epoch-result-item">
                    <span class="tool-result-label">GMT</span>
                    <div class="tool-result">@GMT</div>
                </div>
                <div class="epoch-result-item">
                    <span class="tool-result-label">Your timezone</span>
                    <div class="tool-result">@YourTimeZone</div>
                </div>
                <div class="epoch-result-item">
                    <span class="tool-result-label">Relative</span>
                    <div class="tool-result">@Relative</div>
                </div>
            </div>
        }
    </div>
    <hr class="tool-divider" />
    <p class="tool-hint">
        Inspired by <a href="https://www.epochconverter.com" target="_blank">Epoch Converter</a>.
        Relative by <a href="https://github.com/Humanizr/Humanizer" target="_blank">Humanizer</a>.
    </p>
</ToolShell>

@code {
    long Timestamp = DateTimeOffset.Now.ToUnixTimeSeconds();
    string GMT = "";
    string YourTimeZone = "";
    string Relative = "";

    void Refresh() { Timestamp = DateTimeOffset.Now.ToUnixTimeSeconds(); }

    void TimestampToHuman()
    {
        DateTimeOffset dateTimeOffset = DateTimeOffset.FromUnixTimeSeconds(Timestamp);
        DateTime dateTime = dateTimeOffset.DateTime;
        GMT = dateTime.ToString("dddd, dd MMMM yyyy HH:mm:ss");
        YourTimeZone = dateTime.ToLocalTime().ToString("dddd, dd MMMM yyyy HH:mm:ss");
        Relative = dateTime.Humanize();
    }
}