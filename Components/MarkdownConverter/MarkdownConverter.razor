@using System.Net

<ToolShell Title="Markdown Converter" Icon="bi-markdown" Description="Convert HTML to Markdown.">
    <div class="tool-form">
        <div class="tool-field">
            <label class="tool-label" for="html">HTML input</label>
            <textarea id="html" class="tool-textarea" rows="6" @bind="HTML" placeholder="<h1>Hello</h1>"></textarea>
        </div>
        <div class="tool-actions">
            <button class="tool-btn tool-btn-primary" @onclick="Convert">
                <i class="bi bi-arrow-down" aria-hidden="true"></i> Convert
            </button>
        </div>
        <div class="tool-field">
            <label class="tool-label">Markdown output</label>
            <textarea class="tool-textarea" rows="6" @bind="Markdown" readonly placeholder="# Hello"></textarea>
        </div>
    </div>
    <hr class="tool-divider" />
    <p class="tool-hint">
        Powered by <a href="https://github.com/mysticmind/reversemarkdown-net/" target="_blank">ReverseMarkdown</a>
        and <a href="https://html-agility-pack.net" target="_blank">HtmlAgilityPack</a>.
    </p>
</ToolShell>

@code {
    [Parameter] public string HTML { get; set; } = "";
    [Parameter] public string Markdown { get; set; } = "";

    private void Convert()
    {
        var writer = new StringWriter();
        WebUtility.HtmlDecode(HTML, writer);
        HTML = writer.ToString();
        var converter = new ReverseMarkdown.Converter();
        Markdown = converter.Convert(HTML);
    }
}