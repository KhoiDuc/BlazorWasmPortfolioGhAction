@using BlazorWasmPortfolioGhAction.Services.Crypto

<ToolShell Title="MD5 Converter" Icon="bi-fingerprint" Description="Generate MD5 hash from a string.">
    <div class="tool-form">
        <div class="tool-field">
            <label class="tool-label" for="md5input">Input string</label>
            <div class="conv-row">
                <input id="md5input" class="tool-input" @bind="md5" placeholder="Enter text..." />
                <button class="tool-btn tool-btn-primary" @onclick="ConvertString">Convert</button>
            </div>
        </div>
        <div class="tool-field">
            <label class="tool-label">MD5 hash</label>
            <textarea class="tool-textarea" rows="3" @bind="Output" readonly placeholder="Hash output"></textarea>
        </div>
    </div>
</ToolShell>

@code {
    string md5 = "";
    string Output = string.Empty;

    void ConvertString() => Output = Md5Helper.ComputeHash(md5);
}
