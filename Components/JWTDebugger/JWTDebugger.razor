@using System.Text
@using System.IdentityModel.Tokens.Jwt
@using BlazorWasmPortfolioGhAction.Services
@inject IClipboardService Clipboard

<ToolShell Title="JWT Debugger" Icon="bi-shield-lock" Description="Decode JWT tokens to inspect header, payload, and signature.">
    <div class="tool-form">
        <div class="tool-field">
            <label class="tool-label" for="algorithm-select">Algorithm</label>
            <select id="algorithm-select" class="tool-select">
                <option value="HS256" selected>HS256</option>
            </select>
        </div>
        <div class="jwt-layout">
            <div class="tool-field">
                <label class="tool-label" for="Input">Encoded JWT</label>
                <textarea id="Input" class="tool-textarea" rows="8" @bind="Input" placeholder="eyJhbGciOiJIUzI1NiIs..."></textarea>
                <div class="tool-actions">
                    <button class="tool-btn tool-btn-success" @onclick="Decode">
                        <i class="bi bi-arrow-down" aria-hidden="true"></i> Decode
                    </button>
                    <button class="tool-btn tool-btn-danger" @onclick="Clear">
                        <i class="bi bi-trash" aria-hidden="true"></i> Clear
                    </button>
                </div>
            </div>
            <div class="jwt-decoded">
                <div class="tool-field">
                    <span class="tool-result-label">Header</span>
                    <textarea id="Header" class="tool-textarea" rows="3" @bind="Header" placeholder="Decoded header" readonly></textarea>
                </div>
                <div class="tool-field">
                    <span class="tool-result-label">Payload</span>
                    <textarea id="Payload" class="tool-textarea" rows="4" @bind="Payload" placeholder="Decoded payload" readonly></textarea>
                </div>
                <div class="tool-field">
                    <span class="tool-result-label">Verify signature</span>
                    <textarea id="VerifySignature" class="tool-textarea" rows="2" @bind="Signature" placeholder="Signature" readonly></textarea>
                </div>
            </div>
        </div>
    </div>
    <hr class="tool-divider" />
    <p class="tool-hint">Inspired by <a href="https://jwt.io" target="_blank">JWT.io</a></p>
</ToolShell>

@code {
    [Parameter] public string? Input { get; set; }
    [Parameter] public string? Output { get; set; }
    [Parameter] public string Header { get; set; } = "";
    [Parameter] public string Payload { get; set; } = "";
    [Parameter] public string Signature { get; set; } = "";

    void Decode()
    {
        if (string.IsNullOrEmpty(Input)) return;
        var handler = new JwtSecurityTokenHandler();
        var jwtSecurityToken = handler.ReadJwtToken(Input);
        Header = jwtSecurityToken.Header.SerializeToJson();
        Payload = jwtSecurityToken.Payload.SerializeToJson();
        Signature = jwtSecurityToken.RawSignature;
    }

    private void Clear() { Input = string.Empty; }

    async Task Copy()
    {
        if (!string.IsNullOrEmpty(Output))
            await Clipboard.CopyTextAsync(Output);
    }
}