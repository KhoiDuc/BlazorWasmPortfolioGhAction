@using BlazorWasmPortfolioGhAction.Services
@inject IDevOpsService DevOpsService

<div class="tool-card">
    <div class="tool-header">
        <h3><i class="bi bi-microsoft-teams" aria-hidden="true"></i> Teams Notifier</h3>
        <p>Send MessageCard notifications to Microsoft Teams via webhook.</p>
    </div>

    @if (!string.IsNullOrEmpty(status))
    {
        <div class="tool-alert @(statusClass.Contains("success") ? "tool-alert-success" : "tool-alert-danger")">@status</div>
    }

    <div class="tool-form">
        <div class="tool-field">
            <label class="tool-label" for="teams-title">Title</label>
            <input id="teams-title" type="text" @bind="title" class="tool-input" placeholder="Enter message title" />
        </div>
        <div class="tool-field">
            <label class="tool-label" for="teams-message">Message</label>
            <textarea id="teams-message" @bind="message" class="tool-textarea" rows="5" placeholder="Enter message content"></textarea>
        </div>
        <div class="tool-actions">
            <button type="button" @onclick="SendMessage" class="tool-btn tool-btn-primary">Send to Teams</button>
            <button type="button" @onclick="() => showPreview = !showPreview" class="tool-btn tool-btn-secondary">@(showPreview ? "Hide preview" : "Show preview")</button>
        </div>
    </div>

    @if (showPreview && !string.IsNullOrEmpty(message))
    {
        <div class="tool-inspect-card teams-preview">
            <h4>@title</h4>
            <p>@message</p>
            <small class="tool-hint">Portfolio Bot</small>
        </div>
    }
</div>

@code {
    private string title = string.Empty;
    private string message = string.Empty;
    private string status = string.Empty;
    private string statusClass = string.Empty;
    private bool showPreview = false;

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(title) || string.IsNullOrWhiteSpace(message))
        {
            status = "Please fill in all fields";
            statusClass = "text-danger";
            return;
        }

        var result = await DevOpsService.SendTeamsMessageAsync(title, message);
        status = result
            ? "Message sent successfully!"
            : "Failed to send message. Check webhook URL in appsettings.";
        statusClass = result ? "text-success" : "text-danger";

        if (result)
        {
            title = string.Empty;
            message = string.Empty;
        }
    }
}
