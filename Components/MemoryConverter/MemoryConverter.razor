@using System.Text
@inject IJSRuntime JSRuntime

<ToolShell Title="Memory Converter" Icon="bi-hdd" Description="Convert bytes to human-readable sizes (KB, MB, GB...).">
    <div class="tool-form">
        <div class="tool-field">
            <label class="tool-label" for="input">Bytes</label>
            <div class="conv-row">
                <input type="number" id="input" class="tool-input" @bind="Input" placeholder="1030" />
                <button class="tool-btn tool-btn-danger" @onclick="Clear" title="Clear">
                    <i class="bi bi-trash" aria-hidden="true"></i>
                </button>
            </div>
        </div>
        <div class="tool-actions">
            <button class="tool-btn tool-btn-success" @onclick="Convert">
                <i class="bi bi-arrow-left-right" aria-hidden="true"></i> Convert
            </button>
        </div>
        <div class="tool-field">
            <label class="tool-label">Result</label>
            <div class="conv-row">
                <input id="output" class="tool-input" @bind="Output" placeholder="KB / MB / GB / TB" readonly />
                <button class="tool-btn" @onclick="Copy" title="Copy">
                    <i class="bi bi-clipboard" aria-hidden="true"></i>
                </button>
            </div>
        </div>
    </div>
</ToolShell>

@code {
    [Parameter] public long Input { get; set; }
    [Parameter] public string? Output { get; set; }

    protected override void OnInitialized()
    {
        Input = 1030;
        Output = string.Empty;
    }

    void Convert() { Output = SizeSuffix(Input); }
    void Clear() { Input = 0; }

    async Task Copy()
    {
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", Output);
    }

    static readonly string[] SizeSuffixes = { "bytes", "KB", "MB", "GB", "TB", "PB", "EB", "ZB", "YB" };

    static string SizeSuffix(Int64 value, int decimalPlaces = 1)
    {
        if (decimalPlaces < 0) { throw new ArgumentOutOfRangeException("decimalPlaces"); }
        if (value < 0) { return "-" + SizeSuffix(-value, decimalPlaces); }
        if (value == 0) { return string.Format("{0:n" + decimalPlaces + "} bytes", 0); }
        int mag = (int)Math.Log(value, 1024);
        decimal adjustedSize = (decimal)value / (1L << (mag * 10));
        if (Math.Round(adjustedSize, decimalPlaces) >= 1000) { mag += 1; adjustedSize /= 1024; }
        return string.Format("{0:n" + decimalPlaces + "} {1}", adjustedSize, SizeSuffixes[mag]);
    }
}