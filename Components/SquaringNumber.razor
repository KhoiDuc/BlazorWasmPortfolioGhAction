<div class="tool-form">
    <p class="tool-hint"><strong>Instructions:</strong> @InstructionParam</p>
    <div class="tool-field">
        <label class="tool-label" for="sq-x">X</label>
        <input id="sq-x" type="number" class="tool-input" @bind="textFieldValue" />
    </div>
    <div class="tool-actions">
        <button type="button" class="tool-btn tool-btn-primary" @onclick="CalculateRun">Calculate</button>
    </div>
    @if (!string.IsNullOrEmpty(resultText))
    {
        <div class="tool-result">@resultText</div>
    }
</div>

@code {
    [Parameter]
    public string InstructionParam { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> MyCallback { get; set; }

    private string textFieldValue = string.Empty;
    private string resultText = string.Empty;

    private async Task CalculateRun()
    {
        if (!int.TryParse(textFieldValue, out var x)) return;
        var kv = x * x;
        resultText = $"Result: {x} × {x} = {kv}";
        await MyCallback.InvokeAsync(resultText);
    }
}
