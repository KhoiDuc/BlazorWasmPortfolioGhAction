@using System.Text
@inject IJSRuntime JSRuntime

<div class="tool-card">
    <div class="tool-header">
        <h3>Time Converter</h3>
        <p>Convert seconds to hh:mm:ss:fff format.</p>
    </div>
    <div class="tool-form">
        <div class="tool-field">
            <label class="tool-label" for="input">Seconds</label>
            <div class="conv-row">
                <input type="number" id="input" class="tool-input" @bind="Input" placeholder="60" />
                <button class="tool-btn tool-btn-danger" @onclick="Clear" title="Clear">
                    <i class="bi bi-trash" aria-hidden="true"></i>
                </button>
            </div>
        </div>
        <div class="tool-actions">
            <button class="tool-btn tool-btn-success" @onclick="Convert">
                <i class="bi bi-arrow-left-right" aria-hidden="true"></i> Convert
            </button>
        </div>
        <div class="tool-field">
            <label class="tool-label">Result (hh:mm:ss:fff)</label>
            <div class="conv-row">
                <input id="output" class="tool-input" @bind="Output" placeholder="hh:mm:ss:fff" readonly />
                <button class="tool-btn" @onclick="Copy" title="Copy">
                    <i class="bi bi-clipboard" aria-hidden="true"></i>
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    long Input = 60;
    string Output = string.Empty;

    void Convert() { Output = ConvertTime(Input); }
    void Clear() { Input = 0; }

    async Task Copy()
    {
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", Output);
    }

    static string ConvertTime(long seconds)
    {
        TimeSpan time = TimeSpan.FromSeconds(seconds);
        return time.ToString(@"hh\:mm\:ss\:fff");
    }
}