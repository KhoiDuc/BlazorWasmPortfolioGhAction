@page "/dev-learning"
@page "/{lang:regex(^(en|vn)$)}/dev-learning"
@page "/learning/dev-learning"
@page "/{lang:regex(^(en|vn)$)}/learning/dev-learning"
@page "/learning/dev-learning/{SeriesId}"
@page "/{lang:regex(^(en|vn)$)}/learning/dev-learning/{SeriesId}"
@page "/dev-learning/{SeriesId}"
@page "/{lang:regex(^(en|vn)$)}/dev-learning/{SeriesId}"
@page "/learning/dev-learning/{SeriesId}/{ArticleId}"
@page "/{lang:regex(^(en|vn)$)}/learning/dev-learning/{SeriesId}/{ArticleId}"
@page "/dev-learning/{SeriesId}/{ArticleId}"
@page "/{lang:regex(^(en|vn)$)}/dev-learning/{SeriesId}/{ArticleId}"
@inherits CultureAwareComponent
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Navigation
@using System.Text.Json
@using BlazorWasmPortfolioGhAction.Pages

<div class="dev-master-app">
    <div class="dev-wrapper">
        <LearningSubNav ActiveSection="dev-learning" />

        <!-- Top Hero Banner (Portfolio Midnight Gold / Crisp Slate Design System) -->
        <header class="dev-top-hero">
            <div class="dev-ambient-glow" aria-hidden="true"></div>
            <div class="dev-brand-row">
                <span class="dev-brand-pill">
                    <span class="dev-live-dot"></span> DEV LEARNING BLOG
                </span>
                <span class="dev-brand-pill outline">
                    LỘ TRÌNH TỪ CƠ BẢN ĐẾN NÂNG CAO
                </span>
                <button type="button" 
                        class="dev-brand-pill" 
                        style="cursor: pointer; background: rgba(245, 158, 11, 0.15); color: #f59e0b; border-color: #f59e0b;"
                        @onclick="() => ShowNewlyAddedTab()">
                    <i class="bi bi-sparkles"></i> @(CultureService.IsEnglish ? $"{NewlyAddedCount} Newly Added" : $"{NewlyAddedCount} Bài Mới Thêm")
                </button>
                @if (_bookmarkedIds.Count > 0)
                {
                    <button type="button" 
                            class="dev-brand-pill" 
                            style="cursor: pointer; background: rgba(250, 204, 21, 0.15); color: #facc15; border-color: #facc15;"
                            @onclick="() => ToggleBookmarkFilter()">
                        <i class="bi bi-bookmark-star-fill"></i> @(_showOnlyBookmarks ? (CultureService.IsEnglish ? "Show All Articles" : "Hiện Tất Cả Bài Viết") : $"{_bookmarkedIds.Count} {(CultureService.IsEnglish ? "Saved Articles" : "Bài Đã Lưu")}")
                    </button>
                }
                @if (_recentArticleIds.Count > 0)
                {
                    <button type="button" 
                            class="dev-brand-pill" 
                            style="cursor: pointer; background: rgba(56, 189, 248, 0.15); color: #38bdf8; border-color: #38bdf8;"
                            @onclick="() => ToggleRecentReadFilter()">
                        <i class="bi bi-clock-history"></i> @(_showOnlyRecentRead ? (CultureService.IsEnglish ? "Show All Series" : "Hiện Tất Cả Chuyên Đề") : $"{_recentArticleIds.Count} {(CultureService.IsEnglish ? "Recently Read" : "Đã Đọc Gần Đây")}")
                    </button>
                }
            </div>

            <h1 class="dev-title">
                @(CultureService.IsEnglish ? "Tech Blog & Engineering Roadmaps" : "Blog Kỹ Thuật & Chuyên Đề Thực Chiến")
            </h1>
            <p class="dev-subtitle">
                Hệ thống các <b>Chuyên đề công nghệ</b> chia theo từng bài viết Blog từ <b>Cơ bản &rarr; Trung cấp &rarr; Nâng cao &rarr; Thực chiến</b> cho <b>Khôi Nguyễn</b> · Đầy đủ lý thuyết nền tảng, kiến trúc hệ thống, file cấu hình và code mẫu thực tế.
            </p>

            @if (_data != null)
            {
                <div class="dev-stats-ticker">
                    <div class="dev-ticker-item">
                        <span class="dev-ticker-val">@_data.SeriesList.Count</span>
                        <span class="dev-ticker-lbl">Chuyên Đề</span>
                    </div>
                    <div class="dev-ticker-sep"></div>
                    <div class="dev-ticker-item">
                        <span class="dev-ticker-val">@TotalArticlesCount</span>
                        <span class="dev-ticker-lbl">Bài Viết Blog</span>
                    </div>
                    <div class="dev-ticker-sep"></div>
                    <div class="dev-ticker-item highlight">
                        <span class="dev-ticker-val">Cơ Bản &rarr; Nâng Cao</span>
                        <span class="dev-ticker-lbl">Lộ Trình Chuẩn</span>
                    </div>
                    <div class="dev-ticker-sep"></div>
                    <div class="dev-ticker-item highlight" style="cursor: pointer;" @onclick="() => ShowNewlyAddedTab()" title="Xem tất cả bài viết mới thêm gần đây">
                        <span class="dev-ticker-val" style="color: #f59e0b;"><i class="bi bi-sparkles"></i> @NewlyAddedCount</span>
                        <span class="dev-ticker-lbl">Mới Thêm Gần Đây</span>
                    </div>
                    <div class="dev-ticker-sep"></div>
                    <div class="dev-ticker-item">
                        <span class="dev-ticker-val">@_bookmarkedIds.Count</span>
                        <span class="dev-ticker-lbl">Bài Đã Lưu</span>
                    </div>
                    @if (_recentArticleIds.Count > 0)
                    {
                        <div class="dev-ticker-sep"></div>
                        <div class="dev-ticker-item" style="cursor: pointer;" @onclick="() => ToggleRecentReadFilter()" title="Xem danh sách bài viết đã đọc gần đây">
                            <span class="dev-ticker-val" style="color: #38bdf8;">@_recentArticleIds.Count</span>
                            <span class="dev-ticker-lbl">Đã Đọc Gần Đây</span>
                        </div>
                    }
                </div>
            }
        </header>


        @if (_isLoading)
        {
            <div style="text-align: center; padding: 4rem 1rem; color: var(--color-text-muted);">
                <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem; margin-bottom: 1rem;"></div>
                <p>Đang tải các chuyên đề bài viết kỹ thuật...</p>
            </div>
        }
        else if (_data == null || !_data.SeriesList.Any())
        {
            <div style="text-align: center; padding: 3rem 1rem; color: var(--color-text-muted); background: var(--color-bg-surface); border: 1px dashed var(--color-border); border-radius: var(--radius-xl, 1rem);">
                <i class="bi bi-journal-x" style="font-size: 2.5rem; display: block; margin-bottom: 0.5rem; color: var(--color-brand-symbol);"></i>
                <h5>Không tìm thấy dữ liệu bài viết</h5>
            </div>
        }
        else if (_activeArticle != null && _viewMode == ViewMode.Reader)
        {
            <!-- ========================================================================= -->
            <!-- MODE 2: SINGLE ARTICLE READER VIEW (Chi Tiết Bài Viết)                     -->
            <!-- ========================================================================= -->
            <div class="dev-article-reader-wrapper">
                <!-- Back Button & Breadcrumbs Bar -->
                <div class="dev-reader-top-action">
                    <button type="button" class="dev-back-to-feed-btn" @onclick="BackToFeed">
                        <i class="bi bi-arrow-left"></i>
                        <span>@(CultureService.IsEnglish ? "Back to Articles List" : $"Quay lại danh sách: {_selectedSeries?.TitleVi}")</span>
                    </button>

                    <nav class="dev-breadcrumb-nav" aria-label="Breadcrumb">
                        <span class="dev-bc-item">
                            <a href="@LangHref("")">Trang Chủ</a>
                        </span>
                        <i class="bi bi-chevron-right dev-bc-sep"></i>
                        <span class="dev-bc-item">
                            <a href="@GetDevLearningHomeUrl()">Dev Learning</a>
                        </span>
                        @if (_selectedSeries != null)
                        {
                            <i class="bi bi-chevron-right dev-bc-sep"></i>
                            <span class="dev-bc-item">
                                <a href="@GetSeriesUrl(_selectedSeries.Id)">@(CultureService.IsEnglish ? _selectedSeries.Title : _selectedSeries.TitleVi)</a>
                            </span>
                        }
                        <i class="bi bi-chevron-right dev-bc-sep"></i>
                        <span class="dev-bc-item active">@_activeArticle.LessonNumber</span>
                    </nav>
                </div>

                <div class="dev-blog-layout">
                    <!-- Left Column: Series Sidebar / Lesson List -->
                    <aside class="dev-series-sidebar">
                        <div class="dev-sidebar-sticky-card">
                            <div class="dev-sidebar-header">
                                <div class="dev-sidebar-series-badge" style="color: @(_selectedSeries?.Color ?? "#0284c7"); background: @(_selectedSeries?.Color ?? "#0284c7")18;">
                                    <i class="bi @(_selectedSeries?.Icon ?? "bi-collection-play-fill")"></i>
                                    <span>@(_selectedSeries?.Badge ?? "Chuyên Đề")</span>
                                </div>
                                <h3 class="dev-sidebar-title">
                                    @(CultureService.IsEnglish ? _selectedSeries?.Title : _selectedSeries?.TitleVi)
                                </h3>
                            </div>

                            <!-- Lessons in this series -->
                            <div class="dev-lesson-nav-list" role="navigation">
                                @foreach (var art in _selectedSeries?.Articles ?? new List<DevArticle>())
                                {
                                    var isCur = _activeArticle?.Id == art.Id;
                                    var isArtSaved = _bookmarkedIds.Contains(art.Id);

                                    <button type="button" 
                                            class="dev-lesson-item @(isCur ? "active" : "")"
                                            style="@(isCur ? $"--lesson-accent: {_selectedSeries?.Color ?? "#0284c7"};" : "")"
                                            @onclick="() => ReadArticle(art)">
                                        <div class="dev-lesson-meta-row">
                                            <span class="dev-level-tag @GetLevelCssClass(art.LevelOrder)">@art.LevelVi</span>
                                            <span class="dev-lesson-number-badge">@art.LessonNumber</span>
                                            @if (isArtSaved)
                                            {
                                                <i class="bi bi-bookmark-fill dev-saved-icon ms-auto" title="Đã lưu"></i>
                                            }
                                        </div>
                                        <div class="dev-lesson-title">
                                            @(CultureService.IsEnglish ? art.Title : art.TitleVi)
                                        </div>
                                    </button>
                                }
                            </div>
                        </div>
                    </aside>

                    <!-- Right Column: Full Article Body -->
                    <main class="dev-article-reader">
                        @{
                            var isCurArticleSaved = _activeArticle != null && _bookmarkedIds.Contains(_activeArticle.Id);
                        }
                        <article class="dev-article-card">
                            <header class="dev-article-main-header">
                                <!-- Top Metadata Row -->
                                <div class="dev-article-meta-bar">
                                    <span class="dev-level-badge-large @GetLevelCssClass(_activeArticle!.LevelOrder)">
                                        @GetLevelIcon(_activeArticle.LevelOrder) @_activeArticle.LevelVi
                                    </span>
                                    <span class="dev-series-tag" style="background: @(_selectedSeries?.Color ?? "#0284c7")18; color: @(_selectedSeries?.Color ?? "#0284c7"); border-color: @(_selectedSeries?.Color ?? "#0284c7")40;">
                                        @_activeArticle.LessonNumber
                                    </span>
                                    <span class="dev-meta-pill">
                                        <i class="bi bi-clock-history"></i> @_activeArticle.ReadingTime
                                    </span>
                                    <span class="dev-meta-pill">
                                        <i class="bi bi-calendar3"></i> @_activeArticle.PublishedDate
                                    </span>
                                    <span class="dev-meta-pill author">
                                        <i class="bi bi-person-circle"></i> Khôi Nguyễn · Senior Fullstack
                                    </span>
                                    <div class="dev-actions-group">
                                        <button type="button" 
                                                class="dev-bookmark-btn @(isCurArticleSaved ? "saved" : "")"
                                                title="@(isCurArticleSaved ? "Bỏ lưu bài viết" : "Lưu bài viết này")"
                                                @onclick="() => ToggleBookmark(_activeArticle.Id)">
                                            <i class="bi @(isCurArticleSaved ? "bi-bookmark-star-fill" : "bi-bookmark-plus")"></i>
                                            <span>@(isCurArticleSaved ? (CultureService.IsEnglish ? "Saved" : "Đã Lưu") : (CultureService.IsEnglish ? "Save" : "Lưu Bài"))</span>
                                        </button>
                                        <button type="button" 
                                                class="dev-share-btn @(_copiedShareUrl ? "copied" : "")"
                                                title="Sao chép link bài viết để chia sẻ"
                                                @onclick="ShareCurrentArticle">
                                            <i class="bi @(_copiedShareUrl ? "bi-check2-circle" : "bi-share-fill")"></i>
                                            <span>@(_copiedShareUrl ? (CultureService.IsEnglish ? "Copied Link!" : "Đã Chép Link!") : (CultureService.IsEnglish ? "Share Article" : "Chia Sẻ"))</span>
                                        </button>
                                    </div>
                                </div>

                                <!-- Article Main Title -->
                                <h1 class="dev-article-h1">
                                    @(CultureService.IsEnglish ? _activeArticle.Title : _activeArticle.TitleVi)
                                </h1>

                                <!-- Lead Summary Callout -->
                                <!-- Lead Summary Callout -->
                                <div class="dev-lead-summary">
                                    <div class="dev-lead-icon">
                                        <i class="bi bi-quote"></i>
                                    </div>
                                    <div class="dev-lead-text">
                                        @RenderFormattedText(CultureService.IsEnglish ? _activeArticle.Summary : _activeArticle.SummaryVi)
                                    </div>
                                </div>

                                <!-- Tags Cloud -->
                                <div class="dev-article-tags-row">
                                    <span class="dev-tags-label"><i class="bi bi-tags-fill"></i> Chủ đề:</span>
                                    @foreach (var tag in _activeArticle.Tags)
                                    {
                                        <span class="dev-article-tag">#@tag</span>
                                    }
                                </div>

                                <!-- Table of Contents Box -->
                                @if (_activeArticle.Sections.Count > 1)
                                {
                                    <div class="dev-article-toc-box">
                                        <div class="dev-toc-header">
                                            <i class="bi bi-list-nested"></i>
                                            <span>Mục Lục Bài Viết</span>
                                        </div>
                                        <ul class="dev-toc-list">
                                            @for (int i = 0; i < _activeArticle.Sections.Count; i++)
                                            {
                                                var sec = _activeArticle.Sections[i];
                                                var secTitle = CultureService.IsEnglish ? sec.Heading : sec.HeadingVi;
                                                <li>
                                                    <a href="@($"#section-{_activeArticle.Id}-{i}")">
                                                        <span class="dev-toc-num">@(i + 1).</span> @secTitle
                                                    </a>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                }
                            </header>

                            <!-- In-Depth Article Content Sections -->
                            <div class="dev-article-body">
                                @for (int i = 0; i < _activeArticle.Sections.Count; i++)
                                {
                                    var sec = _activeArticle.Sections[i];
                                    var secId = $"section-{_activeArticle.Id}-{i}";
                                    var paragraphs = CultureService.IsEnglish ? sec.Paragraphs : sec.ParagraphsVi;
                                    var isCodeCopied = _copiedCodeId == secId;

                                    <section class="dev-content-section" id="@secId">
                                        <h2 class="dev-section-heading">
                                            <span class="dev-section-anchor" aria-hidden="true">#</span>
                                            @(CultureService.IsEnglish ? sec.Heading : sec.HeadingVi)
                                        </h2>

                                        @foreach (var p in paragraphs)
                                        {
                                            @RenderFormattedText(p)
                                        }

                                        <!-- Code Block (macOS Terminal Style) -->
                                        @if (!string.IsNullOrWhiteSpace(sec.CodeContent))
                                        {
                                            <div class="dev-terminal-wrapper">
                                                <div class="dev-terminal-header">
                                                    <div class="dev-terminal-dots">
                                                        <span class="dev-tdot red"></span>
                                                        <span class="dev-tdot yellow"></span>
                                                        <span class="dev-tdot green"></span>
                                                    </div>
                                                    <div class="dev-terminal-title">
                                                        <span>@sec.CodeTitle</span>
                                                        <span class="dev-lang-pill">@sec.CodeLanguage</span>
                                                    </div>
                                                    <button type="button" 
                                                            class="dev-terminal-copy-btn @(isCodeCopied ? "copied" : "")"
                                                            title="Sao chép đoạn code"
                                                            @onclick="() => CopyCodeToClipboard(secId, sec.CodeContent)">
                                                        <i class="bi @(isCodeCopied ? "bi-check2 text-success" : "bi-clipboard")"></i>
                                                        <span>@(isCodeCopied ? "Đã Sao Chép!" : "Copy")</span>
                                                    </button>
                                                </div>
                                                <pre class="dev-terminal-code"><code class="language-@sec.CodeLanguage">@sec.CodeContent</code></pre>
                                            </div>
                                        }

                                        <!-- Callout Box (tip, warning, info) -->
                                        @if (!string.IsNullOrWhiteSpace(sec.CalloutType))
                                        {
                                            var cType = sec.CalloutType.ToLowerInvariant();
                                            var cTitle = CultureService.IsEnglish ? sec.CalloutTitle : sec.CalloutTitleVi;
                                            var cText = CultureService.IsEnglish ? sec.CalloutText : sec.CalloutTextVi;

                                            <div class="dev-callout-box @cType">
                                                <div class="dev-callout-icon">
                                                    @if (cType == "tip")
                                                    {
                                                        <i class="bi bi-lightbulb-fill"></i>
                                                    }
                                                    else if (cType == "warning")
                                                    {
                                                        <i class="bi bi-exclamation-triangle-fill"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-info-circle-fill"></i>
                                                    }
                                                </div>
                                                <div class="dev-callout-content">
                                                    <div class="dev-callout-title">@RenderFormattedText(cTitle)</div>
                                                    <div class="dev-callout-text">@RenderFormattedText(cText)</div>
                                                </div>
                                            </div>
                                        }
                                    </section>
                                }
                            </div>

                            <!-- Article Navigation Footer (Bài Trước & Bài Tiếp Theo) -->
                            <footer class="dev-article-footer-nav">
                                @if (PreviousArticle != null)
                                {
                                    var prevTitle = $"{PreviousArticle.LessonNumber}: {(CultureService.IsEnglish ? PreviousArticle.Title : PreviousArticle.TitleVi)}";
                                    <button type="button" 
                                            class="dev-nav-btn prev"
                                            title="@prevTitle"
                                            @onclick="() => ReadArticle(PreviousArticle)">
                                        <i class="bi bi-arrow-left"></i>
                                        <div class="dev-nav-btn-text">
                                            <span class="dev-nav-sub">Bài Trước · @PreviousArticle.LevelVi</span>
                                            <span class="dev-nav-main">@prevTitle</span>
                                        </div>
                                    </button>
                                }
                                else
                                {
                                    <div class="dev-nav-btn-placeholder"></div>
                                }

                                @if (NextArticle != null)
                                {
                                    var nextTitle = $"{NextArticle.LessonNumber}: {(CultureService.IsEnglish ? NextArticle.Title : NextArticle.TitleVi)}";
                                    <button type="button" 
                                            class="dev-nav-btn next"
                                            title="@nextTitle"
                                            @onclick="() => ReadArticle(NextArticle)">
                                        <div class="dev-nav-btn-text">
                                            <span class="dev-nav-sub">Bài Tiếp Theo · @NextArticle.LevelVi</span>
                                            <span class="dev-nav-main">@nextTitle</span>
                                        </div>
                                        <i class="bi bi-arrow-right"></i>
                                    </button>
                                }
                                else
                                {
                                    <div class="dev-nav-btn-placeholder"></div>
                                }
                            </footer>

                            <!-- Recommended & Recent Articles Section -->
                            <div class="dev-reader-recent-box">
                                <div class="dev-reader-recent-header">
                                    <div class="dev-reader-recent-title">
                                        <i class="bi bi-fire text-warning"></i>
                                        <span>@(CultureService.IsEnglish ? "Recent Articles & Next Reads" : "Bài Viết Gần Đây & Gợi Ý Đọc Tiếp")</span>
                                    </div>
                                    <button type="button" class="dev-reader-see-all-btn" @onclick="BackToCatalog">
                                        <span>@(CultureService.IsEnglish ? "All Series" : "Tất Cả Chuyên Đề")</span>
                                        <i class="bi bi-arrow-right"></i>
                                    </button>
                                </div>
                                <div class="dev-reader-recent-grid">
                                    @foreach (var recArt in GetRecommendedRecentArticles(3))
                                    {
                                        var rSeries = GetParentSeries(recArt.SeriesId);
                                        var sColor = rSeries?.Color ?? "#0284c7";
                                        <div class="dev-reader-rec-card" style="--rec-accent: @sColor;" @onclick="() => ReadArticle(recArt)">
                                            <div class="dev-reader-rec-series">
                                                <i class="bi @(rSeries?.Icon ?? "bi-box-seam")"></i>
                                                <span>@(CultureService.IsEnglish ? rSeries?.Title : rSeries?.TitleVi)</span>
                                            </div>
                                            <h5 class="dev-reader-rec-title">
                                                @(CultureService.IsEnglish ? recArt.Title : recArt.TitleVi)
                                            </h5>
                                            <div class="dev-reader-rec-footer">
                                                <span class="dev-reader-rec-level @GetLevelCssClass(recArt.LevelOrder)">@recArt.LessonNumber · @recArt.LevelVi</span>
                                                <span class="dev-reader-rec-action">@(CultureService.IsEnglish ? "Read" : "Đọc tiếp") <i class="bi bi-arrow-right"></i></span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </article>
                    </main>
                </div>
            </div>
        }
        else if (_viewMode == ViewMode.Feed && (_selectedSeries != null || _showOnlyBookmarks || _showOnlyRecentRead))
        {
            <!-- ========================================================================= -->
            <!-- MODE 1: BLOG POSTS LIST / FEED VIEW (Danh Sách Bài Viết Theo Chuyên Đề)   -->
            <!-- ========================================================================= -->
            <section class="dev-series-feed-section">
                <!-- Feed Top Navigation Bar (Back to Catalog + Series Dropdown Switcher) -->
                <div class="dev-feed-top-nav">
                    <div class="dev-feed-nav-left">
                        <button type="button" class="dev-feed-back-btn" @onclick="BackToCatalog">
                            <i class="bi bi-grid-fill"></i>
                            <span>@(CultureService.IsEnglish ? "All Series Catalog" : "Tất Cả Chuyên Đề")</span>
                        </button>
                        <i class="bi bi-chevron-right dev-feed-bc-sep"></i>
                        <span class="dev-feed-bc-current">
                            @if (_showOnlyBookmarks)
                            {
                                @(CultureService.IsEnglish ? "Saved Articles" : "Bài Viết Đã Lưu")
                            }
                            else if (_showOnlyRecentRead)
                            {
                                @(CultureService.IsEnglish ? "Recently Read Articles" : "Bài Viết Đã Đọc Gần Đây")
                            }
                            else
                            {
                                @(CultureService.IsEnglish ? _selectedSeries?.Title : _selectedSeries?.TitleVi)
                            }
                        </span>
                    </div>

                    @if (!_showOnlyBookmarks && !_showOnlyRecentRead && _data?.SeriesList != null)
                    {
                        <div class="dev-feed-switcher-wrap">
                            <label class="dev-feed-switcher-label">
                                <i class="bi bi-arrow-left-right"></i>
                                <span>@(CultureService.IsEnglish ? "Switch Series:" : "Đổi Chuyên Đề:")</span>
                            </label>
                            <select class="dev-feed-select" value="@_selectedSeries?.Id" @onchange="OnSeriesDropdownChanged">
                                @foreach (var s in _data.SeriesList)
                                {
                                    <option value="@s.Id">@(CultureService.IsEnglish ? s.Title : s.TitleVi) (@s.Articles.Count)</option>
                                }
                            </select>
                        </div>
                    }
                </div>

                <!-- Chuyên Đề Header Card -->
                <div class="dev-feed-series-banner" style="--banner-accent: @(_showOnlyBookmarks ? "#facc15" : (_showOnlyRecentRead ? "#38bdf8" : (_selectedSeries?.Color ?? "#0284c7")));">
                    <div class="dev-feed-banner-content">
                        <div class="dev-feed-banner-badge-row">
                            <div class="dev-feed-banner-badge">
                                <i class="bi @(_showOnlyBookmarks ? "bi-bookmark-star-fill" : (_showOnlyRecentRead ? "bi-clock-history" : (_selectedSeries?.Icon ?? "bi-box-seam-fill")))"></i>
                                <span>@(_showOnlyBookmarks ? (CultureService.IsEnglish ? "Bookmarks" : "Bộ Sưu Tập") : (_showOnlyRecentRead ? (CultureService.IsEnglish ? "Reading History" : "Lịch Sử Đọc") : (_selectedSeries?.Badge ?? "Chuyên Đề")))</span>
                            </div>
                            @if (_selectedSeries != null && !_showOnlyBookmarks && !_showOnlyRecentRead)
                            {
                                <button type="button" 
                                        class="dev-share-btn @(_copiedSeriesUrl ? "copied" : "")"
                                        title="Sao chép link chuyên đề này để chia sẻ"
                                        @onclick="ShareCurrentSeries">
                                    <i class="bi @(_copiedSeriesUrl ? "bi-check2-circle" : "bi-share-fill")"></i>
                                    <span>@(_copiedSeriesUrl ? (CultureService.IsEnglish ? "Copied Series Link!" : "Đã Chép Link Chuyên Đề!") : (CultureService.IsEnglish ? "Share Series" : "Chia Sẻ Chuyên Đề"))</span>
                                </button>
                            }
                            @if (_showOnlyRecentRead)
                            {
                                <button type="button" 
                                        class="dev-share-btn"
                                        style="border-color: rgba(239, 68, 68, 0.4); color: #ef4444;"
                                        title="Xóa toàn bộ lịch sử đọc"
                                        @onclick="ClearRecentHistory">
                                    <i class="bi bi-trash3"></i>
                                    <span>@(CultureService.IsEnglish ? "Clear History" : "Xóa Lịch Sử Đọc")</span>
                                </button>
                            }
                        </div>
                        <h2 class="dev-feed-series-title">
                            @if (_showOnlyBookmarks)
                            {
                                @(CultureService.IsEnglish ? "Saved Articles Collection" : "Bộ Sưu Tập Bài Viết Đã Lưu")
                            }
                            else if (_showOnlyRecentRead)
                            {
                                @(CultureService.IsEnglish ? "Recently Read Articles" : "Lịch Sử Các Bài Viết Đã Đọc Gần Đây")
                            }
                            else
                            {
                                @(CultureService.IsEnglish ? _selectedSeries?.Title : _selectedSeries?.TitleVi)
                            }
                        </h2>
                        <p class="dev-feed-series-desc">
                            @if (_showOnlyBookmarks)
                            {
                                @(CultureService.IsEnglish ? "Here are all the technical lessons you bookmarked for offline review and quick practice." : "Tổng hợp toàn bộ các bài viết kỹ thuật bạn đã đánh dấu lưu lại để tiện tra cứu và thực hành.")
                            }
                            else if (_showOnlyRecentRead)
                            {
                                @(CultureService.IsEnglish ? "Review technical articles you have read recently or pick up right where you left off." : "Xem lại các bài viết kỹ thuật bạn đã đọc gần đây hoặc tiếp tục nội dung đang theo dõi.")
                            }
                            else
                            {
                                @(CultureService.IsEnglish ? _selectedSeries?.Description : _selectedSeries?.DescriptionVi)
                            }
                        </p>
                    </div>
                </div>

                <!-- Toolbar: Lọc Cấp Độ (Cơ bản -> Nâng cao) & Ô Tìm Kiếm -->
                <div class="dev-feed-toolbar">
                    <div class="dev-level-filter-chips">
                        <button type="button" 
                                class="dev-level-chip @(_selectedLevelFilter == null ? "active" : "")"
                                @onclick="() => _selectedLevelFilter = null">
                            <span>Tất Cả Bài Viết</span>
                            <span class="dev-level-count">@(_showOnlyBookmarks ? _bookmarkedIds.Count : (_showOnlyRecentRead ? _recentArticleIds.Count : (_selectedSeries?.Articles.Count ?? 0)))</span>
                        </button>
                        <button type="button" 
                                class="dev-level-chip level-1 @(_selectedLevelFilter == 1 ? "active" : "")"
                                @onclick="() => _selectedLevelFilter = 1">
                            <span>🌱 Cơ Bản</span>
                            <span class="dev-level-count">@CountArticlesByLevel(1)</span>
                        </button>
                        <button type="button" 
                                class="dev-level-chip level-2 @(_selectedLevelFilter == 2 ? "active" : "")"
                                @onclick="() => _selectedLevelFilter = 2">
                            <span>⚡ Trung Cấp</span>
                            <span class="dev-level-count">@CountArticlesByLevel(2)</span>
                        </button>
                        <button type="button" 
                                class="dev-level-chip level-3 @(_selectedLevelFilter == 3 ? "active" : "")"
                                @onclick="() => _selectedLevelFilter = 3">
                            <span>🔥 Nâng Cao</span>
                            <span class="dev-level-count">@CountArticlesByLevel(3)</span>
                        </button>
                        <button type="button" 
                                class="dev-level-chip level-4 @(_selectedLevelFilter == 4 ? "active" : "")"
                                @onclick="() => _selectedLevelFilter = 4">
                            <span>🚀 Thực Chiến</span>
                            <span class="dev-level-count">@CountArticlesByLevel(4)</span>
                        </button>
                    </div>

                    <div class="dev-feed-search-box">
                        <i class="bi bi-search"></i>
                        <input type="text" 
                               placeholder="@(CultureService.IsEnglish ? "Search articles in this feed..." : "Tìm bài viết trong danh sách này...")" 
                               @bind="_searchTerm" 
                               @bind:event="oninput" />
                    </div>
                </div>

                <!-- Blog Articles Grid / Cards -->
                @if (!FilteredArticles.Any())
                {
                    <div class="dev-empty-feed">
                        <i class="bi bi-search"></i>
                        <h5>Không tìm thấy bài viết nào phù hợp</h5>
                        <p>Thử chọn cấp độ khác hoặc xóa từ khóa tìm kiếm.</p>
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="ClearFilters">
                            Xem tất cả bài viết
                        </button>
                    </div>
                }
                else
                {
                    <div class="dev-articles-grid">
                        @foreach (var article in FilteredArticles)
                        {
                            var isSaved = _bookmarkedIds.Contains(article.Id);
                            var parentS = GetParentSeries(article.SeriesId);
                            var postAccentColor = (_showOnlyBookmarks || _showOnlyRecentRead) ? (parentS?.Color ?? "#0284c7") : (_selectedSeries?.Color ?? "#0284c7");

                            <div class="dev-article-post-card" style="--post-accent: @postAccentColor;">
                                <div class="dev-post-card-top">
                                    @if (_showOnlyBookmarks || _showOnlyRecentRead)
                                    {
                                        if (parentS != null)
                                        {
                                            <span class="dev-recent-series-tag" 
                                                  style="cursor: pointer;"
                                                  @onclick="() => SelectSeries(parentS)"
                                                  @onclick:stopPropagation="true"
                                                  title="Xem chuyên đề: @(CultureService.IsEnglish ? parentS.Title : parentS.TitleVi)">
                                                <i class="bi @parentS.Icon"></i>
                                                @(CultureService.IsEnglish ? parentS.Badge : parentS.Badge)
                                            </span>
                                        }
                                    }
                                    <span class="dev-level-badge @GetLevelCssClass(article.LevelOrder)">
                                        @GetLevelIcon(article.LevelOrder) @article.LevelVi
                                    </span>
                                    <span class="dev-post-lesson-pill">@article.LessonNumber</span>
                                    <div class="dev-post-card-actions">
                                        <button type="button" 
                                                class="dev-post-card-bookmark @(_copiedArticleCardId == article.Id ? "copied" : "")"
                                                title="Sao chép link bài viết"
                                                @onclick="() => ShareSpecificArticle(article)"
                                                @onclick:stopPropagation="true">
                                            <i class="bi @(_copiedArticleCardId == article.Id ? "bi-check2" : "bi-share")"></i>
                                        </button>
                                        <button type="button" 
                                                class="dev-post-card-bookmark @(isSaved ? "saved" : "")"
                                                title="@(isSaved ? "Bỏ lưu bài viết" : "Lưu bài viết này")"
                                                @onclick="() => ToggleBookmark(article.Id)"
                                                @onclick:stopPropagation="true">
                                            <i class="bi @(isSaved ? "bi-bookmark-star-fill" : "bi-bookmark")"></i>
                                        </button>
                                    </div>
                                </div>

                                <h3 class="dev-post-card-title" @onclick="() => ReadArticle(article)">
                                    @(CultureService.IsEnglish ? article.Title : article.TitleVi)
                                </h3>

                                <p class="dev-post-card-summary">
                                    @(CultureService.IsEnglish ? article.Summary : article.SummaryVi)
                                </p>

                                <div class="dev-post-tags">
                                    @foreach (var tag in article.Tags.Take(3))
                                    {
                                        <span class="dev-post-tag">#@tag</span>
                                    }
                                </div>

                                <div class="dev-post-card-footer">
                                    <div class="dev-post-meta">
                                        <span><i class="bi bi-clock"></i> @article.ReadingTime</span>
                                        <span><i class="bi bi-calendar3"></i> @article.PublishedDate</span>
                                    </div>

                                    <button type="button" 
                                            class="dev-post-read-btn" 
                                            @onclick="() => ReadArticle(article)">
                                        <span>Đọc Bài Viết</span>
                                        <i class="bi bi-arrow-right"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>
        }
        else
        {
            <!-- ========================================================================= -->
            <!-- MODE 3: SERIES CATALOG DASHBOARD (Showcase Tất Cả 16+ Chuyên Đề)          -->
            <!-- ========================================================================= -->
            <section class="dev-catalog-section">
                <!-- Catalog Toolbar: Search + Category Chips -->
                <div class="dev-catalog-toolbar">
                    <div class="dev-catalog-search-wrap">
                        <i class="bi bi-search dev-catalog-search-icon"></i>
                        <input type="text" 
                               class="dev-catalog-search-input" 
                               placeholder="@(CultureService.IsEnglish ? "Search series by title, tech stack (Docker, .NET, AWS, AI, JWT...), or keyword..." : "Tìm kiếm chuyên đề theo tên, công nghệ (Docker, .NET, AWS, AI, JWT...) hoặc nội dung...")"
                               @bind="_catalogSearch" 
                               @bind:event="oninput" />
                        @if (!string.IsNullOrEmpty(_catalogSearch))
                        {
                            <button type="button" class="dev-catalog-clear-btn" @onclick="() => _catalogSearch = string.Empty" title="Xóa tìm kiếm">
                                <i class="bi bi-x-circle-fill"></i>
                            </button>
                        }
                    </div>

                    <div class="dev-catalog-chips">
                        <button type="button" 
                                class="dev-catalog-chip @(_selectedCatalogCategory == "all" ? "active" : "")"
                                @onclick='() => _selectedCatalogCategory = "all"'>
                            <span>@(CultureService.IsEnglish ? "All Series" : "Tất Cả Chuyên Đề")</span>
                            <span class="dev-catalog-chip-badge">@GetCategoryCount("all")</span>
                        </button>
                        <button type="button" 
                                class="dev-catalog-chip @(_selectedCatalogCategory == "devops" ? "active" : "")"
                                @onclick='() => _selectedCatalogCategory = "devops"'>
                            <span>🐳 @GetCategoryLabel("devops")</span>
                            <span class="dev-catalog-chip-badge">@GetCategoryCount("devops")</span>
                        </button>
                        <button type="button" 
                                class="dev-catalog-chip @(_selectedCatalogCategory == "backend" ? "active" : "")"
                                @onclick='() => _selectedCatalogCategory = "backend"'>
                            <span>⚡ @GetCategoryLabel("backend")</span>
                            <span class="dev-catalog-chip-badge">@GetCategoryCount("backend")</span>
                        </button>
                        <button type="button" 
                                class="dev-catalog-chip @(_selectedCatalogCategory == "cloud" ? "active" : "")"
                                @onclick='() => _selectedCatalogCategory = "cloud"'>
                            <span>☁️ @GetCategoryLabel("cloud")</span>
                            <span class="dev-catalog-chip-badge">@GetCategoryCount("cloud")</span>
                        </button>
                        <button type="button" 
                                class="dev-catalog-chip @(_selectedCatalogCategory == "ai" ? "active" : "")"
                                @onclick='() => _selectedCatalogCategory = "ai"'>
                            <span>🤖 @GetCategoryLabel("ai")</span>
                            <span class="dev-catalog-chip-badge">@GetCategoryCount("ai")</span>
                        </button>
                        <button type="button" 
                                class="dev-catalog-chip @(_selectedCatalogCategory == "standards" ? "active" : "")"
                                @onclick='() => _selectedCatalogCategory = "standards"'>
                            <span>🎯 @GetCategoryLabel("standards")</span>
                            <span class="dev-catalog-chip-badge">@GetCategoryCount("standards")</span>
                        </button>
                        <button type="button" 
                                class="dev-catalog-chip recent-highlight @(_selectedCatalogCategory == "recent" ? "active" : "")"
                                style="@(_selectedCatalogCategory == "recent" ? "background: #f59e0b; border-color: #f59e0b; color: #fff; box-shadow: 0 4px 14px rgba(245, 158, 11, 0.4);" : "")"
                                @onclick='() => _selectedCatalogCategory = "recent"'>
                            <span>✨ @(CultureService.IsEnglish ? "Newly Added Articles" : "Bài Viết Mới Thêm")</span>
                            <span class="dev-catalog-chip-badge">@NewlyAddedCount</span>
                        </button>
                    </div>
                </div>

                <!-- Tiếp tục đọc / Đã xem gần đây Shelf -->
                @if (_selectedCatalogCategory == "all" && _recentArticleIds.Count > 0 && string.IsNullOrWhiteSpace(_catalogSearch))
                {
                    <div class="dev-recently-viewed-shelf">
                        <div class="dev-shelf-header">
                            <div class="dev-shelf-title-wrap">
                                <span class="dev-shelf-icon"><i class="bi bi-clock-history"></i></span>
                                <div>
                                    <h4 class="dev-shelf-title">@(CultureService.IsEnglish ? "Continue Reading / Recently Viewed" : "Tiếp Tục Đọc / Đã Xem Gần Đây")</h4>
                                    <p class="dev-shelf-subtitle">@(CultureService.IsEnglish ? "Pick up where you left off from your recent study sessions" : "Tiếp tục bài viết bạn đang đọc dở hoặc xem lại các nội dung vừa tra cứu")</p>
                                </div>
                            </div>
                            <div class="dev-shelf-actions">
                                <button type="button" class="dev-shelf-btn-viewall" @onclick="ToggleRecentReadFilter">
                                    <span>@(CultureService.IsEnglish ? $"View All ({_recentArticleIds.Count})" : $"Xem Tất Cả ({_recentArticleIds.Count})")</span>
                                    <i class="bi bi-arrow-right"></i>
                                </button>
                                <button type="button" class="dev-shelf-btn-clear" @onclick="ClearRecentHistory" title="Xóa lịch sử bài đọc gần đây">
                                    <i class="bi bi-x-circle"></i>
                                    <span>@(CultureService.IsEnglish ? "Clear" : "Xóa")</span>
                                </button>
                            </div>
                        </div>

                        <div class="dev-shelf-cards">
                            @foreach (var art in GetRecentlyViewedArticles(6))
                            {
                                var pSeries = GetParentSeries(art.SeriesId);
                                var color = pSeries?.Color ?? "#0284c7";
                                <div class="dev-shelf-card" style="--shelf-accent: @color;" @onclick="() => ReadArticle(art)">
                                    <div class="dev-shelf-card-badge">
                                        <span class="dev-shelf-series-name">
                                            <i class="bi @(pSeries?.Icon ?? "bi-journal-text")"></i>
                                            @(CultureService.IsEnglish ? pSeries?.Badge ?? "Chuyên Đề" : pSeries?.Badge ?? "Chuyên Đề")
                                        </span>
                                        <span class="dev-shelf-lesson-pill">@art.LessonNumber</span>
                                    </div>
                                    <h5 class="dev-shelf-card-title">
                                        @(CultureService.IsEnglish ? art.Title : art.TitleVi)
                                    </h5>
                                    <div class="dev-shelf-card-meta">
                                        <span class="dev-shelf-level @GetLevelCssClass(art.LevelOrder)">@art.LevelVi</span>
                                        <span class="dev-shelf-time"><i class="bi bi-clock"></i> @art.ReadingTime</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (_selectedCatalogCategory == "recent")
                {
                    <!-- Recent / Latest Articles Grid -->
                    @if (!FilteredRecentArticles.Any())
                    {
                        <div class="dev-empty-feed">
                            <i class="bi bi-search"></i>
                            <h5>@(CultureService.IsEnglish ? "No matching articles found" : "Không tìm thấy bài viết nào phù hợp")</h5>
                            <p>@(CultureService.IsEnglish ? "Try clearing search keywords." : "Thử xóa từ khóa tìm kiếm để xem các bài viết mới nhất.")</p>
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="ClearCatalogFilters">
                                @(CultureService.IsEnglish ? "Show All Recent Articles" : "Xem tất cả bài viết mới nhất")
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="dev-recent-articles-grid">
                            @foreach (var article in FilteredRecentArticles)
                            {
                                var parentSeries = GetParentSeries(article.SeriesId);
                                var seriesColor = parentSeries?.Color ?? "#0284c7";
                                var isSaved = _bookmarkedIds.Contains(article.Id);

                                <div class="dev-article-post-card dev-recent-post-card" style="--post-accent: @seriesColor;">
                                    <div class="dev-post-card-top">
                                        @if (parentSeries != null)
                                        {
                                            <span class="dev-recent-series-tag" 
                                                  @onclick="() => SelectSeries(parentSeries)"
                                                  @onclick:stopPropagation="true">
                                                <i class="bi @parentSeries.Icon"></i>
                                                @(CultureService.IsEnglish ? parentSeries.Title : parentSeries.TitleVi)
                                            </span>
                                        }
                                        <span class="dev-level-badge @GetLevelCssClass(article.LevelOrder)">
                                            @GetLevelIcon(article.LevelOrder) @article.LevelVi
                                        </span>
                                        <div class="dev-post-card-actions">
                                            <button type="button" 
                                                    class="dev-post-card-bookmark @(_copiedArticleCardId == article.Id ? "copied" : "")"
                                                    title="Sao chép link bài viết"
                                                    @onclick="() => ShareSpecificArticle(article)"
                                                    @onclick:stopPropagation="true">
                                                <i class="bi @(_copiedArticleCardId == article.Id ? "bi-check2" : "bi-share")"></i>
                                            </button>
                                            <button type="button" 
                                                    class="dev-post-card-bookmark @(isSaved ? "saved" : "")"
                                                    title="@(isSaved ? "Bỏ lưu bài viết" : "Lưu bài viết này")"
                                                    @onclick="() => ToggleBookmark(article.Id)"
                                                    @onclick:stopPropagation="true">
                                                <i class="bi @(isSaved ? "bi-bookmark-star-fill" : "bi-bookmark")"></i>
                                            </button>
                                        </div>
                                    </div>

                                    <div class="dev-recent-lesson-bar">
                                        <span class="dev-post-lesson-pill">@article.LessonNumber</span>
                                        <span class="dev-recent-date-badge"><i class="bi bi-clock-history"></i> @article.PublishedDate</span>
                                    </div>

                                    <h3 class="dev-post-card-title" @onclick="() => ReadArticle(article)">
                                        @(CultureService.IsEnglish ? article.Title : article.TitleVi)
                                    </h3>

                                    <p class="dev-post-card-summary">
                                        @(CultureService.IsEnglish ? article.Summary : article.SummaryVi)
                                    </p>

                                    <div class="dev-post-tags">
                                        @foreach (var tag in article.Tags.Take(3))
                                        {
                                            <span class="dev-post-tag">#@tag</span>
                                        }
                                    </div>

                                    <div class="dev-post-card-footer">
                                        <div class="dev-post-meta">
                                            <span><i class="bi bi-clock"></i> @article.ReadingTime</span>
                                            <span><i class="bi bi-calendar3"></i> @article.PublishedDate</span>
                                        </div>

                                        <button type="button" 
                                                class="dev-post-read-btn" 
                                                @onclick="() => ReadArticle(article)">
                                            <span>@(CultureService.IsEnglish ? "Read Article" : "Đọc Bài Viết")</span>
                                            <i class="bi bi-arrow-right"></i>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    @if (_selectedCatalogCategory == "all" && string.IsNullOrWhiteSpace(_catalogSearch))
                    {
                        <!-- SECTION: BÀI VIẾT MỚI THÊM GẦN ĐÂY -->
                        <section class="dev-newly-added-section">
                            <div class="dev-newly-added-header">
                                <div class="dev-newly-added-title-wrap">
                                    <span class="dev-new-sparkle-icon"><i class="bi bi-sparkles"></i></span>
                                    <div>
                                        <div class="dev-newly-added-title-row">
                                            <h3 class="dev-newly-added-title">@(CultureService.IsEnglish ? "Newly Added Articles" : "Bài Viết Mới Thêm Gần Đây")</h3>
                                            <span class="dev-new-badge-pill">MỚI</span>
                                        </div>
                                        <p class="dev-newly-added-subtitle">
                                            @(CultureService.IsEnglish ? "Explore the latest engineering posts and production lessons published recently" : "Các bài viết kỹ thuật, kiến trúc và lộ trình thực chiến mới nhất vừa được bổ sung vào hệ thống")
                                        </p>
                                    </div>
                                </div>
                                <button type="button" 
                                        class="dev-view-all-new-btn"
                                        @onclick='() => ShowNewlyAddedTab()'>
                                    <span>@(CultureService.IsEnglish ? $"View All ({NewlyAddedCount})" : $"Xem Tất Cả ({NewlyAddedCount} Bài)")</span>
                                    <i class="bi bi-arrow-right"></i>
                                </button>
                            </div>

                            <div class="dev-newly-added-grid">
                                @foreach (var art in GetNewlyAddedArticles(6))
                                {
                                    var pSeries = GetParentSeries(art.SeriesId);
                                    var cardColor = pSeries?.Color ?? "#0284c7";

                                    <div class="dev-new-post-card" style="--card-accent: @cardColor;">
                                        <div class="dev-new-card-top">
                                            @if (pSeries != null)
                                            {
                                                <span class="dev-recent-series-tag" 
                                                      @onclick="() => SelectSeries(pSeries)"
                                                      @onclick:stopPropagation="true">
                                                    <i class="bi @pSeries.Icon"></i>
                                                    @(CultureService.IsEnglish ? pSeries.Title : pSeries.TitleVi)
                                                </span>
                                            }
                                            <span class="dev-badge-new-shine">
                                                <i class="bi bi-stars"></i> @art.PublishedDate
                                            </span>
                                        </div>

                                        <div class="dev-new-card-mid">
                                            <span class="dev-level-badge @GetLevelCssClass(art.LevelOrder)">
                                                @GetLevelIcon(art.LevelOrder) @art.LevelVi
                                            </span>
                                            <span class="dev-post-lesson-pill">@art.LessonNumber</span>
                                        </div>

                                        <h4 class="dev-new-card-title" @onclick="() => ReadArticle(art)">
                                            @(CultureService.IsEnglish ? art.Title : art.TitleVi)
                                        </h4>

                                        <p class="dev-new-card-summary">
                                            @(CultureService.IsEnglish ? art.Summary : art.SummaryVi)
                                        </p>

                                        <div class="dev-post-tags">
                                            @foreach (var tag in art.Tags.Take(3))
                                            {
                                                <span class="dev-post-tag">#@tag</span>
                                            }
                                        </div>

                                        <div class="dev-new-card-footer">
                                            <span class="dev-post-meta-item"><i class="bi bi-clock"></i> @art.ReadingTime</span>
                                            <button type="button" 
                                                    class="dev-post-read-btn" 
                                                    @onclick="() => ReadArticle(art)">
                                                <span>@(CultureService.IsEnglish ? "Read Now" : "Đọc Ngay")</span>
                                                <i class="bi bi-arrow-right"></i>
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        </section>

                        <!-- Header phân mục chuyên đề -->
                        <div class="dev-catalog-section-divider">
                            <div class="dev-divider-title">
                                <i class="bi bi-collection-play-fill text-primary"></i>
                                <span>@(CultureService.IsEnglish ? "All Learning Series & Tracks" : "Tất Cả Chuyên Đề & Lộ Trình Học Tập")</span>
                            </div>
                            <span class="dev-divider-count">@FilteredCatalogSeries.Count() Chuyên Đề</span>
                        </div>
                    }

                    <div class="dev-catalog-grid">
                        @foreach (var s in FilteredCatalogSeries)
                        {
                            var isCopied = _copiedCatalogSeriesId == s.Id;
                            var catKey = GetSeriesCategory(s.Id);
                            var catLabel = GetCategoryLabel(catKey);
                            var cardColor = !string.IsNullOrWhiteSpace(s.Color) ? s.Color : "#0284c7";
                            var cardIcon = !string.IsNullOrWhiteSpace(s.Icon) ? s.Icon : "bi-journal-code";
                            var iconBg = cardColor.StartsWith("#") && cardColor.Length == 7 ? $"{cardColor}18" : "rgba(2, 132, 199, 0.12)";

                            <div class="dev-catalog-card" style="--card-accent: @cardColor; --icon-bg: @iconBg;">
                                <div class="dev-catalog-accent-stripe"></div>

                                <div class="dev-catalog-card-header">
                                    <div class="dev-catalog-icon-box">
                                        <i class="bi @cardIcon"></i>
                                    </div>
                                    <div class="dev-catalog-badge-group">
                                        <span class="dev-catalog-cat-pill">@catLabel</span>
                                        <span class="dev-catalog-count-pill">@(s.Articles?.Count ?? 0) Bài</span>
                                    </div>
                                </div>

                                <h3 class="dev-catalog-card-title" @onclick="() => SelectSeries(s)">
                                    @(CultureService.IsEnglish ? s.Title : s.TitleVi)
                                </h3>

                                <p class="dev-catalog-card-desc">
                                    @(CultureService.IsEnglish ? s.Description : s.DescriptionVi)
                                </p>

                                <!-- Preview Lessons Box -->
                                @if (s.Articles != null && s.Articles.Count > 0)
                                {
                                    <div class="dev-catalog-lessons-box">
                                        <div class="dev-catalog-lessons-header">
                                            <span>@(CultureService.IsEnglish ? "Featured Lessons" : "Lộ Trình Bài Học")</span>
                                            <span>@s.Articles.Count Bài</span>
                                        </div>
                                        <ul class="dev-catalog-lessons-list">
                                            @foreach (var art in s.Articles.Take(3))
                                            {
                                                var lessonLabel = !string.IsNullOrWhiteSpace(art.LessonNumber) ? art.LessonNumber : $"Bài {s.Articles.IndexOf(art) + 1}";
                                                <li class="dev-catalog-preview-item" 
                                                    title="@(CultureService.IsEnglish ? art.Title : art.TitleVi)"
                                                    @onclick="() => ReadArticle(art)">
                                                    <span class="dev-catalog-lesson-num">@lessonLabel:</span>
                                                    <span class="dev-catalog-lesson-name">@(CultureService.IsEnglish ? art.Title : art.TitleVi)</span>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                }

                                <!-- Card Footer with Action Buttons -->
                                <div class="dev-catalog-card-footer">
                                    <button type="button" 
                                            class="dev-catalog-share-btn @(isCopied ? "copied" : "")"
                                            title="@(CultureService.IsEnglish ? "Copy link to this series" : "Sao chép link chuyên đề này")"
                                            @onclick="() => ShareCatalogSeries(s)">
                                        <i class="bi @(isCopied ? "bi-check2" : "bi-share")"></i>
                                    </button>

                                    <button type="button" 
                                            class="dev-catalog-explore-btn"
                                            @onclick="() => SelectSeries(s)">
                                        <span>@(CultureService.IsEnglish ? "Explore Series" : "Khám Phá Chuyên Đề")</span>
                                        <i class="bi bi-arrow-right"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
                }
            </section>
        }
    </div>
</div>

@code {
    private enum ViewMode { Catalog, Feed, Reader }

    [Parameter] public string? SeriesId { get; set; }
    [Parameter] public string? ArticleId { get; set; }

    private DevBlogData? _data;
    private bool _isLoading = true;
    private DevSeries? _selectedSeries;
    private DevArticle? _activeArticle;
    private ViewMode _viewMode = ViewMode.Catalog;
    private int? _selectedLevelFilter = null;
    private string _searchTerm = "";
    private bool _showOnlyBookmarks = false;
    private bool _showOnlyRecentRead = false;
    private string? _copiedCodeId = null;

    private string _catalogSearch = "";
    private string _selectedCatalogCategory = "all";
    private string? _copiedCatalogSeriesId = null;

    private string? _lastAppliedSeriesId;
    private string? _lastAppliedArticleId;
    private bool _copiedShareUrl = false;
    private bool _copiedSeriesUrl = false;
    private string? _copiedArticleCardId = null;

    private HashSet<string> _bookmarkedIds = new();
    private List<string> _recentArticleIds = new();

    private static readonly JsonSerializerOptions _jsonOpts = new()
    {
        PropertyNameCaseInsensitive = true
    };

    private string GetDevLearningHomeUrl() =>
        CulturePath.Combine(CultureService.UrlLang, "learning/dev-learning");

    private string GetSeriesUrl(string seriesId) =>
        CulturePath.Combine(CultureService.UrlLang, $"learning/dev-learning/{seriesId}");

    private string GetArticleUrl(string seriesId, string articleId) =>
        CulturePath.Combine(CultureService.UrlLang, $"learning/dev-learning/{seriesId}/{articleId}");

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _data = await Http.GetFromJsonAsync<DevBlogData>("sample-data/dev-learning.json", _jsonOpts);
            ApplyRouteParameters();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading dev-learning.json: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    protected override void OnParametersSet()
    {
        if (_data != null)
        {
            ApplyRouteParameters();
        }
    }

    private void ApplyRouteParameters()
    {
        if (_data == null || _data.SeriesList == null || _data.SeriesList.Count == 0) return;

        if (string.Equals(SeriesId, _lastAppliedSeriesId, StringComparison.OrdinalIgnoreCase) &&
            string.Equals(ArticleId, _lastAppliedArticleId, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _lastAppliedSeriesId = SeriesId;
        _lastAppliedArticleId = ArticleId;

        if (!string.IsNullOrEmpty(ArticleId))
        {
            var matchedArticle = _data.SeriesList
                .SelectMany(s => s.Articles)
                .FirstOrDefault(a => string.Equals(a.Id, ArticleId, StringComparison.OrdinalIgnoreCase));

            if (matchedArticle != null)
            {
                _activeArticle = matchedArticle;
                _selectedSeries = _data.SeriesList.FirstOrDefault(s => s.Id == matchedArticle.SeriesId) ?? _selectedSeries;
                _viewMode = ViewMode.Reader;
                _ = RecordRecentArticle(matchedArticle.Id);
                try
                {
                    _ = JS.InvokeVoidAsync("window.scrollTo", new { top = 180, behavior = "smooth" });
                }
                catch { }
                return;
            }
        }

        if (!string.IsNullOrEmpty(SeriesId))
        {
            var matchedSeries = _data.SeriesList
                .FirstOrDefault(s => string.Equals(s.Id, SeriesId, StringComparison.OrdinalIgnoreCase));

            if (matchedSeries != null)
            {
                _selectedSeries = matchedSeries;
                _activeArticle = null;
                _viewMode = ViewMode.Feed;
                return;
            }
        }

        _selectedSeries = null;
        _activeArticle = null;
        _viewMode = ViewMode.Catalog;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var stored = await JS.InvokeAsync<string?>("localStorage.getItem", "dev_blog_bookmarks");
                if (!string.IsNullOrEmpty(stored))
                {
                    var list = JsonSerializer.Deserialize<List<string>>(stored);
                    if (list != null)
                    {
                        _bookmarkedIds = new HashSet<string>(list);
                    }
                }

                var recentStored = await JS.InvokeAsync<string?>("localStorage.getItem", "dev_blog_recent_reads");
                if (!string.IsNullOrEmpty(recentStored))
                {
                    var rList = JsonSerializer.Deserialize<List<string>>(recentStored);
                    if (rList != null)
                    {
                        _recentArticleIds = rList;
                    }
                }
                StateHasChanged();
            }
            catch { }
        }

        if (_viewMode == ViewMode.Reader)
        {
            try
            {
                await JS.InvokeVoidAsync("hljs.highlightAll");
            }
            catch { }
        }
    }

    private int TotalArticlesCount => _data?.SeriesList?.Sum(s => s.Articles.Count) ?? 0;
    private int RecentArticlesCount => Math.Min(30, TotalArticlesCount);

    private int CountArticlesByLevel(int levelOrder)
    {
        if (_showOnlyBookmarks)
        {
            return _data?.SeriesList.SelectMany(s => s.Articles).Count(a => _bookmarkedIds.Contains(a.Id) && a.LevelOrder == levelOrder) ?? 0;
        }
        if (_showOnlyRecentRead)
        {
            return GetRecentlyViewedArticles(100).Count(a => a.LevelOrder == levelOrder);
        }
        if (_selectedSeries == null) return 0;
        return _selectedSeries.Articles.Count(a => a.LevelOrder == levelOrder);
    }

    private DevSeries? GetParentSeries(string seriesId) =>
        _data?.SeriesList.FirstOrDefault(s => string.Equals(s.Id, seriesId, StringComparison.OrdinalIgnoreCase));

    private static DateTime ParseArticleDate(string? dateStr)
    {
        if (DateTime.TryParseExact(dateStr, "dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var dt))
        {
            return dt;
        }
        return DateTime.MinValue;
    }

    private List<DevArticle> GetRecentlyViewedArticles(int take = 10)
    {
        if (_data?.SeriesList == null || _recentArticleIds.Count == 0) return new List<DevArticle>();
        var allArticles = _data.SeriesList.SelectMany(s => s.Articles).ToDictionary(a => a.Id, a => a);
        var list = new List<DevArticle>();
        foreach (var id in _recentArticleIds)
        {
            if (allArticles.TryGetValue(id, out var art))
            {
                list.Add(art);
                if (list.Count >= take) break;
            }
        }
        return list;
    }

    private IEnumerable<DevArticle> GetRecommendedRecentArticles(int count = 3)
    {
        if (_data?.SeriesList == null) return Enumerable.Empty<DevArticle>();
        return _data.SeriesList
            .SelectMany(s => s.Articles)
            .Where(a => _activeArticle == null || a.Id != _activeArticle.Id)
            .OrderByDescending(a => ParseArticleDate(a.PublishedDate))
            .ThenByDescending(a => a.LevelOrder)
            .Take(count);
    }

    private static bool IsNewArticle(DevArticle? article)
    {
        if (article == null) return false;
        return ParseArticleDate(article.PublishedDate) >= new DateTime(2026, 10, 17);
    }

    private int NewlyAddedCount
    {
        get
        {
            var count = _data?.SeriesList.SelectMany(s => s.Articles).Count(IsNewArticle) ?? 0;
            return count > 0 ? count : Math.Min(25, TotalArticlesCount);
        }
    }

    private IEnumerable<DevArticle> GetNewlyAddedArticles(int count = 6)
    {
        if (_data?.SeriesList == null) return Enumerable.Empty<DevArticle>();
        return _data.SeriesList
            .SelectMany(s => s.Articles)
            .OrderByDescending(a => ParseArticleDate(a.PublishedDate))
            .ThenByDescending(a => a.LevelOrder)
            .Take(count);
    }

    private void ShowNewlyAddedTab()
    {
        _selectedCatalogCategory = "recent";
        _viewMode = ViewMode.Catalog;
        _selectedSeries = null;
        _activeArticle = null;
        _showOnlyBookmarks = false;
        _showOnlyRecentRead = false;
        _catalogSearch = "";
        try
        {
            _ = JS.InvokeVoidAsync("window.scrollTo", new { top = 260, behavior = "smooth" });
        }
        catch { }
    }

    private async Task RecordRecentArticle(string articleId)
    {
        if (string.IsNullOrWhiteSpace(articleId)) return;
        _recentArticleIds.Remove(articleId);
        _recentArticleIds.Insert(0, articleId);
        if (_recentArticleIds.Count > 25)
        {
            _recentArticleIds = _recentArticleIds.Take(25).ToList();
        }
        try
        {
            var json = JsonSerializer.Serialize(_recentArticleIds);
            await JS.InvokeVoidAsync("localStorage.setItem", "dev_blog_recent_reads", json);
        }
        catch { }
        StateHasChanged();
    }

    private async Task ClearRecentHistory()
    {
        _recentArticleIds.Clear();
        try
        {
            await JS.InvokeVoidAsync("localStorage.removeItem", "dev_blog_recent_reads");
        }
        catch { }
        if (_showOnlyRecentRead)
        {
            BackToCatalog();
        }
        else
        {
            StateHasChanged();
        }
    }

    private void ToggleRecentReadFilter()
    {
        _showOnlyRecentRead = !_showOnlyRecentRead;
        if (_showOnlyRecentRead)
        {
            _showOnlyBookmarks = false;
            _viewMode = ViewMode.Feed;
            _activeArticle = null;
        }
        else
        {
            if (_selectedSeries != null)
            {
                _viewMode = ViewMode.Feed;
            }
            else
            {
                _viewMode = ViewMode.Catalog;
            }
        }
    }

    private string GetSeriesCategory(string seriesId)
    {
        var matched = _data?.SeriesList?.FirstOrDefault(s => string.Equals(s.Id, seriesId, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrWhiteSpace(matched?.Category))
        {
            return matched.Category.Trim().ToLowerInvariant();
        }

        return seriesId switch
        {
            "docker-series" or "k8s-series" or "logging-observability-series" or "load-balancing-series" or "container-vs-vm-series" => "devops",
            "dotnet-series" or "idempotency-key-series" or "jwt-deep-dive-series" or "db-interview-low-series" or "db-interview-mid-series" or "db-interview-high-series" or "enterprise-auth-series" or "sql-server-tuning-series" => "backend",
            "aws-series" or "cloudflare-series" or "app-insights-series" or "free-cloud-deploy-db-series" or "vpn-proxy-testing-series" => "cloud",
            "ai-mcp-series" or "vibe-coding-series" or "rag-gemini-series" => "ai",
            "wcag-accessibility-series" or "blazor-fullstack-series" => "standards",
            _ => "other"
        };
    }

    private string GetCategoryLabel(string category)
    {
        if (CultureService.IsEnglish)
        {
            return category switch
            {
                "devops" => "DevOps & Containers",
                "backend" => "Backend & Architecture",
                "cloud" => "Cloud & Infrastructure",
                "ai" => "AI & LLM",
                "standards" => "Frontend & Standards",
                _ => "General"
            };
        }
        return category switch
        {
            "devops" => "DevOps & Container",
            "backend" => "Backend & Kiến Trúc",
            "cloud" => "Cloud & Hạ Tầng",
            "ai" => "AI & LLM",
            "standards" => "Frontend & Tiêu Chuẩn",
            _ => "Khác"
        };
    }

    private int GetCategoryCount(string category)
    {
        if (_data?.SeriesList == null) return 0;
        if (category == "all") return _data.SeriesList.Count;
        if (category == "recent") return RecentArticlesCount;
        return _data.SeriesList.Count(s => GetSeriesCategory(s.Id) == category);
    }

    private IEnumerable<DevSeries> FilteredCatalogSeries
    {
        get
        {
            if (_data?.SeriesList == null) return Enumerable.Empty<DevSeries>();
            var list = _data.SeriesList.AsEnumerable();

            if (_selectedCatalogCategory != "all")
            {
                list = list.Where(s => GetSeriesCategory(s.Id) == _selectedCatalogCategory);
            }

            if (!string.IsNullOrWhiteSpace(_catalogSearch))
            {
                var q = _catalogSearch.Trim().ToLowerInvariant();
                list = list.Where(s =>
                    s.Title.ToLowerInvariant().Contains(q) ||
                    s.TitleVi.ToLowerInvariant().Contains(q) ||
                    s.Description.ToLowerInvariant().Contains(q) ||
                    s.DescriptionVi.ToLowerInvariant().Contains(q) ||
                    s.Articles.Any(a => 
                        a.Title.ToLowerInvariant().Contains(q) || 
                        a.TitleVi.ToLowerInvariant().Contains(q) ||
                        a.Tags.Any(t => t.ToLowerInvariant().Contains(q))));
            }

            return list;
        }
    }

    private IEnumerable<DevArticle> FilteredRecentArticles
    {
        get
        {
            if (_data?.SeriesList == null) return Enumerable.Empty<DevArticle>();
            var list = _data.SeriesList
                .SelectMany(s => s.Articles)
                .OrderByDescending(a => ParseArticleDate(a.PublishedDate))
                .ThenByDescending(a => a.LevelOrder);

            if (!string.IsNullOrWhiteSpace(_catalogSearch))
            {
                var q = _catalogSearch.Trim().ToLowerInvariant();
                return list.Where(a =>
                    a.Title.ToLowerInvariant().Contains(q) ||
                    a.TitleVi.ToLowerInvariant().Contains(q) ||
                    a.Summary.ToLowerInvariant().Contains(q) ||
                    a.SummaryVi.ToLowerInvariant().Contains(q) ||
                    a.Tags.Any(t => t.ToLowerInvariant().Contains(q)) ||
                    (GetParentSeries(a.SeriesId)?.Title.ToLowerInvariant().Contains(q) ?? false) ||
                    (GetParentSeries(a.SeriesId)?.TitleVi.ToLowerInvariant().Contains(q) ?? false));
            }

            return list.Take(RecentArticlesCount);
        }
    }

    private void ClearCatalogFilters()
    {
        _catalogSearch = "";
        _selectedCatalogCategory = "all";
    }

    private void BackToCatalog()
    {
        _viewMode = ViewMode.Catalog;
        _selectedSeries = null;
        _activeArticle = null;
        _showOnlyBookmarks = false;
        _showOnlyRecentRead = false;
        _selectedLevelFilter = null;
        _searchTerm = "";
        Navigation.NavigateTo(GetDevLearningHomeUrl());
    }

    private void OnSeriesDropdownChanged(ChangeEventArgs e)
    {
        var newId = e.Value?.ToString();
        if (!string.IsNullOrEmpty(newId))
        {
            var targetSeries = _data?.SeriesList.FirstOrDefault(s => s.Id == newId);
            if (targetSeries != null)
            {
                SelectSeries(targetSeries);
            }
        }
    }

    private async Task ShareCatalogSeries(DevSeries s)
    {
        try
        {
            var url = Navigation.ToAbsoluteUri(GetSeriesUrl(s.Id)).ToString();
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", url);
            _copiedCatalogSeriesId = s.Id;
            StateHasChanged();
            await Task.Delay(2000);
            _copiedCatalogSeriesId = null;
            StateHasChanged();
        }
        catch { }
    }

    private IEnumerable<DevArticle> FilteredArticles
    {
        get
        {
            IEnumerable<DevArticle> list;
            if (_showOnlyBookmarks)
            {
                list = _data?.SeriesList.SelectMany(s => s.Articles).Where(a => _bookmarkedIds.Contains(a.Id)) ?? Enumerable.Empty<DevArticle>();
            }
            else if (_showOnlyRecentRead)
            {
                list = GetRecentlyViewedArticles(50);
            }
            else
            {
                if (_selectedSeries == null) return Enumerable.Empty<DevArticle>();
                list = _selectedSeries.Articles;
            }

            // Filter by level
            if (_selectedLevelFilter.HasValue)
            {
                list = list.Where(a => a.LevelOrder == _selectedLevelFilter.Value);
            }

            // Filter by search term
            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                var t = _searchTerm.Trim().ToLowerInvariant();
                list = list.Where(a =>
                    a.LessonNumber.ToLowerInvariant().Contains(t) ||
                    a.Title.ToLowerInvariant().Contains(t) ||
                    a.TitleVi.ToLowerInvariant().Contains(t) ||
                    a.Summary.ToLowerInvariant().Contains(t) ||
                    a.SummaryVi.ToLowerInvariant().Contains(t) ||
                    a.Tags.Any(tag => tag.ToLowerInvariant().Contains(t)));
            }

            if (_showOnlyRecentRead)
            {
                return list;
            }

            // Order by LevelOrder then lesson
            return list.OrderBy(a => a.LevelOrder);
        }
    }

    private DevArticle? PreviousArticle
    {
        get
        {
            if (_selectedSeries == null || _activeArticle == null) return null;
            var list = _selectedSeries.Articles;
            var idx = list.FindIndex(a => a.Id == _activeArticle.Id);
            return idx > 0 ? list[idx - 1] : null;
        }
    }

    private DevArticle? NextArticle
    {
        get
        {
            if (_selectedSeries == null || _activeArticle == null) return null;
            var list = _selectedSeries.Articles;
            var idx = list.FindIndex(a => a.Id == _activeArticle.Id);
            return (idx >= 0 && idx < list.Count - 1) ? list[idx + 1] : null;
        }
    }

    private void SelectSeries(DevSeries series)
    {
        _selectedSeries = series;
        _showOnlyBookmarks = false;
        _showOnlyRecentRead = false;
        _selectedLevelFilter = null;
        _searchTerm = "";
        _viewMode = ViewMode.Feed;
        _activeArticle = null;
        Navigation.NavigateTo(GetSeriesUrl(series.Id));
    }

    private void ToggleBookmarkFilter()
    {
        _showOnlyBookmarks = !_showOnlyBookmarks;
        if (_showOnlyBookmarks)
        {
            _showOnlyRecentRead = false;
            _viewMode = ViewMode.Feed;
            _activeArticle = null;
        }
        else
        {
            if (_selectedSeries != null)
            {
                _viewMode = ViewMode.Feed;
            }
            else
            {
                _viewMode = ViewMode.Catalog;
            }
        }
    }

    private void ClearFilters()
    {
        _selectedLevelFilter = null;
        _searchTerm = "";
        _showOnlyBookmarks = false;
        _showOnlyRecentRead = false;
    }

    private async Task ReadArticle(DevArticle article)
    {
        _activeArticle = article;
        if (_selectedSeries == null || _selectedSeries.Id != article.SeriesId)
        {
            _selectedSeries = _data?.SeriesList.FirstOrDefault(s => s.Id == article.SeriesId) ?? _selectedSeries;
        }
        _viewMode = ViewMode.Reader;
        Navigation.NavigateTo(GetArticleUrl(article.SeriesId, article.Id));
        await RecordRecentArticle(article.Id);
        try
        {
            _ = JS.InvokeVoidAsync("window.scrollTo", new { top = 180, behavior = "smooth" });
        }
        catch { }
    }

    private void BackToFeed()
    {
        _activeArticle = null;
        if (_selectedSeries != null)
        {
            _viewMode = ViewMode.Feed;
            Navigation.NavigateTo(GetSeriesUrl(_selectedSeries.Id));
        }
        else
        {
            BackToCatalog();
            return;
        }
        try
        {
            _ = JS.InvokeVoidAsync("window.scrollTo", new { top = 180, behavior = "smooth" });
        }
        catch { }
    }

    private async Task ShareCurrentArticle()
    {
        if (_activeArticle == null || _selectedSeries == null) return;
        var rel = GetArticleUrl(_activeArticle.SeriesId, _activeArticle.Id);
        var url = Navigation.ToAbsoluteUri(rel).ToString();
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", url);
            _copiedShareUrl = true;
            StateHasChanged();
            await Task.Delay(2500);
            _copiedShareUrl = false;
            StateHasChanged();
        }
        catch { }
    }

    private async Task ShareCurrentSeries()
    {
        if (_selectedSeries == null) return;
        var rel = GetSeriesUrl(_selectedSeries.Id);
        var url = Navigation.ToAbsoluteUri(rel).ToString();
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", url);
            _copiedSeriesUrl = true;
            StateHasChanged();
            await Task.Delay(2500);
            _copiedSeriesUrl = false;
            StateHasChanged();
        }
        catch { }
    }

    private async Task ShareSpecificArticle(DevArticle article)
    {
        var rel = GetArticleUrl(article.SeriesId, article.Id);
        var url = Navigation.ToAbsoluteUri(rel).ToString();
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", url);
            _copiedArticleCardId = article.Id;
            StateHasChanged();
            await Task.Delay(2500);
            _copiedArticleCardId = null;
            StateHasChanged();
        }
        catch { }
    }

    private async Task ToggleBookmark(string articleId)
    {
        if (!_bookmarkedIds.Remove(articleId))
        {
            _bookmarkedIds.Add(articleId);
        }

        try
        {
            var json = JsonSerializer.Serialize(_bookmarkedIds);
            await JS.InvokeVoidAsync("localStorage.setItem", "dev_blog_bookmarks", json);
        }
        catch { }
    }

    private async Task CopyCodeToClipboard(string sectionId, string code)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
            _copiedCodeId = sectionId;
            StateHasChanged();

            await Task.Delay(2000);
            if (_copiedCodeId == sectionId)
            {
                _copiedCodeId = null;
                StateHasChanged();
            }
        }
        catch { }
    }

    private static string GetLevelCssClass(int levelOrder) => levelOrder switch
    {
        1 => "level-beginner",
        2 => "level-intermediate",
        3 => "level-advanced",
        4 => "level-production",
        _ => "level-beginner"
    };

    private static string GetLevelIcon(int levelOrder) => levelOrder switch
    {
        1 => "🌱",
        2 => "⚡",
        3 => "🔥",
        4 => "🚀",
        _ => "📌"
    };

    private async Task TriggerSyntaxHighlightAsync()
    {
        await Task.Delay(60);
        try
        {
            await JS.InvokeVoidAsync("hljs.highlightAll");
        }
        catch { }
    }

    private static MarkupString RenderFormattedText(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return new MarkupString("");

        var lines = raw.Replace("\r\n", "\n").Split('\n');
        var sb = new System.Text.StringBuilder();

        bool inUl = false;
        bool inOl = false;
        bool inQuote = false;

        foreach (var line in lines)
        {
            var trimmed = line.Trim();

            // Check blockquote
            if (trimmed.StartsWith("> "))
            {
                if (inUl) { sb.Append("</ul>"); inUl = false; }
                if (inOl) { sb.Append("</ol>"); inOl = false; }
                if (!inQuote) { sb.Append("<blockquote class=\"dev-article-quote\">"); inQuote = true; }
                var qText = trimmed.Substring(2).Trim();
                sb.Append(FormatInline(qText)).Append("<br />");
                continue;
            }
            else if (inQuote)
            {
                sb.Append("</blockquote>");
                inQuote = false;
            }

            // Check bullet list: - or *
            if (trimmed.StartsWith("- ") || trimmed.StartsWith("* "))
            {
                if (inOl) { sb.Append("</ol>"); inOl = false; }
                if (!inUl) { sb.Append("<ul class=\"dev-article-list\">"); inUl = true; }
                var itemText = trimmed.Substring(2).Trim();
                sb.Append("<li class=\"dev-article-list-item\">").Append(FormatInline(itemText)).Append("</li>");
                continue;
            }

            // Check numbered list: 1. , 2. 
            var matchNum = System.Text.RegularExpressions.Regex.Match(trimmed, @"^(\d+)\.\s+(.*)$");
            if (matchNum.Success)
            {
                if (inUl) { sb.Append("</ul>"); inUl = false; }
                if (!inOl) { sb.Append("<ol class=\"dev-article-olist\">"); inOl = true; }
                sb.Append("<li class=\"dev-article-list-item\">").Append(FormatInline(matchNum.Groups[2].Value)).Append("</li>");
                continue;
            }

            // Close any open lists
            if (inUl) { sb.Append("</ul>"); inUl = false; }
            if (inOl) { sb.Append("</ol>"); inOl = false; }

            // Sub-headings: #### or ###
            if (trimmed.StartsWith("#### "))
            {
                sb.Append("<h4 class=\"dev-sub-heading\">").Append(FormatInline(trimmed.Substring(5).Trim())).Append("</h4>");
                continue;
            }
            if (trimmed.StartsWith("### "))
            {
                sb.Append("<h3 class=\"dev-sub-heading\">").Append(FormatInline(trimmed.Substring(4).Trim())).Append("</h3>");
                continue;
            }

            // Regular paragraph line
            if (trimmed.Length > 0)
            {
                sb.Append("<p class=\"dev-section-paragraph\">").Append(FormatInline(trimmed)).Append("</p>");
            }
        }

        if (inUl) sb.Append("</ul>");
        if (inOl) sb.Append("</ol>");
        if (inQuote) sb.Append("</blockquote>");

        return new MarkupString(sb.ToString());
    }

    private static string FormatInline(string text)
    {
        if (string.IsNullOrEmpty(text)) return "";

        var s = System.Net.WebUtility.HtmlEncode(text);

        // Convert inline code `code` (before bold to prevent collision)
        s = System.Text.RegularExpressions.Regex.Replace(s, @"`([^`]+)`", "<code class=\"dev-inline-code\">$1</code>");

        // Convert bold **text**
        s = System.Text.RegularExpressions.Regex.Replace(s, @"\*\*([^*]+)\*\*", "<strong class=\"dev-bold\">$1</strong>");

        // Convert italic *text* (single asterisk)
        s = System.Text.RegularExpressions.Regex.Replace(s, @"(?<!\*)\*([^*]+)\*(?!\*)", "<em>$1</em>");

        // Convert markdown links: [label](url)
        s = System.Text.RegularExpressions.Regex.Replace(s, @"\[([^\]]+)\]\((https?://[^)]+)\)", "<a href=\"$2\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"dev-inline-link\">$1</a>");

        return s;
    }

    private string LangHref(string path) => CulturePath.Combine(CultureService.UrlLang, path);
}
