@page "/dev-learning"
@page "/{lang:regex(^(en|vn)$)}/dev-learning"
@page "/learning/dev-learning"
@page "/{lang:regex(^(en|vn)$)}/learning/dev-learning"
@page "/learning/dev-learning/{SeriesId}"
@page "/{lang:regex(^(en|vn)$)}/learning/dev-learning/{SeriesId}"
@page "/dev-learning/{SeriesId}"
@page "/{lang:regex(^(en|vn)$)}/dev-learning/{SeriesId}"
@page "/learning/dev-learning/{SeriesId}/{ArticleId}"
@page "/{lang:regex(^(en|vn)$)}/learning/dev-learning/{SeriesId}/{ArticleId}"
@page "/dev-learning/{SeriesId}/{ArticleId}"
@page "/{lang:regex(^(en|vn)$)}/dev-learning/{SeriesId}/{ArticleId}"
@inherits CultureAwareComponent
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Navigation
@using System.Text.Json
@using BlazorWasmPortfolioGhAction.Pages

<div class="dev-master-app">
    <div class="dev-wrapper">
        <LearningSubNav ActiveSection="dev-learning" />

        <!-- Top Hero Banner (Portfolio Midnight Gold / Crisp Slate Design System) -->
        <header class="dev-top-hero">
            <div class="dev-ambient-glow" aria-hidden="true"></div>
            <div class="dev-brand-row">
                <span class="dev-brand-pill">
                    <span class="dev-live-dot"></span> DEV LEARNING BLOG
                </span>
                <span class="dev-brand-pill outline">
                    LỘ TRÌNH TỪ CƠ BẢN ĐẾN NÂNG CAO
                </span>
                @if (_bookmarkedIds.Count > 0)
                {
                    <button type="button" 
                            class="dev-brand-pill" 
                            style="cursor: pointer; background: rgba(250, 204, 21, 0.15); color: #facc15; border-color: #facc15;"
                            @onclick="() => ToggleBookmarkFilter()">
                        <i class="bi bi-bookmark-star-fill"></i> @(_showOnlyBookmarks ? (CultureService.IsEnglish ? "Show All Articles" : "Hiện Tất Cả Bài Viết") : $"{_bookmarkedIds.Count} {(CultureService.IsEnglish ? "Saved Articles" : "Bài Đã Lưu")}")
                    </button>
                }
            </div>

            <h1 class="dev-title">
                @(CultureService.IsEnglish ? "Tech Blog & Engineering Roadmaps" : "Blog Kỹ Thuật & Chuyên Đề Thực Chiến")
            </h1>
            <p class="dev-subtitle">
                Hệ thống các <b>Chuyên đề công nghệ</b> chia theo từng bài viết Blog từ <b>Cơ bản &rarr; Trung cấp &rarr; Nâng cao &rarr; Thực chiến</b> cho <b>Khôi Nguyễn</b> · Đầy đủ lý thuyết nền tảng, kiến trúc hệ thống, file cấu hình và code mẫu thực tế.
            </p>

            @if (_data != null)
            {
                <div class="dev-stats-ticker">
                    <div class="dev-ticker-item">
                        <span class="dev-ticker-val">@_data.SeriesList.Count</span>
                        <span class="dev-ticker-lbl">Chuyên Đề</span>
                    </div>
                    <div class="dev-ticker-sep"></div>
                    <div class="dev-ticker-item">
                        <span class="dev-ticker-val">@TotalArticlesCount</span>
                        <span class="dev-ticker-lbl">Bài Viết Blog</span>
                    </div>
                    <div class="dev-ticker-sep"></div>
                    <div class="dev-ticker-item highlight">
                        <span class="dev-ticker-val">Cơ Bản &rarr; Nâng Cao</span>
                        <span class="dev-ticker-lbl">Lộ Trình Chuẩn</span>
                    </div>
                    <div class="dev-ticker-sep"></div>
                    <div class="dev-ticker-item">
                        <span class="dev-ticker-val">@_bookmarkedIds.Count</span>
                        <span class="dev-ticker-lbl">Bài Đã Lưu</span>
                    </div>
                </div>
            }
        </header>

        <!-- Series Selector Bar (Chuyên Đề Docker, K8s, .NET, AWS, AI MCP) -->
        @if (_data?.SeriesList != null)
        {
            <section class="dev-series-pills-bar">
                <div class="dev-series-pills">
                    @foreach (var s in _data.SeriesList)
                    {
                        var isAct = _selectedSeries?.Id == s.Id && !_showOnlyBookmarks;
                        <button type="button" 
                                class="dev-series-pill-btn @(isAct ? "active" : "")"
                                style="@(isAct ? $"--pill-accent: {s.Color}; border-color: {s.Color};" : "")"
                                @onclick="() => SelectSeries(s)">
                            <i class="bi @s.Icon"></i>
                            <span class="dev-pill-title">@(CultureService.IsEnglish ? s.Title : s.TitleVi)</span>
                            <span class="dev-pill-badge">@s.Articles.Count Bài</span>
                        </button>
                    }
                </div>
            </section>
        }

        @if (_isLoading)
        {
            <div style="text-align: center; padding: 4rem 1rem; color: var(--color-text-muted);">
                <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem; margin-bottom: 1rem;"></div>
                <p>Đang tải các chuyên đề bài viết kỹ thuật...</p>
            </div>
        }
        else if (_data == null || !_data.SeriesList.Any())
        {
            <div style="text-align: center; padding: 3rem 1rem; color: var(--color-text-muted); background: var(--color-bg-surface); border: 1px dashed var(--color-border); border-radius: var(--radius-xl, 1rem);">
                <i class="bi bi-journal-x" style="font-size: 2.5rem; display: block; margin-bottom: 0.5rem; color: var(--color-brand-symbol);"></i>
                <h5>Không tìm thấy dữ liệu bài viết</h5>
            </div>
        }
        else if (_activeArticle != null && _viewMode == ViewMode.Reader)
        {
            <!-- ========================================================================= -->
            <!-- MODE 2: SINGLE ARTICLE READER VIEW (Chi Tiết Bài Viết)                     -->
            <!-- ========================================================================= -->
            <div class="dev-article-reader-wrapper">
                <!-- Back Button & Breadcrumbs Bar -->
                <div class="dev-reader-top-action">
                    <button type="button" class="dev-back-to-feed-btn" @onclick="BackToFeed">
                        <i class="bi bi-arrow-left"></i>
                        <span>@(CultureService.IsEnglish ? "Back to Articles List" : $"Quay lại danh sách: {_selectedSeries?.TitleVi}")</span>
                    </button>

                    <nav class="dev-breadcrumb-nav" aria-label="Breadcrumb">
                        <span class="dev-bc-item">
                            <a href="@LangHref("")">Trang Chủ</a>
                        </span>
                        <i class="bi bi-chevron-right dev-bc-sep"></i>
                        <span class="dev-bc-item">
                            <a href="@GetDevLearningHomeUrl()">Dev Learning</a>
                        </span>
                        @if (_selectedSeries != null)
                        {
                            <i class="bi bi-chevron-right dev-bc-sep"></i>
                            <span class="dev-bc-item">
                                <a href="@GetSeriesUrl(_selectedSeries.Id)">@(CultureService.IsEnglish ? _selectedSeries.Title : _selectedSeries.TitleVi)</a>
                            </span>
                        }
                        <i class="bi bi-chevron-right dev-bc-sep"></i>
                        <span class="dev-bc-item active">@_activeArticle.LessonNumber</span>
                    </nav>
                </div>

                <div class="dev-blog-layout">
                    <!-- Left Column: Series Sidebar / Lesson List -->
                    <aside class="dev-series-sidebar">
                        <div class="dev-sidebar-sticky-card">
                            <div class="dev-sidebar-header">
                                <div class="dev-sidebar-series-badge" style="color: @(_selectedSeries?.Color ?? "#0284c7"); background: @(_selectedSeries?.Color ?? "#0284c7")18;">
                                    <i class="bi @(_selectedSeries?.Icon ?? "bi-collection-play-fill")"></i>
                                    <span>@(_selectedSeries?.Badge ?? "Chuyên Đề")</span>
                                </div>
                                <h3 class="dev-sidebar-title">
                                    @(CultureService.IsEnglish ? _selectedSeries?.Title : _selectedSeries?.TitleVi)
                                </h3>
                            </div>

                            <!-- Lessons in this series -->
                            <div class="dev-lesson-nav-list" role="navigation">
                                @foreach (var art in _selectedSeries?.Articles ?? new List<DevArticle>())
                                {
                                    var isCur = _activeArticle?.Id == art.Id;
                                    var isArtSaved = _bookmarkedIds.Contains(art.Id);

                                    <button type="button" 
                                            class="dev-lesson-item @(isCur ? "active" : "")"
                                            style="@(isCur ? $"--lesson-accent: {_selectedSeries?.Color ?? "#0284c7"};" : "")"
                                            @onclick="() => ReadArticle(art)">
                                        <div class="dev-lesson-meta-row">
                                            <span class="dev-level-tag @GetLevelCssClass(art.LevelOrder)">@art.LevelVi</span>
                                            <span class="dev-lesson-number-badge">@art.LessonNumber</span>
                                            @if (isArtSaved)
                                            {
                                                <i class="bi bi-bookmark-fill dev-saved-icon ms-auto" title="Đã lưu"></i>
                                            }
                                        </div>
                                        <div class="dev-lesson-title">
                                            @(CultureService.IsEnglish ? art.Title : art.TitleVi)
                                        </div>
                                    </button>
                                }
                            </div>
                        </div>
                    </aside>

                    <!-- Right Column: Full Article Body -->
                    <main class="dev-article-reader">
                        @{
                            var isCurArticleSaved = _activeArticle != null && _bookmarkedIds.Contains(_activeArticle.Id);
                        }
                        <article class="dev-article-card">
                            <header class="dev-article-main-header">
                                <!-- Top Metadata Row -->
                                <div class="dev-article-meta-bar">
                                    <span class="dev-level-badge-large @GetLevelCssClass(_activeArticle.LevelOrder)">
                                        @GetLevelIcon(_activeArticle.LevelOrder) @_activeArticle.LevelVi
                                    </span>
                                    <span class="dev-series-tag" style="background: @(_selectedSeries?.Color ?? "#0284c7")18; color: @(_selectedSeries?.Color ?? "#0284c7"); border-color: @(_selectedSeries?.Color ?? "#0284c7")40;">
                                        @_activeArticle.LessonNumber
                                    </span>
                                    <span class="dev-meta-pill">
                                        <i class="bi bi-clock-history"></i> @_activeArticle.ReadingTime
                                    </span>
                                    <span class="dev-meta-pill">
                                        <i class="bi bi-calendar3"></i> @_activeArticle.PublishedDate
                                    </span>
                                    <span class="dev-meta-pill author">
                                        <i class="bi bi-person-circle"></i> Khôi Nguyễn · Senior Fullstack
                                    </span>
                                    <div class="dev-actions-group">
                                        <button type="button" 
                                                class="dev-bookmark-btn @(isCurArticleSaved ? "saved" : "")"
                                                title="@(isCurArticleSaved ? "Bỏ lưu bài viết" : "Lưu bài viết này")"
                                                @onclick="() => ToggleBookmark(_activeArticle.Id)">
                                            <i class="bi @(isCurArticleSaved ? "bi-bookmark-star-fill" : "bi-bookmark-plus")"></i>
                                            <span>@(isCurArticleSaved ? (CultureService.IsEnglish ? "Saved" : "Đã Lưu") : (CultureService.IsEnglish ? "Save" : "Lưu Bài"))</span>
                                        </button>
                                        <button type="button" 
                                                class="dev-share-btn @(_copiedShareUrl ? "copied" : "")"
                                                title="Sao chép link bài viết để chia sẻ"
                                                @onclick="ShareCurrentArticle">
                                            <i class="bi @(_copiedShareUrl ? "bi-check2-circle" : "bi-share-fill")"></i>
                                            <span>@(_copiedShareUrl ? (CultureService.IsEnglish ? "Copied Link!" : "Đã Chép Link!") : (CultureService.IsEnglish ? "Share Article" : "Chia Sẻ"))</span>
                                        </button>
                                    </div>
                                </div>

                                <!-- Article Main Title -->
                                <h1 class="dev-article-h1">
                                    @(CultureService.IsEnglish ? _activeArticle.Title : _activeArticle.TitleVi)
                                </h1>

                                <!-- Lead Summary Callout -->
                                <div class="dev-lead-summary">
                                    <div class="dev-lead-icon">
                                        <i class="bi bi-quote"></i>
                                    </div>
                                    <div class="dev-lead-text">
                                        @(CultureService.IsEnglish ? _activeArticle.Summary : _activeArticle.SummaryVi)
                                    </div>
                                </div>

                                <!-- Tags Cloud -->
                                <div class="dev-article-tags-row">
                                    <span class="dev-tags-label"><i class="bi bi-tags-fill"></i> Chủ đề:</span>
                                    @foreach (var tag in _activeArticle.Tags)
                                    {
                                        <span class="dev-article-tag">#@tag</span>
                                    }
                                </div>

                                <!-- Table of Contents Box -->
                                @if (_activeArticle.Sections.Count > 1)
                                {
                                    <div class="dev-article-toc-box">
                                        <div class="dev-toc-header">
                                            <i class="bi bi-list-nested"></i>
                                            <span>Mục Lục Bài Viết</span>
                                        </div>
                                        <ul class="dev-toc-list">
                                            @for (int i = 0; i < _activeArticle.Sections.Count; i++)
                                            {
                                                var sec = _activeArticle.Sections[i];
                                                var secTitle = CultureService.IsEnglish ? sec.Heading : sec.HeadingVi;
                                                <li>
                                                    <a href="@($"#section-{_activeArticle.Id}-{i}")">
                                                        <span class="dev-toc-num">@(i + 1).</span> @secTitle
                                                    </a>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                }
                            </header>

                            <!-- In-Depth Article Content Sections -->
                            <div class="dev-article-body">
                                @for (int i = 0; i < _activeArticle.Sections.Count; i++)
                                {
                                    var sec = _activeArticle.Sections[i];
                                    var secId = $"section-{_activeArticle.Id}-{i}";
                                    var paragraphs = CultureService.IsEnglish ? sec.Paragraphs : sec.ParagraphsVi;
                                    var isCodeCopied = _copiedCodeId == secId;

                                    <section class="dev-content-section" id="@secId">
                                        <h2 class="dev-section-heading">
                                            <span class="dev-section-anchor" aria-hidden="true">#</span>
                                            @(CultureService.IsEnglish ? sec.Heading : sec.HeadingVi)
                                        </h2>

                                        @foreach (var p in paragraphs)
                                        {
                                            <p class="dev-section-paragraph">@p</p>
                                        }

                                        <!-- Code Block (macOS Terminal Style) -->
                                        @if (!string.IsNullOrWhiteSpace(sec.CodeContent))
                                        {
                                            <div class="dev-terminal-wrapper">
                                                <div class="dev-terminal-header">
                                                    <div class="dev-terminal-dots">
                                                        <span class="dev-tdot red"></span>
                                                        <span class="dev-tdot yellow"></span>
                                                        <span class="dev-tdot green"></span>
                                                    </div>
                                                    <div class="dev-terminal-title">
                                                        <span>@sec.CodeTitle</span>
                                                        <span class="dev-lang-pill">@sec.CodeLanguage</span>
                                                    </div>
                                                    <button type="button" 
                                                            class="dev-terminal-copy-btn @(isCodeCopied ? "copied" : "")"
                                                            title="Sao chép đoạn code"
                                                            @onclick="() => CopyCodeToClipboard(secId, sec.CodeContent)">
                                                        <i class="bi @(isCodeCopied ? "bi-check2 text-success" : "bi-clipboard")"></i>
                                                        <span>@(isCodeCopied ? "Đã Sao Chép!" : "Copy")</span>
                                                    </button>
                                                </div>
                                                <pre class="dev-terminal-code"><code class="language-@sec.CodeLanguage">@sec.CodeContent</code></pre>
                                            </div>
                                        }

                                        <!-- Callout Box (tip, warning, info) -->
                                        @if (!string.IsNullOrWhiteSpace(sec.CalloutType))
                                        {
                                            var cType = sec.CalloutType.ToLowerInvariant();
                                            var cTitle = CultureService.IsEnglish ? sec.CalloutTitle : sec.CalloutTitleVi;
                                            var cText = CultureService.IsEnglish ? sec.CalloutText : sec.CalloutTextVi;

                                            <div class="dev-callout-box @cType">
                                                <div class="dev-callout-icon">
                                                    @if (cType == "tip")
                                                    {
                                                        <i class="bi bi-lightbulb-fill"></i>
                                                    }
                                                    else if (cType == "warning")
                                                    {
                                                        <i class="bi bi-exclamation-triangle-fill"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-info-circle-fill"></i>
                                                    }
                                                </div>
                                                <div class="dev-callout-content">
                                                    <div class="dev-callout-title">@cTitle</div>
                                                    <div class="dev-callout-text">@cText</div>
                                                </div>
                                            </div>
                                        }
                                    </section>
                                }
                            </div>

                            <!-- Article Navigation Footer (Bài Trước & Bài Tiếp Theo) -->
                            <footer class="dev-article-footer-nav">
                                @if (PreviousArticle != null)
                                {
                                    var prevTitle = $"{PreviousArticle.LessonNumber}: {(CultureService.IsEnglish ? PreviousArticle.Title : PreviousArticle.TitleVi)}";
                                    <button type="button" 
                                            class="dev-nav-btn prev"
                                            title="@prevTitle"
                                            @onclick="() => ReadArticle(PreviousArticle)">
                                        <i class="bi bi-arrow-left"></i>
                                        <div class="dev-nav-btn-text">
                                            <span class="dev-nav-sub">Bài Trước · @PreviousArticle.LevelVi</span>
                                            <span class="dev-nav-main">@prevTitle</span>
                                        </div>
                                    </button>
                                }
                                else
                                {
                                    <div class="dev-nav-btn-placeholder"></div>
                                }

                                @if (NextArticle != null)
                                {
                                    var nextTitle = $"{NextArticle.LessonNumber}: {(CultureService.IsEnglish ? NextArticle.Title : NextArticle.TitleVi)}";
                                    <button type="button" 
                                            class="dev-nav-btn next"
                                            title="@nextTitle"
                                            @onclick="() => ReadArticle(NextArticle)">
                                        <div class="dev-nav-btn-text">
                                            <span class="dev-nav-sub">Bài Tiếp Theo · @NextArticle.LevelVi</span>
                                            <span class="dev-nav-main">@nextTitle</span>
                                        </div>
                                        <i class="bi bi-arrow-right"></i>
                                    </button>
                                }
                                else
                                {
                                    <div class="dev-nav-btn-placeholder"></div>
                                }
                            </footer>
                        </article>
                    </main>
                </div>
            </div>
        }
        else
        {
            <!-- ========================================================================= -->
            <!-- MODE 1: BLOG POSTS LIST / FEED VIEW (Danh Sách Bài Viết Theo Chuyên Đề)   -->
            <!-- ========================================================================= -->
            <section class="dev-series-feed-section">
                <!-- Chuyên Đề Header Card -->
                <div class="dev-feed-series-banner" style="--banner-accent: @(_selectedSeries?.Color ?? "#0284c7");">
                    <div class="dev-feed-banner-content">
                        <div class="dev-feed-banner-badge-row">
                            <div class="dev-feed-banner-badge">
                                <i class="bi @(_selectedSeries?.Icon ?? "bi-box-seam-fill")"></i>
                                <span>@(_selectedSeries?.Badge ?? "Chuyên Đề")</span>
                            </div>
                            @if (_selectedSeries != null)
                            {
                                <button type="button" 
                                        class="dev-share-btn @(_copiedSeriesUrl ? "copied" : "")"
                                        title="Sao chép link chuyên đề này để chia sẻ"
                                        @onclick="ShareCurrentSeries">
                                    <i class="bi @(_copiedSeriesUrl ? "bi-check2-circle" : "bi-share-fill")"></i>
                                    <span>@(_copiedSeriesUrl ? (CultureService.IsEnglish ? "Copied Series Link!" : "Đã Chép Link Chuyên Đề!") : (CultureService.IsEnglish ? "Share Series" : "Chia Sẻ Chuyên Đề"))</span>
                                </button>
                            }
                        </div>
                        <h2 class="dev-feed-series-title">
                            @(CultureService.IsEnglish ? _selectedSeries?.Title : _selectedSeries?.TitleVi)
                        </h2>
                        <p class="dev-feed-series-desc">
                            @(CultureService.IsEnglish ? _selectedSeries?.Description : _selectedSeries?.DescriptionVi)
                        </p>
                    </div>
                </div>

                <!-- Toolbar: Lọc Cấp Độ (Cơ bản -> Nâng cao) & Ô Tìm Kiếm -->
                <div class="dev-feed-toolbar">
                    <div class="dev-level-filter-chips">
                        <button type="button" 
                                class="dev-level-chip @(_selectedLevelFilter == null ? "active" : "")"
                                @onclick="() => _selectedLevelFilter = null">
                            <span>Tất Cả Bài Viết</span>
                            <span class="dev-level-count">@(_selectedSeries?.Articles.Count ?? 0)</span>
                        </button>
                        <button type="button" 
                                class="dev-level-chip level-1 @(_selectedLevelFilter == 1 ? "active" : "")"
                                @onclick="() => _selectedLevelFilter = 1">
                            <span>🌱 Cơ Bản</span>
                            <span class="dev-level-count">@CountArticlesByLevel(1)</span>
                        </button>
                        <button type="button" 
                                class="dev-level-chip level-2 @(_selectedLevelFilter == 2 ? "active" : "")"
                                @onclick="() => _selectedLevelFilter = 2">
                            <span>⚡ Trung Cấp</span>
                            <span class="dev-level-count">@CountArticlesByLevel(2)</span>
                        </button>
                        <button type="button" 
                                class="dev-level-chip level-3 @(_selectedLevelFilter == 3 ? "active" : "")"
                                @onclick="() => _selectedLevelFilter = 3">
                            <span>🔥 Nâng Cao</span>
                            <span class="dev-level-count">@CountArticlesByLevel(3)</span>
                        </button>
                        <button type="button" 
                                class="dev-level-chip level-4 @(_selectedLevelFilter == 4 ? "active" : "")"
                                @onclick="() => _selectedLevelFilter = 4">
                            <span>🚀 Thực Chiến</span>
                            <span class="dev-level-count">@CountArticlesByLevel(4)</span>
                        </button>
                    </div>

                    <div class="dev-feed-search-box">
                        <i class="bi bi-search"></i>
                        <input type="text" 
                               placeholder="Tìm bài viết trong chuyên đề này..." 
                               @bind="_searchTerm" 
                               @bind:event="oninput" />
                    </div>
                </div>

                <!-- Blog Articles Grid / Cards -->
                @if (!FilteredArticles.Any())
                {
                    <div class="dev-empty-feed">
                        <i class="bi bi-search"></i>
                        <h5>Không tìm thấy bài viết nào phù hợp</h5>
                        <p>Thử chọn cấp độ khác hoặc xóa từ khóa tìm kiếm.</p>
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="ClearFilters">
                            Xem tất cả bài viết
                        </button>
                    </div>
                }
                else
                {
                    <div class="dev-articles-grid">
                        @foreach (var article in FilteredArticles)
                        {
                            var isSaved = _bookmarkedIds.Contains(article.Id);

                            <div class="dev-article-post-card" style="--post-accent: @(_selectedSeries?.Color ?? "#0284c7");">
                                <div class="dev-post-card-top">
                                    <span class="dev-level-badge @GetLevelCssClass(article.LevelOrder)">
                                        @GetLevelIcon(article.LevelOrder) @article.LevelVi
                                    </span>
                                    <span class="dev-post-lesson-pill">@article.LessonNumber</span>
                                    <div class="dev-post-card-actions">
                                        <button type="button" 
                                                class="dev-post-card-bookmark @(_copiedArticleCardId == article.Id ? "copied" : "")"
                                                title="Sao chép link bài viết"
                                                @onclick="() => ShareSpecificArticle(article)"
                                                @onclick:stopPropagation="true">
                                            <i class="bi @(_copiedArticleCardId == article.Id ? "bi-check2" : "bi-share")"></i>
                                        </button>
                                        <button type="button" 
                                                class="dev-post-card-bookmark @(isSaved ? "saved" : "")"
                                                title="@(isSaved ? "Bỏ lưu bài viết" : "Lưu bài viết này")"
                                                @onclick="() => ToggleBookmark(article.Id)"
                                                @onclick:stopPropagation="true">
                                            <i class="bi @(isSaved ? "bi-bookmark-star-fill" : "bi-bookmark")"></i>
                                        </button>
                                    </div>
                                </div>

                                <h3 class="dev-post-card-title" @onclick="() => ReadArticle(article)">
                                    @(CultureService.IsEnglish ? article.Title : article.TitleVi)
                                </h3>

                                <p class="dev-post-card-summary">
                                    @(CultureService.IsEnglish ? article.Summary : article.SummaryVi)
                                </p>

                                <div class="dev-post-tags">
                                    @foreach (var tag in article.Tags.Take(3))
                                    {
                                        <span class="dev-post-tag">#@tag</span>
                                    }
                                </div>

                                <div class="dev-post-card-footer">
                                    <div class="dev-post-meta">
                                        <span><i class="bi bi-clock"></i> @article.ReadingTime</span>
                                        <span><i class="bi bi-calendar3"></i> @article.PublishedDate</span>
                                    </div>

                                    <button type="button" 
                                            class="dev-post-read-btn" 
                                            @onclick="() => ReadArticle(article)">
                                        <span>Đọc Bài Viết</span>
                                        <i class="bi bi-arrow-right"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>
        }
    </div>
</div>

@code {
    private enum ViewMode { Feed, Reader }

    [Parameter] public string? SeriesId { get; set; }
    [Parameter] public string? ArticleId { get; set; }

    private DevBlogData? _data;
    private bool _isLoading = true;
    private DevSeries? _selectedSeries;
    private DevArticle? _activeArticle;
    private ViewMode _viewMode = ViewMode.Feed;
    private int? _selectedLevelFilter = null;
    private string _searchTerm = "";
    private bool _showOnlyBookmarks = false;
    private string? _copiedCodeId = null;

    private string? _lastAppliedSeriesId;
    private string? _lastAppliedArticleId;
    private bool _copiedShareUrl = false;
    private bool _copiedSeriesUrl = false;
    private string? _copiedArticleCardId = null;

    private HashSet<string> _bookmarkedIds = new();

    private static readonly JsonSerializerOptions _jsonOpts = new()
    {
        PropertyNameCaseInsensitive = true
    };

    private string GetDevLearningHomeUrl() =>
        CulturePath.Combine(CultureService.UrlLang, "learning/dev-learning");

    private string GetSeriesUrl(string seriesId) =>
        CulturePath.Combine(CultureService.UrlLang, $"learning/dev-learning/{seriesId}");

    private string GetArticleUrl(string seriesId, string articleId) =>
        CulturePath.Combine(CultureService.UrlLang, $"learning/dev-learning/{seriesId}/{articleId}");

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _data = await Http.GetFromJsonAsync<DevBlogData>("sample-data/dev-learning.json", _jsonOpts);
            ApplyRouteParameters();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading dev-learning.json: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    protected override void OnParametersSet()
    {
        if (_data != null)
        {
            ApplyRouteParameters();
        }
    }

    private void ApplyRouteParameters()
    {
        if (_data == null || _data.SeriesList == null || _data.SeriesList.Count == 0) return;

        if (string.Equals(SeriesId, _lastAppliedSeriesId, StringComparison.OrdinalIgnoreCase) &&
            string.Equals(ArticleId, _lastAppliedArticleId, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _lastAppliedSeriesId = SeriesId;
        _lastAppliedArticleId = ArticleId;

        if (!string.IsNullOrEmpty(ArticleId))
        {
            var matchedArticle = _data.SeriesList
                .SelectMany(s => s.Articles)
                .FirstOrDefault(a => string.Equals(a.Id, ArticleId, StringComparison.OrdinalIgnoreCase));

            if (matchedArticle != null)
            {
                _activeArticle = matchedArticle;
                _selectedSeries = _data.SeriesList.FirstOrDefault(s => s.Id == matchedArticle.SeriesId) ?? _selectedSeries;
                _viewMode = ViewMode.Reader;
                try
                {
                    _ = JS.InvokeVoidAsync("window.scrollTo", new { top = 180, behavior = "smooth" });
                }
                catch { }
                return;
            }
        }

        if (!string.IsNullOrEmpty(SeriesId))
        {
            var matchedSeries = _data.SeriesList
                .FirstOrDefault(s => string.Equals(s.Id, SeriesId, StringComparison.OrdinalIgnoreCase));

            if (matchedSeries != null)
            {
                _selectedSeries = matchedSeries;
                _activeArticle = null;
                _viewMode = ViewMode.Feed;
                return;
            }
        }

        if (_selectedSeries == null && _data.SeriesList.Count > 0)
        {
            _selectedSeries = _data.SeriesList[0];
        }
        _activeArticle = null;
        _viewMode = ViewMode.Feed;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var stored = await JS.InvokeAsync<string?>("localStorage.getItem", "dev_blog_bookmarks");
                if (!string.IsNullOrEmpty(stored))
                {
                    var list = JsonSerializer.Deserialize<List<string>>(stored);
                    if (list != null)
                    {
                        _bookmarkedIds = new HashSet<string>(list);
                        StateHasChanged();
                    }
                }
            }
            catch { }
        }
    }

    private int TotalArticlesCount => _data?.SeriesList?.Sum(s => s.Articles.Count) ?? 0;

    private int CountArticlesByLevel(int levelOrder)
    {
        if (_selectedSeries == null) return 0;
        return _selectedSeries.Articles.Count(a => a.LevelOrder == levelOrder);
    }

    private IEnumerable<DevArticle> FilteredArticles
    {
        get
        {
            if (_selectedSeries == null) return Enumerable.Empty<DevArticle>();

            IEnumerable<DevArticle> list;
            if (_showOnlyBookmarks)
            {
                list = _data?.SeriesList.SelectMany(s => s.Articles).Where(a => _bookmarkedIds.Contains(a.Id)) ?? Enumerable.Empty<DevArticle>();
            }
            else
            {
                list = _selectedSeries.Articles;
            }

            // Filter by level
            if (_selectedLevelFilter.HasValue)
            {
                list = list.Where(a => a.LevelOrder == _selectedLevelFilter.Value);
            }

            // Filter by search term
            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                var t = _searchTerm.Trim().ToLowerInvariant();
                list = list.Where(a =>
                    a.LessonNumber.ToLowerInvariant().Contains(t) ||
                    a.Title.ToLowerInvariant().Contains(t) ||
                    a.TitleVi.ToLowerInvariant().Contains(t) ||
                    a.Summary.ToLowerInvariant().Contains(t) ||
                    a.SummaryVi.ToLowerInvariant().Contains(t) ||
                    a.Tags.Any(tag => tag.ToLowerInvariant().Contains(t)));
            }

            // Order by LevelOrder then lesson
            return list.OrderBy(a => a.LevelOrder);
        }
    }

    private DevArticle? PreviousArticle
    {
        get
        {
            if (_selectedSeries == null || _activeArticle == null) return null;
            var list = _selectedSeries.Articles;
            var idx = list.FindIndex(a => a.Id == _activeArticle.Id);
            return idx > 0 ? list[idx - 1] : null;
        }
    }

    private DevArticle? NextArticle
    {
        get
        {
            if (_selectedSeries == null || _activeArticle == null) return null;
            var list = _selectedSeries.Articles;
            var idx = list.FindIndex(a => a.Id == _activeArticle.Id);
            return (idx >= 0 && idx < list.Count - 1) ? list[idx + 1] : null;
        }
    }

    private void SelectSeries(DevSeries series)
    {
        _selectedSeries = series;
        _showOnlyBookmarks = false;
        _selectedLevelFilter = null;
        _searchTerm = "";
        _viewMode = ViewMode.Feed;
        _activeArticle = null;
        Navigation.NavigateTo(GetSeriesUrl(series.Id));
    }

    private void ToggleBookmarkFilter()
    {
        _showOnlyBookmarks = !_showOnlyBookmarks;
        _viewMode = ViewMode.Feed;
        _activeArticle = null;
    }

    private void ClearFilters()
    {
        _selectedLevelFilter = null;
        _searchTerm = "";
        _showOnlyBookmarks = false;
    }

    private void ReadArticle(DevArticle article)
    {
        _activeArticle = article;
        if (_selectedSeries == null || _selectedSeries.Id != article.SeriesId)
        {
            _selectedSeries = _data?.SeriesList.FirstOrDefault(s => s.Id == article.SeriesId) ?? _selectedSeries;
        }
        _viewMode = ViewMode.Reader;
        Navigation.NavigateTo(GetArticleUrl(article.SeriesId, article.Id));
        try
        {
            _ = JS.InvokeVoidAsync("window.scrollTo", new { top = 180, behavior = "smooth" });
        }
        catch { }
    }

    private void BackToFeed()
    {
        _viewMode = ViewMode.Feed;
        _activeArticle = null;
        if (_selectedSeries != null)
        {
            Navigation.NavigateTo(GetSeriesUrl(_selectedSeries.Id));
        }
        else
        {
            Navigation.NavigateTo(GetDevLearningHomeUrl());
        }
        try
        {
            _ = JS.InvokeVoidAsync("window.scrollTo", new { top = 180, behavior = "smooth" });
        }
        catch { }
    }

    private async Task ShareCurrentArticle()
    {
        if (_activeArticle == null || _selectedSeries == null) return;
        var rel = GetArticleUrl(_activeArticle.SeriesId, _activeArticle.Id);
        var url = Navigation.ToAbsoluteUri(rel).ToString();
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", url);
            _copiedShareUrl = true;
            StateHasChanged();
            await Task.Delay(2500);
            _copiedShareUrl = false;
            StateHasChanged();
        }
        catch { }
    }

    private async Task ShareCurrentSeries()
    {
        if (_selectedSeries == null) return;
        var rel = GetSeriesUrl(_selectedSeries.Id);
        var url = Navigation.ToAbsoluteUri(rel).ToString();
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", url);
            _copiedSeriesUrl = true;
            StateHasChanged();
            await Task.Delay(2500);
            _copiedSeriesUrl = false;
            StateHasChanged();
        }
        catch { }
    }

    private async Task ShareSpecificArticle(DevArticle article)
    {
        var rel = GetArticleUrl(article.SeriesId, article.Id);
        var url = Navigation.ToAbsoluteUri(rel).ToString();
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", url);
            _copiedArticleCardId = article.Id;
            StateHasChanged();
            await Task.Delay(2500);
            _copiedArticleCardId = null;
            StateHasChanged();
        }
        catch { }
    }

    private async Task ToggleBookmark(string articleId)
    {
        if (!_bookmarkedIds.Remove(articleId))
        {
            _bookmarkedIds.Add(articleId);
        }

        try
        {
            var json = JsonSerializer.Serialize(_bookmarkedIds);
            await JS.InvokeVoidAsync("localStorage.setItem", "dev_blog_bookmarks", json);
        }
        catch { }
    }

    private async Task CopyCodeToClipboard(string sectionId, string code)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
            _copiedCodeId = sectionId;
            StateHasChanged();

            await Task.Delay(2000);
            if (_copiedCodeId == sectionId)
            {
                _copiedCodeId = null;
                StateHasChanged();
            }
        }
        catch { }
    }

    private static string GetLevelCssClass(int levelOrder) => levelOrder switch
    {
        1 => "level-beginner",
        2 => "level-intermediate",
        3 => "level-advanced",
        4 => "level-production",
        _ => "level-beginner"
    };

    private static string GetLevelIcon(int levelOrder) => levelOrder switch
    {
        1 => "🌱",
        2 => "⚡",
        3 => "🔥",
        4 => "🚀",
        _ => "📌"
    };

    private string LangHref(string path) => CulturePath.Combine(CultureService.UrlLang, path);
}
