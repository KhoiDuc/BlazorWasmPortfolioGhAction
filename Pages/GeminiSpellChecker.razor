@using System.Text.Json
@using BlazorWasmPortfolioGhAction.Components.ToolShell
@using BlazorWasmPortfolioGhAction.Services.Trading.Broker
@using BlazorWasmPortfolioGhAction.Shared
@inject ApiKeyModel ApiKeyService
@inject HttpClient Http
@inject IStringLocalizer<SharedResources> L

<ToolShell Title="Gemini Spell Checker" Icon="bi-spellcheck" Description="Vietnamese spelling correction powered by Google Gemini API.">
    @if (enumPage == EnumPage.FirstPage)
    {
        <div class="tool-form">
            <div class="tool-field">
                <label class="tool-label" for="api-key-input">Gemini API key</label>
                <input type="password" @bind="ApiKey" id="api-key-input" class="tool-input" placeholder="Enter API key" autocomplete="off" />
            </div>
            <div class="tool-field">
                <label class="tool-label" for="model-select">Model</label>
                <select @bind="SelectedModel" id="model-select" class="tool-input">
                    @foreach (var m in GeminiModels.All)
                    {
                        <option value="@m.Id">@m.Label</option>
                    }
                </select>
            </div>
            <div class="tool-actions">
                <button type="button" @onclick="SaveApiKey" class="tool-btn tool-btn-primary">Continue</button>
            </div>
            <p class="tool-hint">Your key and model are stored in memory for this session only.</p>
        </div>
    }
    else
    {
        <div class="tool-form">
            <div class="tool-field">
                <label class="tool-label" for="spell-check-input">Vietnamese text</label>
                <textarea @bind="InputText" id="spell-check-input" rows="6" class="tool-textarea" placeholder="Enter Vietnamese text"></textarea>
            </div>
            <div class="tool-actions">
                <button type="button" @onclick="GoBack" class="tool-btn tool-btn-secondary">Back</button>
                <button type="button" @onclick="CheckSpelling" class="tool-btn tool-btn-primary" disabled="@_isLoading">
                    @if (_isLoading) { <span>@L["Common_Loading"]</span> } else { <span>Check spelling</span> }
                </button>
            </div>
        </div>

        @if (_isLoading)
        {
            <LoadingSpinner LabelKey="Common_LoadingData" />
        }

        @if (!string.IsNullOrEmpty(CorrectedText))
        {
            <div class="tool-result">
                <div class="tool-result-label">Corrected text</div>
                <p>@CorrectedText</p>
                @if (!string.IsNullOrEmpty(Corrections))
                {
                    <div class="tool-result-label">Corrections</div>
                    <ul class="tool-link-list">
                        @foreach (var item in Corrections.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                        {
                            <li>@item</li>
                        }
                    </ul>
                }
            </div>
        }
    }
</ToolShell>

@code {
    private string InputText { get; set; } = string.Empty;
    private string CorrectedText { get; set; } = string.Empty;
    private string Corrections { get; set; } = string.Empty;
    private string ApiKey { get; set; } = string.Empty;
    private string SelectedModel { get; set; } = GeminiModels.DefaultId;

    private EnumPage enumPage = EnumPage.FirstPage;
    private bool _isLoading;

    public enum EnumPage { FirstPage, SecondPage }

    private void SaveApiKey()
    {
        if (string.IsNullOrEmpty(ApiKey)) return;
        ApiKeyService.ApiKey = ApiKey;
        ApiKeyService.Model = SelectedModel;
        enumPage = EnumPage.SecondPage;
    }

    private void GoBack() => enumPage = EnumPage.FirstPage;

    private async Task CheckSpelling()
    {
        if (string.IsNullOrEmpty(InputText))
        {
            CorrectedText = "Please enter text.";
            Corrections = string.Empty;
            return;
        }

        _isLoading = true;
        try
        {
            var apiKey = ApiKeyService.ApiKey;
            if (string.IsNullOrEmpty(apiKey))
            {
                CorrectedText = "API key not provided.";
                Corrections = string.Empty;
                return;
            }

            var requestUri = $"https://generativelanguage.googleapis.com/v1beta/models/{ApiKeyService.Model ?? GeminiModels.DefaultId}:generateContent?key={apiKey}";
            var prompt = $"Correct the spelling of the following Vietnamese text. Return the result in this format:\n" +
                         $"Corrected: [corrected text here]\n" +
                         $"Fixes: [list each correction as 'original -> corrected', separated by commas, or 'None' if no changes]\n\n" +
                         $"Text: {InputText}";

            var requestBody = new
            {
                contents = new[] { new { parts = new[] { new { text = prompt } } } },
                generationConfig = new { temperature = 0.1, maxOutputTokens = 500 }
            };

            var response = await Http.PostAsJsonAsync(requestUri, requestBody);

            if (response.IsSuccessStatusCode)
            {
                var jsonResponse = await response.Content.ReadAsStringAsync();
                var result = JsonSerializer.Deserialize<GeminiResponse>(jsonResponse,
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true });

                var rawResponse = result?.Candidates?.FirstOrDefault()?.Content?.Parts?.FirstOrDefault()?.Text?.Trim() ?? InputText;
                CorrectedText = ExtractCorrectedText(rawResponse) ?? InputText;
                Corrections = ExtractCorrections(rawResponse) ?? "No changes needed.";
            }
            else
            {
                CorrectedText = $"An error occurred while checking. (Error: {response.StatusCode})";
                Corrections = string.Empty;
            }
        }
        catch (Exception ex)
        {
            CorrectedText = $"Error: {ex.Message}";
            Corrections = string.Empty;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string? ExtractCorrectedText(string response)
    {
        const string correctedPrefix = "Corrected: ";
        var startIndex = response.IndexOf(correctedPrefix, StringComparison.Ordinal);
        if (startIndex == -1) return null;
        startIndex += correctedPrefix.Length;
        var endIndex = response.IndexOf('\n', startIndex);
        if (endIndex == -1) endIndex = response.Length;
        return response.Substring(startIndex, endIndex - startIndex).Trim();
    }

    private static string? ExtractCorrections(string response)
    {
        const string fixesPrefix = "Fixes: ";
        var startIndex = response.IndexOf(fixesPrefix, StringComparison.Ordinal);
        if (startIndex == -1) return null;
        startIndex += fixesPrefix.Length;
        var corrections = response.Substring(startIndex).Trim();
        return corrections == "None" ? "No corrections required." : corrections;
    }

    private class GeminiResponse { public Candidate[]? Candidates { get; set; } }
    private class Candidate { public Content? Content { get; set; } }
    private class Content { public Part[]? Parts { get; set; } }
    private class Part { public string? Text { get; set; } }
}
