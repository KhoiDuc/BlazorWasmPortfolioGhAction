@using BlazorWasmPortfolioGhAction.Models

<div class="tool-card">
    <div class="tool-header">
        <h3><i class="bi bi-database" aria-hidden="true"></i> SQLite + EF Core (Wasm)</h3>
        <p>Client-side SQLite demo with Entity Framework Core in the browser.</p>
    </div>

    @if (!string.IsNullOrEmpty(_alertMessage))
    {
        <div class="tool-alert @(_alertType == "danger" ? "tool-alert-danger" : "tool-alert-success")" role="alert">
            @_alertMessage
        </div>
    }

    <div class="tool-inspect-card">
        <strong>SQLite version:</strong>
        <span class="tool-badge">@_version</span>
        <div class="tool-actions">
            <button type="button" class="tool-btn tool-btn-secondary" @onclick="@(async () => await SQLiteVersion())">Check version</button>
        </div>
    </div>

    <div class="tool-form">
        <h4>Add new car</h4>
        <div class="tool-field">
            <label class="tool-label" for="brand">Brand</label>
            <input type="text" id="brand" class="tool-input" @bind="_newBrand" />
        </div>
        <div class="tool-field">
            <label class="tool-label" for="price">Price</label>
            <input type="number" id="price" class="tool-input" @bind="_newPrice" />
        </div>
        <div class="tool-actions">
            <button type="button" class="tool-btn tool-btn-primary" @onclick="@(async () => await Create(new Car { Brand = _newBrand, Price = _newPrice }))">Add car</button>
        </div>
    </div>

    <div class="tool-result">
        <h4>Car list</h4>
        <div class="tool-table-wrapper">
            <table class="tool-table">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Brand</th>
                        <th>Price</th>
                        <th>Update</th>
                        <th>Delete</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var car in _cars)
                    {
                        <tr>
                            <td>@car.Id</td>
                            <td><input type="text" @bind="car.Brand" class="tool-input" /></td>
                            <td><input type="number" @bind="car.Price" class="tool-input" /></td>
                            <td>
                                <button type="button" class="tool-icon-btn" title="Save" aria-label="Save car @car.Id" @onclick="@(async () => await Update(new Car { Id = car.Id, Brand = car.Brand, Price = car.Price }))">
                                    <img src="sqlite/check.png" width="20" height="20" alt="" aria-hidden="true" />
                                </button>
                            </td>
                            <td>
                                <button type="button" class="tool-icon-btn" title="Delete" aria-label="Delete car @car.Id" @onclick="@(async () => await Delete(car.Id))">
                                    <img src="sqlite/rubbish-bin.png" width="20" height="20" alt="" aria-hidden="true" />
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@functions
{
    private string _newBrand = "no brand";
    private int _newPrice = 999;
}
