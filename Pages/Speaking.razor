@page "/speaking"
@page "/{lang:regex(^(en|vn)$)}/speaking"
@inherits CultureAwareComponent
@inject HttpClient Http
@inject IJSRuntime JS
@using System.Text.Json

<div class="speaking-studio-app">
    <div class="speaking-studio-wrapper">
        <!-- Studio Top Hero / Header -->
        <header class="studio-top-hero">
            <div class="studio-ambient-glow" aria-hidden="true"></div>
            <div class="studio-hero-content">
                <div class="studio-brand-row">
                    <span class="studio-brand-pill">
                        <span class="live-dot"></span> SPEAKING STUDIO
                    </span>
                    <span class="studio-brand-pill outline">
                        A–R–E–A FRAMEWORK
                    </span>
                </div>

                <h1 class="studio-title">Nói Tự Nhiên. Phản Xạ Nhanh.</h1>
                <p class="studio-subtitle">
                    Phòng luyện nói chuẩn hóa cho <b>Khôi</b> · Tích hợp 500+ từ vựng đời thường, Web Development, DevOps, AI, Thể thao với âm thanh tương tác.
                </p>

                @if (_data != null)
                {
                    <div class="studio-stats-ticker">
                        <div class="ticker-item">
                            <span class="ticker-val">@_data.Topics.Count</span>
                            <span class="ticker-lbl">Chủ đề thực tế</span>
                        </div>
                        <div class="ticker-sep"></div>
                        <div class="ticker-item">
                            <span class="ticker-val">@_data.Vocab.Count</span>
                            <span class="ticker-lbl">Từ vựng & Cụm từ</span>
                        </div>
                        <div class="ticker-sep"></div>
                        <div class="ticker-item">
                            <span class="ticker-val">@_data.Frames.Count</span>
                            <span class="ticker-lbl">Mẫu câu phản xạ</span>
                        </div>
                        <div class="ticker-sep"></div>
                        <div class="ticker-item highlight">
                            <span class="ticker-val">@_learned.Count</span>
                            <span class="ticker-lbl">Từ đã thuộc</span>
                        </div>
                    </div>
                }
            </div>
        </header>

        @if (_loadError)
        {
            <div class="studio-alert-error">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <div>
                    <h4>Không tải được dữ liệu</h4>
                    <p>Vui lòng kiểm tra lại đường truyền hoặc thử làm mới trang (Ctrl + F5).</p>
                </div>
            </div>
        }
        else if (_data == null)
        {
            <div class="studio-loading-box">
                <div class="studio-spinner"></div>
                <p>Đang tải Speaking Studio...</p>
            </div>
        }
        else
        {
            <!-- Studio Floating Tab Bar -->
            <nav class="studio-tab-bar" role="tablist" aria-label="Các phòng luyện tập">
                @foreach (var tab in _studioTabs)
                {
                    var isActive = _activeTab == tab.Key;
                    <button type="button"
                            role="tab"
                            aria-selected="@isActive"
                            class="studio-nav-btn @(isActive ? "active" : "")"
                            @onclick="() => SwitchTab(tab.Key)">
                        <i class="bi @tab.Icon" aria-hidden="true"></i>
                        <span class="nav-btn-label">@tab.Label</span>
                        @if (!string.IsNullOrEmpty(tab.Badge))
                        {
                            <span class="nav-btn-badge">@tab.Badge</span>
                        }
                    </button>
                }
            </nav>

            <!-- Studio Tab Viewport -->
            <main class="studio-viewport">
                @switch (_activeTab)
                {
                    case "studio":
                        <StudioTab Data="@_data" InitialTopicId="@_currentTopicId" Speak="@SpeakText" />
                        break;

                    case "cards":
                        <FlashcardTab Data="@_data" InitialGroup="@_currentTopicId" Learned="@_learned" ToggleLearn="@ToggleLearn" Speak="@SpeakText" />
                        break;

                    case "vocab":
                        <VocabHubTab Data="@_data" InitialGroup="@_currentVocabGroup" Learned="@_learned" ToggleLearn="@ToggleLearn" Speak="@SpeakText" />
                        break;

                    case "personal":
                        <PersonalScriptTab Data="@_data" Speak="@SpeakText" />
                        break;

                    case "frames":
                        <FramesStudioTab Data="@_data" Speak="@SpeakText" />
                        break;

                    case "mock":
                        <MockTestTab Data="@_data" Speak="@SpeakText" />
                        break;
                }
            </main>
        }
    </div>
</div>

@code {
    private SpeakingData? _data;
    private bool _loadError;
    private string _activeTab = "studio";
    private string _currentTopicId = "";
    private string _currentVocabGroup = "all";
    private HashSet<string> _learned = new();

    private readonly List<(string Key, string Label, string Icon, string Badge)> _studioTabs = new()
    {
        ("studio", "Studio Luyện Nói", "bi-broadcast", "Live"),
        ("cards", "Thẻ Nhớ", "bi-card-heading", "3D"),
        ("vocab", "Kho Từ Vựng", "bi-journal-bookmark", "450+"),
        ("personal", "Bài Mẫu Của Khôi", "bi-person-badge", "VIP"),
        ("frames", "Mẫu Câu A-R-E-A", "bi-chat-quote", ""),
        ("mock", "Thi Thử 1–1", "bi-mic", ""),
    };

    private static readonly JsonSerializerOptions _jsonOpts = new()
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull,
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _data = await Http.GetFromJsonAsync<SpeakingData>("sample-data/speaking.json", _jsonOpts);
            if (_data is null) _loadError = true;
            else if (_data.Topics.Any()) _currentTopicId = _data.Topics[0].Id;
        }
        catch
        {
            _loadError = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var stored = await JS.InvokeAsync<string?>("localStorage.getItem", "speaking_learned_words");
                if (!string.IsNullOrEmpty(stored))
                {
                    var list = JsonSerializer.Deserialize<List<string>>(stored);
                    if (list != null && list.Any())
                    {
                        _learned = new HashSet<string>(list);
                        StateHasChanged();
                    }
                }
            }
            catch { }
        }
    }

    private void SwitchTab(string key) => _activeTab = key;

    private void ToggleLearn(string en)
    {
        if (!_learned.Remove(en)) _learned.Add(en);
        _ = SaveLearnedAsync();
    }

    private async Task SaveLearnedAsync()
    {
        try
        {
            var json = JsonSerializer.Serialize(_learned);
            await JS.InvokeVoidAsync("localStorage.setItem", "speaking_learned_words", json);
        }
        catch { }
    }

    private async Task SpeakText(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return;
        try
        {
            await JS.InvokeVoidAsync("eval", $"speechSynthesis.cancel();var u=new SpeechSynthesisUtterance({JsonSerializer.Serialize(text)});u.lang='en-US';u.rate=0.88;speechSynthesis.speak(u)");
        }
        catch { }
    }
}