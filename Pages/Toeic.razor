@page "/toeic"
@page "/{lang:regex(^(en|vn)$)}/toeic"
@page "/learning/toeic"
@page "/{lang:regex(^(en|vn)$)}/learning/toeic"
@inherits CultureAwareComponent
@inject HttpClient Http
@inject IJSRuntime JS
@using System.Text.Json
@using BlazorWasmPortfolioGhAction.Pages.ToeicTabs

<div class="toeic-master-app">
    <div class="toeic-wrapper">
        <LearningSubNav ActiveSection="toeic" />

        <!-- Top Hero Banner -->
        <header class="toeic-top-hero">
            <div class="toeic-ambient-glow" aria-hidden="true"></div>
            <div class="toeic-brand-row">
                <span class="toeic-brand-pill">
                    <span class="toeic-live-dot"></span> TOEIC MASTERY HUB
                </span>
                <span class="toeic-brand-pill outline">
                    4-SKILLS & EXAM BLUEPRINT
                </span>
            </div>

            <h1 class="toeic-title">Cẩm Nang Ôn Thi TOEIC Toàn Diện & Thực Chiến</h1>
            <p class="toeic-subtitle">
                Hệ thống ôn luyện chuẩn hóa cho <b>Khôi</b> · Cấu trúc đề 7 Part & quản trị 120 phút, công cụ tính quy đổi điểm ETS, cẩm nang phòng thi IIG, 28 chuyên đề tri thức, bóc tách cạm bẫy Part 1–7, ngữ pháp 12 trụ cột cốt lõi, cặp từ dễ nhầm lẫn, Flashcard 3D và phòng luyện Speaking/Writing.
            </p>

            @if (_data != null)
            {
                <div class="toeic-stats-ticker">
                    <div class="toeic-ticker-item">
                        <span class="toeic-ticker-val">@_data.ExamParts.Count Parts</span>
                        <span class="toeic-ticker-lbl">Cấu Trúc Đề</span>
                    </div>
                    <div class="toeic-ticker-sep"></div>
                    <div class="toeic-ticker-item">
                        <span class="toeic-ticker-val">@_data.Modules.Count</span>
                        <span class="toeic-ticker-lbl">Chuyên Đề Tri Thức</span>
                    </div>
                    <div class="toeic-ticker-sep"></div>
                    <div class="toeic-ticker-item">
                        <span class="toeic-ticker-val">@_data.GrammarTopics.Count Trụ Cột</span>
                        <span class="toeic-ticker-lbl">Ngữ Pháp Part 5</span>
                    </div>
                    <div class="toeic-ticker-sep"></div>
                    <div class="toeic-ticker-item">
                        <span class="toeic-ticker-val">@_data.Traps.Count</span>
                        <span class="toeic-ticker-lbl">Bẫy Đề Thi</span>
                    </div>
                    <div class="toeic-ticker-sep"></div>
                    <div class="toeic-ticker-item highlight">
                        <span class="toeic-ticker-val">@_masteredTraps.Count</span>
                        <span class="toeic-ticker-lbl">Bẫy Đã Thành Thạo</span>
                    </div>
                </div>
            }
        </header>

        @if (_loadError)
        {
            <div style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 12px; padding: 2rem; text-align: center; color: #ef4444;">
                <i class="bi bi-exclamation-triangle-fill" style="font-size: 2rem; margin-bottom: 0.5rem; display: block;"></i>
                <h4 style="margin: 0 0 0.5rem;">Không tải được dữ liệu TOEIC</h4>
                <p style="margin: 0; color: var(--color-text-secondary);">Vui lòng kiểm tra lại đường truyền hoặc thử tải lại trang (Ctrl + F5).</p>
            </div>
        }
        else if (_data == null)
        {
            <div style="text-align: center; padding: 4rem 1rem; color: var(--color-text-muted);">
                <div class="spinner-border text-warning" role="status" style="width: 3rem; height: 3rem; margin-bottom: 1rem;"></div>
                <p>Đang tải tài liệu TOEIC 4-Skills...</p>
            </div>
        }
        else
        {
            <!-- Tab Navigation Bar -->
            <nav class="toeic-tab-bar" role="tablist" aria-label="Các chuyên đề TOEIC">
                @foreach (var tab in _tabs)
                {
                    var isActive = _activeTab == tab.Key;
                    <button type="button"
                            role="tab"
                            aria-selected="@isActive"
                            class="toeic-nav-btn @(isActive ? "active" : "")"
                            @onclick="() => SwitchTab(tab.Key)">
                        <i class="bi @tab.Icon" aria-hidden="true"></i>
                        <span>@tab.Label</span>
                        @if (!string.IsNullOrEmpty(tab.Badge))
                        {
                            <span class="toeic-nav-btn-badge">@tab.Badge</span>
                        }
                    </button>
                }
            </nav>

            <!-- Main Tab Viewport -->
            <main class="toeic-viewport">
                @switch (_activeTab)
                {
                    case "format":
                        <ToeicFormatTab Data="@_data" />
                        break;

                    case "overview":
                        <ToeicOverviewTab Data="@_data" />
                        break;

                    case "traps":
                        <ToeicTrapsTab Data="@_data" MasteredTraps="@_masteredTraps" OnToggleTrap="ToggleTrapMastered" />
                        break;

                    case "vocab":
                        <ToeicVocabTab Data="@_data" OnSpeak="SpeakText" />
                        break;

                    case "grammar":
                        <ToeicGrammarTab Data="@_data" />
                        break;

                    case "speaking":
                        <ToeicSpeakingTab Data="@_data" OnSpeak="SpeakText" />
                        break;

                    case "writing":
                        <ToeicWritingTab Data="@_data" />
                        break;
                }
            </main>
        }
    </div>
</div>

@code {
    private ToeicData? _data;
    private bool _loadError;
    private string _activeTab = "format";
    private HashSet<string> _masteredTraps = new();

    private readonly List<(string Key, string Label, string Icon, string Badge)> _tabs = new()
    {
        ("format", "Cấu Trúc Đề & Tính Điểm ETS", "bi-compass-fill", "Chuẩn ETS"),
        ("overview", "28 Chuyên Đề Tương Tác", "bi-grid-fill", "28"),
        ("traps", "Bẫy Đề Thi & Mẹo 5s", "bi-shield-exclamation", "Part 1-7"),
        ("vocab", "Từ Vựng, Cặp Từ & Thẻ Nhớ 3D", "bi-card-heading", "Flashcards"),
        ("grammar", "Ngữ Pháp 12 Trụ Cột & Quiz", "bi-diagram-3-fill", "12 Trụ Cột"),
        ("speaking", "Luyện Nói (Speaking)", "bi-mic-fill", "Timer"),
        ("writing", "Luyện Viết (Writing)", "bi-pen-fill", "Blueprint"),
    };

    private static readonly JsonSerializerOptions _jsonOpts = new()
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        DefaultIgnoreCondition = System.Text.Json.Serialization.JsonIgnoreCondition.WhenWritingNull,
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _data = await Http.GetFromJsonAsync<ToeicData>("sample-data/toeic.json", _jsonOpts);
            if (_data is null) _loadError = true;
        }
        catch
        {
            _loadError = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var stored = await JS.InvokeAsync<string?>("localStorage.getItem", "toeic_mastered_traps");
                if (!string.IsNullOrEmpty(stored))
                {
                    var list = JsonSerializer.Deserialize<List<string>>(stored);
                    if (list != null && list.Any())
                    {
                        _masteredTraps = new HashSet<string>(list);
                        StateHasChanged();
                    }
                }
            }
            catch { }
        }
    }

    private void SwitchTab(string key) => _activeTab = key;

    private void ToggleTrapMastered(string trapId)
    {
        if (!_masteredTraps.Remove(trapId)) _masteredTraps.Add(trapId);
        _ = SaveMasteredTrapsAsync();
    }

    private async Task SaveMasteredTrapsAsync()
    {
        try
        {
            var json = JsonSerializer.Serialize(_masteredTraps);
            await JS.InvokeVoidAsync("localStorage.setItem", "toeic_mastered_traps", json);
        }
        catch { }
    }

    private async Task SpeakText(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return;
        try
        {
            await JS.InvokeVoidAsync("eval", $"speechSynthesis.cancel();var u=new SpeechSynthesisUtterance({JsonSerializer.Serialize(text)});u.lang='en-US';u.rate=0.88;speechSynthesis.speak(u)");
        }
        catch { }
    }
}
