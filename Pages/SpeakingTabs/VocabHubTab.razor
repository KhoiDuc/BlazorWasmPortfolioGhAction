@* VocabHubTab.razor — Kho từ vựng & ma trận tra cứu thông minh phong cách Studio *@

<div class="vocab-hub-container">
    <!-- Hub Header & Filters -->
    <div class="vocab-hub-toolbar">
        <div class="vocab-search-box">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input type="search"
                   placeholder="Tìm từ vựng, nghĩa tiếng Việt, ví dụ..."
                   @bind="_search"
                   @bind:event="oninput"
                   aria-label="Tìm từ vựng" />
            @if (!string.IsNullOrWhiteSpace(_search))
            {
                <button type="button" class="vocab-clear-btn" @onclick='() => _search = ""' aria-label="Xóa tìm kiếm">
                    <i class="bi bi-x-circle-fill"></i>
                </button>
            }
        </div>

        <div class="vocab-select-group">
            <select @bind="_selectedGroup" class="vocab-select" aria-label="Lọc theo chủ đề">
                <option value="all">Tất cả 18 chủ đề (@Data.Vocab.Count từ)</option>
                @foreach (var g in _groupLabels)
                {
                    <option value="@g.Key">@g.Value</option>
                }
            </select>

            <select @bind="_selectedFilter" class="vocab-select" aria-label="Lọc theo tính chất">
                <option value="all">Tất cả tính chất (@Data.Vocab.Count)</option>
                <option value="common">🔥 Đời thường quen thuộc (@Data.Vocab.Count(v => v.Common))</option>
                <option value="priority">⭐ Cụm ưu tiên Speaking (@Data.Vocab.Count(v => v.Priority))</option>
                <option value="extra">💻 Web & DevOps (@Data.Vocab.Count(v => v.Extra))</option>
                <option value="unlearned">⏳ Chưa thuộc (@Data.Vocab.Count(v => !Learned.Contains(v.En)))</option>
                <option value="learned">✓ Đã thuộc (@Data.Vocab.Count(v => Learned.Contains(v.En)))</option>
            </select>

            <select @bind="_selectedKind" class="vocab-select" aria-label="Lọc theo loại từ">
                <option value="all">Tất cả loại từ</option>
                <option value="idiom">💬 Thành ngữ & Cụm tự nhiên (Idioms)</option>
                <option value="phrasal verb">⚡ Cụm động từ (Phrasal Verbs)</option>
                <option value="noun">🏷️ Danh từ & Cụm danh từ</option>
                <option value="verb">🎯 Động từ & Cụm hành động</option>
                <option value="adjective">✨ Tính từ miêu tả</option>
                <option value="signpost">🔗 Câu nối & Cứu nguy phản xạ</option>
            </select>
        </div>
    </div>

    <!-- Quick Category Chips -->
    <div class="vocab-chips-bar">
        <button type="button" class="vocab-chip @(_selectedGroup == "all" ? "active" : "")" @onclick='() => _selectedGroup = "all"'>
            ✨ Tất cả (@Data.Vocab.Count)
        </button>
        @foreach (var g in _quickChips)
        {
            var count = Data.Vocab.Count(v => v.Group == g.Key);
            <button type="button" class="vocab-chip @(_selectedGroup == g.Key ? "active" : "")" @onclick="() => _selectedGroup = g.Key">
                @g.Value (@count)
            </button>
        }
    </div>

    <!-- Summary Stats Bar -->
    <div class="vocab-meta-bar">
        <div class="vocab-count-info">
            Hiển thị <b>@FilteredVocab.Count</b> / @Data.Vocab.Count từ vựng
            @if (_selectedGroup != "all" || _selectedFilter != "all" || _selectedKind != "all" || !string.IsNullOrWhiteSpace(_search))
            {
                <button type="button" class="vocab-chip-reset" @onclick="ResetFilters">
                    <i class="bi bi-arrow-counterclockwise"></i> Đặt lại tất cả lọc
                </button>
            }
            @if (_selectedFilter == "learned" || Learned.Any())
            {
                <span class="vocab-learned-badge">· Tiến độ: @Learned.Count/@Data.Vocab.Count (@(Data.Vocab.Count > 0 ? (Learned.Count * 100 / Data.Vocab.Count) : 0)%)</span>
            }
        </div>
    </div>

    <!-- Vocab Matrix Grid -->
    <div class="vocab-grid">
        @if (FilteredVocab.Any())
        {
            @foreach (var item in FilteredVocab)
            {
                var isLearned = Learned.Contains(item.En);
                <div class="vocab-card @(isLearned ? "is-learned" : "")">
                    <div class="vocab-card-header">
                        <div class="vocab-card-badges">
                            <span class="vocab-group-tag">@_groupLabels.GetValueOrDefault(item.Group, item.Group)</span>
                            <span class="vocab-kind-tag">@item.Kind</span>
                            @if (item.Common)
                            {
                                <span class="vocab-badge-fire" title="Từ vựng đời thường quen thuộc"><i class="bi bi-fire"></i> Common</span>
                            }
                            @if (item.Priority)
                            {
                                <span class="vocab-badge-star" title="Từ vựng ưu tiên"><i class="bi bi-star-fill"></i> Priority</span>
                            }
                            @if (item.Extra)
                            {
                                <span class="vocab-badge-tech" title="Thuật ngữ Web & DevOps"><i class="bi bi-cpu"></i> Tech</span>
                            }
                        </div>

                        <button type="button"
                                class="vocab-learn-check @(isLearned ? "active" : "")"
                                @onclick="() => ToggleLearn(item.En)"
                                title="@(isLearned ? "Đã thuộc (Bấm để hủy)" : "Đánh dấu đã thuộc")">
                            <i class="bi @(isLearned ? "bi-check-circle-fill" : "bi-circle")"></i>
                        </button>
                    </div>

                    <div class="vocab-card-main">
                        <div class="vocab-word-row">
                            <h3 class="vocab-en-text" lang="en">@item.En</h3>
                            @if (Speak != null)
                            {
                                <button type="button" class="vocab-tts-btn" @onclick="() => Speak(item.En)" title="Nghe phát âm từ này">
                                    <i class="bi bi-volume-up-fill"></i>
                                </button>
                            }
                        </div>
                        <p class="vocab-vi-text">@item.Vi</p>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(item.Ex))
                    {
                        <div class="vocab-example-box">
                            <div class="vocab-example-header">
                                <span>Ví dụ giao tiếp thực tế:</span>
                                @if (Speak != null)
                                {
                                    <button type="button" class="vocab-tts-btn sm" @onclick="() => Speak(item.Ex)" title="Nghe cả câu">
                                        <i class="bi bi-play-circle"></i> Nghe
                                    </button>
                                }
                            </div>
                            <p class="vocab-ex-text" lang="en">“@item.Ex”</p>
                        </div>
                    }
                </div>
            }
        }
        else
        {
            <div class="vocab-empty-box">
                <i class="bi bi-search"></i>
                <p>Không tìm thấy từ vựng nào khớp với bộ lọc đã chọn.</p>
                <button type="button" class="vocab-reset-btn" @onclick="ResetFilters">Xóa toàn bộ bộ lọc</button>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public SpeakingData Data { get; set; } = default!;
    [Parameter] public string? InitialGroup { get; set; }
    [Parameter] public HashSet<string> Learned { get; set; } = new();
    [Parameter] public Action<string> ToggleLearn { get; set; } = default!;
    [Parameter] public Func<string, Task>? Speak { get; set; }

    private string _search = "";
    private string _selectedGroup = "all";
    private string _selectedFilter = "all";
    private string _selectedKind = "all";

    private readonly Dictionary<string, string> _groupLabels = new()
    {
        ["routine"] = "☀️ Sinh hoạt & Cuối tuần (25)",
        ["work"] = "💼 Công việc & Thể thao (25)",
        ["tech"] = "🤖 AI & DevOps trong IT (50)",
        ["food"] = "🍜 Ăn uống & Nấu ăn (26)",
        ["travel"] = "✈️ Du lịch & Đi lại (25)",
        ["shopping"] = "💳 Mua sắm & Tiền bạc (25)",
        ["family"] = "👨‍👩‍👧 Gia đình & Bạn bè (25)",
        ["home"] = "🏡 Nhà ở & Không gian sống (24)",
        ["health"] = "🏃 Sức khỏe & Lối sống (25)",
        ["weather"] = "🌤️ Thời tiết & Ngoài trời (25)",
        ["entertainment"] = "🎬 Giải trí, Phim & Nhạc (25)",
        ["english"] = "📚 Học tập & Tiếng Anh (24)",
        ["plans"] = "🎯 Kế hoạch & Mục tiêu tương lai (25)",
        ["communication"] = "🗣️ Giao tiếp & Làm việc nhóm (25)",
        ["short"] = "📱 Video ngắn & TikTok (16)",
        ["life"] = "🌐 AI tác động đời sống (16)",
        ["focus"] = "🧠 Tập trung & Năng suất (24)",
        ["sign"] = "⚡ Mẫu câu nối & Cứu nguy (20)",
    };

    private readonly List<KeyValuePair<string, string>> _quickChips = new()
    {
        new("routine", "☀️ Sinh hoạt"),
        new("work", "💼 Công việc"),
        new("tech", "🤖 AI & IT"),
        new("food", "🍜 Ăn uống"),
        new("travel", "✈️ Du lịch"),
        new("shopping", "💳 Mua sắm"),
        new("entertainment", "🎬 Giải trí"),
        new("family", "👨‍👩‍👧 Gia đình"),
        new("health", "🏃 Sức khỏe"),
        new("short", "📱 TikTok"),
        new("english", "📚 Tiếng Anh"),
        new("communication", "🗣️ Giao tiếp"),
        new("plans", "🎯 Kế hoạch"),
        new("focus", "🧠 Tập trung"),
        new("home", "🏡 Nhà cửa"),
        new("weather", "🌤️ Thời tiết"),
        new("sign", "⚡ Câu cứu nguy"),
    };

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(InitialGroup) && _groupLabels.ContainsKey(InitialGroup))
        {
            _selectedGroup = InitialGroup;
        }
    }

    private List<VocabItem> FilteredVocab
    {
        get
        {
            var q = Data.Vocab.AsEnumerable();

            if (_selectedGroup != "all")
            {
                q = q.Where(v => v.Group == _selectedGroup);
            }

            if (_selectedFilter == "common") q = q.Where(v => v.Common);
            else if (_selectedFilter == "priority") q = q.Where(v => v.Priority);
            else if (_selectedFilter == "extra") q = q.Where(v => v.Extra);
            else if (_selectedFilter == "learned") q = q.Where(v => Learned.Contains(v.En));
            else if (_selectedFilter == "unlearned") q = q.Where(v => !Learned.Contains(v.En));

            if (_selectedKind != "all")
            {
                var k = _selectedKind.ToLowerInvariant();
                q = q.Where(v => (v.Kind ?? "").ToLowerInvariant().Contains(k));
            }

            if (!string.IsNullOrWhiteSpace(_search))
            {
                var s = _search.Trim().ToLowerInvariant();
                q = q.Where(v =>
                    v.En.ToLowerInvariant().Contains(s) ||
                    v.Vi.ToLowerInvariant().Contains(s) ||
                    (v.Ex ?? "").ToLowerInvariant().Contains(s));
            }

            return q.ToList();
        }
    }

    private void ResetFilters()
    {
        _search = "";
        _selectedGroup = "all";
        _selectedFilter = "all";
        _selectedKind = "all";
    }
}
