@using BlazorWasmPortfolioGhAction.Components.ToolShell

<ToolShell Title="CIDR Calculator" Icon="bi-diagram-3" Description="Convert between IP ranges and CIDR notation (IPv4/IPv6).">
    <div class="tool-grid-2">
        <div class="tool-card tool-card-nested">
            <h4>IP range → CIDR</h4>
            <form class="tool-form" @onsubmit="GetCIDR" @onsubmit:preventDefault="true">
                <div class="tool-field">
                    <label class="tool-label">Start IP</label>
                    <input class="tool-input" placeholder="10.0.0.0" @bind="IPRange2CIDRModel.StartIP" @bind:event="oninput" />
                </div>
                <div class="tool-field">
                    <label class="tool-label">End IP</label>
                    <input class="tool-input" placeholder="10.0.0.255" @bind="IPRange2CIDRModel.EndIP" @bind:event="oninput" />
                </div>
                <div class="tool-actions">
                    <button type="submit" class="tool-btn tool-btn-primary">Get CIDR</button>
                </div>
            </form>
            @if (CIDRs.Any())
            {
                <div class="tool-result">
                    @foreach (var cidr in CIDRs)
                    {
                        <div>@cidr</div>
                    }
                </div>
            }
        </div>

        <div class="tool-card tool-card-nested">
            <h4>CIDR → IP range</h4>
            <form class="tool-form" @onsubmit="GetIPRange" @onsubmit:preventDefault="true">
                <div class="tool-field">
                    <label class="tool-label">CIDR</label>
                    <input class="tool-input" placeholder="10.0.0.0/24" @bind="CIDR2IPRangeModel.CIDR" @bind:event="oninput" />
                </div>
                <div class="tool-actions">
                    <button type="submit" class="tool-btn tool-btn-primary">Get IP range</button>
                </div>
            </form>
            @if (!string.IsNullOrWhiteSpace(IPRangeStart) && !string.IsNullOrWhiteSpace(IPRangeEnd))
            {
                <div class="tool-result">
                    <div><span class="tool-result-label">Start</span> @IPRangeStart</div>
                    <div><span class="tool-result-label">End</span> @IPRangeEnd</div>
                </div>
            }
        </div>
    </div>
</ToolShell>
