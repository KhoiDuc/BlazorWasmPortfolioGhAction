        new("converter", "Unit Converters", "bi-arrow-left-right", "Hex, memory, and time converters.", "General Tools"),
        new("stringconverter", "String Converter", "bi-fonts", "Change text casing and formats.", "General Tools"),
        new("geminispellchecker", "Spell Checker (Gemini)", "bi-spellcheck", "Vietnamese spell check via Gemini.", "General Tools"),
        new("randomfact", "Random Fact", "bi-lightbulb", "Fetch a random fact from the web.", "General Tools"),
        new("jokequotes", "Joke Quotes", "bi-emoji-laughing", "Random jokes with category filters.", "General Tools"),
        new("sqlite", "SQLite Integration", "bi-database", "Client-side SQLite + EF Core demo.", "SQL Tools"),
        new("jwt", "JWT Debugger", "bi-shield-lock", "Inspect JWT header, payload, signature.", "Cryptography Tools"),
        new("luhn", "Luhn Checker", "bi-credit-card", "Validate numbers with Luhn algorithm.", "Cryptography Tools"),
        new("cryptography", "MD5 / Hash", "bi-fingerprint", "Generate MD5 hashes from text.", "Cryptography Tools"),
        new("mathcalculator", "Math Calculator", "bi-calculator", "Squaring and perimeter demos.", "Time & Calculation Tools"),
        new("overnightmintemp", "Min Temp Calculator", "bi-thermometer-half", "Estimate overnight minimum temperature.", "Time & Calculation Tools"),
        new("cidrcalculator", "CIDR Calculator", "bi-diagram-3", "Convert IP ranges and CIDR notation.", "Time & Calculation Tools"),
        new("timerstopwatch", "Timer / Stopwatch", "bi-stopwatch", "Countdown timer and stopwatch.", "Time & Calculation Tools"),
        new("epoch", "Epoch Converter", "bi-clock-history", "Unix timestamp to readable dates.", "Time & Calculation Tools"),
