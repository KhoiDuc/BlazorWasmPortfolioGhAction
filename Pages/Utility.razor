@page "/Utility/{Component?}"
@inherits CultureAwareComponent
@inject IStringLocalizer<SharedResources> L
@using BlazorWasmPortfolioGhAction.Components.Ascii
@using BlazorWasmPortfolioGhAction.Components.Teams
@using BlazorWasmPortfolioGhAction.Components.Github
@inject NavigationManager Navigation

<div class="page-section utility-deck">
    <section>
        <div class="container">
            <header class="utility-deck-header">
                <div class="utility-deck-intro">
                    <p class="section-label">@L["Utility_Label"]</p>
                    <h2>@L["Utility_Title"]</h2>
                    <p class="utility-deck-lead">@L["Utility_Lead"]</p>
                </div>

                <div class="utility-deck-controls">
                    <div class="utility-deck-search">
                        <i class="bi bi-search" aria-hidden="true"></i>
                        <input id="utility-filter"
                               type="search"
                               class="utility-deck-search-input"
                               placeholder="@L["Utility_SearchPlaceholder"]"
                               @bind="_filter"
                               @bind:event="oninput"
                               aria-label="@L["Utility_SearchAria"]" />
                    </div>

            @if (Component == null)
            {
                <div class="utility-deck-pills" role="tablist" aria-label="@L["Utility_CategoriesAria"]">
                    <button type="button"
                            class="utility-pill @(_activeCategory == null ? "is-active" : "")"
                            @onclick="SelectAllCategories">
                        @L["Utility_All"]
                    </button>
                    @foreach (var category in Categories)
                    {
                        var cat = category;
                        <button type="button"
                                class="utility-pill @(_activeCategory == cat ? "is-active" : "")"
                                @onclick="() => SelectCategory(cat)">
                            @LocalizeCategory(cat)
                        </button>
                    }
                </div>
            }
                </div>
            </header>

            @if (Component == null)
            {
                <div class="utility-launcher">
                    @foreach (var group in LauncherGroups)
                    {
                        <section class="utility-launch-group" aria-labelledby="@($"utility-group-{group.CategoryKey}")">
                            <h3 id="@($"utility-group-{group.CategoryKey}")" class="utility-launch-group-title">
                                <i class="bi @group.Icon" aria-hidden="true"></i>
                                @LocalizeCategory(group.CategoryKey)
                                <span class="utility-launch-count">@group.Tools.Count</span>
                            </h3>
                            <div class="utility-launch-grid">
                                @foreach (var tool in group.Tools)
                                {
                                    <NavLink href="@tool.Link" class="utility-launch-card">
                                        <span class="utility-launch-icon" aria-hidden="true">
                                            <i class="bi @tool.Icon"></i>
                                        </span>
                                        <span class="utility-launch-body">
                                            <strong>@L[tool.TitleKey]</strong>
                                            <span>@L[tool.DescKey]</span>
                                        </span>
                                        <i class="bi bi-arrow-up-right utility-launch-arrow" aria-hidden="true"></i>
                                    </NavLink>
                                }
                            </div>
                        </section>
                    }

                    @if (!LauncherGroups.Any())
                    {
                        <div class="utility-launch-empty">
                            <i class="bi bi-search" aria-hidden="true"></i>
                            <h3>@L["Utility_NoToolsTitle"]</h3>
                            <p>@L["Utility_NoToolsLead"]</p>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="utility-workspace">
                    <div class="utility-workspace-bar">
                        <NavLink href="Utility" class="utility-back-link">
                            <i class="bi bi-grid-3x3-gap" aria-hidden="true"></i>
                            @L["Utility_AllTools"]
                        </NavLink>
                        <div class="utility-workspace-meta">
                            @if (ActiveTool is not null)
                            {
                                <span class="utility-workspace-category">@LocalizeCategory(ActiveTool.CategoryKey)</span>
                                <h3>@L[ActiveTool.TitleKey]</h3>
                            }
                        </div>
                        <div class="utility-workspace-switch">
                            <label class="visually-hidden" for="utility-switch">@L["Utility_SwitchTool"]</label>
                            <select id="utility-switch"
                                    class="utility-switch-select"
                                    value="@Component"
                                    @onchange="OnToolSwitch">
                                @foreach (var tool in AllTools.OrderBy(t => L[t.TitleKey].Value))
                                {
                                    <option value="@tool.Key">@L[tool.TitleKey]</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="utility-workspace-panel">
                        @DynamicComponent
                    </div>
                </div>
            }
        </div>
    </section>
</div>

@code {
    [Parameter]
    public string? Component { get; set; }

    private string _filter = "";
    private string? _activeCategory;

    private IEnumerable<string> Categories => AllTools.Select(t => t.CategoryKey).Distinct().OrderBy(c => LocalizeCategory(c));

    private ToolDef? ActiveTool =>
        AllTools.FirstOrDefault(t => string.Equals(t.Key, Component, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<LaunchGroup> LauncherGroups
    {
        get
        {
            var tools = FilteredTools.ToList();
            return tools
                .GroupBy(t => t.CategoryKey)
                .OrderBy(g => LocalizeCategory(g.Key))
                .Select(g => new LaunchGroup(
                    g.Key,
                    CategoryIcons.GetValueOrDefault(g.Key, "bi-folder2"),
                    g.OrderBy(t => L[t.TitleKey].Value).ToList()));
        }
    }

    private IEnumerable<ToolDef> FilteredTools
    {
        get
        {
            var term = _filter.Trim();
            return AllTools.Where(t =>
                (_activeCategory == null || t.CategoryKey == _activeCategory)
                && (string.IsNullOrEmpty(term)
                    || L[t.TitleKey].Value.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || L[t.DescKey].Value.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || LocalizeCategory(t.CategoryKey).Contains(term, StringComparison.OrdinalIgnoreCase)));
        }
    }

    private string LocalizeCategory(string categoryKey) => categoryKey switch
    {
        "General Tools" => L["Cat_General"],
        "SQL Tools" => L["Cat_SQL"],
        "Cryptography Tools" => L["Cat_Crypto"],
        "Time & Calculation Tools" => L["Cat_TimeCalc"],
        "Encoding & Format Tools" => L["Cat_Encoding"],
        "Testing Library Tools" => L["Cat_Testing"],
        "DevOps Tools" => L["Cat_DevOps"],
        _ => categoryKey
    };

    private void SelectAllCategories() => SelectCategory(null);

    private void SelectCategory(string? category)
    {
        _activeCategory = category;
        if (Component is not null)
            Navigation.NavigateTo("Utility");
    }

    private void OnToolSwitch(ChangeEventArgs e)
    {
        var key = e.Value?.ToString();
        if (!string.IsNullOrEmpty(key))
            Navigation.NavigateTo($"Utility/{key}");
    }

    private RenderFragment DynamicComponent => (Component?.ToLowerInvariant()) switch
    {
        "base64" => RenderComponent<BlazorWasmPortfolioGhAction.Components.Base64.Base64>(),
        "map" => RenderComponent<BlazorWasmPortfolioGhAction.Components.MapComponent>(),
        "bigbangcounter" => RenderComponent<BigBangCounter>(),
        "mathcalculator" => RenderComponent<MathCalculator>(),
        "browserstorage" => RenderComponent<BrowserStorageWasm>(),
        "webglrender" => RenderComponent<WebGLRender>(),
        "overnightmintemp" => RenderComponent<OvernightMinTemp>(),
        "cidrcalculator" => RenderComponent<CIDRCalculator>(),
        "geminispellchecker" => RenderComponent<GeminiSpellChecker>(),
        "currenttime" => RenderComponent<CurrentTime>(),
        "ascii" => RenderComponent<BlazorWasmPortfolioGhAction.Components.Ascii.Ascii>(),
        "urls" => RenderUrlComponents(),
        "guid" => RenderComponent<BlazorWasmPortfolioGhAction.Components.GuidGenerator.GuidGenerator>(),
        "sqlite" => RenderComponent<Sqlite>(),
        "html" => RenderComponent<BlazorWasmPortfolioGhAction.Components.HTMLEncodeDecode.HTMLEncodeDecode>(),
        "markdown" => RenderComponent<BlazorWasmPortfolioGhAction.Components.MarkdownConverter.MarkdownConverter>(),
        "timerstopwatch" => RenderTimerStopwatchComponents(),
        "colourconverter" => RenderComponent<BlazorWasmPortfolioGhAction.Components.HexToRGB.HexToRGB>(),
        "binary" => RenderComponent<BlazorWasmPortfolioGhAction.Components.Binary.Binary>(),
        "stringconverter" => RenderComponent<BlazorWasmPortfolioGhAction.Components.StringConverter.StringConverter>(),
        "epoch" => RenderComponent<BlazorWasmPortfolioGhAction.Components.EpochConverter.EpochConverter>(),
        "converter" => RenderConverterComponents(),
        "jwt" => RenderComponent<BlazorWasmPortfolioGhAction.Components.JWTDebugger.JWTDebugger>(),
        "luhn" => RenderComponent<BlazorWasmPortfolioGhAction.Components.LuhnChecker.LuhnChecker>(),
        "hcf" => RenderComponent<BlazorWasmPortfolioGhAction.Components.HCF.HCF>(),
        "unicode" => RenderComponent<BlazorWasmPortfolioGhAction.Components.UnicodePicker.UnicodePicker>(),
        "cryptography" => RenderComponent<BlazorWasmPortfolioGhAction.Components.MD5Converter.MD5Converter>(),
        "fluxortest" => RenderFluxorTestComponents(),
        "qrgenerator" => RenderComponent<QRGenerator>(),
        "randomfact" => RenderComponent<RandomFacts>(),
        "jokequotes" => RenderComponent<JokeQuotes>(),
        "svgdiagrameditor" => RenderComponent<SvgDiagramEditor>(),
        "emailcomposer" => RenderComponent<BlazorWasmPortfolioGhAction.Components.EmailComposer.EmailComposer>(),
        "discord" => RenderComponent<BlazorWasmPortfolioGhAction.Components.Discord.DiscordNotifier>(),
        "slack" => RenderComponent<BlazorWasmPortfolioGhAction.Components.Slack.SlackNotifier>(),
        "teams" => RenderComponent<TeamsNotifier>(),
        "githubsearch" => RenderComponent<GitHubSearcher>(),
        "githubinspector" => RenderComponent<GitHubInspector>(),
        "githubtrending" => RenderComponent<GitHubTrending>(),
        "gist" => RenderComponent<GistCreator>(),
        _ => RenderDefaultComponent()
    };

    private RenderFragment RenderComponent<TComponent>() where TComponent : IComponent => builder =>
    {
        builder.OpenComponent<TComponent>(0);
        builder.CloseComponent();
    };

    private RenderFragment RenderUrlComponents() => builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "utility-tool-stack");
        builder.OpenComponent<BlazorWasmPortfolioGhAction.Components.UrlSplitter.UrlSplitter>(2);
        builder.CloseComponent();
        builder.OpenComponent<BlazorWasmPortfolioGhAction.Components.UrlEncode.UrlEncode>(3);
        builder.CloseComponent();
        builder.CloseElement();
    };

    private RenderFragment RenderTimerStopwatchComponents() => builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "utility-tool-stack");
        builder.OpenComponent<BlazorWasmPortfolioGhAction.Components.TimerControl.TimerControl>(2);
        builder.AddAttribute(3, "Input", "5m 00s");
        builder.CloseComponent();
        builder.OpenComponent<BlazorWasmPortfolioGhAction.Components.Stopwatch.Stopwatch>(4);
        builder.AddAttribute(5, "Input", "0s 00");
        builder.CloseComponent();
        builder.CloseElement();
    };

    private RenderFragment RenderConverterComponents() => builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "utility-tool-stack");
        builder.OpenComponent<BlazorWasmPortfolioGhAction.Components.HextoDec.HextoDec>(2);
        builder.CloseComponent();
        builder.OpenComponent<BlazorWasmPortfolioGhAction.Components.MemoryConverter.MemoryConverter>(3);
        builder.CloseComponent();
        builder.OpenComponent<BlazorWasmPortfolioGhAction.Components.TimeConverter.TimeConverter>(4);
        builder.CloseComponent();
        builder.CloseElement();
    };

    private RenderFragment RenderFluxorTestComponents() => builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "utility-tool-stack");
        builder.OpenComponent<BlazorWasmPortfolioGhAction.Components.FluxorExample.FirstComponent>(2);
        builder.CloseComponent();
        builder.OpenComponent<BlazorWasmPortfolioGhAction.Components.FluxorExample.SecondComponent>(3);
        builder.CloseComponent();
        builder.OpenComponent<BlazorWasmPortfolioGhAction.Components.FluxorExample.FetchData>(4);
        builder.CloseComponent();
        builder.OpenComponent<BlazorWasmPortfolioGhAction.Components.FluxorExample.Counter>(5);
        builder.CloseComponent();
        builder.CloseElement();
    };

    private RenderFragment RenderDefaultComponent() => builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "utility-unknown tool-alert tool-alert-info");
        builder.AddContent(2, L["Utility_Unknown"]);
        builder.CloseElement();
    };

    private static readonly Dictionary<string, string> CategoryIcons = new(StringComparer.OrdinalIgnoreCase)
    {
        ["General Tools"] = "bi-box-seam",
        ["SQL Tools"] = "bi-database",
        ["Cryptography Tools"] = "bi-shield-lock",
        ["Time & Calculation Tools"] = "bi-calculator",
        ["Encoding & Format Tools"] = "bi-braces",
        ["Testing Library Tools"] = "bi-bezier2",
        ["DevOps Tools"] = "bi-rocket-takeoff"
    };

    private static readonly List<ToolDef> AllTools = new()
    {
        new("base64", "bi-file-binary", "General Tools"),
        new("urls", "bi-link-45deg", "General Tools"),
        new("guid", "bi-hash", "General Tools"),
        new("html", "bi-code-slash", "General Tools"),
        new("markdown", "bi-markdown", "General Tools"),
        new("converter", "bi-arrow-left-right", "General Tools"),
        new("stringconverter", "bi-fonts", "General Tools"),
        new("geminispellchecker", "bi-spellcheck", "General Tools"),
        new("randomfact", "bi-lightbulb", "General Tools"),
        new("jokequotes", "bi-emoji-laughing", "General Tools"),
        new("sqlite", "bi-database", "SQL Tools"),
        new("jwt", "bi-shield-lock", "Cryptography Tools"),
        new("luhn", "bi-credit-card", "Cryptography Tools"),
        new("cryptography", "bi-fingerprint", "Cryptography Tools"),
        new("mathcalculator", "bi-calculator", "Time & Calculation Tools"),
        new("overnightmintemp", "bi-thermometer-half", "Time & Calculation Tools"),
        new("cidrcalculator", "bi-diagram-3", "Time & Calculation Tools"),
        new("timerstopwatch", "bi-stopwatch", "Time & Calculation Tools"),
        new("epoch", "bi-clock-history", "Time & Calculation Tools"),
        new("currenttime", "bi-clock", "Time & Calculation Tools"),
        new("ascii", "bi-keyboard", "Encoding & Format Tools"),
        new("colourconverter", "bi-palette", "Encoding & Format Tools"),
        new("binary", "bi-0-circle", "Encoding & Format Tools"),
        new("unicode", "bi-translate", "Encoding & Format Tools"),
        new("hcf", "bi-eye", "Encoding & Format Tools"),
        new("fluxortest", "bi-boxes", "Testing Library Tools"),
        new("webglrender", "bi-gpu-card", "Testing Library Tools"),
        new("browserstorage", "bi-hdd-stack", "Testing Library Tools"),
        new("qrgenerator", "bi-qr-code", "Testing Library Tools"),
        new("map", "bi-geo-alt", "Testing Library Tools"),
        new("bigbangcounter", "bi-stars", "Testing Library Tools"),
        new("svgdiagrameditor", "bi-diagram-2", "Testing Library Tools"),
        new("emailcomposer", "bi-envelope", "Testing Library Tools"),
        new("discord", "bi-discord", "DevOps Tools"),
        new("slack", "bi-slack", "DevOps Tools"),
        new("teams", "bi-microsoft-teams", "DevOps Tools"),
        new("githubsearch", "bi-search", "DevOps Tools"),
        new("githubinspector", "bi-person-badge", "DevOps Tools"),
        new("githubtrending", "bi-graph-up-arrow", "DevOps Tools"),
        new("gist", "bi-file-earmark-code", "DevOps Tools")
    };

    private record ToolDef(string Key, string Icon, string CategoryKey)
    {
        public string Link => $"Utility/{Key}";
        public string TitleKey => $"Tool_{Key}_Title";
        public string DescKey => $"Tool_{Key}_Desc";
    }

    private record LaunchGroup(string CategoryKey, string Icon, List<ToolDef> Tools);
}
