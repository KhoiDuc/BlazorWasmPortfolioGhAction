@page "/Utility/{Component?}"
@using BlazorWasmPortfolioGhAction.Components.Ascii
@using BlazorWasmPortfolioGhAction.Components.Teams
@using BlazorWasmPortfolioGhAction.Components.Github
@inject NavigationManager Navigation

<div class="page-section utility-page">
    <section>
        <div class="container">
            <div class="section-heading">
                <p class="section-label">TOOLS</p>
                <h2>Developer utilities.</h2>
                <p class="utility-lead">Browse converters, DevOps helpers, and experimental tools in one place.</p>
            </div>

            <div class="utility-layout">
                <aside class="utility-sidebar" aria-label="Tool navigation">
                    <div class="utility-sidebar-search">
                        <label class="tool-label" for="utility-filter">Filter tools</label>
                        <input id="utility-filter"
                               type="search"
                               class="tool-input"
                               placeholder="Search by name..."
                               @bind="_filter"
                               @bind:event="oninput" />
                    </div>

                    <nav class="utility-nav">
                        @foreach (var category in FilteredCategories)
                        {
                            <details class="nav-group" open="@IsCategoryOpen(category)">
                                <summary class="nav-group-title">@category.CategoryName</summary>
                                <ul class="nav-group-items">
                                    @foreach (var item in category.Items)
                                    {
                                        <li>
                                            <NavLink href="@item.Link" class="nav-item" Match="NavLinkMatch.All">
                                                @item.Text
                                            </NavLink>
                                        </li>
                                    }
                                </ul>
                            </details>
                        }
                    </nav>
                </aside>

                <div class="utility-main">
                    @if (Component == null)
                    {
                        <div class="utility-empty tool-card">
                            <i class="bi bi-tools" aria-hidden="true"></i>
                            <h3>Select a tool</h3>
                            <p>Pick a utility from the sidebar or use the filter to find one quickly.</p>
                        </div>
                    }
                    else
                    {
                        <div class="utility-tool-body">
                            @DynamicComponent
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>
</div>

@code {
    [Parameter]
    public string? Component { get; set; }

    private string _filter = "";

    private IEnumerable<NavCategory> FilteredCategories
    {
        get
        {
            var term = _filter.Trim();
            return NavigationItems
                .Select(cat => new NavCategory
                {
                    CategoryName = cat.CategoryName,
                    Items = cat.Items
                        .Where(i => string.IsNullOrEmpty(term)
                            || i.Text.Contains(term, StringComparison.OrdinalIgnoreCase)
                            || cat.CategoryName.Contains(term, StringComparison.OrdinalIgnoreCase))
                        .ToList()
                })
                .Where(cat => cat.Items.Count > 0);
        }
    }

    private bool IsCategoryOpen(NavCategory category) =>
        !string.IsNullOrWhiteSpace(_filter)
        || category.Items.Any(i => IsActiveLink(i.Link));

    private bool IsActiveLink(string link) =>
        Navigation.Uri.Contains(link, StringComparison.OrdinalIgnoreCase);

    private RenderFragment DynamicComponent => (Component?.ToLowerInvariant()) switch
    {
        "base64" => RenderComponent<BlazorWasmPortfolioGhAction.Components.Base64.Base64>(),
        "map" => RenderComponent<BlazorWasmPortfolioGhAction.Components.MapComponent>(),
        "bigbangcounter" => RenderComponent<BigBangCounter>(),
        "mathcalculator" => RenderComponent<MathCalculator>(),
        "browserstorage" => RenderComponent<BrowserStorageWasm>(),
        "webglrender" => RenderComponent<WebGLRender>(),
        "overnightmintemp" => RenderComponent<OvernightMinTemp>(),
        "cidrcalculator" => RenderComponent<CIDRCalculator>(),
        "geminispellchecker" => RenderComponent<GeminiSpellChecker>(),
        "currenttime" => RenderComponent<CurrentTime>(),
        "ascii" => RenderComponent<BlazorWasmPortfolioGhAction.Components.Ascii.Ascii>(),
        "urls" => RenderUrlComponents(),
        "guid" => RenderComponent<BlazorWasmPortfolioGhAction.Components.GuidGenerator.GuidGenerator>(),
        "sqlite" => RenderComponent<Sqlite>(),
        "html" => RenderComponent<BlazorWasmPortfolioGhAction.Components.HTMLEncodeDecode.HTMLEncodeDecode>(),
        "markdown" => RenderComponent<BlazorWasmPortfolioGhAction.Components.MarkdownConverter.MarkdownConverter>(),
        "timerstopwatch" => RenderTimerStopwatchComponents(),
        "colourconverter" => RenderComponent<BlazorWasmPortfolioGhAction.Components.HexToRGB.HexToRGB>(),
        "binary" => RenderComponent<BlazorWasmPortfolioGhAction.Components.Binary.Binary>(),
        "stringconverter" => RenderComponent<BlazorWasmPortfolioGhAction.Components.StringConverter.StringConverter>(),
        "epoch" => RenderComponent<BlazorWasmPortfolioGhAction.Components.EpochConverter.EpochConverter>(),
        "converter" => RenderConverterComponents(),
        "jwt" => RenderComponent<BlazorWasmPortfolioGhAction.Components.JWTDebugger.JWTDebugger>(),
        "luhn" => RenderComponent<BlazorWasmPortfolioGhAction.Components.LuhnChecker.LuhnChecker>(),
        "hcf" => RenderComponent<BlazorWasmPortfolioGhAction.Components.HCF.HCF>(),
        "unicode" => RenderComponent<BlazorWasmPortfolioGhAction.Components.UnicodePicker.UnicodePicker>(),
        "cryptography" => RenderComponent<BlazorWasmPortfolioGhAction.Components.MD5Converter.MD5Converter>(),
        "fluxortest" => RenderFluxorTestComponents(),
        "qrgenerator" => RenderComponent<QRGenerator>(),
        "randomfact" => RenderComponent<RandomFacts>(),
        "jokequotes" => RenderComponent<JokeQuotes>(),
        "svgdiagrameditor" => RenderComponent<SvgDiagramEditor>(),
        "emailcomposer" => RenderComponent<BlazorWasmPortfolioGhAction.Components.EmailComposer.EmailComposer>(),
        "discord" => RenderComponent<BlazorWasmPortfolioGhAction.Components.Discord.DiscordNotifier>(),
        "slack" => RenderComponent<BlazorWasmPortfolioGhAction.Components.Slack.SlackNotifier>(),
        "teams" => RenderComponent<TeamsNotifier>(),
        "githubsearch" => RenderComponent<GitHubSearcher>(),
        "githubinspector" => RenderComponent<GitHubInspector>(),
        "githubtrending" => RenderComponent<GitHubTrending>(),
        "gist" => RenderComponent<GistCreator>(),
        _ => RenderDefaultComponent()
    };

    private static readonly List<(string Key, string Title)> AllItems = new()
    {
        ("base64", "Base64"), ("map", "Google Maps"), ("bigbangcounter", "Big Bang Counter"),
        ("mathcalculator", "Math Calculator"), ("browserstorage", "Browser Storage WASM"),
        ("webglrender", "WebGL Canvas"), ("overnightmintemp", "Min Temp Calculator"),
        ("cidrcalculator", "CIDR Calculator"), ("geminispellchecker", "Spell Checker (Gemini)"),
        ("currenttime", "Current Time"), ("ascii", "ASCII"), ("urls", "URL Tools"),
        ("guid", "GUID Generator"), ("sqlite", "SQLite Integration"), ("html", "HTML Encode/Decode"),
        ("markdown", "Markdown Converter"), ("timerstopwatch", "Timer / Stopwatch"),
        ("colourconverter", "Colour Converter"), ("binary", "Binary"), ("stringconverter", "String Converter"),
        ("epoch", "Epoch Converter"), ("converter", "Unit Converters"), ("jwt", "JWT Debugger"),
        ("luhn", "Luhn Checker"), ("hcf", "Hidden Char Finder"), ("unicode", "Unicode Picker"),
        ("cryptography", "MD5 / Hash"), ("fluxortest", "Fluxor Test"), ("qrgenerator", "QR Generator"),
        ("randomfact", "Random Fact"), ("jokequotes", "Joke Quotes"), ("svgdiagrameditor", "SVG Diagram Editor"),
        ("emailcomposer", "Email Composer"), ("discord", "Discord Notifier"), ("slack", "Slack Notifier"),
        ("teams", "Teams Notifier"), ("githubsearch", "GitHub Search"), ("githubinspector", "GitHub Inspector"),
        ("githubtrending", "GitHub Trending"), ("gist", "Gist Creator")
    };

    private RenderFragment RenderComponent<TComponent>() where TComponent : IComponent => builder =>
    {
        builder.OpenComponent<TComponent>(0);
        builder.CloseComponent();
    };

    private RenderFragment RenderUrlComponents() => builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "utility-tool-stack");
        builder.OpenComponent<BlazorWasmPortfolioGhAction.Components.UrlSplitter.UrlSplitter>(2);
        builder.CloseComponent();
        builder.OpenComponent<BlazorWasmPortfolioGhAction.Components.UrlEncode.UrlEncode>(3);
        builder.CloseComponent();
        builder.CloseElement();
    };

    private RenderFragment RenderTimerStopwatchComponents() => builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "utility-tool-stack");
        builder.OpenComponent<BlazorWasmPortfolioGhAction.Components.TimerControl.TimerControl>(2);
        builder.AddAttribute(3, "Input", "5m 00s");
        builder.CloseComponent();
        builder.OpenComponent<BlazorWasmPortfolioGhAction.Components.Stopwatch.Stopwatch>(4);
        builder.AddAttribute(5, "Input", "0s 00");
        builder.CloseComponent();
        builder.CloseElement();
    };

    private RenderFragment RenderConverterComponents() => builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "utility-tool-stack");
        builder.OpenComponent<BlazorWasmPortfolioGhAction.Components.HextoDec.HextoDec>(2);
        builder.CloseComponent();
        builder.OpenComponent<BlazorWasmPortfolioGhAction.Components.MemoryConverter.MemoryConverter>(3);
        builder.CloseComponent();
        builder.OpenComponent<BlazorWasmPortfolioGhAction.Components.TimeConverter.TimeConverter>(4);
        builder.CloseComponent();
        builder.CloseElement();
    };

    private RenderFragment RenderFluxorTestComponents() => builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "utility-tool-stack");
        builder.OpenComponent<BlazorWasmPortfolioGhAction.Components.FluxorExample.FirstComponent>(2);
        builder.CloseComponent();
        builder.OpenComponent<BlazorWasmPortfolioGhAction.Components.FluxorExample.SecondComponent>(3);
        builder.CloseComponent();
        builder.OpenComponent<BlazorWasmPortfolioGhAction.Components.FluxorExample.FetchData>(4);
        builder.CloseComponent();
        builder.OpenComponent<BlazorWasmPortfolioGhAction.Components.FluxorExample.Counter>(5);
        builder.CloseComponent();
        builder.CloseElement();
    };

    private RenderFragment RenderDefaultComponent() => builder =>
    {
        builder.AddMarkupContent(0, "<div class=\"tool-alert tool-alert-info\">Unknown tool. Choose one from the sidebar.</div>");
    };

    private readonly List<NavCategory> NavigationItems = new()
    {
        new NavCategory
        {
            CategoryName = "General Tools",
            Items = new List<NavItem>
            {
                new() { Text = "Base64", Link = "Utility/base64" },
                new() { Text = "Urls", Link = "Utility/urls" },
                new() { Text = "Guid", Link = "Utility/guid" },
                new() { Text = "HTML", Link = "Utility/html" },
                new() { Text = "Markdown", Link = "Utility/markdown" },
                new() { Text = "Converter", Link = "Utility/converter" },
                new() { Text = "String Converter", Link = "Utility/stringconverter" },
                new() { Text = "Spell Checker (Gemini)", Link = "Utility/geminispellchecker" },
                new() { Text = "Random Fact", Link = "Utility/randomfact" },
                new() { Text = "Joke quotes", Link = "Utility/jokequotes" },
            }
        },
        new NavCategory
        {
            CategoryName = "SQL Tools",
            Items = new List<NavItem> { new() { Text = "SQLite Integration", Link = "Utility/sqlite" } }
        },
        new NavCategory
        {
            CategoryName = "Cryptography Tools",
            Items = new List<NavItem>
            {
                new() { Text = "JWT", Link = "Utility/jwt" },
                new() { Text = "Luhn", Link = "Utility/luhn" },
                new() { Text = "Cryptography", Link = "Utility/cryptography" }
            }
        },
        new NavCategory
        {
            CategoryName = "Time & Calculation Tools",
            Items = new List<NavItem>
            {
                new() { Text = "Math Calculator", Link = "Utility/mathcalculator" },
                new() { Text = "Min Temp Calculator", Link = "Utility/overnightmintemp" },
                new() { Text = "CIDR Calculator", Link = "Utility/cidrcalculator" },
                new() { Text = "Timer / Stopwatch", Link = "Utility/timerstopwatch" },
                new() { Text = "Epoch", Link = "Utility/epoch" },
                new() { Text = "Current Time", Link = "Utility/currenttime" }
            }
        },
        new NavCategory
        {
            CategoryName = "Encoding & Format Tools",
            Items = new List<NavItem>
            {
                new() { Text = "Ascii", Link = "Utility/ascii" },
                new() { Text = "Colour Converter", Link = "Utility/colourconverter" },
                new() { Text = "Binary", Link = "Utility/binary" },
                new() { Text = "Unicode", Link = "Utility/unicode" },
                new() { Text = "Hidden Char Finder", Link = "Utility/hcf" }
            }
        },
        new NavCategory
        {
            CategoryName = "Testing Library Tools",
            Items = new List<NavItem>
            {
                new() { Text = "Fluxor Test", Link = "Utility/fluxortest" },
                new() { Text = "WebGL Canvas", Link = "Utility/webglrender" },
                new() { Text = "Browser Storage Wasm", Link = "Utility/browserstorage" },
                new() { Text = "QR Generator", Link = "Utility/qrgenerator" },
                new() { Text = "Google Maps", Link = "Utility/map" },
                new() { Text = "Big Bang Counter", Link = "Utility/bigbangcounter" },
                new() { Text = "Svg Diagram Editor", Link = "Utility/svgdiagrameditor" },
                new() { Text = "Email Composer", Link = "Utility/emailcomposer" }
            }
        },
        new NavCategory
        {
            CategoryName = "DevOps Tools",
            Items = new List<NavItem>
            {
                new() { Text = "Discord Notifier", Link = "Utility/discord" },
                new() { Text = "Slack Notifier", Link = "Utility/slack" },
                new() { Text = "Teams Notifier", Link = "Utility/teams" },
                new() { Text = "GitHub Search", Link = "Utility/githubsearch" },
                new() { Text = "GitHub Inspector", Link = "Utility/githubinspector" },
                new() { Text = "GitHub Trending", Link = "Utility/githubtrending" },
                new() { Text = "Gist Creator", Link = "Utility/gist" }
            }
        }
    };

    public class NavCategory
    {
        public string CategoryName { get; set; } = "";
        public List<NavItem> Items { get; set; } = new();
    }

    public class NavItem
    {
        public string Text { get; set; } = "";
        public string Link { get; set; } = "";
    }
}
