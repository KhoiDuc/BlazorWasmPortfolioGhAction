@page "/Utility/{Component?}"
@page "/{lang:regex(^(en|vn)$)}/Utility/{Component?}"
@inherits CultureAwareComponent
@inject IStringLocalizer<SharedResources> L
@using BlazorWasmPortfolioGhAction.Components.Ascii
@using BlazorWasmPortfolioGhAction.Components.Teams
@using BlazorWasmPortfolioGhAction.Components.OnlineTools
@using BlazorWasmPortfolioGhAction.Components.Github
@using BlazorWasmPortfolioGhAction.Components.CreditCardDemo
@inject NavigationManager Navigation

<div class="page-section utility-deck">
    <section>
        <div class="container">
            <header class="utility-deck-header">
                <div class="utility-deck-intro">
                    <p class="section-label">@L["Utility_Label"]</p>
                    <h2>@L["Utility_Title"]</h2>
                    <p class="utility-deck-lead">@L["Utility_Lead"]</p>
                </div>

                <div class="utility-deck-controls">
                    <div class="utility-deck-search">
                        <i class="bi bi-search" aria-hidden="true"></i>
                        <input id="utility-filter"
                               type="search"
                               class="utility-deck-search-input"
                               placeholder="@L["Utility_SearchPlaceholder"]"
                               @bind="_filter"
                               @bind:event="oninput"
                               aria-label="@L["Utility_SearchAria"]" />
                    </div>

            @if (Component == null)
            {
                <div class="utility-deck-pills" role="tablist" aria-label="@L["Utility_CategoriesAria"]">
                    <button type="button"
                            class="utility-pill @(_activeCategory == null ? "is-active" : "")"
                            @onclick="SelectAllCategories">
                        @L["Utility_All"]
                    </button>
                    @foreach (var category in Categories)
                    {
                        var cat = category;
                        <button type="button"
                                class="utility-pill @(_activeCategory == cat ? "is-active" : "")"
                                @onclick="() => SelectCategory(cat)">
                            @LocalizeCategory(cat)
                        </button>
                    }
                </div>
            }
                </div>
            </header>

            @if (Component == null)
            {
                <div class="utility-launcher">
                    @foreach (var group in LauncherGroups)
                    {
                        <section class="utility-launch-group cat-@(group.CategoryKey.Replace(" & ", "-").Replace(" ", "-").ToLowerInvariant())" aria-labelledby="@($"utility-group-{group.CategoryKey}")" style="@CategoryAccentStyle(group.CategoryKey)">
                            <h3 id="@($"utility-group-{group.CategoryKey}")" class="utility-launch-group-title">
                                <i class="bi @group.Icon" aria-hidden="true"></i>
                                @LocalizeCategory(group.CategoryKey)
                                <span class="utility-launch-count">@group.Tools.Count</span>
                            </h3>
                            <div class="utility-launch-grid">
                                @foreach (var tool in group.Tools)
                                {
                                    <NavLink href="@ToolHref(tool.Key)" class="utility-launch-card">
                                        <span class="utility-launch-icon" aria-hidden="true">
                                            <i class="bi @tool.Icon"></i>
                                        </span>
                                        <span class="utility-launch-body">
                                            <strong>@L[tool.TitleKey]</strong>
                                            <span>@L[tool.DescKey]</span>
                                        </span>
                                        <i class="bi bi-arrow-up-right utility-launch-arrow" aria-hidden="true"></i>
                                    </NavLink>
                                }
                            </div>
                        </section>
                    }

                    @if (!LauncherGroups.Any())
                    {
                        <div class="utility-launch-empty">
                            <i class="bi bi-search" aria-hidden="true"></i>
                            <h3>@L["Utility_NoToolsTitle"]</h3>
                            <p>@L["Utility_NoToolsLead"]</p>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="utility-workspace" @onkeydown="OnWorkspaceKeyDown" tabindex="-1">
                    <div class="utility-workspace-bar">
                        <NavLink href="@UtilityHomeHref" class="utility-back-link" aria-label="@L["Utility_AllTools"]">
                            <i class="bi bi-grid-3x3-gap" aria-hidden="true"></i>
                            <span class="utility-back-link-text">@L["Utility_AllTools"]</span>
                        </NavLink>
                        <div class="utility-workspace-breadcrumb">
                            @if (ActiveTool is not null)
                            {
                                <span class="utility-workspace-category">@LocalizeCategory(ActiveTool.CategoryKey)</span>
                                <i class="bi bi-chevron-right utility-breadcrumb-sep" aria-hidden="true"></i>
                                <h3 class="utility-workspace-title">@L[ActiveTool.TitleKey]</h3>
                            }
                        </div>
                        <div class="utility-workspace-switch">
                            <label class="visually-hidden" for="utility-switch">@L["Utility_SwitchTool"]</label>
                            <input id="utility-switch"
                                   class="utility-switch-input"
                                   type="search"
                                   placeholder="@L["Utility_SwitchTool"]"
                                   value="@_switchQuery"
                                   @oninput="OnSwitchInput"
                                   @onkeydown="OnSwitchKeyDown"
                                   autocomplete="off" />
                            @if (!string.IsNullOrEmpty(_switchQuery) && _switchResults.Any())
                            {
                                <div class="utility-switch-dropdown" role="listbox">
                                    @foreach (var tool in _switchResults.Take(10))
                                    {
                                        <button type="button"
                                                class="utility-switch-option"
                                                role="option"
                                                @onclick="() => SwitchToTool(tool.Key)">
                                            <i class="bi @tool.Icon" aria-hidden="true"></i>
                                            <span>@L[tool.TitleKey]</span>
                                            <small>@LocalizeCategory(tool.CategoryKey)</small>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <div class="utility-workspace-panel">
                        @DynamicComponent
                    </div>
                </div>
            }
        </div>
    </section>
</div>

@code {
    [Parameter]
    public string? Component { get; set; }

    private string _filter = "";
    private string? _activeCategory;

    private IEnumerable<string> Categories => AllTools.Select(t => t.CategoryKey).Distinct().OrderBy(c => LocalizeCategory(c));

    private ToolDef? ActiveTool =>
        AllTools.FirstOrDefault(t => string.Equals(t.Key, Component, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<LaunchGroup> LauncherGroups
    {
        get
        {
            var tools = FilteredTools.ToList();
            return tools
                .GroupBy(t => t.CategoryKey)
                .OrderBy(g => LocalizeCategory(g.Key))
                .Select(g => new LaunchGroup(
                    g.Key,
                    CategoryIcons.GetValueOrDefault(g.Key, "bi-folder2"),
                    g.OrderBy(t => L[t.TitleKey].Value).ToList()));
        }
    }

    private IEnumerable<ToolDef> FilteredTools
    {
        get
        {
            var term = _filter.Trim();
            return AllTools.Where(t =>
                (_activeCategory == null || t.CategoryKey == _activeCategory)
                && (string.IsNullOrEmpty(term)
                    || L[t.TitleKey].Value.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || L[t.DescKey].Value.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || LocalizeCategory(t.CategoryKey).Contains(term, StringComparison.OrdinalIgnoreCase)));
        }
    }

    private string LocalizeCategory(string categoryKey) => categoryKey switch
    {
        "Text & Code" => L["Cat_TextCode"],
        "Converters & Encoding" => L["Cat_Converters"],
        "DevOps & APIs" => L["Cat_DevOpsApis"],
        "Demos & Testing" => L["Cat_DemosTesting"],
        _ => categoryKey
    };

    private string UtilityHomeHref => CulturePath.Combine(CultureService.UrlLang, "Utility");

    private static readonly Dictionary<string, string> CategoryAccents = new(StringComparer.OrdinalIgnoreCase)
    {
        ["Text & Code"] = "var(--color-accent)",
        ["Converters & Encoding"] = "var(--color-info)",
        ["DevOps & APIs"] = "var(--color-success)",
        ["Demos & Testing"] = "var(--color-primary)"
    };

    private static string? CategoryAccentStyle(string categoryKey) =>
        CategoryAccents.TryGetValue(categoryKey, out var accent) ? $"--cat-accent: {accent}" : null;
    private string ToolHref(string key) => CulturePath.Combine(CultureService.UrlLang, $"Utility/{key}");

    private void SelectAllCategories() => SelectCategory(null);

    private void SelectCategory(string? category)
    {
        _activeCategory = category;
        if (Component is not null)
            Navigation.NavigateTo(UtilityHomeHref);
    }

    private string _switchQuery = string.Empty;
    private List<ToolDef> _switchResults = new();

    private void OnSwitchInput(ChangeEventArgs e)
    {
        _switchQuery = e.Value?.ToString() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(_switchQuery))
        {
            _switchResults = new();
            return;
        }
        var q = _switchQuery.Trim();
        _switchResults = AllTools
            .OrderBy(t => L[t.TitleKey].Value)
            .Where(t => L[t.TitleKey].Value.Contains(q, StringComparison.OrdinalIgnoreCase)
                        || t.Key.Contains(q, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private void OnSwitchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _switchQuery = string.Empty;
            _switchResults = new();
        }
        else if (e.Key == "Enter" && _switchResults.Count > 0)
        {
            SwitchToTool(_switchResults[0].Key);
        }
    }

    private void SwitchToTool(string key)
    {
        _switchQuery = string.Empty;
        _switchResults = new();
        Navigation.NavigateTo(ToolHref(key));
    }

    private void OnWorkspaceKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            Navigation.NavigateTo(UtilityHomeHref);
    }

