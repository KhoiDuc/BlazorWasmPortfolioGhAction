@using BlazorWasmPortfolioGhAction.Components.ToolShell
@using BlazorWasmPortfolioGhAction.Components

<ToolShell Title="Math Calculator" Icon="bi-calculator" Description="Simple arithmetic demos with operation history.">
    <div class="tool-radio-group">
        <button type="button" class="tool-btn @(currentOperation == "Squaring a number" ? "tool-btn-primary" : "tool-btn-secondary")" @onclick="ChooseSquaringNumber">Squaring a number</button>
        <button type="button" class="tool-btn @(currentOperation == "Perimeter of a rectangle" ? "tool-btn-primary" : "tool-btn-secondary")" @onclick="ChoosePerimeterRectangle">Perimeter of a rectangle</button>
    </div>

    <div class="tool-card tool-card-nested">
        @if (string.IsNullOrEmpty(currentOperation))
        {
            <p class="tool-hint">Choose an operation above.</p>
        }
        else
        {
            <h4>@currentOperation</h4>
            @if (currentOperation == "Squaring a number")
            {
                <SquaringNumber InstructionParam="@InstructionA" MyCallback="CallbackFunction" />
            }
            @if (currentOperation == "Perimeter of a rectangle")
            {
                <PerimeterRectangle InstructionParam="@InstructionB" MyCallback="CallbackFunction" />
            }
        }
    </div>

    @if (arrayForRendering.Length > 0)
    {
        <div class="tool-result">
            <div class="tool-result-label">History</div>
            @foreach (var element in arrayForRendering)
            {
                <div>@element</div>
            }
        </div>
    }
</ToolShell>

@code {
    private string currentOperation = string.Empty;

    private void ChooseSquaringNumber() => currentOperation = "Squaring a number";
    private void ChoosePerimeterRectangle() => currentOperation = "Perimeter of a rectangle";

    const string InstructionA = "Input X value. You will get result X × X.";
    const string InstructionB = "Input A and B sides of rectangle. You will get result 2 × (A + B).";

    private List<string> historyOperations = new();
    private string[] arrayForRendering = Array.Empty<string>();

    private void CallbackFunction(string content)
    {
        historyOperations.Add(content);
        arrayForRendering = historyOperations.ToArray();
    }
}
