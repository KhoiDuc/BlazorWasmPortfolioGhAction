@page "/design-catalog"
@page "/{lang:regex(^(en|vn)$)}/design-catalog"
@inherits CultureAwareComponent
@inject IStringLocalizer<SharedResources> L

<div class="page-container page-section">
    <h1 class="section-heading gradient-text">UI Design Catalog</h1>
    <p class="section-label">Live reference of every design component used in this project.</p>

    @{
        var sections = new (string Title, string Anchor)[]
        {
            ("Buttons", "buttons"),
            ("Badges", "badges"),
            ("Fields & Inputs", "fields"),
            ("Switches & Toggles", "switches"),
            ("Banners / Alerts", "alerts"),
            ("Cards", "cards"),
            ("Tables", "tables"),
            ("Modals", "modals"),
            ("Spinners & Progress", "spinners"),
            ("Code & Result", "code"),
            ("Stats & Misc", "stats"),
        };
    }
    <nav class="tool-link-list" aria-label="Catalog sections">
        @foreach (var s in sections)
        {
            <a href="#@s.Anchor">@s.Title</a>
        }
    </nav>

    @* ────────────────── BUTTONS ────────────────── *@
    <section id="buttons" class="tool-card-nested">
        <h4><i class="bi bi-hand-index" aria-hidden="true"></i> Buttons</h4>

        <h5 class="tool-subheading">Variants — <code class="tool-inline-code">.tool-btn</code></h5>
        <div class="tool-actions">
            <button class="tool-btn">Default</button>
            <button class="tool-btn tool-btn-primary">Primary</button>
            <button class="tool-btn tool-btn-secondary">Secondary</button>
            <button class="tool-btn tool-btn-success">Success</button>
            <button class="tool-btn tool-btn-danger">Danger</button>
        </div>

        <h5 class="tool-subheading">Hero / legacy — <code class="tool-inline-code">.btn-*</code> &amp; <code class="tool-inline-code">.button-*</code></h5>
        <div class="tool-actions">
            <button class="btn-primary">Hero Primary</button>
            <button class="btn-ghost">Ghost</button>
            <button class="button button-primary">Button Primary</button>
            <button class="button button-secondary">Button Secondary</button>
        </div>

        <h5 class="tool-subheading">Resume / CTA — <code class="tool-inline-code">.resume-btn</code></h5>
        <div class="tool-actions">
            <button class="resume-btn">Resume</button>
            <button class="resume-btn resume-btn-primary">Resume Primary</button>
            <button class="resume-btn resume-btn-ghost">Resume Ghost</button>
        </div>

        <h5 class="tool-subheading">Icon button — <code class="tool-inline-code">.tool-icon-btn</code></h5>
        <div class="tool-actions">
            <button class="tool-icon-btn" aria-label="Copy"><i class="bi bi-clipboard" aria-hidden="true"></i></button>
            <button class="tool-icon-btn" aria-label="Delete"><i class="bi bi-trash" aria-hidden="true"></i></button>
        </div>

        <h5 class="tool-subheading">States — Default / Hover / Focus / Disabled / Loading</h5>
        <div class="tool-actions">
            <button class="tool-btn">Default</button>
            <button class="tool-btn" style="border-color:var(--color-brand-symbol);color:var(--color-brand-symbol);">Hover (forced)</button>
            <button class="tool-btn" style="outline:2px solid var(--color-brand-symbol);outline-offset:2px;">Focus (forced)</button>
            <button class="tool-btn" disabled>Disabled</button>
            <button class="tool-btn" aria-busy="true" disabled>
                <span class="tool-spinner" style="width:1rem;height:1rem;border-width:2px;" role="status" aria-label="Loading"></span>
                Loading…
            </button>
        </div>

        <h5 class="tool-subheading">States — Primary variant</h5>
        <div class="tool-actions">
            <button class="tool-btn tool-btn-primary">Default</button>
            <button class="tool-btn tool-btn-primary" style="background-color:var(--color-accent-hover);border-color:var(--color-accent-hover);">Hover (forced)</button>
            <button class="tool-btn tool-btn-primary" style="outline:2px solid var(--color-brand-symbol);outline-offset:2px;">Focus (forced)</button>
            <button class="tool-btn tool-btn-primary" disabled>Disabled</button>
            <button class="tool-btn tool-btn-primary" aria-busy="true" disabled>
                <span class="tool-spinner" style="width:1rem;height:1rem;border-width:2px;border-color:var(--color-text-on-accent);border-top-color:transparent;" role="status" aria-label="Loading"></span>
                Loading…
            </button>
        </div>

        <h5 class="tool-subheading">States — Danger / Success / Secondary</h5>
        <div class="tool-actions">
            <button class="tool-btn tool-btn-danger" disabled>Danger Disabled</button>
            <button class="tool-btn tool-btn-success" disabled>Success Disabled</button>
            <button class="tool-btn tool-btn-secondary" disabled>Secondary Disabled</button>
        </div>

        <h5 class="tool-subheading">As link — <code class="tool-inline-code">a.tool-btn</code></h5>
        <div class="tool-actions">
            <a href="#" class="tool-btn">Link button</a>
            <a href="#" class="tool-btn tool-btn-primary">Link primary</a>
            <a href="#" class="button button-primary">Link hero</a>
        </div>

        <p class="tool-hint">Note: hover/focus states shown via inline style forced simulation. Real <code class="tool-inline-code">:hover</code>/<code class="tool-inline-code">:focus</code> apply automatically on interaction.</p>
    </section>

    @* ────────────────── BADGES ────────────────── *@
    <section id="badges" class="tool-card-nested">
        <h4><i class="bi bi-tag" aria-hidden="true"></i> Badges</h4>
        <div class="tool-badge-row">
            <span class="badge-tech">.NET 8</span>
            <span class="badge-tech">Blazor WASM</span>
            <span class="badge-tech">C# 12</span>
        </div>
        <div class="tool-badge-row">
            <span class="tool-badge">tool-badge</span>
            <span class="tool-badge">tag</span>
            <span class="tool-badge">chip</span>
        </div>
    </section>

    @* ────────────────── FIELDS & INPUTS ────────────────── *@
    <section id="fields" class="tool-card-nested">
        <h4><i class="bi bi-input-cursor-text" aria-hidden="true"></i> Fields & Inputs</h4>
        <div class="tool-form">
            <div class="tool-field">
                <label class="tool-label">Text input</label>
                <input class="tool-input" placeholder="Placeholder text" />
                <p class="tool-hint">Helper hint goes here.</p>
            </div>
            <div class="tool-field">
                <label class="tool-label">Small input</label>
                <input class="tool-input tool-input-sm" placeholder=".tool-input-sm" />
            </div>
            <div class="tool-field">
                <label class="tool-label">Textarea</label>
                <textarea class="tool-textarea" rows="2" placeholder="Multi-line"></textarea>
            </div>
            <div class="tool-field">
                <label class="tool-label">Select</label>
                <select class="tool-select">
                    <option>Option A</option>
                    <option>Option B</option>
                </select>
            </div>
            <div class="tool-field">
                <label class="tool-label">Inline search</label>
                <div class="tool-inline-search">
                    <input class="tool-input" placeholder="Search…" />
                </div>
            </div>
            <div class="tool-inline-inputs">
                <span class="tool-stepper-value">Inline inputs row</span>
            </div>
        </div>
    </section>

    @* ────────────────── SWITCHES & TOGGLES ────────────────── *@
    <section id="switches" class="tool-card-nested">
        <h4><i class="bi bi-toggles" aria-hidden="true"></i> Switches & Toggles</h4>
        <div class="tool-checkbox-group">
            <label class="tool-checkbox"><input type="checkbox" checked /> Checkbox A</label>
            <label class="tool-checkbox"><input type="checkbox" /> Checkbox B</label>
        </div>
        <div class="tool-radio-group" style="margin-top:0.6rem;">
            <label class="tool-radio"><input type="radio" name="cat-radio" checked /> Radio A</label>
            <label class="tool-radio"><input type="radio" name="cat-radio" /> Radio B</label>
        </div>
        <div class="tool-stepper" style="margin-top:0.6rem;">
            <span class="tool-stepper-value">Stepper value</span>
        </div>
    </section>

    @* ────────────────── BANNERS / ALERTS ────────────────── *@
    <section id="alerts" class="tool-card-nested">
        <h4><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> Banners / Alerts</h4>
        <div class="tool-alert tool-alert-success">.tool-alert-success — operation succeeded.</div>
        <div class="tool-alert tool-alert-info">.tool-alert-info — informational message.</div>
        <div class="tool-alert tool-alert-warning">.tool-alert-warning — be cautious.</div>
        <div class="tool-alert tool-alert-danger">.tool-alert-danger — something failed.</div>
        <div class="tool-rate-limit">.tool-rate-limit — rate limit banner.</div>
    </section>

    @* ────────────────── CARDS ────────────────── *@
    <section id="cards" class="tool-card-nested">
        <h4><i class="bi bi-card-text" aria-hidden="true"></i> Cards</h4>
        <div class="tool-grid-2">
            <div class="glass-card">
                <h3>.glass-card</h3>
                <p>Glassmorphism surface with blur backdrop.</p>
            </div>
            <div class="glass-panel" style="padding:1.5rem;">
                <h3>.glass-panel</h3>
                <p>Flat glass panel variant.</p>
            </div>
            <div class="tool-card">
                <h3>.tool-card</h3>
                <p>Tool shell card container.</p>
            </div>
            <div class="code-card">
                <h3>.code-card</h3>
                <p>3D tilt code card.</p>
            </div>
        </div>
    </section>

    @* ────────────────── TABLES ────────────────── *@
    <section id="tables" class="tool-card-nested">
        <h4><i class="bi bi-table" aria-hidden="true"></i> Tables</h4>
        <table class="tool-table">
            <thead>
                <tr><th>Class</th><th>Usage</th></tr>
            </thead>
            <tbody>
                <tr><td>.tool-table</td><td>Data table</td></tr>
                <tr><td>.tool-pagination</td><td>Pagination</td></tr>
            </tbody>
        </table>
        <div class="tool-pagination" style="margin-top:0.6rem;">.tool-pagination row</div>
    </section>

    @* ────────────────── MODALS ────────────────── *@
    <section id="modals" class="tool-card-nested">
        <h4><i class="bi bi-window" aria-hidden="true"></i> Modals</h4>
        <div class="tool-modal-backdrop" style="position:relative;">
            <div class="tool-modal" style="position:relative;">
                <div class="tool-modal-header">
                    <h3 class="tool-modal-title">.tool-modal-title</h3>
                    <button class="tool-modal-close" aria-label="Close">&times;</button>
                </div>
                <div class="tool-modal-body">
                    <p>Modal body content.</p>
                </div>
                <div class="tool-modal-footer">
                    <button class="tool-btn tool-btn-secondary">Cancel</button>
                    <button class="tool-btn tool-btn-primary">OK</button>
                </div>
            </div>
        </div>
    </section>

    @* ────────────────── SPINNERS & PROGRESS ────────────────── *@
    <section id="spinners" class="tool-card-nested">
        <h4><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Spinners & Progress</h4>
        <div class="tool-spinner" role="status" aria-label="Loading"></div>
        <div class="skeleton" style="height:1rem;margin-top:0.5rem;width:60%;">.skeleton</div>
        <div class="route-progress" style="position:relative;margin-top:0.5rem;">
            <div class="route-progress-bar"></div>
        </div>
        <button class="progress" style="position:relative;margin-top:0.5rem;">
            <i class="bi bi-arrow-up" aria-hidden="true"></i>
        </button>
        <div class="skill-meter" style="margin-top:0.5rem;">
            <div class="skill-meter-header">
                <span class="skill-meter-name">.skill-meter</span>
                <span class="skill-meter-value">80%</span>
            </div>
            <div class="skill-meter-track">
                <div class="skill-meter-fill" style="width:80%"></div>
            </div>
        </div>
    </section>

    @* ────────────────── CODE & RESULT ────────────────── *@
    <section id="code" class="tool-card-nested">
        <h4><i class="bi bi-code-slash" aria-hidden="true"></i> Code & Result</h4>
        <pre class="tool-code">.tool-code — preformatted block</pre>
        <code class="tool-inline-code">.tool-inline-code</code>
        <div class="tool-result">
            <div class="tool-result-label">.tool-result-label</div>
            <div class="tool-result-block">
                <div class="tool-result-header">.tool-result-header</div>
                <pre class="tool-result-code">.tool-result-code</pre>
            </div>
        </div>
    </section>

    @* ────────────────── STATS & MISC ────────────────── *@
    <section id="stats" class="tool-card-nested">
        <h4><i class="bi bi-bar-chart" aria-hidden="true"></i> Stats & Misc</h4>
        <div class="tool-stat-grid">
            <div class="tool-stat-card">
                <div class="tool-stat-value">42</div>
                <div class="tool-stat-label">.tool-stat-label</div>
            </div>
            <div class="tool-stat-card">
                <div class="tool-stat-value">7</div>
                <div class="tool-stat-label">Repos</div>
            </div>
        </div>
        <hr class="tool-divider" />
        <div class="loading-spinner-overlay" style="position:relative;">
            <span class="loading-spinner-label">.loading-spinner-label</span>
        </div>
    </section>
</div>