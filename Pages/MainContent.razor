@if (showEmailModal)
{
    <div class="email-modal-overlay" @onclick="CloseEmailModal">
        <div class="email-modal-content" @onclick:stopPropagation>
            <div class="email-modal-header">
                <h4>@L["Home_ComposeEmail"]</h4>
                <button class="email-modal-close" @onclick="CloseEmailModal" aria-label="@L["Home_Close"]">&times;</button>
            </div>
            <div class="email-modal-body">
                <EmailComposer />
            </div>
        </div>
    </div>
}

@code {
    private bool showEmailModal = false;

    private void OpenEmailComposer() => showEmailModal = true;
    private void CloseEmailModal() => showEmailModal = false;

    private async Task ScrollToContact()
    {
        await JSRuntime.InvokeVoidAsync("scrollToSection", "contact");
    }

    [Parameter]
    [SupplyParameterFromQuery]
    public string? Section { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("initializeStarfield");

            var currentUri = new Uri(NavigationManager.Uri);
            var hash = currentUri.Fragment.TrimStart('#');
            if (!string.IsNullOrEmpty(hash))
            {
                await JSRuntime.InvokeVoidAsync("scrollToSection", hash);
            }
        }
    }
}
