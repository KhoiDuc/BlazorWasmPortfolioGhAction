@page "/"
@using System.Net;
@using System.Net.Http;
@using System.Net.Http.Headers;
@using Microsoft.AspNetCore.Components.Authorization
@using Newtonsoft.Json;
@using System.Timers;
@using System.Text.RegularExpressions;
@using BlazorWasmPortfolioGhAction.Shared.Model;
@using BlazorWasmPortfolioGhAction.Store.Actions;
@using BlazorWasmPortfolioGhAction.Store.State;
@using BlazorWasmPortfolioGhAction.Components.EmailComposer
@using Fluxor
@inject IState<ContentState> contentState
@inject IDispatcher Dispatcher
@inject HttpClient Http;
@inject NavigationManager Navigation;
@inject IJSRuntime JSRuntime;

<div class="container-fluid mx-0 ps-0 mainContentContainer">
    <div class="row mx-0 ps-0 gx-3">
        <div class="col">
            <div class="introductionBody">
                <div class="start_light"></div>
                <div id="header">
                    <div class="container">
                        <nav class="nav">
                            <h2 class="title-content">PORTFOLIO</h2>
                        </nav>
                        <div class="header-content">
                            <div class="header-text">
                                <h1>Khoi Nguyen Minh Duc</h1>
                                <p>.NET Developer</p>
                                <div class="grid-container justify-content-center">
                                     <div class="email-button contact-container">
                                        <button id="contactButton" class="contact-button email-link" @onclick="ToggleContactOptions">
                                            <h5>Contact Me</h5>
                                            <img src="images/envelope-blue.svg" alt="email" class="email-icon">
                                        </button>
                                        <div id="contactOptions" class="contact-options @(showContactOptions ? "show" : "")">
                                            <a href="mailto:khoi.duc.dev@gmail.com" class="email-link">
                                                <h6>Default Email</h6>
                                                <i class="fas fa-envelope email-icon"></i>
                                            </a>
                                            <a href="https://mail.google.com/mail/?view=cm&fs=1&to=khoi.duc.dev@gmail.com" class="email-link">
                                                <h6>Gmail</h6>
                                                <i class="fab fa-google email-icon"></i>
                                            </a>
                                            <a href="https://outlook.live.com/mail/0/deeplink/compose?to=khoi.duc.dev@gmail.com" class="email-link">
                                                <h6>Outlook</h6>
                                                <i class="fab fa-microsoft email-icon"></i>
                                            </a>
                                            <button class="email-link btn btn-link p-0 text-start border-0 text-decoration-none" @onclick="CopyEmail">
                                                <h6>Copy Email</h6>
                                                <i class="fas fa-copy email-icon"></i>
                                            </button>
                                            <button class="email-link btn btn-link p-0 text-start border-0 text-decoration-none" @onclick="OpenEmailComposer">
                                                <h6>Compose Email</h6>
                                                <i class="fas fa-pen-to-square email-icon"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="google-drive-button">
                                        <a href="MyResume" class="google-drive-link">
                                            <h5>My Resume</h5>
                                            <img src="images/googledrive-blue.svg" alt="Resume site" class="google-drive-icon">
                                        </a>
                                    </div>
                                    <div class="download-file-button">
                                        <a href="Dissertation/CV" class="download-file-button-link">
                                            <h5>My CV</h5>
                                            <img src="images/downloadfile-blue.svg" alt="Download file" class="download-file-icon">
                                        </a>
                                    </div>
                                    <div class="download-file-button">
                                        <a href="files/resume.pdf" target="_blank" rel="noopener" download class="download-file-button-link">
                                            <h5>PDF Resume</h5>
                                            <img src="images/downloadfile-blue.svg" alt="Download PDF" class="download-file-icon">
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <div class="header-image">
                                <img src="images/avt-men.png" alt="Profile Image">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (showEmailModal)
{
    <div class="email-modal-overlay" @onclick="CloseEmailModal">
        <div class="email-modal-content" @onclick:stopPropagation>
            <div class="email-modal-header">
                <h4>Compose Email</h4>
                <button class="email-modal-close" @onclick="CloseEmailModal" aria-label="Close">&times;</button>
            </div>
            <div class="email-modal-body">
                <EmailComposer />
            </div>
        </div>
    </div>
}

@code {
    private bool showContactOptions = false;
    private bool showEmailModal = false;

    private void ToggleContactOptions()
    {
        showContactOptions = !showContactOptions;
    }

    private void OpenEmailComposer()
    {
        showContactOptions = false;
        showEmailModal = true;
    }

    private void CloseEmailModal()
    {
        showEmailModal = false;
    }

    private async Task CopyEmail()
    {
        const string email = "khoi.duc.dev@gmail.com";
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", email);
        await JSRuntime.InvokeVoidAsync("alert", "Copied email to clipboard: " + email);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("initializeStarfield");
            await JSRuntime.InvokeVoidAsync("initializeScrollProgress");
        }
    }
}

<style>
    .email-modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.6);
        z-index: 1050;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .email-modal-content {
        background: #fff;
        border-radius: 8px;
        max-width: 95vw;
        width: 1000px;
        max-height: 92vh;
        overflow-y: auto;
    }

    .email-modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 15px 20px;
        border-bottom: 1px solid #e1e4e8;
        position: sticky;
        top: 0;
        background: #fff;
        z-index: 1;
    }

    .email-modal-header h4 {
        margin: 0;
        color: #24292e;
    }

    .email-modal-close {
        background: none;
        border: none;
        font-size: 1.8em;
        line-height: 1;
        color: #586069;
        cursor: pointer;
        padding: 0;
        width: 32px;
        height: 32px;
        border-radius: 4px;
    }

    .email-modal-close:hover {
        background: #f1f2f3;
        color: #24292e;
    }

    .email-modal-body {
        padding: 15px 20px;
    }

    @@media (max-width: 768px) {
        .email-modal-content {
            max-width: 100vw;
            width: 100%;
            border-radius: 0;
            max-height: 100vh;
        }
        .email-modal-overlay {
            padding: 0;
        }
        .email-modal-header, .email-modal-body {
            padding: 10px 15px;
        }
    }
</style>