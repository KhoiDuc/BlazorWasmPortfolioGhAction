@using BlazorWasmPortfolioGhAction.Components.ToolShell
@implements IDisposable

<ToolShell Title="Big Bang Counter" Icon="bi-stars" Description="Live counter of seconds elapsed since the Big Bang.">
    <div class="tool-result bigbang-display">
        <div class="tool-result-label">Seconds since Big Bang</div>
        <strong class="bigbang-value">@Seconds</strong>
    </div>
</ToolShell>

@code {
    private ulong secondsSinceBigBang;
    private System.Timers.Timer? timer;

    protected override void OnInitialized()
    {
        ulong secondsInYear = 31_556_926;
        ulong yearsSinceBigBang = 13_787_000_000;
        ulong secondsBigBang = yearsSinceBigBang * secondsInYear;
        var timeSince1970 = DateTime.Now - new DateTime(1970, 1, 1);
        secondsSinceBigBang = (ulong)timeSince1970.TotalSeconds + secondsBigBang;

        timer = new System.Timers.Timer(1000);
        timer.Elapsed += OnTimerElapsed;
        timer.AutoReset = true;
        timer.Enabled = true;
    }

    private void OnTimerElapsed(object? sender, System.Timers.ElapsedEventArgs e) =>
        InvokeAsync(() => { secondsSinceBigBang++; StateHasChanged(); });

    public void Dispose()
    {
        timer?.Stop();
        timer?.Dispose();
    }

    private string Seconds => secondsSinceBigBang.ToString("N0");
}
