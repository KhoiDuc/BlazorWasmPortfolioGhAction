            },
        };
    }

    private static CalculatorInfo Calc(string name, Type type, bool placeholder = false) =>
        new() { Name = name, ComponentType = type, IsPlaceholder = placeholder };

    private void OnCalculatorSelected(CalculatorInfo calculatorInfo)
    {
        AddCalculatorInstance(calculatorInfo.ComponentType);
        IsNavbarVisible = false;
    }

    private void AddCalculatorInstance(Type componentType)
    {
        var instanceId = Guid.NewGuid();
        OpenCalculators.Add(new OpenCalculatorInstance
        {
            Id = instanceId,
            ComponentType = componentType,
            Parameters = new Dictionary<string, object>
            {
                { "InstanceId", instanceId },
                { "OnClose", EventCallback.Factory.Create<Guid>(this, OnCalculatorClosed) }
            }
        });
    }

    private void OnCalculatorClosed(Guid instanceId)
    {
        var instance = OpenCalculators.FirstOrDefault(c => c.Id == instanceId);
        if (instance != null)
            OpenCalculators.Remove(instance);

        if (OpenCalculators.Count == 0)
            IsNavbarVisible = true;
    }

    private void ToggleNavbarVisibility() => IsNavbarVisible = !IsNavbarVisible;

    private sealed class CalculatorInfo
    {
        public string Name { get; set; } = string.Empty;
        public Type ComponentType { get; set; } = typeof(PlaceholderCalculator);
        public bool IsPlaceholder { get; set; }
    }

    private sealed class OpenCalculatorInstance
    {
        public Guid Id { get; set; }
        public Type ComponentType { get; set; } = typeof(PlaceholderCalculator);
        public Dictionary<string, object> Parameters { get; set; } = new();
    }
}
