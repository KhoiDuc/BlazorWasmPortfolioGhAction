@page "/generalCalc"
@using BlazorWasmPortfolioGhAction.Pages.ConverterComponents
@using BlazorWasmPortfolioGhAction.Services
@inject IScriptLoaderService ScriptLoader

<div class="page-section general-calc-page">
    <section>
        <div class="container">
            <div class="section-heading">
                <p class="section-label">CALCULATORS</p>
                <h2>General calculator suite.</h2>
            </div>

            <div class="general-calc-layout">
                <aside class="general-calc-sidebar">
                    <button type="button" class="tool-btn general-calc-toggle" @onclick="ToggleNavbarVisibility">
                        @(IsNavbarVisible ? "Hide categories" : "Show categories")
                    </button>

                    @if (IsNavbarVisible)
                    {
                        <nav class="general-calc-nav" aria-label="Calculator categories">
                            @foreach (var category in CalculatorCategories)
                            {
                                <details class="general-calc-group" open="@(category.Key == "General")">
                                    <summary>@category.Key</summary>
                                    <ul>
                                        @foreach (var calculator in category.Value)
                                        {
                                            <li>
                                                <button type="button" class="general-calc-link" @onclick="() => OnCalculatorSelected(calculator)">
                                                    @calculator.Name
                                                    @if (calculator.IsPlaceholder)
                                                    {
                                                        <span class="calc-badge calc-badge-soon">Soon</span>
                                                    }
                                                </button>
                                            </li>
                                        }
                                    </ul>
                                </details>
                            }
                        </nav>
                    }
                </aside>

                <div class="general-calc-workspace">
                    @if (OpenCalculators.Count == 0)
                    {
                        <div class="general-calc-empty">
                            <i class="bi bi-calculator" aria-hidden="true"></i>
                            <p>Select a calculator from the sidebar.</p>
                        </div>
                    }

                    @foreach (var calculatorInstance in OpenCalculators)
                    {
                        <div class="calculator-wrapper">
                            <DynamicComponent Type="calculatorInstance.ComponentType" Parameters="calculatorInstance.Parameters" />
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>
</div>

@code {
