                    Calc("Ideal Gas Law Calculator", typeof(PlaceholderCalculator), placeholder: true),
                    Calc("Solution Concentration Calculator", typeof(PlaceholderCalculator), placeholder: true),
                    Calc("pH and pOH Calculator", typeof(PlaceholderCalculator), placeholder: true),
                    Calc("Dilution Calculator", typeof(PlaceholderCalculator), placeholder: true),
                }
            },
            {
                "Electronics",
                new List<CalculatorInfo>
                {
                    Calc("Resistor Color Code Calculator", typeof(PlaceholderCalculator), placeholder: true),
                    Calc("LED Resistor Calculator", typeof(PlaceholderCalculator), placeholder: true),
                    Calc("Capacitor Charge/Discharge Calculator", typeof(PlaceholderCalculator), placeholder: true),
                    Calc("Voltage Divider Calculator", typeof(PlaceholderCalculator), placeholder: true),
                    Calc("Inductor Reactance Calculator", typeof(PlaceholderCalculator), placeholder: true),
                }
            },
            {
                "Computer Science",
                new List<CalculatorInfo>
                {
                    Calc("Binary Calculator", typeof(BinaryCalculatorCalc)),
                    Calc("Bitwise Operation Calculator", typeof(PlaceholderCalculator), placeholder: true),
                    Calc("Simple Encryption/Decryption", typeof(PlaceholderCalculator), placeholder: true),
