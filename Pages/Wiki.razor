@page "/wiki"
@page "/wiki/{PageName}/{Section?}/{SubSection?}"
@page "/wiki/edit/{PageName}/{Section?}/{SubSection?}"
@page "/{lang:regex(^(en|vn)$)}/wiki"
@page "/{lang:regex(^(en|vn)$)}/wiki/{PageName}/{Section?}/{SubSection?}"
@page "/{lang:regex(^(en|vn)$)}/wiki/edit/{PageName}/{Section?}/{SubSection?}"
@inherits CultureAwareComponent
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using BlazorWasmPortfolioGhAction.Store.Actions
@using BlazorWasmPortfolioGhAction.Store.State
@using Fluxor
@using System.Text
@using System.IO
@using System.Threading
@using Markdig
@using Stilo.Documents.Converters
@inject IDispatcher Dispatcher
@inject IState<ContentState> ContentState
@inject IConfiguration Configuration
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject IStringLocalizer<SharedResources> L
@implements IDisposable

<div class="page-section wiki-hub">
    <section>
        <div class="container">
            <header class="wiki-hero">
                <div class="wiki-hero-copy">
                    <p class="section-label">@L["Wiki_Label"]</p>
                    <h1>@L["Wiki_Title"]</h1>
                    <p class="wiki-hero-lead">@L["Wiki_Lead"]</p>
                </div>
                <div class="wiki-hero-actions">
                    @if (IsContentReady && FilteredContents.Count > 0)
                    {
                        <div class="wiki-export-group" role="group" aria-label="Export options">
                            <button type="button" class="tool-btn tool-btn-secondary" @onclick="() => ExportDocumentAsync(ExportFormat.Pdf)" disabled="@_isExporting" title="Export as PDF">
                                @if (_isExporting && _currentExportFormat == ExportFormat.Pdf)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                }
                                else
                                {
                                    <i class="bi bi-file-earmark-pdf text-danger" aria-hidden="true"></i>
                                }
                                <span>PDF</span>
                            </button>
                            <button type="button" class="tool-btn tool-btn-secondary" @onclick="() => ExportDocumentAsync(ExportFormat.Docx)" disabled="@_isExporting" title="Export as Word DOCX">
                                @if (_isExporting && _currentExportFormat == ExportFormat.Docx)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                }
                                else
                                {
                                    <i class="bi bi-file-earmark-word text-primary" aria-hidden="true"></i>
                                }
                                <span>DOCX</span>
                            </button>
                            <button type="button" class="tool-btn tool-btn-secondary" @onclick="() => ExportDocumentAsync(ExportFormat.Markdown)" disabled="@_isExporting" title="Export as Markdown">
                                <i class="bi bi-markdown" aria-hidden="true"></i> <span>MD</span>
                            </button>
                        </div>
                    }
                    <AuthorizeView>
                        <Authorized>
                            @if (!IsEditMode)
                            {
                                <a class="tool-btn tool-btn-primary" href="@EditUrl">
                                    <i class="bi bi-pencil" aria-hidden="true"></i> @L["Wiki_Edit"]
                                </a>
                            }
                            else
                            {
                                <a class="tool-btn tool-btn-secondary" href="@ReadUrl">
                                    <i class="bi bi-eye" aria-hidden="true"></i> @L["Wiki_ReadOnly"]
                                </a>
                            }
                        </Authorized>
                        <NotAuthorized>
                            <a class="tool-btn tool-btn-primary" href="@AdminLoginUrl">
                                <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i> @L["Wiki_AdminLogin"]
                            </a>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </header>

            <div class="wiki-toolbar">
                <SearchBar type="Search"
                           Label=""
                           Placeholder="@L["Wiki_SearchPlaceholder"]"
                           SearchTermChanged="OnSearchChanged" />
                <div class="wiki-toolbar-meta">
                    @if (IsEditMode)
                    {
                        <span class="wiki-mode-badge is-edit">@L["Wiki_Editing"]</span>
                    }
                    @if (IsContentReady)
                    {
                        <span class="wiki-stat">@string.Format(L["Wiki_Sections"], FilteredContents.Count)</span>
                    }
                </div>
            </div>

            @if (!IsContentReady)
            {
                <div class="wiki-state wiki-state-loading">
                    <div class="tool-spinner" role="status" aria-label="@L["Wiki_LoadingAria"]"></div>
                    <p>@L["Wiki_Loading"]</p>
                </div>
            }
            else if (FilteredContents.Count == 0)
            {
                <div class="wiki-state wiki-state-empty">
                    <i class="bi bi-journal-x" aria-hidden="true"></i>
                    <h3>@L["Wiki_EmptyTitle"]</h3>
                    <p>
                        @if (IsEditMode)
                        {
                            <span>@L["Wiki_EmptyEdit"]</span>
                        }
                        else
                        {
                            <span>@L["Wiki_EmptyRead"]</span>
                        }
                    </p>
                </div>
            }
            else
            {
                <div class="wiki-layout">
                    <aside class="wiki-toc" aria-label="Table of contents">
                        <p class="wiki-toc-label">On this page</p>
                        <nav class="wiki-toc-nav">
                            @foreach (var entry in TocEntries)
                            {
                                <a href="@($"#wiki-section-{entry.Index}")" class="wiki-toc-link @entry.LevelClass">
                                    @entry.Label
                                </a>
                            }
                        </nav>
                    </aside>

                    <div class="wiki-stream">
                        @{
                            string? lastPageHeading = null;
                        }
                        @for (var i = 0; i < FilteredContents.Count; i++)
                        {
                            var index = ContentState.Value.Contents.IndexOf(FilteredContents[i]);
                            if (index < 0) continue;

                            var pageName = FilteredContents[i].Page;
                            if (!string.IsNullOrEmpty(pageName) && pageName != lastPageHeading && (string.IsNullOrEmpty(PageName) || PageName == "all"))
                            {
                                lastPageHeading = pageName;
                                <div class="wiki-page-heading">
                                    <span class="wiki-page-badge">Page</span>
                                    <h2>@pageName</h2>
                                </div>
                            }

                            @if (IsEditMode)
                            {
                                <WikiBlock type="@ViewType"
                                           sections="@Section"
                                           subSections="@SubSection"
                                           count="@FilteredContents.Count"
                                           indexParsed="@index"
                                           username="@Username"
                                           matchType="@MatchPage"
                                           matchTypeSections="@MatchSection"
                                           matchTypeSectionsSubSections="@MatchSubSection"
                                           inline="false" />
                            }
                            else
                            {
                                <WikiBlockNoAuth type="@ViewType"
                                                 sections="@Section"
                                                 subSections="@SubSection"
                                                 count="@FilteredContents.Count"
                                                 indexParsed="@index"
                                                 matchType="@MatchPage"
                                                 matchTypeSections="@MatchSection"
                                                 matchTypeSectionsSubSections="@MatchSubSection"
                                                 inline="false" />
                            }
                        }
                    </div>
                </div>
            }
        </div>
    </section>
</div>

@code {
    [Parameter] public string? PageName { get; set; }
    [Parameter] public string? Section { get; set; }
    [Parameter] public string? SubSection { get; set; }

    private string? _searchTerm;
    private string Username => "editor";

    private bool IsEditMode => Navigation.Uri.Contains("/wiki/edit/", StringComparison.OrdinalIgnoreCase);
    private bool IsContentReady => ContentState.Value.FileCount == ContentState.Value.LoadedFilesCount;

    private string ViewType => string.IsNullOrEmpty(PageName) ? "all" :
        string.IsNullOrEmpty(Section) || Section == "all" ? PageName :
        string.IsNullOrEmpty(SubSection) || SubSection == "all" ? Section : SubSection;

    private bool MatchPage => string.IsNullOrEmpty(PageName) || PageName == "all";
    private bool MatchSection => string.IsNullOrEmpty(Section) || Section == "all";
    private bool MatchSubSection => string.IsNullOrEmpty(SubSection) || SubSection == "all";

    private string EditUrl => BuildWikiUrl("edit");
    private string ReadUrl => BuildWikiUrl("read");
    private string AdminLoginUrl =>
        $"/{CultureService.UrlLang}/admin?returnUrl={Uri.EscapeDataString(Navigation.Uri)}";

    private string EffectivePageName =>
        !string.IsNullOrEmpty(PageName) ? PageName :
        ContentState.Value.Contents.FirstOrDefault()?.Page ?? "Portfolio";

    private List<Shared.Model.ContentHolder> FilteredContents =>
        ContentState.Value.Contents
            .Where(MatchesRoute)
            .Where(MatchesSearch)
            .ToList();

    private IEnumerable<TocEntry> TocEntries =>
        FilteredContents
            .Select(item =>
            {
                var index = ContentState.Value.Contents.IndexOf(item);
                var section = item.Section?.Trim();
                var sub = item.SubSection?.Trim();
                var label = !string.IsNullOrEmpty(sub) ? sub
                    : !string.IsNullOrEmpty(section) ? section
                    : item.Page ?? "Section";
                var level = !string.IsNullOrEmpty(sub) && !string.IsNullOrEmpty(section) ? "is-sub"
                    : !string.IsNullOrEmpty(section) ? "is-section" : "is-page";
                return new TocEntry(index, label, level);
            })
            .Where(e => e.Index >= 0);

    private string BuildWikiUrl(string mode)
    {
        var segments = new List<string> { CultureService.UrlLang, "wiki" };
        if (mode == "edit") segments.Add("edit");
        segments.Add(EffectivePageName);
        if (!string.IsNullOrEmpty(Section) && Section != "all") segments.Add(Section);
        if (!string.IsNullOrEmpty(SubSection) && SubSection != "all") segments.Add(SubSection);
        return string.Join('/', segments);
    }

    protected override async Task OnInitializedAsync()
    {
        ContentState.StateChanged += OnContentStateChanged;

        if (IsEditMode)
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated != true)
            {
                Navigation.NavigateTo($"/{CultureService.UrlLang}/admin?returnUrl={Uri.EscapeDataString(Navigation.Uri)}");
                return;
            }
        }

        if (ContentState.Value.FileCount == 0 && ContentState.Value.LoadedFilesCount == 0)
        {
            Dispatcher.Dispatch(new LoadContentsFromRepoAction());
        }
    }

    private bool MatchesRoute(Shared.Model.ContentHolder item)
    {
        if (string.IsNullOrEmpty(PageName) || PageName == "all") return true;
        if (!string.Equals(item.Page, PageName, StringComparison.OrdinalIgnoreCase)) return false;
        if (string.IsNullOrEmpty(Section) || Section == "all") return true;
        if (!string.Equals(item.Section, Section, StringComparison.OrdinalIgnoreCase)) return false;
        if (string.IsNullOrEmpty(SubSection) || SubSection == "all") return true;
        return string.Equals(item.SubSection, SubSection, StringComparison.OrdinalIgnoreCase);
    }

    private bool MatchesSearch(Shared.Model.ContentHolder item)
    {
        if (string.IsNullOrWhiteSpace(_searchTerm)) return true;
        var term = _searchTerm.Trim();
        return (item.Page?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
            || (item.Section?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
            || (item.SubSection?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
            || (item.Content?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private void OnSearchChanged(string? term)
    {
        _searchTerm = term;
        StateHasChanged();
    }

    private void OnContentStateChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    private enum ExportFormat { Pdf, Docx, Markdown }
    private bool _isExporting;
    private ExportFormat _currentExportFormat;

    private static readonly MarkdownPipeline WikiExportPipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .UseEmojiAndSmiley(true)
        .Build();

    private static bool IsHtmlContent(string? raw) =>
        !string.IsNullOrWhiteSpace(raw) && raw.TrimStart().StartsWith('<');

    private async Task ExportDocumentAsync(ExportFormat format)
    {
        if (FilteredContents.Count == 0 || _isExporting) return;
        _isExporting = true;
        _currentExportFormat = format;
        StateHasChanged();

        try
        {
            var title = string.IsNullOrEmpty(PageName) || PageName == "all" ? "Portfolio-Wiki" : PageName;
            var safeFileName = string.Concat(title.Split(Path.GetInvalidFileNameChars())).Replace(" ", "-");

            if (format == ExportFormat.Markdown)
            {
                var sbMd = new StringBuilder();
                sbMd.AppendLine($"# {title}");
                sbMd.AppendLine();
                foreach (var item in FilteredContents)
                {
                    if (!string.IsNullOrWhiteSpace(item.Section))
                        sbMd.AppendLine($"## {item.Section}");
                    if (!string.IsNullOrWhiteSpace(item.SubSection))
                        sbMd.AppendLine($"### {item.SubSection}");
                    var content = item.Content ?? "";
                    if (IsHtmlContent(content))
                    {
                        content = MarkdownConverter.HtmlToMarkdown(content);
                    }
                    sbMd.AppendLine(content);
                    sbMd.AppendLine();
                }
                var mdBytes = Encoding.UTF8.GetBytes(sbMd.ToString());
                using var ms = new MemoryStream(mdBytes);
                using var streamRef = new DotNetStreamReference(stream: ms);
                await JSRuntime.InvokeVoidAsync("downloadFileFromStream", $"{safeFileName}.md", streamRef);
            }
            else
            {
                var sbHtml = new StringBuilder();
                sbHtml.Append("<!DOCTYPE html><html><head><meta charset='utf-8'>");
                sbHtml.Append($"<title>{title}</title>");
                sbHtml.Append("<style>body{font-family:Segoe UI,Helvetica,Arial,sans-serif;line-height:1.6;color:#1e293b;padding:32px;max-width:850px;margin:auto;} h1{color:#1e40af;border-bottom:2px solid #e2e8f0;padding-bottom:8px;margin-bottom:24px;} h2{color:#2563eb;margin-top:24px;border-bottom:1px solid #f1f5f9;padding-bottom:4px;} h3{color:#3b82f6;margin-top:16px;} code{background:#f1f5f9;color:#0f172a;padding:2px 6px;border-radius:4px;font-family:Consolas,monospace;font-size:0.9em;} pre{background:#f8fafc;padding:12px;border:1px solid #e2e8f0;border-radius:6px;overflow-x:auto;} table{border-collapse:collapse;width:100%;margin:16px 0;} th,td{border:1px solid #cbd5e1;padding:8px 12px;text-align:left;} th{background:#f1f5f9;} blockquote{border-left:4px solid #3b82f6;margin:16px 0;padding-left:12px;color:#64748b;}</style>");
                sbHtml.Append("</head><body>");
                sbHtml.Append($"<h1>{title}</h1>");
                foreach (var item in FilteredContents)
                {
                    if (!string.IsNullOrWhiteSpace(item.Section))
                        sbHtml.Append($"<h2>{item.Section}</h2>");
                    if (!string.IsNullOrWhiteSpace(item.SubSection))
                        sbHtml.Append($"<h3>{item.SubSection}</h3>");
                    var raw = item.Content ?? "";
                    var rendered = IsHtmlContent(raw) ? raw : Markdig.Markdown.ToHtml(raw, WikiExportPipeline);
                    sbHtml.Append($"<div class='wiki-export-section'>{rendered}</div>");
                }
                sbHtml.Append("</body></html>");
                var fullHtml = sbHtml.ToString();

                if (format == ExportFormat.Pdf)
                {
                    var converter = new HtmlToPdfConverter();
                    using var pdfStream = await converter.ConvertAsync(fullHtml, CancellationToken.None);
                    using var streamRef = new DotNetStreamReference(stream: pdfStream);
                    await JSRuntime.InvokeVoidAsync("downloadFileFromStream", $"{safeFileName}.pdf", streamRef);
                }
                else if (format == ExportFormat.Docx)
                {
                    var converter = new HtmlToDocxConverter();
                    using var docxStream = await converter.ConvertAsync(fullHtml, CancellationToken.None);
                    using var streamRef = new DotNetStreamReference(stream: docxStream);
                    await JSRuntime.InvokeVoidAsync("downloadFileFromStream", $"{safeFileName}.docx", streamRef);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Export error: {ex.Message}");
        }
        finally
        {
            _isExporting = false;
            StateHasChanged();
        }
    }

    public override void Dispose()
    {
        ContentState.StateChanged -= OnContentStateChanged;
        base.Dispose();
    }

    private record TocEntry(int Index, string Label, string LevelClass);
}
