@using BlazorWasmPortfolioGhAction.Pages
@inject IJSRuntime JS

<div class="toeic-writing-tab">
    <!-- Header -->
    <div class="toeic-section-header">
        <h2 class="toeic-section-title">
            <i class="bi bi-pen-fill text-warning"></i>
            Xưởng Luyện Viết TOEIC Writing (Task 1 – Task 3)
        </h2>
        <p class="toeic-section-desc">
            Bí quyết viết câu phức theo tranh (Task 1), sườn trả lời email 3 yêu cầu (Task 2) và dàn ý bài luận 300+ từ chuẩn mực (Task 3).
        </p>
    </div>

    @foreach (var template in Data.WritingTemplates)
    {
        <div class="toeic-writing-card">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; flex-wrap: wrap; gap: 0.5rem;">
                <span class="toeic-wri-task-badge">@template.Task</span>
                <span style="font-size: 1.15rem; font-weight: 800; color: var(--color-text-primary);">
                    @template.Title
                </span>
            </div>

            <!-- Scenario Box -->
            <div class="toeic-prompt-box">
                <b><i class="bi bi-file-earmark-text me-1 text-warning"></i> Tình huống đề bài:</b> @template.Scenario
            </div>

            <!-- Required Points -->
            <div style="margin-bottom: 1.25rem;">
                <h4 style="font-size: 0.92rem; font-weight: 700; color: var(--color-text-primary); margin: 0 0 0.5rem;">
                    <i class="bi bi-list-check me-1 text-primary"></i> Yêu cầu bắt buộc để đạt điểm tối đa:
                </h4>
                <ul class="toeic-notes-list">
                    @foreach (var req in template.RequiredPoints)
                    {
                        <li>@req</li>
                    }
                </ul>
            </div>

            <!-- Structure Blueprint -->
            <div style="margin-bottom: 1.25rem;">
                <h4 style="font-size: 0.92rem; font-weight: 700; color: var(--color-brand-symbol, #ca8a04); margin: 0 0 0.5rem;">
                    <i class="bi bi-diagram-2 me-1"></i> Khung Cấu Trúc Blueprint:
                </h4>
                <div class="toeic-blueprint-flow">
                    @foreach (var step in template.StructureBlueprint)
                    {
                        <div class="toeic-blueprint-step" style="border-left-color: var(--color-brand-symbol, #ca8a04);">
                            @step
                        </div>
                    }
                </div>
            </div>

            <!-- High Scoring Connectors -->
            <div style="margin-bottom: 1.25rem;">
                <h4 style="font-size: 0.88rem; font-weight: 700; color: #0284c7; margin: 0 0 0.4rem;">
                    <i class="bi bi-link me-1"></i> Từ nối & Mẫu câu ăn điểm cao:
                </h4>
                <div class="toeic-connectors-row">
                    @foreach (var conn in template.Connectors)
                    {
                        <span class="toeic-connector-pill">@conn</span>
                    }
                </div>
            </div>

            <!-- Full Model Response -->
            <div>
                <h4 style="font-size: 0.92rem; font-weight: 800; color: #16a34a; margin: 0 0 0.5rem;">
                    <i class="bi bi-award-fill me-1"></i> Bài Viết Mẫu Hoàn Chỉnh (High-Score Model):
                </h4>
                <div class="toeic-full-response-box">
                    @template.SampleFullResponse
                </div>
            </div>

            <!-- Interactive Writing Practice Sandbox -->
            <div class="toeic-writing-sandbox">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; flex-wrap: wrap; gap: 0.5rem;">
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <span style="font-size: 0.95rem; font-weight: 800; color: var(--color-brand-symbol, #ca8a04);">
                            <i class="bi bi-pencil-square me-1"></i> Phòng Luyện Viết Cho @template.Task
                        </span>
                        <span class="toeic-tag" style="background: rgba(59, 130, 246, 0.12); color: #3b82f6;">
                            Thời gian gợi ý: @GetTaskTime(template.Task)
                        </span>
                    </div>

                    <div style="display: flex; gap: 0.5rem; align-items: center;">
                        <span style="font-size: 0.85rem; font-weight: 700; color: @GetWordCountColor(template.Task, GetWordCount(template.Task));">
                            <i class="bi bi-card-text me-1"></i> @GetWordCount(template.Task) từ @GetWordCountTargetHint(template.Task)
                        </span>

                        <button type="button" class="toeic-filter-chip @(_showSplitView.Contains(template.Task) ? "active" : "")"
                                style="font-size: 0.8rem; padding: 0.2rem 0.65rem;"
                                @onclick="() => ToggleSplitView(template.Task)">
                            <i class="bi bi-layout-split me-1"></i> So sánh với bài mẫu
                        </button>
                    </div>
                </div>

                <textarea class="toeic-writing-textarea"
                          placeholder="Bắt đầu gõ bài viết của bạn tại đây để rèn luyện phản xạ viết và quản trị dung lượng từ..."
                          value="@GetDraft(template.Task)"
                          @oninput="@(e => OnDraftInput(template.Task, e))">
                </textarea>

                @if (_showSplitView.Contains(template.Task))
                {
                    <div class="toeic-split-compare-grid">
                        <div style="background: rgba(59, 130, 246, 0.05); border: 1px solid rgba(59, 130, 246, 0.2); border-radius: 8px; padding: 1rem;">
                            <h5 style="margin: 0 0 0.5rem; font-size: 0.88rem; font-weight: 800; color: #3b82f6;">
                                Bài viết của bạn (@GetWordCount(template.Task) từ)
                            </h5>
                            <div style="font-size: 0.85rem; color: var(--color-text-primary); line-height: 1.6; white-space: pre-wrap;">
                                @(string.IsNullOrWhiteSpace(GetDraft(template.Task)) ? "(Chưa nhập bài viết)" : GetDraft(template.Task))
                            </div>
                        </div>

                        <div style="background: rgba(34, 197, 94, 0.05); border: 1px solid rgba(34, 197, 94, 0.2); border-radius: 8px; padding: 1rem;">
                            <h5 style="margin: 0 0 0.5rem; font-size: 0.88rem; font-weight: 800; color: #16a34a;">
                                Bài viết mẫu đạt điểm tối đa
                            </h5>
                            <div style="font-size: 0.85rem; color: var(--color-text-secondary); line-height: 1.6; white-space: pre-wrap;">
                                @template.SampleFullResponse
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Common Mistakes -->
            @if (template.CommonMistakes.Any())
            {
                <div style="background: rgba(239, 68, 68, 0.05); border: 1px solid rgba(239, 68, 68, 0.2); border-radius: 8px; padding: 1rem; margin-top: 1rem;">
                    <h5 style="font-size: 0.85rem; font-weight: 800; color: #ef4444; margin: 0 0 0.4rem;">
                        <i class="bi bi-exclamation-octagon-fill me-1"></i> Cảnh giác các lỗi dễ mất điểm:
                    </h5>
                    <ul style="margin: 0; padding-left: 1.25rem; font-size: 0.82rem; color: var(--color-text-secondary); line-height: 1.6;">
                        @foreach (var mistake in template.CommonMistakes)
                        {
                            <li>@mistake</li>
                        }
                    </ul>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public ToeicData Data { get; set; } = default!;

    private Dictionary<string, string> _drafts = new();
    private HashSet<string> _showSplitView = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var stored = await JS.InvokeAsync<string?>("localStorage.getItem", "toeic_writing_drafts");
                if (!string.IsNullOrEmpty(stored))
                {
                    var dict = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string>>(stored);
                    if (dict != null)
                    {
                        _drafts = dict;
                        StateHasChanged();
                    }
                }
            }
            catch { }
        }
    }

    private string GetDraft(string task) => _drafts.TryGetValue(task, out var text) ? text : "";

    private void OnDraftInput(string task, Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        OnDraftChanged(task, e.Value?.ToString() ?? "");
    }

    private void OnDraftChanged(string task, string value)
    {
        _drafts[task] = value;
        _ = SaveDraftsAsync();
    }

    private async Task SaveDraftsAsync()
    {
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(_drafts);
            await JS.InvokeVoidAsync("localStorage.setItem", "toeic_writing_drafts", json);
        }
        catch { }
    }

    private void ToggleSplitView(string task)
    {
        if (!_showSplitView.Remove(task)) _showSplitView.Add(task);
    }

    private int GetWordCount(string task)
    {
        var text = GetDraft(task);
        if (string.IsNullOrWhiteSpace(text)) return 0;
        return text.Split(new[] { ' ', '\r', '\n', '\t' }, StringSplitOptions.RemoveEmptyEntries).Length;
    }

    private string GetTaskTime(string task) => task switch
    {
        "Task 1" => "8 phút / 5 câu",
        "Task 2" => "10 phút / email",
        "Task 3" => "30 phút / bài luận",
        _ => "10 phút"
    };

    private string GetWordCountTargetHint(string task) => task switch
    {
        "Task 1" => "(chuẩn: 15–25 từ/câu)",
        "Task 2" => "(chuẩn: 80–120 từ)",
        "Task 3" => "(chuẩn: 300+ từ)",
        _ => ""
    };

    private string GetWordCountColor(string task, int count) => task switch
    {
        "Task 1" => count >= 15 && count <= 30 ? "#16a34a" : (count > 0 ? "#d97706" : "var(--color-text-muted)"),
        "Task 2" => count >= 80 ? "#16a34a" : (count >= 50 ? "#d97706" : "var(--color-text-muted)"),
        "Task 3" => count >= 300 ? "#16a34a" : (count >= 150 ? "#d97706" : "var(--color-text-muted)"),
        _ => "var(--color-text-primary)"
    };
}
