@using BlazorWasmPortfolioGhAction.Pages

<div class="toeic-daily-game">
    <div style="text-align: center; margin-bottom: 1.5rem;">
        <h3 style="font-size: 1.25rem; font-weight: 800; color: var(--color-brand-symbol, #ca8a04); margin: 0 0 0.25rem;">
            <i class="bi bi-controller me-1"></i> Match Pairs — Nối từ với nghĩa
        </h3>
        <p style="font-size: 0.85rem; color: var(--color-text-secondary); margin: 0;">
            Chọn 1 từ tiếng Anh rồi chọn nghĩa tiếng Việt tương ứng. Đúng +10, sai -2.
        </p>
    </div>

    @if (_gameFinished)
    {
        <div style="text-align: center; padding: 2rem; background: var(--color-bg-surface); border: 1px solid var(--color-border); border-radius: 14px;">
            <i class="bi bi-trophy-fill" style="font-size: 3rem; color: #d97706;"></i>
            <h3 style="margin: 1rem 0 0.5rem; font-weight: 800;">Hoàn thành!</h3>
            <p style="font-size: 1.1rem; color: var(--color-text-primary);">
                Điểm: <b style="color: #16a34a;">@_score</b> / @(_maxScore)
            </p>
            <p style="font-size: 0.85rem; color: var(--color-text-secondary); margin-bottom: 1.5rem;">
                @_matchedCount / @Words.Count cặp đúng • @_wrongAttempts lần sai
            </p>
            <button type="button" class="toeic-timer-btn primary" @onclick="ResetGame">
                <i class="bi bi-arrow-clockwise me-1"></i> Chơi lại
            </button>
        </div>
    }
    else
    {
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
            <!-- English column -->
            <div>
                <h4 style="font-size: 0.85rem; font-weight: 700; color: var(--color-text-muted); margin: 0 0 0.75rem; text-transform: uppercase; letter-spacing: 0.05em;">
                    Tiếng Anh
                </h4>
                <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                    @foreach (var item in _enItems)
                    {
                        var isSelected = _selectedEn == item.Word;
                        var isMatched = _matched.Contains(item.Word);
                        <button type="button"
                                disabled="@isMatched"
                                class="toeic-game-card @(isSelected ? "selected" : "") @(isMatched ? "matched" : "")"
                                @onclick="() => SelectEn(item.Word)">
                            <span class="toeic-game-word">@item.Word</span>
                            @if (!isMatched)
                            {
                                <span class="toeic-game-pos text-muted">@item.Pos</span>
                            }
                            else
                            {
                                <i class="bi bi-check-circle-fill text-success"></i>
                            }
                        </button>
                    }
                </div>
            </div>

            <!-- Vietnamese column -->
            <div>
                <h4 style="font-size: 0.85rem; font-weight: 700; color: var(--color-text-muted); margin: 0 0 0.75rem; text-transform: uppercase; letter-spacing: 0.05em;">
                    Nghĩa Tiếng Việt
                </h4>
                <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                    @foreach (var item in _viItems)
                    {
                        var isMatched = _matched.Contains(item.MatchedEn!);
                        <button type="button"
                                disabled="@isMatched"
                                class="toeic-game-card @(isMatched ? "matched" : "")"
                                @onclick="() => SelectVi(item.Vi)">
                            <span class="toeic-game-word">@item.Vi</span>
                        </button>
                    }
                </div>
            </div>
        </div>

        <div style="text-align: center; margin-top: 1.5rem; font-size: 1.05rem; font-weight: 700;">
            Điểm: <b style="color: #16a34a;">@_score</b>
            <span style="color: var(--color-text-muted); margin-left: 1rem;">
                @_matchedCount / @Words.Count đã nối
            </span>
        </div>
    }
</div>

<style>
    .toeic-game-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        padding: 0.7rem 1rem;
        background: var(--color-bg-surface);
        border: 2px solid var(--color-border);
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.15s ease;
        text-align: left;
        width: 100%;
    }
    .toeic-game-card:hover:not(:disabled) {
        border-color: var(--color-brand-symbol, #ca8a04);
        background: var(--color-bg-surface-elevated);
    }
    .toeic-game-card.selected {
        border-color: #3b82f6;
        background: rgba(59, 130, 246, 0.08);
    }
    .toeic-game-card.matched {
        opacity: 0.4;
        cursor: default;
        border-color: #16a34a;
        background: rgba(34, 197, 94, 0.05);
    }
    .toeic-game-word {
        font-weight: 700;
        font-size: 0.95rem;
        color: var(--color-text-primary);
    }
    .toeic-game-pos {
        font-size: 0.78rem;
        font-weight: 600;
    }
    .spin {
        animation: spin 1s linear infinite;
    }
    @@keyframes spin {
        to { transform: rotate(360deg); }
    }
</style>

@code {
    [Parameter] public List<ToeicWordItem> Words { get; set; } = new();
    [Parameter] public EventCallback<string> OnSpeak { get; set; }

    private record EnItem(string Word, string Pos);
    private record ViItem(string Vi, string? MatchedEn);

    private List<EnItem> _enItems = new();
    private List<ViItem> _viItems = new();
    private HashSet<string> _matched = new();
    private string? _selectedEn;
    private int _score;
    private int _wrongAttempts;
    private int _matchedCount;
    private int _maxScore;
    private bool _gameFinished;

    protected override void OnInitialized()
    {
        ResetGame();
    }

    private void ResetGame()
    {
        var rng = new Random();
        _enItems = Words.Select(w => new EnItem(w.En, w.Pos)).OrderBy(_ => rng.Next()).ToList();
        _viItems = Words.Select(w => new ViItem(w.Vi, w.En)).OrderBy(_ => rng.Next()).ToList();
        _matched = new HashSet<string>();
        _selectedEn = null;
        _score = 0;
        _wrongAttempts = 0;
        _matchedCount = 0;
        _maxScore = Words.Count * 10;
        _gameFinished = false;
    }

    private void SelectEn(string en)
    {
        _selectedEn = en;
    }

    private void SelectVi(string vi)
    {
        if (string.IsNullOrEmpty(_selectedEn)) return;

        var wordItem = Words.FirstOrDefault(w => w.En == _selectedEn);
        if (wordItem == null) return;

        if (wordItem.Vi == vi)
        {
            _matched.Add(_selectedEn);
            _score += 10;
            _matchedCount++;
            _selectedEn = null;

            if (_matchedCount >= Words.Count)
            {
                _gameFinished = true;
            }
        }
        else
        {
            _score = Math.Max(0, _score - 2);
            _wrongAttempts++;
            _selectedEn = null;
        }
    }
}
