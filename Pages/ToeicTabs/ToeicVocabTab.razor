@using BlazorWasmPortfolioGhAction.Pages
@using BlazorWasmPortfolioGhAction.Services.Toeic
@using BlazorWasmPortfolioGhAction.Services.Trading.Broker
@using BlazorWasmPortfolioGhAction.Pages.ToeicTabs
@inject IJSRuntime JS
@inject IDailyVocabService DailyVocabService
@inject IBrokerAuthService BrokerAuth

<div class="toeic-vocab-tab">
    <!-- Header -->
    <div class="toeic-section-header">
        <h2 class="toeic-section-title">
            <i class="bi bi-journal-bookmark-fill text-warning"></i>
            Kho Từ Vựng Trọng Điểm & Thẻ Nhớ Flashcard 3D
        </h2>
        <p class="toeic-section-desc">
            Từ vựng phân theo @Data.VocabCategories.Count chủ đề cốt lõi của đề thi TOEIC, hỗ trợ học tương tác bằng Flashcard 3D phản xạ nhanh và ma trận Paraphrase Part 7.
        </p>
    </div>

    <!-- Mode Selector -->
    <div class="toeic-filter-pills" style="margin-bottom: 2rem;">
        <button type="button"
                class="toeic-filter-chip @(_vocabMode == "daily" ? "active" : "")"
                @onclick='() => _vocabMode = "daily"'>
            <i class="bi bi-stars me-1 text-info"></i> 🎯 Hôm nay (@(_dailyResult?.Words.Count ?? 0) từ)
        </button>
        <button type="button"
                class="toeic-filter-chip @(_vocabMode == "flashcard" ? "active" : "")"
                @onclick='() => _vocabMode = "flashcard"'>
            <i class="bi bi-card-heading me-1 text-warning"></i> Thẻ Nhớ 3D (@AllWords.Count từ)
        </button>
        <button type="button"
                class="toeic-filter-chip @(_vocabMode == "confusing" ? "active" : "")"
                @onclick='() => _vocabMode = "confusing"'>
            <i class="bi bi-slash-circle me-1 text-danger"></i> Cặp Từ Dễ Nhầm Lẫn (@(Data.ConfusingWords?.Count ?? 0) cặp)
        </button>
        <button type="button"
                class="toeic-filter-chip @(_vocabMode == "phrasal" ? "active" : "")"
                @onclick='() => _vocabMode = "phrasal"'>
            <i class="bi bi-lightning-charge-fill me-1 text-primary"></i> Cụm Động Từ Hay Gặp (@(Data.PhrasalVerbs?.Count ?? 0) cụm)
        </button>
        <button type="button"
                class="toeic-filter-chip @(_vocabMode == "game" ? "active" : "")"
                @onclick='() => _vocabMode = "game"'>
            <i class="bi bi-controller me-1 text-success"></i> 🎮 Game Ôn Tập
        </button>
        <button type="button"
                class="toeic-filter-chip @(_vocabMode == "vocab" ? "active" : "")"
                @onclick='() => _vocabMode = "vocab"'>
            <i class="bi bi-grid-fill me-1"></i> Danh Sách Từ Vựng @Data.VocabCategories.Count Chủ Đề
        </button>
        <button type="button"
                class="toeic-filter-chip @(_vocabMode == "paraphrase" ? "active" : "")"
                @onclick='() => _vocabMode = "paraphrase"'>
            <i class="bi bi-arrow-left-right me-1"></i> Ma Trận Paraphrase
        </button>
    </div>

    @if (_vocabMode == "daily")
    {
        <!-- Daily Vocab Mode -->
        <div class="toeic-fc-wrapper">
            <div class="toeic-fc-toolbar">
                <div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
                    @if (_dailyResult != null && !string.IsNullOrEmpty(_dailyResult.TopicId))
                    {
                        <span class="toeic-tag" style="background: rgba(34, 197, 94, 0.15); color: #16a34a; font-weight: 700;">
                            <i class="bi bi-calendar-check me-1"></i> @_dailyResult.DateKey
                        </span>
                        <span class="toeic-tag" style="background: rgba(59, 130, 246, 0.12); color: #3b82f6; font-weight: 700;">
                            @_dailyResult.TopicId
                        </span>
                    }
                    @if (_dailyStreak > 0)
                    {
                        <span class="toeic-tag" style="background: rgba(245, 158, 11, 0.15); color: #d97706; font-weight: 700;">
                            <i class="bi bi-fire me-1"></i> Streak @_dailyStreak ngày
                        </span>
                    }
                </div>
                <div style="font-size: 0.85rem; color: var(--color-text-secondary); font-weight: 600;">
                    @if (_dailyLoading)
                    {
                        <text><span><i class="bi bi-arrow-repeat spin me-1"></i> Đang tạo từ vựng hôm nay...</span></text>
                    }
                    else if (_dailyResult is { FromCache: true })
                    {
                        <text><i class="bi bi-check-circle text-success me-1"></i> Đã tải cache hôm nay</text>
                    }
                </div>
            </div>

            @if (!_isLoggedIn)
            {
                <div style="text-align: center; padding: 3rem;">
                    <i class="bi bi-lock-fill" style="font-size: 2.5rem; color: var(--color-text-muted);"></i>
                    <p style="margin: 1rem 0; color: var(--color-text-secondary); font-size: 0.95rem;">
                        Cần đăng nhập broker-api để tạo từ vựng hàng ngày bằng Gemini AI.
                    </p>
                    <a href="@LoginHref" class="toeic-timer-btn primary" style="display: inline-flex; align-items: center; gap: 0.4rem; text-decoration: none;">
                        <i class="bi bi-box-arrow-in-right"></i> Đăng nhập
                    </a>
                </div>
            }
            else if (_dailyLoading)
            {
                <div style="text-align: center; padding: 3rem; color: var(--color-text-secondary);">
                    <i class="bi bi-arrow-repeat spin" style="font-size: 2rem;"></i>
                    <p style="margin-top: 1rem;">Đang gọi Gemini tạo 10 từ vựng hôm nay...</p>
                </div>
            }
            else if (_dailyResult is { Error: not null })
            {
                <div style="text-align: center; padding: 2rem; color: #ef4444;">
                    <i class="bi bi-exclamation-circle" style="font-size: 2rem;"></i>
                    <p style="margin-top: 1rem;">@_dailyResult.Error</p>
                    <button type="button" class="toeic-timer-btn primary" @onclick="LoadDailyVocab">
                        <i class="bi bi-arrow-clockwise me-1"></i> Thử lại
                    </button>
                </div>
            }
            else if (_dailyResult is { Words.Count: > 0 })
            {
                <!-- Flashcard deck for daily words -->
                <div style="height: 6px; background: var(--color-bg-surface-elevated); border-radius: 9999px; margin-bottom: 1.5rem; overflow: hidden;">
                    <div style="height: 100%; width: @(ProgressPercentage)%; background: var(--gradient-brand, #ca8a04); transition: width 0.3s ease;"></div>
                </div>

                @if (_dailyCurrent != null)
                {
                    <div class="toeic-fc-card-scene" @onclick="ToggleDailyFlip">
                        <div class="toeic-fc-card @(_isDailyFlipped ? "is-flipped" : "")">
                            <div class="toeic-fc-face toeic-fc-front">
                                <div class="toeic-fc-badge-row">
                                    <span class="toeic-tag">@_dailyCurrent.Pos</span>
                                </div>
                                <div class="toeic-fc-word-large">@_dailyCurrent.En</div>
                                <div class="toeic-fc-ipa">@_dailyCurrent.Ipa</div>
                                <button type="button" class="toeic-tts-btn" style="font-size: 1.5rem; margin-top: 1rem;" title="Nghe phát âm"
                                        @onclick:stopPropagation="true" @onclick="() => PlayAudio(_dailyCurrent.En)">
                                    <i class="bi bi-volume-up-fill"></i>
                                </button>
                                <div class="toeic-fc-hint">
                                    <i class="bi bi-hand-index-thumb me-1"></i> Chạm để lật xem nghĩa
                                </div>
                            </div>
                            <div class="toeic-fc-face toeic-fc-back">
                                <div class="toeic-fc-badge-row">
                                    <span class="toeic-tag" style="background: rgba(202, 138, 4, 0.15); color: var(--color-brand-symbol, #ca8a04);">Nghĩa Tiếng Việt</span>
                                </div>
                                <div class="toeic-fc-vi">@_dailyCurrent.Vi</div>
                                @if (!string.IsNullOrEmpty(_dailyCurrent.Collocation))
                                {
                                    <div class="toeic-fc-colloc">
                                        <i class="bi bi-link-45deg me-1"></i> <b>Cụm đi kèm:</b> @_dailyCurrent.Collocation
                                    </div>
                                }
                                @if (_dailyCurrent.WordFamily != null && (_dailyCurrent.WordFamily.V != null || _dailyCurrent.WordFamily.N != null || _dailyCurrent.WordFamily.Adj != null || _dailyCurrent.WordFamily.Adv != null))
                                {
                                    <div class="toeic-fc-family">
                                        <span class="toeic-family-label"><i class="bi bi-diagram-2-fill me-1"></i>Họ từ (Word Family):</span>
                                        <div class="toeic-wf-chips">
                                            @if (!string.IsNullOrEmpty(_dailyCurrent.WordFamily.V)) { <span class="toeic-wf-chip v" title="Verb"><b>V:</b> @_dailyCurrent.WordFamily.V</span> }
                                            @if (!string.IsNullOrEmpty(_dailyCurrent.WordFamily.N)) { <span class="toeic-wf-chip n" title="Noun"><b>N:</b> @_dailyCurrent.WordFamily.N</span> }
                                            @if (!string.IsNullOrEmpty(_dailyCurrent.WordFamily.Adj)) { <span class="toeic-wf-chip adj" title="Adjective"><b>Adj:</b> @_dailyCurrent.WordFamily.Adj</span> }
                                            @if (!string.IsNullOrEmpty(_dailyCurrent.WordFamily.Adv)) { <span class="toeic-wf-chip adv" title="Adverb"><b>Adv:</b> @_dailyCurrent.WordFamily.Adv</span> }
                                        </div>
                                    </div>
                                }
                                <div class="toeic-fc-example">"@_dailyCurrent.Example"</div>
                                <div class="toeic-fc-hint"><i class="bi bi-arrow-repeat me-1"></i> Chạm để quay lại</div>
                            </div>
                        </div>
                    </div>

                    <div class="toeic-fc-controls">
                        <button type="button" class="toeic-timer-btn secondary" @onclick="PrevDailyCard" disabled="@(_dailyCardIndex == 0)">
                            <i class="bi bi-arrow-left"></i> Thẻ trước
                        </button>
                        <button type="button" class="toeic-timer-btn primary" @onclick="ToggleDailyFlip">
                            <i class="bi bi-arrow-repeat"></i> Lật thẻ
                        </button>
                        <span style="font-weight: 700; color: var(--color-text-primary);">
                            @(_dailyCardIndex + 1) / @_dailyResult.Words.Count
                        </span>
                        <button type="button" class="toeic-timer-btn secondary" @onclick="NextDailyCard" disabled="@(_dailyCardIndex >= _dailyResult.Words.Count - 1)">
                            Thẻ tiếp <i class="bi bi-arrow-right"></i>
                        </button>
                    </div>

                    <!-- Start game button -->
                    @if (_dailyResult.Words.Count >= 4 && !_dailyGameStarted)
                    {
                        <div style="text-align: center; margin-top: 1.5rem;">
                            <button type="button" class="toeic-timer-btn primary" style="font-size: 1.05rem; padding: 0.7rem 2rem;" @onclick="StartDailyGame">
                                <i class="bi bi-controller me-1"></i> Chơi game Match Pairs
                            </button>
                        </div>
                    }

                    @if (_dailyGameStarted)
                    {
                        <DailyMatchGame Words="@_dailyResult.Words" OnSpeak="@PlayAudio" />
                    }
                }
            }
            else
            {
                <div style="text-align: center; padding: 3rem;">
                    <p style="color: var(--color-text-secondary); margin-bottom: 1rem;">Chưa có từ vựng hôm nay.</p>
                    <button type="button" class="toeic-timer-btn primary" @onclick="LoadDailyVocab">
                        <i class="bi bi-magic me-1"></i> Tạo từ vựng hôm nay
                    </button>
                </div>
            }
        </div>
    }
    else if (_vocabMode == "flashcard")
    {
        <!-- 3D Flashcard Mode -->
        <div class="toeic-fc-wrapper" tabindex="0" @onkeydown="HandleKeyDown" style="outline: none;">
            <!-- Toolbar -->
            <div class="toeic-fc-toolbar">
                <div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
                    <select class="toeic-search-input" style="width: auto; padding: 0.4rem 1rem;" @bind="_selectedFlashcardCategory" @bind:after="ResetDeck">
                        <option value="all">Toàn bộ kho từ (@AllWords.Count từ)</option>
                        <option value="unlearned">🎯 Chỉ từ chưa thuộc (@UnlearnedCount từ)</option>
                        <option value="learned">⭐ Chỉ từ đã thuộc (@_learnedWords.Count từ)</option>
                        <optgroup label="── 41 Chủ Đề Chuẩn ETS ──">
                            @foreach (var cat in Data.VocabCategories)
                            {
                                <option value="@cat.Id">@cat.Name (@cat.Items.Count từ)</option>
                            }
                        </optgroup>
                    </select>

                    <button type="button" class="toeic-tool-btn" @onclick="ShuffleDeck">
                        <i class="bi bi-shuffle me-1"></i> Trộn thẻ
                    </button>
                </div>

                <div style="font-size: 0.85rem; color: var(--color-text-secondary); font-weight: 600;">
                    Thẻ <b>@(_currentDeck.Any() ? _currentCardIndex + 1 : 0)</b> / @_currentDeck.Count
                    • Đã thuộc: <b class="text-success">@LearnedCount</b> từ
                </div>
            </div>

            <!-- Progress Bar -->
            <div style="height: 6px; background: var(--color-bg-surface-elevated); border-radius: 9999px; margin-bottom: 1.5rem; overflow: hidden;">
                <div style="height: 100%; width: @(ProgressPercentage)%; background: var(--gradient-brand, #ca8a04); transition: width 0.3s ease;"></div>
            </div>

            @if (_currentDeck.Any() && CurrentWord != null)
            {
                var isLearned = _learnedWords.Contains(CurrentWord.En);

                <!-- 3D Card Scene -->
                <div class="toeic-fc-card-scene" @onclick="ToggleFlip">
                    <div class="toeic-fc-card @(_isFlipped ? "is-flipped" : "")">
                        <!-- Front Face -->
                        <div class="toeic-fc-face toeic-fc-front">
                            <div class="toeic-fc-badge-row">
                                <span class="toeic-tag">@CurrentWord.Pos</span>
                                @if (isLearned)
                                {
                                    <span class="toeic-tag" style="background: rgba(34, 197, 94, 0.2); color: #16a34a;">
                                        <i class="bi bi-check-circle-fill me-1"></i> Đã thuộc
                                    </span>
                                }
                            </div>

                            <div class="toeic-fc-word-large">@CurrentWord.En</div>
                            <div class="toeic-fc-ipa">@CurrentWord.Ipa</div>

                            <button type="button"
                                    class="toeic-tts-btn"
                                    style="font-size: 1.5rem; margin-top: 1rem;"
                                    title="Nghe phát âm"
                                    @onclick:stopPropagation="true"
                                    @onclick="() => PlayAudio(CurrentWord.En)">
                                <i class="bi bi-volume-up-fill"></i>
                            </button>

                            <div class="toeic-fc-hint">
                                <i class="bi bi-hand-index-thumb me-1"></i> Chạm để lật xem nghĩa tiếng Việt & ví dụ
                            </div>
                        </div>

                        <!-- Back Face -->
                        <div class="toeic-fc-face toeic-fc-back">
                            <div class="toeic-fc-badge-row">
                                <span class="toeic-tag" style="background: rgba(202, 138, 4, 0.15); color: var(--color-brand-symbol, #ca8a04);">
                                    Nghĩa Tiếng Việt
                                </span>
                            </div>

                            <div class="toeic-fc-vi">@CurrentWord.Vi</div>

                            @if (!string.IsNullOrEmpty(CurrentWord.Collocation))
                            {
                                <div class="toeic-fc-colloc">
                                    <i class="bi bi-link-45deg me-1"></i> <b>Cụm đi kèm:</b> @CurrentWord.Collocation
                                </div>
                            }

                            @if (CurrentWord.WordFamily != null && (CurrentWord.WordFamily.V != null || CurrentWord.WordFamily.N != null || CurrentWord.WordFamily.Adj != null || CurrentWord.WordFamily.Adv != null))
                            {
                                <div class="toeic-fc-family">
                                    <span class="toeic-family-label"><i class="bi bi-diagram-2-fill me-1"></i>Họ từ (Word Family):</span>
                                    <div class="toeic-wf-chips">
                                        @if (!string.IsNullOrEmpty(CurrentWord.WordFamily.V)) { <span class="toeic-wf-chip v" title="Verb"><b>V:</b> @CurrentWord.WordFamily.V</span> }
                                        @if (!string.IsNullOrEmpty(CurrentWord.WordFamily.N)) { <span class="toeic-wf-chip n" title="Noun"><b>N:</b> @CurrentWord.WordFamily.N</span> }
                                        @if (!string.IsNullOrEmpty(CurrentWord.WordFamily.Adj)) { <span class="toeic-wf-chip adj" title="Adjective"><b>Adj:</b> @CurrentWord.WordFamily.Adj</span> }
                                        @if (!string.IsNullOrEmpty(CurrentWord.WordFamily.Adv)) { <span class="toeic-wf-chip adv" title="Adverb"><b>Adv:</b> @CurrentWord.WordFamily.Adv</span> }
                                    </div>
                                </div>
                            }

                            <div class="toeic-fc-example">
                                "@CurrentWord.Example"
                            </div>

                            <div class="toeic-fc-hint">
                                <i class="bi bi-arrow-repeat me-1"></i> Chạm để quay lại mặt trước
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Controls -->
                <div class="toeic-fc-controls">
                    <button type="button" class="toeic-timer-btn secondary" @onclick="PrevCard" disabled="@(_currentCardIndex == 0)">
                        <i class="bi bi-arrow-left"></i> Thẻ trước
                    </button>

                    <button type="button" class="toeic-timer-btn primary" @onclick="ToggleFlip">
                        <i class="bi bi-arrow-repeat"></i> Lật thẻ
                    </button>

                    <button type="button"
                            class="toeic-tool-btn @(isLearned ? "text-success" : "")"
                            @onclick="() => ToggleLearned(CurrentWord.En)">
                        <i class="bi @(isLearned ? "bi-check2-all text-success" : "bi-check2")"></i>
                        @(isLearned ? "Đã thuộc từ này" : "Đánh dấu đã thuộc")
                    </button>

                    <button type="button" class="toeic-timer-btn secondary" @onclick="NextCard" disabled="@(_currentCardIndex >= _currentDeck.Count - 1)">
                        Thẻ tiếp <i class="bi bi-arrow-right"></i>
                    </button>
                </div>

                <div class="toeic-keyboard-shortcuts">
                    <span><kbd>Space</kbd> Lật thẻ</span>
                    <span><kbd>←</kbd> <kbd>→</kbd> Thẻ trước / sau</span>
                    <span><kbd>M</kbd> hoặc <kbd>Enter</kbd> Đánh dấu đã thuộc</span>
                </div>
            }
        </div>
    }
    else if (_vocabMode == "vocab")
    {
        var currentCat = Data.VocabCategories.FirstOrDefault(c => c.Id == _selectedCatId) ?? Data.VocabCategories.First();
        var isSearching = !string.IsNullOrWhiteSpace(_vocabSearchTerm);
        var displayedWords = FilteredVocabList.ToList();

        <!-- Search Bar & Scope Toggle -->
        <div class="toeic-vocab-search-wrap" style="margin-bottom: 1.5rem;">
            <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; align-items: center; justify-content: space-between;">
                <div class="toeic-search-box" style="flex: 1; min-width: 280px; position: relative;">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <input type="text"
                           class="toeic-search-input"
                           style="padding-right: 2.5rem;"
                           placeholder="Tra cứu từ vựng (ví dụ: negotiate, đàm phán, hợp đồng, collocation)..."
                           @bind="_vocabSearchTerm"
                           @bind:event="oninput" />
                    @if (isSearching)
                    {
                        <button type="button" class="toeic-clear-search-btn" title="Xóa tìm kiếm" @onclick="ClearVocabSearch">
                            <i class="bi bi-x-circle-fill"></i>
                        </button>
                    }
                </div>

                <div style="display: flex; gap: 0.5rem; align-items: center;">
                    <label class="toeic-toggle-label" style="display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.85rem; color: var(--color-text-secondary); cursor: pointer; user-select: none;">
                        <input type="checkbox" @bind="_searchAcrossAllCategories" />
                        <span>Tìm trong toàn bộ 2.050 từ (41 chủ đề)</span>
                    </label>
                </div>
            </div>

            @if (isSearching)
            {
                <div style="margin-top: 0.75rem; font-size: 0.88rem; color: var(--color-text-secondary); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;">
                    <span>
                        <i class="bi bi-funnel-fill text-warning me-1"></i>
                        Tìm thấy <b class="text-warning">@displayedWords.Count</b> từ khớp với "<b>@_vocabSearchTerm</b>"
                        @(_searchAcrossAllCategories ? "(trên toàn bộ 41 chủ đề)" : $"(trong chủ đề {currentCat.NameVi})")
                    </span>
                    <button type="button" class="btn btn-sm btn-link text-warning text-decoration-none p-0" style="font-size: 0.82rem;" @onclick="ClearVocabSearch">
                        <i class="bi bi-x-lg me-1"></i> Xóa tìm kiếm
                    </button>
                </div>
            }
        </div>

        @if (!_searchAcrossAllCategories || !isSearching)
        {
            <!-- Category Selector -->
            <div class="toeic-filter-pills" style="margin-bottom: 1.5rem;">
                @foreach (var cat in Data.VocabCategories)
                {
                    <button type="button"
                            class="toeic-filter-chip @(_selectedCatId == cat.Id ? "active" : "")"
                            @onclick="() => _selectedCatId = cat.Id">
                        <i class="bi @cat.Icon me-1"></i> @cat.Name
                    </button>
                }
            </div>
        }

        <div class="toeic-vocab-section">
            <div style="margin-bottom: 1rem; display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 0.5rem;">
                <div>
                    <h3 style="font-size: 1.15rem; font-weight: 800; color: var(--color-brand-symbol, #ca8a04); margin: 0 0 0.25rem;">
                        @(isSearching && _searchAcrossAllCategories ? "Kết Quả Tìm Kiếm Toàn Diện" : currentCat.NameVi)
                    </h3>
                    <span style="font-size: 0.85rem; color: var(--color-text-muted);">
                        @displayedWords.Count từ vựng hiển thị
                    </span>
                </div>
            </div>

            @if (!displayedWords.Any())
            {
                <div style="text-align: center; padding: 3rem 1rem; color: var(--color-text-muted); background: var(--color-bg-surface); border: 1px solid var(--color-border); border-radius: 12px;">
                    <i class="bi bi-search" style="font-size: 2rem; display: block; margin-bottom: 0.75rem; opacity: 0.5;"></i>
                    <h4 style="margin: 0 0 0.5rem; font-size: 1.1rem; color: var(--color-text-primary);">Không tìm thấy từ vựng phù hợp</h4>
                    <p style="margin: 0 0 1rem; font-size: 0.88rem;">Hãy thử từ khóa khác hoặc bỏ chọn giới hạn chủ đề.</p>
                    <button type="button" class="toeic-timer-btn primary" @onclick="ClearVocabSearch">
                        Xóa từ khóa tìm kiếm
                    </button>
                </div>
            }
            else
            {
                <div class="toeic-vocab-grid">
                    @foreach (var word in displayedWords)
                    {
                        var isLearned = _learnedWords.Contains(word.En);
                        <div class="toeic-word-card">
                            <div class="toeic-word-top-row">
                                <span class="toeic-word-en">@word.En</span>
                                <div style="display: flex; gap: 0.35rem; align-items: center;">
                                    <button type="button"
                                            class="toeic-tool-btn p-0"
                                            style="width: 26px; height: 26px; font-size: 0.9rem;"
                                            title="@(isLearned ? "Đã thuộc" : "Đánh dấu đã thuộc")"
                                            @onclick="() => ToggleLearned(word.En)">
                                        <i class="bi @(isLearned ? "bi-check2-all text-success" : "bi-check2 text-muted")"></i>
                                    </button>
                                    <span class="toeic-word-pos">@word.Pos</span>
                                </div>
                            </div>

                            <div class="toeic-word-ipa-row">
                                <span class="toeic-word-ipa">@word.Ipa</span>
                                <button type="button"
                                        class="toeic-tts-btn"
                                        title="Phát âm tiếng Anh chuẩn"
                                        @onclick="() => PlayAudio(word.En)">
                                    <i class="bi bi-volume-up-fill"></i>
                                </button>
                            </div>

                            <div class="toeic-word-vi">@word.Vi</div>

                            @if (!string.IsNullOrEmpty(word.Collocation))
                            {
                                <div class="toeic-word-colloc">
                                    <i class="bi bi-link-45deg me-1"></i> @word.Collocation
                                </div>
                            }

                            @if (word.WordFamily != null && (word.WordFamily.V != null || word.WordFamily.N != null || word.WordFamily.Adj != null || word.WordFamily.Adv != null))
                            {
                                <div class="toeic-word-family">
                                    <span class="toeic-family-label"><i class="bi bi-diagram-2-fill me-1"></i>Họ từ (Word Family):</span>
                                    <div class="toeic-wf-chips">
                                        @if (!string.IsNullOrEmpty(word.WordFamily.V)) { <span class="toeic-wf-chip v" title="Verb"><b>V:</b> @word.WordFamily.V</span> }
                                        @if (!string.IsNullOrEmpty(word.WordFamily.N)) { <span class="toeic-wf-chip n" title="Noun"><b>N:</b> @word.WordFamily.N</span> }
                                        @if (!string.IsNullOrEmpty(word.WordFamily.Adj)) { <span class="toeic-wf-chip adj" title="Adjective"><b>Adj:</b> @word.WordFamily.Adj</span> }
                                        @if (!string.IsNullOrEmpty(word.WordFamily.Adv)) { <span class="toeic-wf-chip adv" title="Adverb"><b>Adv:</b> @word.WordFamily.Adv</span> }
                                    </div>
                                </div>
                            }

                            <div class="toeic-word-example">
                                "@word.Example"
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else if (_vocabMode == "game")
    {
        <!-- Vocab Match Game Mode -->
        <div class="toeic-fc-wrapper">
            <div class="toeic-fc-toolbar">
                <div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
                    <select class="toeic-search-input" style="width: auto; padding: 0.4rem 1rem;" @bind="_gameCategoryId">
                        @foreach (var cat in Data.VocabCategories)
                        {
                            <option value="@cat.Id">@cat.NameVi (@cat.Items.Count từ)</option>
                        }
                    </select>
                    <span class="toeic-tag" style="background: rgba(202, 138, 4, 0.15); color: var(--color-brand-symbol, #ca8a04); font-weight: 700;">
                        <i class="bi bi-calendar-day me-1"></i> Hôm nay: @GameTopicOfTheDay.NameVi
                    </span>
                </div>
                <div style="font-size: 0.85rem; color: var(--color-text-secondary); font-weight: 600;">
                    Chơi 10 từ / lượt • Bấm "Lượt mới" để đổi từ • Lưu tiến độ từng chủ đề
                </div>
            </div>

            @{
                var gameCat = Data.VocabCategories.FirstOrDefault(c => c.Id == _gameCategoryId) ?? GameTopicOfTheDay;
            }
            <VocabMatchGame Words="@gameCat.Items" CategoryId="@gameCat.Id" OnSpeak="@PlayAudio" @key="gameCat.Id" />
        </div>
    }
    else if (_vocabMode == "paraphrase")
    {
        <!-- Paraphrase Matrix -->
        <div class="toeic-paraphrase-grid">
            @foreach (var group in Data.Paraphrases)
            {
                <div class="toeic-paraphrase-card">
                    <h3 class="toeic-paraphrase-header">
                        <i class="bi @(group.Type == "Verbs" ? "bi-play-circle" : "bi-box") me-1 text-warning"></i>
                        @group.Title
                    </h3>

                    @foreach (var pair in group.Pairs)
                    {
                        <div class="toeic-para-item">
                            <div>
                                <span class="toeic-para-orig">@pair.Original</span>
                                <span class="toeic-para-arrow">&rarr;</span>
                            </div>

                            <div class="toeic-para-synonyms">
                                @foreach (var syn in pair.Paraphrases)
                                {
                                    <span class="toeic-para-pill">@syn</span>
                                }
                            </div>

                            <div class="toeic-para-vi">
                                <b>Nghĩa:</b> @pair.Vi
                            </div>

                            <div style="font-size: 0.78rem; color: var(--color-text-muted); margin-top: 0.25rem;">
                                <i class="bi bi-info-circle me-1"></i> @pair.Context
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else if (_vocabMode == "confusing")
    {
        <!-- Confusing Words Matrix -->
        <div class="toeic-confusing-section">
            <div class="toeic-timeline-header-card" style="margin-bottom: 2rem;">
                <h3 style="font-size: 1.25rem; font-weight: 800; margin: 0 0 0.5rem; color: #ef4444;">
                    <i class="bi bi-slash-circle me-2"></i>Ma Trận Cặp Từ Dễ Nhầm Lẫn Kinh Điển (Part 5 & 6)
                </h3>
                <p style="font-size: 0.88rem; color: var(--color-text-secondary); margin: 0; line-height: 1.6;">
                    Đây là các cặp từ có cách viết, phát âm gần giống nhau hoặc chung gốc từ nhưng mang nghĩa hoàn toàn khác biệt mà ETS chuyên dùng làm phương án bẫy gây mất điểm.
                </p>
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 1.5rem;">
                @foreach (var pair in Data.ConfusingWords ?? new())
                {
                    <div style="background: var(--color-bg-surface); border: 1px solid var(--color-border); border-radius: 14px; padding: 1.5rem; display: flex; flex-direction: column; justify-content: space-between;">
                        <div>
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; border-bottom: 1px solid var(--color-border); padding-bottom: 0.75rem;">
                                <h4 style="margin: 0; font-size: 1.15rem; font-weight: 800; color: var(--color-text-primary);">
                                    @pair.PairTitle
                                </h4>
                                <span class="toeic-tag" style="background: rgba(239, 68, 68, 0.12); color: #ef4444; font-weight: 700;">
                                    Bẫy Part 5
                                </span>
                            </div>

                            <!-- Word 1 -->
                            <div style="background: rgba(59, 130, 246, 0.05); border: 1px solid rgba(59, 130, 246, 0.2); border-radius: 10px; padding: 0.85rem; margin-bottom: 0.85rem;">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem;">
                                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                                        <b style="font-size: 1.05rem; color: #3b82f6;">@pair.Word1</b>
                                        <span class="toeic-tag" style="font-size: 0.72rem;">@pair.Pos1</span>
                                    </div>
                                    <button type="button" class="toeic-tts-btn" style="font-size: 1rem;" title="Phát âm" @onclick="() => PlayAudio(pair.Word1)">
                                        <i class="bi bi-volume-up-fill"></i>
                                    </button>
                                </div>
                                <div style="font-size: 0.85rem; font-weight: 600; color: var(--color-text-primary); margin-bottom: 0.35rem;">
                                    @pair.Meaning1
                                </div>
                                <div style="font-size: 0.8rem; color: var(--color-text-muted); font-style: italic;">
                                    "@pair.Example1"
                                </div>
                            </div>

                            <!-- Word 2 -->
                            <div style="background: rgba(16, 185, 129, 0.05); border: 1px solid rgba(16, 185, 129, 0.2); border-radius: 10px; padding: 0.85rem; margin-bottom: 1rem;">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem;">
                                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                                        <b style="font-size: 1.05rem; color: #10b981;">@pair.Word2</b>
                                        <span class="toeic-tag" style="font-size: 0.72rem;">@pair.Pos2</span>
                                    </div>
                                    <button type="button" class="toeic-tts-btn" style="font-size: 1rem;" title="Phát âm" @onclick="() => PlayAudio(pair.Word2)">
                                        <i class="bi bi-volume-up-fill"></i>
                                    </button>
                                </div>
                                <div style="font-size: 0.85rem; font-weight: 600; color: var(--color-text-primary); margin-bottom: 0.35rem;">
                                    @pair.Meaning2
                                </div>
                                <div style="font-size: 0.8rem; color: var(--color-text-muted); font-style: italic;">
                                    "@pair.Example2"
                                </div>
                            </div>
                        </div>

                        <!-- Distinction Tip -->
                        <div style="background: rgba(202, 138, 4, 0.08); border-left: 3px solid #ca8a04; border-radius: 6px; padding: 0.65rem 0.85rem; font-size: 0.82rem; color: var(--color-text-primary);">
                            <i class="bi bi-lightbulb-fill text-warning me-1"></i>
                            <b>Mẹo phân biệt:</b> @pair.DistinctionTip
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else if (_vocabMode == "phrasal")
    {
        <!-- Essential Phrasal Verbs -->
        <div class="toeic-phrasal-section">
            <div class="toeic-timeline-header-card" style="margin-bottom: 2rem;">
                <h3 style="font-size: 1.25rem; font-weight: 800; margin: 0 0 0.5rem; color: #3b82f6;">
                    <i class="bi bi-lightning-charge-fill me-2"></i>Cụm Động Từ (Phrasal Verbs) Xuất Hiện Nhiều Nhất Đề Thi
                </h3>
                <p style="font-size: 0.88rem; color: var(--color-text-secondary); margin: 0; line-height: 1.6;">
                    Trong văn cảnh công sở và đề thi TOEIC, phrasal verbs thường mang nghĩa thành ngữ chuyên biệt. Nắm chắc danh sách này giúp bạn xử lý nhanh gọn các câu hỏi từ vựng khó ở Part 5 & 7.
                </p>
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem;">
                @foreach (var pv in Data.PhrasalVerbs ?? new())
                {
                    <div style="background: var(--color-bg-surface); border: 1px solid var(--color-border); border-radius: 14px; padding: 1.5rem; display: flex; flex-direction: column; justify-content: space-between;">
                        <div>
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                                <div style="display: flex; align-items: center; gap: 0.5rem;">
                                    <h4 style="margin: 0; font-size: 1.25rem; font-weight: 800; color: var(--color-brand-symbol, #ca8a04);">
                                        @pv.Verb
                                    </h4>
                                    <button type="button" class="toeic-tts-btn" style="font-size: 1rem;" title="Phát âm" @onclick="() => PlayAudio(pv.Verb)">
                                        <i class="bi bi-volume-up-fill"></i>
                                    </button>
                                </div>
                                <span class="toeic-tag" style="background: rgba(59, 130, 246, 0.12); color: #3b82f6; font-weight: 700;">
                                    Phrasal Verb
                                </span>
                            </div>

                            <div style="font-size: 0.95rem; font-weight: 700; color: var(--color-text-primary); margin-bottom: 0.5rem;">
                                @pv.MeaningVi
                            </div>

                            <div style="margin-bottom: 0.75rem;">
                                <span style="font-size: 0.78rem; color: var(--color-text-muted); font-weight: 600;">Đồng nghĩa:</span>
                                <span style="font-size: 0.85rem; font-weight: 700; color: #10b981; margin-left: 0.35rem;">@pv.Synonym</span>
                            </div>

                            <div style="background: var(--color-bg-surface-elevated); border-radius: 8px; padding: 0.75rem; font-size: 0.82rem; color: var(--color-text-secondary); font-style: italic; margin-bottom: 0.75rem; line-height: 1.5;">
                                "@pv.Example"
                            </div>
                        </div>

                        <div style="font-size: 0.78rem; color: var(--color-text-muted); border-top: 1px solid var(--color-border); pt-2; margin-top: 0.5rem; display: flex; align-items: center; gap: 0.35rem;">
                            <i class="bi bi-pin-angle-fill text-warning"></i>
                            <span><b>Ngữ cảnh:</b> @pv.ContextNote</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public ToeicData Data { get; set; } = default!;
    [Parameter] public EventCallback<string> OnSpeak { get; set; }

    private string _vocabMode = "daily";
    private string _selectedCatId = "cat-business";
    private string _selectedFlashcardCategory = "all";
    private string _gameCategoryId = "";
    private string _vocabSearchTerm = "";
    private bool _searchAcrossAllCategories = true;

    private List<ToeicWordItem> _currentDeck = new();
    private int _currentCardIndex = 0;
    private bool _isFlipped = false;
    private HashSet<string> _learnedWords = new();

    private int UnlearnedCount => Math.Max(0, AllWords.Count - _learnedWords.Count);

    private void ClearVocabSearch() => _vocabSearchTerm = "";

    private IEnumerable<ToeicWordItem> FilteredVocabList
    {
        get
        {
            var currentCat = Data.VocabCategories.FirstOrDefault(c => c.Id == _selectedCatId) ?? Data.VocabCategories.First();
            var baseList = _searchAcrossAllCategories || string.IsNullOrWhiteSpace(_vocabSearchTerm)
                ? (string.IsNullOrWhiteSpace(_vocabSearchTerm) ? currentCat.Items : AllWords)
                : currentCat.Items;

            if (string.IsNullOrWhiteSpace(_vocabSearchTerm)) return baseList;

            var term = _vocabSearchTerm.Trim().ToLowerInvariant();
            return baseList.Where(w =>
                w.En.ToLowerInvariant().Contains(term) ||
                w.Vi.ToLowerInvariant().Contains(term) ||
                (w.Collocation != null && w.Collocation.ToLowerInvariant().Contains(term)) ||
                (w.Pos != null && w.Pos.ToLowerInvariant().Contains(term)) ||
                (w.Example != null && w.Example.ToLowerInvariant().Contains(term)) ||
                (w.WordFamily != null && (
                    (w.WordFamily.V != null && w.WordFamily.V.ToLowerInvariant().Contains(term)) ||
                    (w.WordFamily.N != null && w.WordFamily.N.ToLowerInvariant().Contains(term)) ||
                    (w.WordFamily.Adj != null && w.WordFamily.Adj.ToLowerInvariant().Contains(term)) ||
                    (w.WordFamily.Adv != null && w.WordFamily.Adv.ToLowerInvariant().Contains(term))
                ))
            );
        }
    }

    // Daily vocab state
    private DailyVocabResult? _dailyResult;
    private bool _dailyLoading;
    private int _dailyCardIndex;
    private bool _isDailyFlipped;
    private bool _dailyGameStarted;
    private int _dailyStreak;
    private bool _isLoggedIn;

    private ToeicWordItem? _dailyCurrent => _dailyResult != null && _dailyResult.Words.Count > _dailyCardIndex
        ? _dailyResult.Words[_dailyCardIndex]
        : null;

    private string LoginHref => "/admin";

    private List<ToeicWordItem> AllWords => Data.VocabCategories.SelectMany(c => c.Items).ToList();

    private ToeicVocabCategory GameTopicOfTheDay
    {
        get
        {
            var dayOfYear = DateTime.UtcNow.DayOfYear;
            var idx = (dayOfYear - 1) % Data.VocabCategories.Count;
            return Data.VocabCategories[idx];
        }
    }

    private ToeicWordItem? CurrentWord => _currentDeck.Count > _currentCardIndex ? _currentDeck[_currentCardIndex] : null;

    private int LearnedCount => _currentDeck.Count(w => _learnedWords.Contains(w.En));

    private double ProgressPercentage => _currentDeck.Any() ? Math.Round((double)(_currentCardIndex + 1) / _currentDeck.Count * 100, 1) : 0;

    protected override void OnInitialized()
    {
        _gameCategoryId = GameTopicOfTheDay.Id;
        ResetDeck();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var stored = await JS.InvokeAsync<string?>("localStorage.getItem", "toeic_learned_words");
                if (!string.IsNullOrEmpty(stored))
                {
                    var list = System.Text.Json.JsonSerializer.Deserialize<List<string>>(stored);
                    if (list != null)
                    {
                        _learnedWords = new HashSet<string>(list);
                        StateHasChanged();
                    }
                }
            }
            catch { }

            _ = CheckLoginAndLoad();
        }
    }

    private async Task CheckLoginAndLoad()
    {
        var token = await BrokerAuth.GetTokenAsync();
        _isLoggedIn = !string.IsNullOrEmpty(token);
        StateHasChanged();
        if (_isLoggedIn)
        {
            await LoadDailyVocab();
            await LoadStreak();
        }
    }

    private async Task LoadDailyVocab()
    {
        _dailyLoading = true;
        _dailyGameStarted = false;
        _dailyCardIndex = 0;
        _isDailyFlipped = false;
        StateHasChanged();

        try
        {
            _dailyResult = await DailyVocabService.GetTodayAsync();
        }
        catch (Exception ex)
        {
            _dailyResult = new DailyVocabResult { Error = ex.Message };
        }

        _dailyLoading = false;
        StateHasChanged();
    }

    private async Task LoadStreak()
    {
        try
        {
            var history = await DailyVocabService.GetHistoryAsync();
            _dailyStreak = DailyVocabService.GetStreak(history);
            StateHasChanged();
        }
        catch { }
    }

    private void ToggleDailyFlip() => _isDailyFlipped = !_isDailyFlipped;

    private void NextDailyCard()
    {
        if (_dailyResult != null && _dailyCardIndex < _dailyResult.Words.Count - 1)
        {
            _dailyCardIndex++;
            _isDailyFlipped = false;
        }
    }

    private void PrevDailyCard()
    {
        if (_dailyCardIndex > 0)
        {
            _dailyCardIndex--;
            _isDailyFlipped = false;
        }
    }

    private void StartDailyGame()
    {
        _dailyGameStarted = true;
    }

    private void ResetDeck()
    {
        if (_selectedFlashcardCategory == "all")
        {
            _currentDeck = AllWords.ToList();
        }
        else if (_selectedFlashcardCategory == "unlearned")
        {
            _currentDeck = AllWords.Where(w => !_learnedWords.Contains(w.En)).ToList();
        }
        else if (_selectedFlashcardCategory == "learned")
        {
            _currentDeck = AllWords.Where(w => _learnedWords.Contains(w.En)).ToList();
        }
        else
        {
            var cat = Data.VocabCategories.FirstOrDefault(c => c.Id == _selectedFlashcardCategory);
            _currentDeck = cat != null ? cat.Items.ToList() : AllWords.ToList();
        }
        _currentCardIndex = 0;
        _isFlipped = false;
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "ArrowRight" || e.Key == "PageDown")
        {
            NextCard();
        }
        else if (e.Key == "ArrowLeft" || e.Key == "PageUp")
        {
            PrevCard();
        }
        else if (e.Key == " " || e.Key == "ArrowUp" || e.Key == "ArrowDown")
        {
            ToggleFlip();
        }
        else if (e.Key == "m" || e.Key == "M" || e.Key == "Enter")
        {
            if (CurrentWord != null) ToggleLearned(CurrentWord.En);
        }
    }

    private void ShuffleDeck()
    {
        var rng = new Random();
        _currentDeck = _currentDeck.OrderBy(x => rng.Next()).ToList();
        _currentCardIndex = 0;
        _isFlipped = false;
    }

    private void ToggleFlip() => _isFlipped = !_isFlipped;

    private void NextCard()
    {
        if (_currentCardIndex < _currentDeck.Count - 1)
        {
            _currentCardIndex++;
            _isFlipped = false;
        }
    }

    private void PrevCard()
    {
        if (_currentCardIndex > 0)
        {
            _currentCardIndex--;
            _isFlipped = false;
        }
    }

    private void ToggleLearned(string en)
    {
        if (!_learnedWords.Remove(en)) _learnedWords.Add(en);
        _ = SaveLearnedAsync();
    }

    private async Task SaveLearnedAsync()
    {
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(_learnedWords);
            await JS.InvokeVoidAsync("localStorage.setItem", "toeic_learned_words", json);
        }
        catch { }
    }

    private async Task PlayAudio(string text)
    {
        await OnSpeak.InvokeAsync(text);
    }
}
