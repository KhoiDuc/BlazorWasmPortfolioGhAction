@using BlazorWasmPortfolioGhAction.Pages
@inject IJSRuntime JS

<div class="toeic-grammar-tab">
    <!-- Header -->
    <div class="toeic-section-header">
        <h2 class="toeic-section-title">
            <i class="bi bi-diagram-3-fill text-warning"></i>
            12 Trụ Cột Ngữ Pháp Cốt Lõi Part 5 & Mini Quiz Tương Tác
        </h2>
        <p class="toeic-section-desc">
            Bao phủ 100% dạng câu hỏi ngữ pháp Part 5: Từ loại, 12 thì, thể bị động, đại từ, sự hòa hợp S-V, mệnh đề quan hệ rút gọn, liên từ vs giới từ, câu điều kiện đảo ngữ, thể giả định, so sánh và V-ing vs To-V.
        </p>
    </div>

    <!-- Quiz Summary Banner -->
    <div class="toeic-quiz-summary-card">
        <div>
            <div style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-brand-symbol, #ca8a04); margin-bottom: 0.25rem;">
                <i class="bi bi-patch-question-fill me-1"></i> Bảng Thành Tích Mini Quiz Ngữ Pháp Part 5
            </div>
            <div style="font-size: 1.15rem; font-weight: 800; color: var(--color-text-primary);">
                Đã làm: <span class="text-primary">@_userAnswers.Count</span> / @TotalQuestions câu
                • Đúng: <span class="text-success">@CorrectAnswersCount</span> câu
                @if (_userAnswers.Any())
                {
                    <span style="font-size: 0.95rem; font-weight: 700; margin-left: 0.5rem; color: @(AccuracyRate >= 80 ? "#16a34a" : (AccuracyRate >= 60 ? "#d97706" : "#ef4444"));">
                        (@AccuracyRate% chính xác)
                    </span>
                }
            </div>
        </div>

        <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
            @if (_userAnswers.Any())
            {
                <button type="button" class="toeic-tool-btn" style="color: #ef4444; border-color: rgba(239, 68, 68, 0.3);" @onclick="ResetQuiz">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Làm lại toàn bộ Quiz
                </button>
            }
        </div>
    </div>

    <!-- Quick Topic Jump Chips -->
    <div class="toeic-filter-pills" style="margin-bottom: 2rem;">
        <button type="button"
                class="toeic-filter-chip @(_selectedGrammarFilter == "all" ? "active" : "")"
                @onclick='() => _selectedGrammarFilter = "all"'>
            <i class="bi bi-grid-fill me-1"></i> Tất Cả (@Data.GrammarTopics.Count Trụ Cột)
        </button>
        @foreach (var topic in Data.GrammarTopics)
        {
            var isCurrent = _selectedGrammarFilter == topic.Id;
            <button type="button"
                    class="toeic-filter-chip @(isCurrent ? "active" : "")"
                    @onclick="() => _selectedGrammarFilter = topic.Id">
                @topic.Title.Split('(')[0].Trim()
            </button>
        }
    </div>

    @foreach (var topic in DisplayedTopics)
    {
        <div class="toeic-grammar-block">
            <h3 class="toeic-grammar-title">@topic.Title</h3>
            <div class="toeic-grammar-formula">
                <i class="bi bi-code-slash me-2"></i>@topic.Formula
            </div>

            <ul class="toeic-rules-list">
                @foreach (var rule in topic.Rules)
                {
                    <li>@rule</li>
                }
            </ul>

            <!-- Cheat Table -->
            <div class="toeic-table-responsive">
                <table class="toeic-cheat-table">
                    <thead>
                        <tr>
                            <th>Vị Trí & Trường Hợp</th>
                            <th>Mẫu Cấu Trúc</th>
                            <th>Ví Dụ Minh Họa</th>
                            <th>Ghi Chú</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in topic.CheatTable)
                        {
                            <tr>
                                <td style="font-weight: 700; color: var(--color-text-primary);">@row.Label</td>
                                <td><code>@row.Patterns</code></td>
                                <td>@row.Examples</td>
                                <td style="font-size: 0.8rem; color: var(--color-text-muted);">@row.Note</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Mini Quiz -->
            <div class="toeic-quiz-box">
                <div class="toeic-quiz-title">
                    <i class="bi bi-patch-question-fill"></i> Thử Thách Phản Xạ Nhanh (Mini Quiz)
                </div>

                @for (int i = 0; i < topic.MiniQuiz.Count; i++)
                {
                    var qIndex = i;
                    var q = topic.MiniQuiz[qIndex];
                    var qKey = $"{topic.Id}-{qIndex}";
                    var userChoice = _userAnswers.ContainsKey(qKey) ? _userAnswers[qKey] : (int?)null;

                    <div style="margin-bottom: 1.25rem;">
                        <div class="toeic-quiz-q">
                            Câu @(qIndex + 1): @q.Question
                        </div>

                        <div class="toeic-quiz-options">
                            @for (int optIdx = 0; optIdx < q.Options.Count; optIdx++)
                            {
                                var currentOpt = optIdx;
                                var isChosen = userChoice == currentOpt;
                                var isCorrect = q.CorrectIndex == currentOpt;

                                var btnClass = "";
                                if (userChoice.HasValue)
                                {
                                    if (isCorrect) btnClass = "correct";
                                    else if (isChosen) btnClass = "wrong";
                                }

                                <button type="button"
                                        class="toeic-quiz-opt-btn @btnClass"
                                        disabled="@userChoice.HasValue"
                                        @onclick="() => SelectAnswer(qKey, currentOpt)">
                                    <span>
                                        <b>@((char)('A' + currentOpt)).</b> @q.Options[currentOpt]
                                    </span>

                                    @if (userChoice.HasValue)
                                    {
                                        if (isCorrect)
                                        {
                                            <i class="bi bi-check-lg text-success"></i>
                                        }
                                        else if (isChosen)
                                        {
                                            <i class="bi bi-x-lg text-danger"></i>
                                        }
                                    }
                                </button>
                            }
                        </div>

                        @if (userChoice.HasValue)
                        {
                            <div class="toeic-quiz-explanation">
                                <b><i class="bi bi-info-circle-fill me-1"></i> Giải thích chi tiết:</b> @q.Explanation
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public ToeicData Data { get; set; } = default!;

    private string _selectedGrammarFilter = "all";
    private Dictionary<string, int> _userAnswers = new();

    private int TotalQuestions => Data.GrammarTopics.Sum(t => t.MiniQuiz.Count);

    private int CorrectAnswersCount
    {
        get
        {
            int count = 0;
            foreach (var topic in Data.GrammarTopics)
            {
                for (int i = 0; i < topic.MiniQuiz.Count; i++)
                {
                    var key = $"{topic.Id}-{i}";
                    if (_userAnswers.TryGetValue(key, out var ans) && ans == topic.MiniQuiz[i].CorrectIndex)
                    {
                        count++;
                    }
                }
            }
            return count;
        }
    }

    private int AccuracyRate => _userAnswers.Any()
        ? (int)Math.Round((double)CorrectAnswersCount / _userAnswers.Count * 100)
        : 0;

    private IEnumerable<ToeicGrammarTopic> DisplayedTopics =>
        _selectedGrammarFilter == "all"
            ? Data.GrammarTopics
            : Data.GrammarTopics.Where(t => t.Id == _selectedGrammarFilter);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var stored = await JS.InvokeAsync<string?>("localStorage.getItem", "toeic_grammar_quiz_answers");
                if (!string.IsNullOrEmpty(stored))
                {
                    var dict = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, int>>(stored);
                    if (dict != null)
                    {
                        _userAnswers = dict;
                        StateHasChanged();
                    }
                }
            }
            catch { }
        }
    }

    private void SelectAnswer(string qKey, int choice)
    {
        _userAnswers[qKey] = choice;
        _ = SaveAnswersAsync();
    }

    private async Task SaveAnswersAsync()
    {
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(_userAnswers);
            await JS.InvokeVoidAsync("localStorage.setItem", "toeic_grammar_quiz_answers", json);
        }
        catch { }
    }

    private async Task ResetQuiz()
    {
        _userAnswers.Clear();
        try
        {
            await JS.InvokeVoidAsync("localStorage.removeItem", "toeic_grammar_quiz_answers");
        }
        catch { }
    }
}
