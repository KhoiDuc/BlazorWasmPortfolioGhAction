@page "/admin"
@page "/{lang:regex(^(en|vn)$)}/admin"
@inherits CultureAwareComponent
@using Microsoft.AspNetCore.Components.Authorization
@using BlazorWasmPortfolioGhAction.Services.Auth
@inject CustomAuthStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResources> L

<div class="page-section admin-page">
    <section>
        <div class="container">
            <AuthorizeView Context="auth">
                <Authorized>
                    <div class="admin-panel tool-card">
                        <p class="section-label">@L["Admin_Label"]</p>
                        <h2>@L["Admin_SignedIn"]</h2>
                        <p class="admin-lead">@L["Admin_SignedInLead"]</p>
                        <div class="tool-actions">
                            <a class="tool-btn tool-btn-primary" href="wiki/edit/Portfolio">
                                <i class="bi bi-pencil" aria-hidden="true"></i> @L["Wiki_Edit"]
                            </a>
                            <button type="button" class="tool-btn tool-btn-secondary" @onclick="LogoutAsync">
                                <i class="bi bi-box-arrow-right" aria-hidden="true"></i> @L["Admin_SignOut"]
                            </button>
                        </div>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <div class="admin-login tool-card">
                        <p class="section-label">@L["Admin_Label"]</p>
                        <h2>@L["Admin_SignIn"]</h2>
                        <p class="admin-lead">@L["Admin_SignInLead"]</p>

                        @if (!string.IsNullOrEmpty(_error))
                        {
                            <div class="tool-alert tool-alert-danger">@_error</div>
                        }

                        <EditForm Model="_model" OnValidSubmit="LoginAsync" class="tool-form">
                            <div class="tool-field">
                                <label class="tool-label" for="admin-user">@L["Admin_Username"]</label>
                                <InputText id="admin-user" class="tool-input" @bind-Value="_model.Username" autocomplete="username" />
                            </div>
                            <div class="tool-field">
                                <label class="tool-label" for="admin-pass">@L["Admin_Password"]</label>
                                <InputText id="admin-pass" type="password" class="tool-input" @bind-Value="_model.Password" autocomplete="current-password" />
                            </div>
                            <div class="tool-actions">
                                <button type="submit" class="tool-btn tool-btn-primary" disabled="@_busy">
                                    @(_busy ? L["Admin_SigningIn"] : L["Admin_SignIn"])
                                </button>
                            </div>
                        </EditForm>
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </section>
</div>

@code {
    private readonly LoginModel _model = new();
    private string? _error;
    private bool _busy;

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private async Task LoginAsync()
    {
        _busy = true;
        _error = null;

        var ok = await AuthStateProvider.LoginAsync(_model.Username.Trim(), _model.Password);
        _busy = false;

        if (!ok)
        {
            _error = L["Admin_Invalid"];
            return;
        }

        var target = string.IsNullOrWhiteSpace(ReturnUrl) ? "/admin" : ReturnUrl;
        Navigation.NavigateTo(target);
    }

    private async Task LogoutAsync()
    {
        await AuthStateProvider.LogoutAsync();
        Navigation.NavigateTo("/admin");
    }

    private sealed class LoginModel
    {
        public string Username { get; set; } = "";
        public string Password { get; set; } = "";
    }
}
