@inject IJSRuntime JSRuntime
@using BlazorWasmPortfolioGhAction.Pages.CryptoManagerComponents

<button type="button"
        class="crypto-card @(IsSelected ? "crypto-card-selected" : "")"
        @onclick="SelectCrypto"
        aria-pressed="@IsSelected">
    <div class="crypto-card-head">
        <strong>@Crypto.Name</strong>
        <span class="crypto-card-symbol">@Crypto.Symbol</span>
    </div>
    <p class="crypto-card-price">@Crypto.CurrentPrice</p>
    <div class="crypto-card-chart">
        <canvas id="@($"chart_{Crypto.Id}")" aria-hidden="true"></canvas>
    </div>
</button>

@code {
    [Parameter, EditorRequired]
    public Crypto Crypto { get; set; } = null!;

    [Parameter]
    public bool IsSelected { get; set; }

    [Parameter]
    public EventCallback<Crypto> OnCryptoSelected { get; set; }

    private Task SelectCrypto() => OnCryptoSelected.InvokeAsync(Crypto);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JSRuntime.InvokeVoidAsync("renderSmallChart", Crypto.Id, Crypto.PriceHistory);
    }
}
