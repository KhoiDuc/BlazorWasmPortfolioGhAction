@inject IJSRuntime JSRuntime
@using BlazorWasmPortfolioGhAction.Pages.CryptoManagerComponents

<article class="tool-card crypto-detail-card">
    <div class="tool-modal-header crypto-detail-header">
        <div>
            <h3 class="tool-modal-title">@Crypto.Name</h3>
            <p class="crypto-detail-symbol">@Crypto.Symbol</p>
        </div>
        <button type="button" class="tool-modal-close" aria-label="Close detail" @onclick="CloseDetail">&times;</button>
    </div>

    <div class="tool-modal-body">
        <p class="crypto-detail-price">@Crypto.CurrentPrice</p>

        <div class="crypto-stats-grid">
            <div class="tool-stat-card">
                <span class="tool-stat-label">24h volume (quote)</span>
                <strong class="tool-stat-value">@Crypto.VolumeInQuoteCurrency</strong>
            </div>
            <div class="tool-stat-card">
                <span class="tool-stat-label">24h volume (base)</span>
                <strong class="tool-stat-value">@Crypto.VolumeInBaseCurrency</strong>
            </div>
            <div class="tool-stat-card">
                <span class="tool-stat-label">24h high</span>
                <strong class="tool-stat-value">@Crypto.High24h</strong>
            </div>
            <div class="tool-stat-card">
                <span class="tool-stat-label">24h low</span>
                <strong class="tool-stat-value">@Crypto.Low24h</strong>
            </div>
            <div class="tool-stat-card">
                <span class="tool-stat-label">24h change</span>
                <strong class="tool-stat-value @(Crypto.Change24h >= 0 ? "crypto-up" : "crypto-down")">@Crypto.Change24h%</strong>
            </div>
            <div class="tool-stat-card">
                <span class="tool-stat-label">Last update</span>
                <strong class="tool-stat-value crypto-stat-time">@Crypto.LastUpdate.ToString("HH:mm:ss")</strong>
            </div>
        </div>

        <div class="crypto-detail-chart">
            <canvas id="@($"detailChart_{Crypto.Id}")" aria-label="@($"{Crypto.Symbol} price chart")"></canvas>
        </div>
    </div>
</article>

@code {
    [Parameter, EditorRequired]
    public Crypto Crypto { get; set; } = null!;

    [Parameter]
    public EventCallback<Crypto> OnClose { get; set; }

    private Task CloseDetail() => OnClose.InvokeAsync(Crypto);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JSRuntime.InvokeVoidAsync("renderDetailChart", Crypto.Id, Crypto.PriceHistory);
    }
}
