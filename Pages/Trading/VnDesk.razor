@page "/trading/vndesk"
@page "/{lang:regex(^(en|vn)$)}/trading/vndesk"
@layout TradingLayout
@inherits CultureAwareComponent
@using BlazorWasmPortfolioGhAction.Models.Trading.VnDesk
@using BlazorWasmPortfolioGhAction.Services.Localization
@inject IStringLocalizer<SharedResources> L

<div class="vd-page">
    <div class="vd-header">
        <div>
            <h2>VnDesk</h2>
            <p>@L["Trading_VnDeskLead"]</p>
        </div>
    </div>

    <div class="vd-symbol-bar">
        <div class="vd-symbol-row">
            <label class="ts-label" for="desk-symbol">@L["Trading_SymbolLabel"]</label>
            <input id="desk-symbol" class="vd-symbol-input" @bind="_symbolInput" @bind:event="oninput"
                   placeholder="VNM, FPT, HPG..." @onkeydown="OnSymbolKey" />
            @if (_popular.Length > 0)
            {
                <div class="vd-chips">
                    @foreach (var p in _popular)
                    {
                        <button type="button" class="vd-chip @(_activeSymbol == p ? "active" : "")" @onclick='() => PickSymbol(p)'>@p</button>
                    }
                </div>
            }
            <button type="button" class="vd-btn vd-btn-primary vd-btn-sm" @onclick="CommitAndAnalyze">Phân tích</button>
        </div>
    </div>

    <nav class="vd-nav" aria-label="VnDesk navigation">
        <button class="vd-nav-item @(_tab == "market" ? "active" : "")" @onclick='() => GoTab("market")'>Thị trường</button>
        <button class="vd-nav-item @(_tab == "analyze" ? "active" : "")" @onclick='() => GoTab("analyze")'>Phân tích</button>
        <button class="vd-nav-item @(_tab == "screen" ? "active" : "")" @onclick='() => GoTab("screen")'>Lọc</button>
        <button class="vd-nav-item @(_tab == "ai" ? "active" : "")" @onclick='() => GoTab("ai")'>AI</button>
    </nav>

    <div class="vd-content">
        @if (_tab == "market")
        {
            <VnMarketPanel OnSymbolSelected="OnSymbolFromMarket" />
        }
        else if (_tab == "analyze")
        {
            <div class="vd-analyze-layout">
                <div class="vd-analyze-main">
                    <VnAnalysisPanel @ref="_analysis" Symbol="@_activeSymbol" />
                </div>
                <div class="vd-chart-dock @(_chartCollapsed ? "collapsed" : "")">
                    <div class="vd-chart-dock-head">
                        <span class="vd-chart-dock-title">@_activeSymbol</span>
                        <div class="vd-controls">
                            <a class="vd-btn vd-btn-sm" href="@BacktestHref" target="_blank">Backtest</a>
                            <button class="vd-btn vd-btn-sm" @onclick="ToggleChart" aria-label="@(_chartCollapsed ? "Mở rộng" : "Thu gọn")">@(_chartCollapsed ? "▸ Biểu đồ" : "▾ Thu gọn")</button>
                        </div>
                    </div>
                    @if (!_chartCollapsed)
                    {
                        <div class="vd-chart-dock-body">
                            <iframe src="@($"https://stockchart.vietstock.vn/?stockcode={_activeSymbol}")"
                                    width="100%" height="420" frameborder="0" title="Vietstock chart"></iframe>
                            <details class="vd-alert-collapse">
                                <summary>Cảnh báo giá — @_activeSymbol</summary>
                                <PriceAlertWidget Symbol="@_activeSymbol" AssetType="stock" />
                            </details>
                        </div>
                    }
                </div>
            </div>
        }
        else if (_tab == "screen")
        {
            <div class="vd-subtabs">
                <button class="vd-subtab @(_screenSub == "basic" ? "active" : "")" @onclick='() => _screenSub = "basic"'>Screener cơ bản</button>
                <button class="vd-subtab @(_screenSub == "multi" ? "active" : "")" @onclick='() => _screenSub = "multi"'>Đa chỉ báo</button>
            </div>
            @if (_screenSub == "basic")
            {
                <VnScreenerPanel OnSymbolSelected="OnSymbolFromScreener" />
            }
            else
            {
                <VnMultiScreenerPanel OnSymbolSelected="OnSymbolFromScreener" />
            }
        }
        else if (_tab == "ai")
        {
            <VnAiPanel Symbol="@_activeSymbol" OnThesisReady="OnThesisReady" />
        }
    </div>
</div>

@code {
    private string _tab = "market";
    private string _symbolInput = "VNM";
    private string _activeSymbol = "VNM";
    private string _screenSub = "basic";
    private bool _chartCollapsed = false;
    private VnAnalysisPanel? _analysis;

    private readonly string[] _popular = ["VNM", "FPT", "HPG", "VCB", "MWG"];

    private string BacktestHref => $"/{CultureService.UrlLang}/trading/backtest?symbol={_activeSymbol}";

    private void GoTab(string tab) => _tab = tab;

    private void ToggleChart() => _chartCollapsed = !_chartCollapsed;

    private void PickSymbol(string sym)
    {
        _symbolInput = sym.Trim().ToUpperInvariant();
        _activeSymbol = _symbolInput;
    }

    private void CommitAndAnalyze()
    {
        if (string.IsNullOrWhiteSpace(_symbolInput)) return;
        _activeSymbol = _symbolInput.Trim().ToUpperInvariant();
        _symbolInput = _activeSymbol;
        GoTab("analyze");
    }

    private void OnSymbolFromMarket(string sym)
    {
        PickSymbol(sym);
        GoTab("analyze");
    }

    private void OnSymbolFromScreener(string sym)
    {
        PickSymbol(sym);
        GoTab("analyze");
    }

    private void OnSymbolKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            CommitAndAnalyze();
    }

    private Task OnThesisReady(string _)
    {
        GoTab("analyze");
        return Task.CompletedTask;
    }
}
