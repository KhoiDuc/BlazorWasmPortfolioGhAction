@page "/trading/forex"
@layout TradingLayout
@using BlazorWasmPortfolioGhAction.Models.Trading
@inject ITradingApiClient Api

<div class="ts-page">
    <div class="ts-tabs">
        <button class="ts-tab @(_tab == "potential" ? "active" : "")" @onclick='() => _tab = "potential"'>Potential Pairs</button>
        <button class="ts-tab @(_tab == "rates" ? "active" : "")" @onclick='() => _tab = "rates"'>FX Rates</button>
        <button class="ts-tab @(_tab == "cheat" ? "active" : "")" @onclick='() => _tab = "cheat"'>Cheat Sheet</button>
        <button class="ts-tab @(_tab == "rrg" ? "active" : "")" @onclick='() => _tab = "rrg"'>RRG Chart</button>
        <button class="ts-tab @(_tab == "sessions" ? "active" : "")" @onclick='() => _tab = "sessions"'>Sessions</button>
    </div>

    @if (_tab == "potential")
    {
        <div class="ts-panel">
            <div class="ts-header">
                <div><h2>Forex Scanner</h2><p>Buy strong / sell weak currency pairs</p></div>
                <button class="ts-btn ts-btn-primary" @onclick="Scan" disabled="@_scanning">Scan Forex</button>
            </div>
            <div class="ts-field"><input class="ts-input" @bind="_pair" placeholder="EURUSD" /></div>
        </div>
        <TradingViewChart Symbol="@_pair" />
        <PriceAlertWidget Symbol="@_pair" AssetType="forex" />
        @if (_data?.Data?.Length > 0)
        {
            <div class="ts-panel ts-table-wrap">
                <table class="ts-table">
                    <thead><tr><th>Pair</th><th>Action</th><th>Score</th><th>Note</th></tr></thead>
                    <tbody>
                        @foreach (var p in _data.Data)
                        {
                            <tr @onclick="() => _pair = p.Pair">
                                <td><strong>@p.Pair</strong></td>
                                <td class="@(p.Action == "buy" ? "ts-positive" : "ts-negative")">@p.Action.ToUpperInvariant()</td>
                                <td>@p.ScoreDiff.ToString("F2")</td>
                                <td>@p.Note</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
    else if (_tab == "rates") { <FxRatesTable /> }
    else if (_tab == "cheat") { <ForexCheatSheetPanel /> }
    else if (_tab == "rrg")
    {
        <div class="ts-panel">
            <img src="@Api.ProxyUrl("forex_rrgchart")" alt="Forex RRG" class="ts-rrg-img" loading="lazy" />
        </div>
    }
    else { <ForexSessionsPanel /> }
</div>

@code {
    private string _tab = "potential";
    private WatchlistResponse<ForexPair>? _data;
    private string _pair = "EURUSD";
    private bool _scanning;

    protected override void OnInitialized() => _ = LoadAsync();

    private async Task LoadAsync()
    {
        try { _data = await Api.GetPotentialForexPairsAsync(); } catch { }
        await InvokeAsync(StateHasChanged);
    }

    private async Task Scan()
    {
        _scanning = true;
        await Api.RunSshScriptAsync("forex_potential");
        _data = await Api.GetPotentialForexPairsAsync();
        _scanning = false;
    }
}
