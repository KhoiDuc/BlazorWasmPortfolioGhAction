@inherits CultureAwareComponent
@inject IStringLocalizer<SharedResources> L

<nav class="trading-subnav" aria-label="@L["TradingNav_Label"]">
    <div class="trading-subnav-inner">
        <button type="button" class="trading-subnav-toggle @(_menuOpen ? "open" : "")"
                @onclick="ToggleMenu"
                aria-label="@(_menuOpen ? L["TradingNav_Close"] : L["TradingNav_Open"])"
                aria-expanded="@_menuOpen.ToString().ToLowerInvariant()">
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
        </button>

        <div class="trading-subnav-links @(_menuOpen ? "open" : "")">
            <NavLink href="@H("trading/vndesk")" Match="NavLinkMatch.Prefix" @onclick="CloseMenu">@L["TradingNav_VnDesk"]</NavLink>
            <NavLink href="@H("trading/stock")" Match="NavLinkMatch.Prefix" @onclick="CloseMenu">@L["TradingNav_Stock"]</NavLink>
            <NavLink href="@H("trading/broker")" Match="NavLinkMatch.Prefix" @onclick="CloseMenu">@L["TradingNav_Broker"]</NavLink>
            <NavLink href="@H("trading/stock-ai")" Match="NavLinkMatch.Prefix" @onclick="CloseMenu">@L["TradingNav_StockAi"]</NavLink>
        </div>
    </div>
</nav>

@code {
    private bool _menuOpen;

    private string H(string path) => CulturePath.Combine(CultureService.UrlLang, path);

    private void ToggleMenu() => _menuOpen = !_menuOpen;
    private void CloseMenu() => _menuOpen = false;
}
