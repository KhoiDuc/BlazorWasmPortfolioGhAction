<nav class="trading-subnav" aria-label="Trading navigation">
    <div class="trading-subnav-inner">
        <button type="button" class="trading-subnav-toggle @(_menuOpen ? "open" : "")"
                @onclick="ToggleMenu"
                aria-label="@(_menuOpen ? "Close trading menu" : "Open trading menu")"
                aria-expanded="@_menuOpen.ToString().ToLowerInvariant()">
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
        </button>

        <div class="trading-subnav-links @(_menuOpen ? "open" : "")">
            <NavLink href="trading/stock" Match="NavLinkMatch.Prefix" @onclick="CloseMenu">Stock</NavLink>
            <NavLink href="trading/broker" Match="NavLinkMatch.Prefix" @onclick="CloseMenu">Broker</NavLink>
            <NavLink href="trading/real-estate" Match="NavLinkMatch.Prefix" @onclick="CloseMenu">Real Estate</NavLink>
        </div>
    </div>
</nav>

@code {
    private bool _menuOpen;

    private void ToggleMenu() => _menuOpen = !_menuOpen;
    private void CloseMenu() => _menuOpen = false;
}
