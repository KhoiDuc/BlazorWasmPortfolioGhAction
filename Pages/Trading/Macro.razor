@page "/trading/macro"
@layout TradingLayout
@using System.Net.Http.Json
@using BlazorWasmPortfolioGhAction.Models.Trading
@inject ITradingApiClient Api
@inject ITradingAuthService Auth
@inject NavigationManager Nav

<div class="ts-page">
    @if (!_authorized)
    {
        <div class="ts-panel ts-alert ts-alert-info">
            Macro Intel Hub requires login. <NavLink href="trading/login">Login</NavLink>
        </div>
    }
    else
    {
        <div class="ts-panel">
            <div class="ts-header">
                <div>
                    <h2>Macro Intelligence Hub</h2>
                    <p>Manage macro events and AI strategy analysis</p>
                </div>
                <div style="display:flex;gap:8px">
                    <button class="ts-btn ts-btn-primary" @onclick="() => _showGroupForm = true">+ New Group</button>
                    <button class="ts-btn ts-btn-outline" @onclick="GeneratePrompt">AI Strategy</button>
                </div>
            </div>
        </div>

        @if (_worldState?.Summary is not null)
        {
            <div class="ts-panel">
                <h3 style="margin:0 0 0.5rem">World State</h3>
                <p style="font-size:0.9rem">@_worldState.Summary</p>
            </div>
        }

        @if (_showPrompt && !string.IsNullOrEmpty(_prompt))
        {
            <div class="ts-panel">
                <div class="ts-panel-header" style="margin:-1.25rem -1.25rem 1rem">
                    <span>AI Strategy Prompt</span>
                    <button class="ts-btn ts-btn-outline" style="padding:2px 8px" @onclick="() => _showPrompt = false">Close</button>
                </div>
                <pre style="white-space:pre-wrap;font-size:0.82rem">@_prompt</pre>
            </div>
        }

        @if (_loading) { <div class="ts-spinner"></div> }
        else if (_groups?.Length > 0)
        {
            @foreach (var g in _groups)
            {
                <div class="ts-panel">
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.75rem">
                        <strong>@g.Name</strong>
                        @if (g.Name != "Telegram News")
                        {
                            <button class="ts-btn ts-btn-outline" style="padding:4px 10px;font-size:0.78rem" @onclick="() => AddNews(g.Id)">+ Add News</button>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(g.Conclusion))
                    {
                        <p style="font-size:0.88rem;color:#475569;margin-bottom:0.75rem">@g.Conclusion</p>
                    }
                    @if (_newsByGroup.TryGetValue(g.Id, out var items) && items.Length > 0)
                    {
                        @foreach (var item in items)
                        {
                            <div style="padding:8px 0;border-bottom:1px solid #e2e8f0;font-size:0.85rem">
                                <strong>@item.Title</strong>
                                <span class="ts-signal ts-signal-@item.Status" style="margin-left:8px">@item.Status</span>
                                @if (!string.IsNullOrEmpty(item.Content))
                                {
                                    <p style="margin:4px 0 0;color:#64748b">@item.Content</p>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <p class="ts-updated">No news items.</p>
                    }
                </div>
            }
        }

        @if (_showGroupForm)
        {
            <div class="ts-panel">
                <h4>New Group</h4>
                <div class="ts-field"><label class="ts-label">Name</label><input class="ts-input" @bind="_newGroupName" /></div>
                <div class="ts-field"><label class="ts-label">Description</label><input class="ts-input" @bind="_newGroupDesc" /></div>
                <button class="ts-btn ts-btn-primary" @onclick="SaveGroup">Save</button>
                <button class="ts-btn ts-btn-outline ms-2" @onclick="() => _showGroupForm = false">Cancel</button>
            </div>
        }

        @if (_showNewsForm)
        {
            <div class="ts-panel">
                <h4>New News Item</h4>
                <div class="ts-field"><label class="ts-label">Title</label><input class="ts-input" @bind="_newNewsTitle" /></div>
                <div class="ts-field"><label class="ts-label">Content</label><textarea class="ts-input" rows="3" @bind="_newNewsContent"></textarea></div>
                <button class="ts-btn ts-btn-primary" @onclick="SaveNews">Save</button>
                <button class="ts-btn ts-btn-outline ms-2" @onclick="() => _showNewsForm = false">Cancel</button>
            </div>
        }
    }
</div>

@code {
    private bool _authorized;
    private bool _loading = true;
    private NewsGroup[]? _groups;
    private Dictionary<int, NewsItem[]> _newsByGroup = new();
    private OsintWorldState? _worldState;
    private bool _showGroupForm;
    private bool _showNewsForm;
    private bool _showPrompt;
    private string? _prompt;
    private string _newGroupName = "";
    private string _newGroupDesc = "";
    private string _newNewsTitle = "";
    private string _newNewsContent = "";
    private int _newsGroupId;

    protected override async Task OnInitializedAsync()
    {
        _authorized = await Auth.IsLoggedInAsync();
        if (!_authorized) return;
        await Load();
    }

    private async Task Load()
    {
        _loading = true;
        var userId = await Auth.GetUserIdAsync();
        _groups = await Api.GetNewsGroupsAsync(userId);
        _worldState = await Api.GetWorldStateAsync();
        _newsByGroup.Clear();
        if (_groups != null)
        {
            foreach (var g in _groups)
            {
                var items = await Api.GetNewsItemsAsync(g.Id);
                if (items != null) _newsByGroup[g.Id] = items;
            }
        }
        _loading = false;
    }

    private void AddNews(int groupId) { _newsGroupId = groupId; _showNewsForm = true; }

    private async Task SaveGroup()
    {
        var userId = await Auth.GetUserIdAsync();
        var client = await Api.CreateAuthorizedClientAsync();
        await client.PostAsJsonAsync($"api/news-groups?user_id={userId}", new { name = _newGroupName, description = _newGroupDesc });
        _showGroupForm = false;
        await Load();
    }

    private async Task SaveNews()
    {
        var client = await Api.CreateAuthorizedClientAsync();
        await client.PostAsJsonAsync($"api/news-items?group_id={_newsGroupId}", new { title = _newNewsTitle, content = _newNewsContent, status = "active" });
        _showNewsForm = false;
        await Load();
    }

    private async Task GeneratePrompt()
    {
        _prompt = await Api.GenerateStrategyPromptAsync();
        _showPrompt = true;
    }
}
