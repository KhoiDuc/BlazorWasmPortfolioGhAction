@page "/trading/backtest"
@page "/{lang:regex(^(en|vn)$)}/trading/backtest"
@inject NavigationManager Nav
@inject ICultureService CultureService
@using Microsoft.AspNetCore.WebUtilities

@code {
    [Parameter] public string? Lang { get; set; }

    [SupplyParameterFromQuery(Name = "symbol")]
    public string? Symbol { get; set; }

    protected override void OnInitialized()
    {
        var prefix = Lang ?? CultureService.UrlLang;
        var query = new Dictionary<string, string?>
        {
            ["group"] = "vn",
            ["tab"] = "backtest"
        };
        if (!string.IsNullOrWhiteSpace(Symbol))
            query["symbol"] = Symbol.Trim().ToUpperInvariant();

        var url = QueryHelpers.AddQueryString($"{prefix}/trading/vndesk", query);
        Nav.NavigateTo(url, replace: true);
    }
}
