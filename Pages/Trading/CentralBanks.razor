@page "/trading/central-banks"
@page "/{lang:regex(^(en|vn)$)}/trading/central-banks"
@inject NavigationManager Nav
@inject ICultureService CultureService

@code {
    [Parameter] public string? Lang { get; set; }

    protected override void OnInitialized()
    {
        var prefix = Lang ?? CultureService.UrlLang;
        Nav.NavigateTo($"{prefix}/trading/vndesk?group=macro&tab=central-banks", replace: true);
    }
}
