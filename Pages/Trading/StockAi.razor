@page "/trading/stock-ai"
@page "/{lang:regex(^(en|vn)$)}/trading/stock-ai"
@inject NavigationManager Nav
@inject ICultureService CultureService

@code {
    [Parameter] public string? Lang { get; set; }

    protected override void OnInitialized()
    {
        var prefix = Lang ?? CultureService.UrlLang;
        Nav.NavigateTo($"{prefix}/trading/vndesk?tab=analyze&sub=ai", replace: true);
    }
}