@inject ITcbsApiClient Tcbs
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResources> L
@implements IAsyncDisposable

<p class="ts-muted" role="status">@_label</p>

@code {
    [Parameter] public string Symbol { get; set; } = "";
    private string _label = "";
    private DotNetObjectReference<TcbsStreamBadge>? _ref;
    private bool _started;

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrEmpty(_label)) _label = L["Trading_Tcbs_StreamIdle"];
        if (_started || string.IsNullOrWhiteSpace(Symbol)) return;
        _started = true;
        var ticket = await Tcbs.CreateStreamTicketAsync("normal", Symbol);
        if (ticket is null || string.IsNullOrWhiteSpace(ticket.RelayUrl))
        {
            _label = L["Trading_Tcbs_StreamNoRelay"];
            return;
        }
        _ref = DotNetObjectReference.Create(this);
        var url = ticket.RelayUrl.TrimEnd('/') + "?ticket=" + Uri.EscapeDataString(ticket.Ticket);
        var ok = await JS.InvokeAsync<bool>("tcbsStream.connect", url, _ref);
        _label = ok ? L["Trading_Tcbs_StreamListening", StreamName(ticket.Stream), Symbol] : L["Trading_Tcbs_StreamFail"];
    }

    private string StreamName(string stream) => stream switch
    {
        "orders" => L["Trading_Tcbs_StreamOrders"],
        "flow" => L["Trading_Tcbs_StreamFlow"],
        _ => L["Trading_Tcbs_StreamBoard"]
    };

    [JSInvokable]
    public Task OnTick(string message)
    {
        _label = "Tick " + (message.Length > 80 ? message[..80] : message);
        return InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("tcbsStream.close"); } catch { /* ignore */ }
        _ref?.Dispose();
    }
}
