@inject IBrokerGeminiClient Gemini
@inject IJSRuntime JS

<div class="ts-panel broker-ai-card stockai-card">
    <div class="broker-ai-head">
        <span class="broker-ai-icon" aria-hidden="true">✦</span>
        <div class="broker-ai-head-text">
            <h3 class="ts-panel-title broker-ai-title">Hỏi đáp chứng khoán bằng AI</h3>
            <span class="broker-ai-sub">Chọn mẫu prompt → nhập câu hỏi/note broker → AI trả lời tiếng Việt.</span>
        </div>
        <span class="broker-ai-badge @(_keyStatus.CssClass)">@_keyStatus.Label</span>
    </div>

    <div class="broker-ai-body">
        @if (_showKeyInput)
        {
            <div class="broker-ai-key-box">
                <div class="broker-ai-key-fields">
                    <div class="broker-ai-key-field">
                        <label class="broker-field-label" for="stockai-key">Gemini API key</label>
                        <div class="broker-ai-key-row">
                            <input id="stockai-key"
                                   class="ts-input broker-ai-key-input"
                                   type="@(_showKey ? "text" : "password")"
                                   placeholder="AIza…"
                                   @bind="_keyInput"
                                   @bind:event="oninput"
                                   autocomplete="off" />
                            <button class="ts-btn ts-btn-outline ts-btn-sm" type="button" title="@(_showKey ? "Ẩn" : "Hiện")" @onclick="ToggleKeyVisibility">
                                @(_showKey ? "🙈" : "👁")
                            </button>
                        </div>
                    </div>
                    <div class="broker-ai-model-field">
                        <label class="broker-field-label" for="stockai-model">Model</label>
                        <select id="stockai-model" class="ts-select broker-ai-model-select" @bind="_modelInput">
                            @foreach (var m in GeminiModels.All)
                            {
                                <option value="@m.Id">@m.Label</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="broker-ai-key-actions">
                    <button class="ts-btn ts-btn-primary ts-btn-sm" type="button" disabled="@string.IsNullOrWhiteSpace(_keyInput)" @onclick="SaveKey">
                        Lưu
                    </button>
                    @if (Gemini.HasUserKey)
                    {
                        <button class="ts-btn ts-btn-outline ts-btn-sm" type="button" @onclick="ClearKey">Xóa key</button>
                    }
                </div>
                <p class="broker-ai-key-hint">
                    Key + model lưu trong localStorage — không ghi vào appsettings.
                    Lấy key tại <a href="https://aistudio.google.com/apikey" target="_blank" rel="noopener">Google AI Studio</a>.
                </p>
            </div>
        }
        else
        {
            <div class="broker-ai-key-toggle">
                <button class="ts-btn ts-btn-link ts-btn-sm" type="button" @onclick="ToggleKeyInput">
                    @(Gemini.HasUserKey ? "Đổi Gemini API key" : "Nhập Gemini API key riêng (tùy chọn)")
                </button>
            </div>
        }

        <div class="stockai-templates">
            <label class="broker-field-label">Mẫu prompt</label>
            <div class="stockai-template-grid">
                @foreach (var t in StockAiPromptLibrary.Templates)
                {
                    <button type="button"
                            class="ts-btn ts-btn-sm stockai-template-btn @(_selectedTemplate == t.Key ? "is-active" : "")"
                            @onclick='() => SelectTemplate(t.Key)'
                            title="@t.Description">
                        @t.Title
                    </button>
                }
            </div>
            @if (!string.IsNullOrEmpty(_templateHint))
            {
                <p class="stockai-template-hint">@_templateHint</p>
            }
        </div>

        <div class="broker-ai-input-wrap">
            <textarea class="ts-input ts-textarea broker-ai-input @(_aiErr is not null ? "ts-input-invalid" : "")"
                      placeholder="@_placeholder"
                      rows="6"
                      @bind="_raw"
                      @bind:event="oninput"
                      @bind:after="ClearErr"></textarea>
            <div class="broker-ai-actions">
                <button class="ts-btn ts-btn-primary ts-btn-sm"
                        type="button"
                        disabled="@(_aiBusy || string.IsNullOrWhiteSpace(_raw))"
                        @onclick="Ask">
                    @(_aiBusy ? "Đang trả lời…" : "✦ Hỏi AI")
                </button>
                @if (!string.IsNullOrWhiteSpace(_raw) && !_aiBusy)
                {
                    <button class="ts-btn ts-btn-outline ts-btn-sm" type="button" @onclick="ClearInput">Xóa</button>
                }
                @if (_history.Count > 0)
                {
                    <button class="ts-btn ts-btn-outline ts-btn-sm" type="button" @onclick="ClearHistory">Xóa lịch sử</button>
                }
            </div>
        </div>

        @if (_aiBusy)
        {
            <div class="broker-ai-result broker-ai-loading">
                <div class="ts-spinner"></div>
            </div>
        }

        @if (_aiErr is not null)
        {
            <div class="ts-alert ts-alert-error broker-ai-err">@_aiErr</div>
        }

        @if (_history.Count > 0)
        {
            <div class="stockai-history">
                @foreach (var item in _history)
                {
                    <div class="stockai-turn">
                        <div class="stockai-turn-q">
                            <span class="stockai-turn-tag">❓ @_templateTitle(item.TemplateKey)</span>
                            <pre class="stockai-turn-pre">@item.Question</pre>
                        </div>
                        <div class="stockai-turn-a">
                            <div class="stockai-turn-bar">
                                <span class="stockai-turn-tag stockai-turn-tag-a">✦ AI</span>
                                <button class="ts-btn ts-btn-outline ts-btn-sm" type="button" @onclick='() => Copy(item.Answer)'>Sao chép</button>
                            </div>
                            <pre class="broker-ai-out-pre">@item.Answer</pre>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private const string KeyStorage = "stockai.gemini.key";
    private const string ModelStorage = "stockai.gemini.model";

    private string _raw = "";
    private string? _aiErr;
    private bool _aiBusy;

    private bool _showKeyInput;
    private string _keyInput = "";
    private string _modelInput = GeminiModels.DefaultId;
    private bool _showKey;

    private string _selectedTemplate = "general";
    private string _templateHint = "";
    private string _placeholder = "Nhập câu hỏi chứng khoán…";

    private record Turn(string TemplateKey, string Question, string Answer);
    private readonly List<Turn> _history = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var savedKey = await JS.InvokeAsync<string?>("localStorage.getItem", KeyStorage);
            if (!string.IsNullOrWhiteSpace(savedKey))
                Gemini.UserKey = savedKey;

            var savedModel = await JS.InvokeAsync<string?>("localStorage.getItem", ModelStorage);
            if (!string.IsNullOrWhiteSpace(savedModel))
            {
                Gemini.UserModel = savedModel;
                _modelInput = savedModel;
            }
        }
        catch { }
        SelectTemplate(_selectedTemplate);
    }

    private (string Label, string CssClass) _keyStatus =>
        Gemini.HasUserKey
            ? ("Key của bạn", "broker-ai-badge-user")
            : Gemini.HasDirectKey
                ? ("Gemini", "")
                : ("Proxy", "broker-ai-badge-proxy");

    private void ToggleKeyInput()
    {
        _showKeyInput = !_showKeyInput;
        if (_showKeyInput)
        {
            _keyInput = Gemini.UserKey ?? "";
            _modelInput = Gemini.UserModel ?? GeminiModels.DefaultId;
        }
    }

    private void ToggleKeyVisibility() => _showKey = !_showKey;

    private async Task SaveKey()
    {
        var key = _keyInput?.Trim() ?? "";
        Gemini.UserKey = string.IsNullOrEmpty(key) ? null : key;
        Gemini.UserModel = _modelInput;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", KeyStorage, key);
            await JS.InvokeVoidAsync("localStorage.setItem", ModelStorage, _modelInput);
        }
        catch { }
        _showKeyInput = false;
    }

    private async Task ClearKey()
    {
        Gemini.UserKey = null;
        Gemini.UserModel = null;
        _keyInput = "";
        _modelInput = GeminiModels.DefaultId;
        try
        {
            await JS.InvokeVoidAsync("localStorage.removeItem", KeyStorage);
            await JS.InvokeVoidAsync("localStorage.removeItem", ModelStorage);
        }
        catch { }
        _showKeyInput = false;
    }

    private void SelectTemplate(string key)
    {
        _selectedTemplate = key;
        var tpl = Array.Find(StockAiPromptLibrary.Templates, t => t.Key == key);
        if (tpl is null) return;
        _templateHint = tpl.Description;
        _placeholder = tpl.Key == "general"
            ? "Nhập câu hỏi chứng khoán…"
            : $"Nhập nội dung cho mẫu \"{tpl.Title}\"… (VD: mã CP, note broker, danh mục…)";
    }

    private string _templateTitle(string key) =>
        Array.Find(StockAiPromptLibrary.Templates, t => t.Key == key)?.Title ?? "Hỏi đáp";

    private async Task Ask()
    {
        if (string.IsNullOrWhiteSpace(_raw)) return;

        _aiBusy = true;
        _aiErr = null;
        try
        {
            var prompt = StockAiPromptLibrary.Build(_selectedTemplate, _raw);
            var reply = await Gemini.ExplainAsync(prompt);
            if (string.IsNullOrWhiteSpace(reply))
            {
                _aiErr = "AI không trả lời. Kiểm tra API key hoặc thử lại.";
                return;
            }

            _history.Insert(0, new Turn(_selectedTemplate, _raw.Trim(), reply));
            _raw = "";
        }
        catch (Exception ex)
        {
            _aiErr = ex.Message;
        }
        finally
        {
            _aiBusy = false;
        }
    }

    private void ClearInput()
    {
        _raw = "";
        _aiErr = null;
    }

    private void ClearHistory() => _history.Clear();

    private void ClearErr() => _aiErr = null;

    private async Task Copy(string? text)
    {
        if (string.IsNullOrWhiteSpace(text)) return;
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", text); }
        catch { }
    }
}