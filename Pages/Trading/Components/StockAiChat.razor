@inject IBrokerGeminiClient Gemini
@inject IBrokerDeskStore BrokerStore
@inject IVnMarketClient Market
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResources> L
@implements IDisposable

<div class="ts-panel broker-ai-card stockai-card">
    <div class="broker-ai-head">
        <span class="broker-ai-icon" aria-hidden="true">✦</span>
        <div class="broker-ai-head-text">
            <h3 class="ts-panel-title broker-ai-title">@L["Trading_StockAiChatTitle"]</h3>
            <span class="broker-ai-sub">@L["Trading_StockAiChatSub"]</span>
        </div>
    </div>

    <div class="broker-ai-body">
        <GeminiKeyBox IdPrefix="stockai" />

        <div class="stockai-templates">
            <label class="broker-field-label" id="stockai-template-label">@L["Trading_StockAiTemplates"]</label>
            <div class="stockai-template-grid" role="group" aria-labelledby="stockai-template-label">
                @foreach (var t in StockAiPromptLibrary.Templates)
                {
                    <button type="button"
                            class="ts-btn ts-btn-sm stockai-template-btn @(_selectedTemplate == t.Key ? "is-active" : "")"
                            aria-pressed="@(_selectedTemplate == t.Key)"
                            @onclick='() => SelectTemplate(t.Key)'
                            title="@GetTemplateDescription(t.Key)">
                        @GetTemplateTitle(t.Key)
                    </button>
                }
            </div>
            @if (!string.IsNullOrEmpty(_templateHint))
            {
                <p class="stockai-template-hint">@_templateHint</p>
            }
        </div>

        @if (_selectedTemplate is "portfolio-review" or "analyze-stock")
        {
            <div class="stockai-data-tools">
                @if (_selectedTemplate == "portfolio-review")
                {
                    <button type="button" class="ts-btn ts-btn-outline ts-btn-sm" disabled="@_dataBusy" @onclick="LoadBrokerPortfolio">
                        @(_dataBusy ? L["Trading_StockAiLoadingPortfolio"] : L["Trading_StockAiLoadPortfolio"])
                    </button>
                }
                @if (_selectedTemplate == "analyze-stock")
                {
                    <div class="stockai-symbol-row">
                        <label class="broker-field-label" for="stockai-symbol">@L["Trading_StockAiSymbol"]</label>
                        <div class="ts-stock-select stockai-symbol-select">
                            <input id="stockai-symbol" class="ts-input ts-stock-select__input"
                                   @bind="_symbolSearch" @bind:event="oninput" @bind:after="FilterSymbols"
                                   @onfocus="OpenSymbolDropdown"
                                   @onblur="CloseSymbolDropdownDelayed"
                                   placeholder="VNM, HPG…" autocomplete="off"
                                   role="combobox" aria-expanded="@_symbolDropdownOpen.ToString().ToLowerInvariant()"
                                   aria-controls="stockai-symbol-list" aria-autocomplete="list" />
                            @if (_symbolDropdownOpen && _filteredSymbols.Count > 0)
                            {
                                <ul id="stockai-symbol-list" class="ts-stock-dropdown" role="listbox">
                                    @foreach (var sym in _filteredSymbols.Take(80))
                                    {
                                        <li role="option" @onmousedown="() => SelectSymbol(sym)">@sym</li>
                                    }
                                </ul>
                            }
                        </div>
                        <button type="button" class="ts-btn ts-btn-outline ts-btn-sm" disabled="@_dataBusy || string.IsNullOrWhiteSpace(_symbolSearch)" @onclick="LoadSymbolWithPrice">
                            @L["Trading_StockAiLoadSymbol"]
                        </button>
                    </div>
                }
            </div>
        }

        <div class="broker-ai-input-wrap">
            <label class="broker-field-label" for="stockai-input">@L["Trading_StockAiInputLabel"]</label>
            <textarea id="stockai-input"
                      class="ts-input ts-textarea broker-ai-input @(_aiErr is not null ? "ts-input-invalid" : "")"
                      placeholder="@_placeholder"
                      rows="6"
                      aria-invalid="@(_aiErr is not null)"
                      aria-describedby="@(_aiErr is not null ? "stockai-error" : null)"
                      @bind="_raw"
                      @bind:event="oninput"
                      @bind:after="ClearErr"
                      @onkeydown="OnInputKeydown"></textarea>
            <div class="broker-ai-actions">
                <button class="ts-btn ts-btn-primary ts-btn-sm"
                        type="button"
                        disabled="@(_aiBusy || string.IsNullOrWhiteSpace(_raw))"
                        @onclick="Ask">
                    @(_aiBusy ? L["Trading_StockAiAnswering"] : L["Trading_StockAiAsk"])
                </button>
                @if (_aiBusy)
                {
                    <button class="ts-btn ts-btn-outline ts-btn-sm" type="button" @onclick="CancelAsk">@L["Trading_StockAiCancel"]</button>
                }
                @if (!string.IsNullOrWhiteSpace(_raw) && !_aiBusy)
                {
                    <button class="ts-btn ts-btn-outline ts-btn-sm" type="button" @onclick="ClearInput">@L["Trading_StockAiClearInput"]</button>
                }
                @if (_history.Count > 0)
                {
                    <button class="ts-btn ts-btn-outline ts-btn-sm" type="button" @onclick="ClearHistory">@L["Trading_StockAiClearHistory"]</button>
                }
            </div>
        </div>

        @if (_aiBusy)
        {
            <div class="broker-ai-result broker-ai-loading" role="status" aria-live="polite">
                <div class="ts-spinner"></div>
            </div>
        }

        @if (_aiErr is not null)
        {
            <div id="stockai-error" class="ts-alert ts-alert-error broker-ai-err" role="alert">@_aiErr</div>
        }

        @if (_history.Count > 0)
        {
            <div class="stockai-history" aria-live="polite">
                @foreach (var item in _history)
                {
                    <div class="stockai-turn">
                        <div class="stockai-turn-q">
                            <span class="stockai-turn-tag">❓ @GetTemplateTitle(item.TemplateKey)</span>
                            <pre class="stockai-turn-pre">@item.Question</pre>
                        </div>
                        <div class="stockai-turn-a">
                            <div class="stockai-turn-bar">
                                <span class="stockai-turn-tag stockai-turn-tag-a">✦ AI</span>
                                <button class="ts-btn ts-btn-outline ts-btn-sm" type="button" @onclick='() => Copy(item.Answer)'>@L["Trading_StockAiCopy"]</button>
                            </div>
                            <AiMarkdown Markdown="@item.Answer" />
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private const string HistoryStorage = "stockai.chat.history";
    private const int MaxHistoryTurns = 30;

    private string _raw = "";
    private string? _aiErr;
    private bool _aiBusy;
    private bool _dataBusy;
    private string _selectedTemplate = "general";
    private string _templateHint = "";
    private string _placeholder = "";
    private string _symbolSearch = "";
    private bool _symbolDropdownOpen;
    private List<string> _brokerSymbols = [];
    private List<string> _filteredSymbols = [];
    private CancellationTokenSource? _askCts;

    private record Turn(string TemplateKey, string Question, string Answer);
    private readonly List<Turn> _history = [];

    protected override async Task OnInitializedAsync()
    {
        SelectTemplate(_selectedTemplate);
        await LoadHistoryAsync();
        await LoadBrokerSymbolsAsync();
    }

    private string GetTemplateTitle(string key) =>
        L[$"Trading_StockAiTpl_{key}_Title"].Value is { Length: > 0 } t && t != $"Trading_StockAiTpl_{key}_Title"
            ? t
            : Array.Find(StockAiPromptLibrary.Templates, x => x.Key == key)?.Title ?? L["Trading_StockAiAsk"];

    private string GetTemplateDescription(string key) =>
        L[$"Trading_StockAiTpl_{key}_Desc"].Value is { Length: > 0 } d && d != $"Trading_StockAiTpl_{key}_Desc"
            ? d
            : Array.Find(StockAiPromptLibrary.Templates, x => x.Key == key)?.Description ?? "";

    private void SelectTemplate(string key)
    {
        _selectedTemplate = key;
        _templateHint = GetTemplateDescription(key);
        _placeholder = key == "general"
            ? L["Trading_StockAiPlaceholderGeneral"]
            : L["Trading_StockAiPlaceholderTemplate", GetTemplateTitle(key)];
    }

    private async Task LoadBrokerSymbolsAsync()
    {
        try
        {
            var portfolio = await BrokerStore.LoadAsync();
            _brokerSymbols = portfolio.Positions.Select(p => p.Symbol).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(s => s).ToList();
        }
        catch { }
    }

    private async Task LoadBrokerPortfolio()
    {
        _dataBusy = true;
        try
        {
            var portfolio = await BrokerStore.LoadAsync();
            if (portfolio.Positions.Count == 0)
            {
                _aiErr = L["Trading_StockAiNoPortfolio"];
                return;
            }

            var symbols = portfolio.Positions.Select(p => p.Symbol).Distinct().ToList();
            var quotes = (await Market.GetLatestManyAsync(symbols))
                .GroupBy(s => s.Symbol, StringComparer.OrdinalIgnoreCase)
                .ToDictionary(g => g.Key, g => g.First().Close, StringComparer.OrdinalIgnoreCase);
            _raw = StockAiPortfolioFormatter.Format(portfolio, quotes);
            _aiErr = null;
        }
        catch (Exception ex)
        {
            _aiErr = ex.Message;
        }
        finally
        {
            _dataBusy = false;
        }
    }

    private void OpenSymbolDropdown()
    {
        _symbolDropdownOpen = true;
        FilterSymbols();
    }

    private async Task CloseSymbolDropdownDelayed()
    {
        await Task.Delay(150);
        _symbolDropdownOpen = false;
        await InvokeAsync(StateHasChanged);
    }

    private void FilterSymbols()
    {
        var q = _symbolSearch.Trim();
        _filteredSymbols = string.IsNullOrWhiteSpace(q)
            ? _brokerSymbols
            : _brokerSymbols.Where(s => s.Contains(q, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private void SelectSymbol(string symbol)
    {
        _symbolSearch = symbol;
        _symbolDropdownOpen = false;
    }

    private async Task LoadSymbolWithPrice()
    {
        var symbol = _symbolSearch.Trim().ToUpperInvariant();
        if (string.IsNullOrWhiteSpace(symbol)) return;

        _dataBusy = true;
        try
        {
            var rows = await Market.GetLatestManyAsync([symbol]);
            var current = rows.FirstOrDefault()?.Close;
            _raw = current is > 0
                ? $"{symbol} — giá hiện tại {current:N2} (nghìn đồng/CP). Phân tích mã này."
                : symbol;
            _aiErr = null;
        }
        catch (Exception ex)
        {
            _aiErr = ex.Message;
        }
        finally
        {
            _dataBusy = false;
        }
    }

    private async Task Ask()
    {
        if (string.IsNullOrWhiteSpace(_raw)) return;

        _askCts?.Cancel();
        _askCts = new CancellationTokenSource();
        var ct = _askCts.Token;

        _aiBusy = true;
        _aiErr = null;
        try
        {
            var prompt = StockAiPromptLibrary.Build(_selectedTemplate, _raw);
            var result = await Gemini.ExplainAsync(prompt, ct);
            if (!string.IsNullOrEmpty(result.Error))
            {
                _aiErr = result.Error;
                return;
            }

            if (string.IsNullOrWhiteSpace(result.Text))
            {
                _aiErr = L["Trading_StockAiNoReply"];
                return;
            }

            _history.Insert(0, new Turn(_selectedTemplate, _raw.Trim(), result.Text));
            if (_history.Count > MaxHistoryTurns)
                _history.RemoveAt(_history.Count - 1);
            _raw = "";
            await SaveHistoryAsync();
        }
        catch (OperationCanceledException)
        {
            _aiErr = L["Trading_StockAiCancelled"];
        }
        catch (Exception ex)
        {
            _aiErr = ex.Message;
        }
        finally
        {
            _aiBusy = false;
        }
    }

    private void CancelAsk()
    {
        _askCts?.Cancel();
        _aiBusy = false;
    }

    private async Task OnInputKeydown(KeyboardEventArgs e)
    {
        if (e.CtrlKey && e.Key == "Enter" && !_aiBusy && !string.IsNullOrWhiteSpace(_raw))
            await Ask();
    }

    private void ClearInput()
    {
        _raw = "";
        _aiErr = null;
    }

    private async Task ClearHistory()
    {
        if (!await JS.InvokeAsync<bool>("confirm", L["Trading_StockAiConfirmClearHistory"]))
            return;
        _history.Clear();
        await SaveHistoryAsync();
    }

    private void ClearErr() => _aiErr = null;

    private async Task Copy(string? text)
    {
        if (string.IsNullOrWhiteSpace(text)) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
        }
        catch { }
    }

    private async Task LoadHistoryAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", HistoryStorage);
            if (string.IsNullOrWhiteSpace(json)) return;
            var turns = System.Text.Json.JsonSerializer.Deserialize<List<Turn>>(json);
            if (turns is null) return;
            _history.Clear();
            _history.AddRange(turns.Take(MaxHistoryTurns));
        }
        catch { }
    }

    private async Task SaveHistoryAsync()
    {
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(_history);
            await JS.InvokeVoidAsync("localStorage.setItem", HistoryStorage, json);
        }
        catch { }
    }

    public void Dispose() => _askCts?.Cancel();
}
