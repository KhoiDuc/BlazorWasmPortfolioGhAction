@using BlazorWasmPortfolioGhAction.Models.Trading.VnDesk
@using BlazorWasmPortfolioGhAction.Services.Trading.VnDesk
@using BlazorWasmPortfolioGhAction.Services.Trading.Broker
@inject IVnMarketClient Market
@inject IndicatorService Indicators
@inject PositionService Positions
@inject IBrokerGeminiClient Gemini

<div class="vd-panel">
    <div class="vd-subtabs">
        <button class="vd-subtab @(_sub == "ta" ? "active" : "")" @onclick='() => _sub = "ta"'>Phân tích TA</button>
        <button class="vd-subtab @(_sub == "check" ? "active" : "")" @onclick='() => _sub = "check"'>Checklist</button>
        <button class="vd-subtab @(_sub == "pnl" ? "active" : "")" @onclick='() => _sub = "pnl"'>P&amp;L</button>
    </div>
    <div class="vd-controls">
        <label class="vd-checks">
            <input type="checkbox" @bind="_intraday" disabled="@_busy" /> Intraday
        </label>
        <button class="vd-btn vd-btn-primary vd-btn-sm" @onclick="Analyze" disabled="@_busy">Phân tích @_symbol</button>
        @if (_busy) { <span class="vd-spinner"></span> }
    </div>
    @if (!string.IsNullOrEmpty(_error)) { <div class="vd-alert vd-alert-error">@_error</div> }
</div>

@if (_ta is not null && _sub == "ta")
{
    <div class="vd-panel">
        <h4 style="margin:0 0 0.6rem">@_ta.Symbol — @_ta.Trend</h4>
        <div class="vd-metric-grid">
            <div class="vd-metric-card"><div class="vd-metric-label">Close</div><div class="vd-metric-value">@_ta.LatestClose.ToString("N2")</div></div>
            <div class="vd-metric-card"><div class="vd-metric-label">RSI</div><div class="vd-metric-value">@_ta.RSI.ToString("F1")</div></div>
            <div class="vd-metric-card"><div class="vd-metric-label">SMA20/50/200</div><div class="vd-metric-value" style="font-size:0.95rem">@_ta.SMA20.ToString("N1") / @_ta.SMA50.ToString("N1") / @_ta.SMA200.ToString("N1")</div></div>
            <div class="vd-metric-card"><div class="vd-metric-label">MACD</div><div class="vd-metric-value">@_ta.MACD.ToString("F3")</div></div>
            <div class="vd-metric-card"><div class="vd-metric-label">ATR%</div><div class="vd-metric-value">@_ta.ATR.ToString("F2")</div></div>
            <div class="vd-metric-card"><div class="vd-metric-label">Vol xTB</div><div class="vd-metric-value">@_ta.VolumeRatio.ToString("F2")</div></div>
            <div class="vd-metric-card"><div class="vd-metric-label">Signal</div><div class="vd-metric-value"><span class="ts-signal">@_ta.TradingSignal.Action</span></div></div>
            <div class="vd-metric-card"><div class="vd-metric-label">SL / TP</div><div class="vd-metric-value" style="font-size:0.95rem">@(_ta.TradingSignal.StopLoss?.ToString("N2") ?? "-") / @(_ta.TradingSignal.TakeProfit?.ToString("N2") ?? "-")</div></div>
        </div>
        @if (_ta.Patterns.Count > 0)
        {
            <p class="mt-2 mb-0" style="font-size:0.82rem"><strong>Patterns:</strong> @string.Join("; ", _ta.Patterns.Take(5).Select(p => p.Name))</p>
        }
        @if (!string.IsNullOrEmpty(_ta.IntradayNote))
        {
            <div class="vd-alert vd-alert-info mt-2">@_ta.IntradayNote</div>
        }
    </div>

    <div class="vd-panel">
        <h4 class="vd-section-title">Xu hướng nâng cao</h4>
        <div class="vd-metric-grid">
            @if (_ta.SuperTrend is not null && _ta.SuperTrend.IsUptrend.Length > 0)
            {
                var up = _ta.SuperTrend.IsUptrend[^1];
                var line = _ta.SuperTrend.SuperTrendLine[^1];
                <div class="vd-metric-card"><div class="vd-metric-label">SuperTrend</div><div class="vd-metric-value @(up ? "vd-pos" : "vd-neg")">@(up ? "Uptrend" : "Downtrend")</div></div>
                <div class="vd-metric-card"><div class="vd-metric-label">ST line</div><div class="vd-metric-value">@line.ToString("N2")</div></div>
                <div class="vd-metric-card"><div class="vd-metric-label">Upper / Lower</div><div class="vd-metric-value" style="font-size:0.95rem">@_ta.SuperTrend.UpperBand[^1].ToString("N2") / @_ta.SuperTrend.LowerBand[^1].ToString("N2")</div></div>
            }
            else
            {
                <div class="ts-muted">SuperTrend — chưa đủ dữ liệu</div>
            }
            @if (_ta.T3.Length > 0)
            {
                var t3 = _ta.T3[^1];
                var bullish = _ta.LatestClose > t3;
                <div class="vd-metric-card"><div class="vd-metric-label">T3 Tilson</div><div class="vd-metric-value">@t3.ToString("N2") <span class="@(bullish ? "vd-pos" : "vd-neg")" style="font-size:0.75rem">(@(bullish ? "close > T3" : "close < T3"))</span></div></div>
            }
        </div>
    </div>

    @if (_ta.AdvancedPatterns.Count > 0)
    {
        <div class="vd-panel">
            <h4 class="vd-section-title">Chart patterns</h4>
            <table class="vd-grid">
                <thead><tr><th>Pattern</th><th>Ngày</th><th>Entry</th><th>SL</th><th>TP</th><th>Reliability</th></tr></thead>
                <tbody>
                    @foreach (var p in _ta.AdvancedPatterns)
                    {
                        <tr>
                            <td>@p.Name</td>
                            <td>@p.Date.ToString("dd/MM")</td>
                            <td>@p.Entry.ToString("N2")</td>
                            <td>@p.StopLoss.ToString("N2")</td>
                            <td>@string.Join(" / ", p.TakeProfits.Select(tp => tp.ToString("N2")))</td>
                            <td>@p.Reliability.ToString("F1")%</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (_ta.OrderBlock is not null)
    {
        var ob = _ta.OrderBlock;
        var bullish = ob.Mode.StartsWith("Bot");
        <div class="vd-panel">
            <h4 class="vd-section-title">OrderBlock <span class="vd-badge @(bullish ? "vd-bull" : "vd-bear")">@ob.Mode</span></h4>
            <p class="mb-0" style="font-size:0.85rem"><strong>Ngày:</strong> @ob.Date.ToString("dd/MM/yyyy") | <strong>Entry:</strong> @ob.Entry.ToString("N2") | <strong>SL:</strong> @ob.StopLoss.ToString("N2") | <strong>TP:</strong> @string.Join(" / ", ob.TakeProfits.Select(tp => tp.ToString("N2")))</p>
            <p class="ts-muted mt-1 mb-0" style="font-size:0.82rem">@ob.Note</p>
        </div>
    }

    @if (_ta.Elliott is not null)
    {
        var el = _ta.Elliott;
        var bullish = el.Direction.Contains("Bullish");
        <div class="vd-panel">
            <h4 class="vd-section-title">Elliott <span class="vd-badge @(bullish ? "vd-bull" : "vd-bear")">@el.Direction</span></h4>
            <p class="mb-0" style="font-size:0.85rem"><strong>Wave:</strong> @el.Wave | <strong>Level:</strong> @el.Level.ToString("N2") | <strong>Ngày:</strong> @el.Date.ToString("dd/MM/yyyy")</p>
            <p class="ts-muted mt-1 mb-0" style="font-size:0.82rem">@el.Note</p>
        </div>
    }

    <div class="vd-panel">
        <a class="vd-btn" href="@($"/trading/backtest?symbol={_symbol}")" target="_blank">Backtest indicator này →</a>
    </div>
}
else if (_checklist is not null && _sub == "check")
{
    <div class="vd-panel">
        <h4 class="vd-section-title">Checklist — @_checklist.Symbol</h4>
        <p><strong>Context:</strong> @_checklist.Context</p>
        <p><strong>Confirm / Invalidate:</strong> @_checklist.ConfirmInvalidate</p>
        <p><strong>Risk:</strong> @_checklist.Risk</p>
        <p><strong>Verify:</strong> @_checklist.Verify</p>
        <p><strong>Observation:</strong> @_checklist.Observation</p>
        <div class="vd-section">
            <label class="ts-label">Ghi chú chart</label>
            <textarea class="vd-input" rows="2" @bind="_notes" style="width:100%"></textarea>
        </div>
        <button class="vd-btn" @onclick="AiChecklist" disabled="@_aiBusy">AI nhập trung lập</button>
        @if (!string.IsNullOrEmpty(_aiText)) { <pre class="mt-2" style="font-size:0.78rem;white-space:pre-wrap">@_aiText</pre> }
    </div>
}
else if (_sub == "pnl")
{
    <div class="vd-panel">
        <h4 class="vd-section-title">P&amp;L Calculator</h4>
        <div class="vd-controls">
            <input type="number" class="vd-input" @bind="_entry" placeholder="Giá mua" step="any" />
            <input type="number" class="vd-input" @bind="_shares" placeholder="Số CP" />
            <select class="vd-select" @bind="_broker">
                <option value="A">VPS 0.15%</option>
                <option value="B">SSI 0.15%</option>
                <option value="C">TCBS 0.10%</option>
                <option value="D">MBS 0.12%</option>
            </select>
            <button class="vd-btn vd-btn-primary" @onclick="CalcPnl">Tính P&amp;L</button>
        </div>
        @if (_pnl is not null)
        {
            <div class="mt-3" style="font-size:0.88rem">
                <p>Broker: @_pnl.Broker | Phí: @_pnl.FeeRatePct%</p>
                <p>Lãi/lỗ: <strong class="@(_pnl.ProfitLoss >= 0 ? "vd-pos" : "vd-neg")">@_pnl.ProfitLoss.ToString("N0") VND (@_pnl.ProfitLossPercent.ToString("F2")%)</strong></p>
                <p class="ts-muted">@_pnl.Note</p>
            </div>
        }
    </div>
}

@code {
    [Parameter] public string Symbol { get; set; } = "VNM";

    private string _sub = "ta";
    private string _symbol = "VNM";
    private bool _intraday;
    private TechnicalIndicators? _ta;
    private TechnicalChecklist? _checklist;
    private PositionResult? _pnl;
    private string _notes = "";
    private string? _error;
    private string? _aiText;
    private bool _busy;
    private bool _aiBusy;
    private decimal _entry;
    private int _shares = 100;
    private string _broker = "C";

    protected override void OnParametersSet()
    {
        if (_symbol != Symbol)
        {
            _symbol = Symbol;
            _ = Analyze();
        }
    }

    public TechnicalIndicators? LastTa => _ta;

    private async Task Analyze()
    {
        if (string.IsNullOrWhiteSpace(_symbol)) return;
        _symbol = _symbol.Trim().ToUpperInvariant();
        _busy = true;
        _error = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            var hist = await Market.GetHistoricalAsync(_symbol, 250);
            _ta = Indicators.Calculate(_symbol, hist);
            if (_ta is null)
            {
                _error = $"Không đủ dữ liệu TA cho {_symbol} (cần ~200 phiên, có {hist.Count}).";
                return;
            }
            if (_intraday)
            {
                var ticks = await Market.FetchIntradayAsync(_symbol);
                Indicators.ApplyIntraday(_ta, ticks);
                if (ticks.Count == 0)
                    _ta.IntradayNote = "Không có intraday (TCBS). Dùng dữ liệu daily.";
            }
            _checklist = Indicators.BuildTechnicalChecklist(_ta, _notes);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; await InvokeAsync(StateHasChanged); }
    }

    private async Task AiChecklist()
    {
        if (_ta is null) return;
        _aiBusy = true;
        var numbers = $"{_ta.Symbol} close={_ta.LatestClose:N2} trend={_ta.Trend} RSI={_ta.RSI:N1} signal={_ta.TradingSignal.Action}";
        var result = await Gemini.ExplainAsync(PromptLibrary.NeutralChecklist(_ta.Symbol, numbers, _notes));
        _aiText = result.Text ?? (result.Error ?? "AI không khả dụng.");
        _aiBusy = false;
    }

    private async Task CalcPnl()
    {
        if (_ta is null) await Analyze();
        if (_ta is null) return;
        _pnl = Positions.Calculate(_symbol, _entry, _shares, _ta.LatestClose, _broker);
    }
}