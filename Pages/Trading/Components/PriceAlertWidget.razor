@using BlazorWasmPortfolioGhAction.Models.Trading
@inject IPriceAlertService AlertSvc
@inject IStringLocalizer<SharedResources> L
@implements IDisposable

<div class="ts-panel">
    <h2 class="ts-panel-title">
        @L["Trading_PriceAlert_Title", Symbol]
        @if (_triggeredCount > 0)
        {
            <span class="broker-alert-count">@_triggeredCount</span>
        }
    </h2>

    <p class="ts-muted">@L["Trading_PriceAlert_Hint"]</p>

    <div class="broker-field">
        <label class="broker-field-label">@L["Trading_PriceAlert_Price"]</label>
        <input type="number" class="ts-input" @bind="_threshold" step="any" min="0" />
    </div>
    <div class="broker-field">
        <label class="broker-field-label">@L["Trading_PriceAlert_Condition"]</label>
        <select class="ts-select" @bind="_operator">
            <option value="@AlertOperator.Above">@L["Trading_PriceAlert_Above"]</option>
            <option value="@AlertOperator.Below">@L["Trading_PriceAlert_Below"]</option>
        </select>
    </div>
    <div class="broker-field">
        <label class="broker-field-label">@L["Trading_PriceAlert_TestPrice"]</label>
        <input type="number" class="ts-input" @bind="_currentPrice" step="any" min="0" placeholder="@L["Trading_PriceAlert_TestPlaceholder"]" />
    </div>

    <div class="broker-header-actions">
        <button type="button" class="ts-btn ts-btn-primary ts-btn-sm" @onclick="CreateAlert" disabled="@(_busy || _threshold <= 0)">
            @L["Trading_PriceAlert_Set"]
        </button>
        @if (_currentPrice > 0)
        {
            <button type="button" class="ts-btn ts-btn-outline ts-btn-sm" @onclick="CheckNow" disabled="@_busy">
                @L["Trading_PriceAlert_Test"]
            </button>
        }
    </div>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="ts-alert ts-alert-info" role="status">@_message</div>
    }
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="ts-alert ts-alert-error" role="alert">@_error</div>
    }

    @if (_alerts.Count > 0)
    {
        <ul>
            @foreach (var a in _alerts.Where(x => x.Symbol == Symbol && x.AssetType == AssetType && x.Status != AlertStatus.Dismissed))
            {
                <li style="@(a.IsTriggered ? "opacity:0.6;text-decoration:line-through;" : "")">
                    @(a.Operator == AlertOperator.Above ? "↑" : "↓")
                    @a.Threshold.ToString("N2")
                    @if (a.IsTriggered && a.TriggeredPrice.HasValue)
                    {
                        <span class="ts-muted">@L["Trading_PriceAlert_Hit", a.TriggeredPrice.Value.ToString("N2")]</span>
                    }
                    <button type="button" class="ts-btn ts-btn-outline ts-btn-sm" @onclick="() => RemoveAlert(a.Id)">
                        @L["Trading_PriceAlert_Remove"]
                    </button>
                </li>
            }
        </ul>
    }
</div>

@code {
    [Parameter] public string Symbol { get; set; } = "";
    [Parameter] public string AssetType { get; set; } = "crypto";

    private double _threshold;
    private AlertOperator _operator = AlertOperator.Above;
    private double _currentPrice;
    private string? _message;
    private string? _error;
    private bool _busy;
    private List<PriceAlert> _alerts = new();
    private int _triggeredCount;
    private Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        _alerts = await AlertSvc.LoadAsync();
        UpdateTriggeredCount();
        // ponytail: poll every 30s only if current price is set. Upgrade: subscribe to live ticker.
        _timer = new Timer(async _ => await TimerTick(), null, 30000, 30000);
    }

    private async Task TimerTick()
    {
        if (_currentPrice <= 0) return;
        var fired = await AlertSvc.CheckAlertsAsync(Symbol, _currentPrice);
        if (fired > 0)
        {
            _alerts = await AlertSvc.LoadAsync();
            UpdateTriggeredCount();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CreateAlert()
    {
        _busy = true;
        _message = null;
        _error = null;
        try
        {
            if (_threshold <= 0)
            {
                _error = L["Trading_PriceAlert_NeedPrice"];
                return;
            }
            await AlertSvc.AddAsync(Symbol, AssetType, _threshold, _operator);
            _alerts = await AlertSvc.LoadAsync();
            _message = L["Trading_PriceAlert_Saved"];
            _threshold = 0;
        }
        catch (Exception ex)
        {
            _error = L["Trading_PriceAlert_Failed", ex.Message];
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CheckNow()
    {
        if (_currentPrice <= 0) return;
        _busy = true;
        try
        {
            var fired = await AlertSvc.CheckAlertsAsync(Symbol, _currentPrice);
            _alerts = await AlertSvc.LoadAsync();
            UpdateTriggeredCount();
            _message = fired > 0
                ? L["Trading_PriceAlert_Fired", fired]
                : L["Trading_PriceAlert_None"];
        }
        catch (Exception ex)
        {
            _error = L["Trading_PriceAlert_CheckFailed", ex.Message];
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RemoveAlert(string id)
    {
        try
        {
            await AlertSvc.RemoveAsync(id);
            _alerts = await AlertSvc.LoadAsync();
            UpdateTriggeredCount();
        }
        catch (Exception ex)
        {
            _error = L["Trading_PriceAlert_RemoveFailed", ex.Message];
        }
    }

    private void UpdateTriggeredCount() =>
        _triggeredCount = _alerts.Count(a => a.Symbol == Symbol && a.AssetType == AssetType && a.IsTriggered);

    public void Dispose() => _timer?.Dispose();
}