@inject IBrokerGeminiClient Gemini
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResources> L

<div class="broker-ai-key-section">
    <span class="broker-ai-badge @KeyStatusCss">@KeyStatusLabel</span>

    @if (_showKeyInput)
    {
        <div class="broker-ai-key-box">
            <div class="broker-ai-key-fields">
                <p class="broker-ai-key-hint">Gemini runs through broker-api. Sign in, then pick a model. The API key stays on the server.</p>
                <div class="broker-ai-model-field">
                    <label class="broker-field-label" for="@($"{IdPrefix}-model")">@L["Trading_GeminiModel"]</label>
                    <select id="@($"{IdPrefix}-model")" class="ts-select broker-ai-model-select" @bind="_modelInput">
                        @foreach (var m in GeminiModels.All)
                        {
                            <option value="@m.Id">@m.Label</option>
                        }
                    </select>
                </div>
            </div>
            <div class="broker-ai-key-actions">
                <button class="ts-btn ts-btn-primary ts-btn-sm" type="button" @onclick="SaveKey">
                    @L["Trading_GeminiSaveKey"]
                </button>
                @if (Gemini.HasUserKey)
                {
                    <button class="ts-btn ts-btn-outline ts-btn-sm" type="button" @onclick="ClearKey">@L["Trading_GeminiClearKey"]</button>
                }
            </div>
            <p class="broker-ai-key-hint">
                @L["Trading_GeminiKeyHint"]
                <a href="https://aistudio.google.com/apikey" target="_blank" rel="noopener">Google AI Studio</a>.
            </p>
        </div>
    }
    else
    {
        <div class="broker-ai-key-toggle">
            <button class="ts-btn ts-btn-link ts-btn-sm" type="button" @onclick="ToggleKeyInput">
                @(Gemini.HasUserKey ? L["Trading_GeminiChangeKey"] : L["Trading_GeminiEnterKey"])
            </button>
        </div>
    }
</div>

@code {
    [Parameter] public string IdPrefix { get; set; } = "gemini";

    private bool _showKeyInput;
    private string _modelInput = GeminiModels.DefaultId;
    private bool _loaded;

    protected override async Task OnInitializedAsync()
    {
        if (_loaded) return;
        _loaded = true;
        await LoadStoredKeyAsync();
    }

    private string KeyStatusLabel =>
        Gemini.HasUserKey ? L["Trading_GeminiKeyUser"]
        : Gemini.HasDirectKey ? L["Trading_GeminiKeyServer"]
        : L["Trading_GeminiKeyProxy"];

    private string KeyStatusCss =>
        Gemini.HasUserKey ? "broker-ai-badge-user"
        : Gemini.HasDirectKey ? ""
        : "broker-ai-badge-proxy";

    private async Task LoadStoredKeyAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.removeItem", GeminiKeyStorage.KeyStorage);
            foreach (var legacy in GeminiKeyStorage.LegacyKeyStorages)
                await JS.InvokeVoidAsync("localStorage.removeItem", legacy);

            var savedModel = await JS.InvokeAsync<string?>("localStorage.getItem", GeminiKeyStorage.ModelStorage);
            if (string.IsNullOrWhiteSpace(savedModel))
            {
                foreach (var legacy in GeminiKeyStorage.LegacyModelStorages)
                {
                    savedModel = await JS.InvokeAsync<string?>("localStorage.getItem", legacy);
                    if (!string.IsNullOrWhiteSpace(savedModel)) break;
                }
            }

            if (!string.IsNullOrWhiteSpace(savedModel))
            {
                Gemini.UserModel = savedModel;
                _modelInput = savedModel;
            }
        }
        catch { }
    }

    private void ToggleKeyInput()
    {
        _showKeyInput = !_showKeyInput;
        if (_showKeyInput)
            _modelInput = Gemini.UserModel ?? GeminiModels.DefaultId;
    }

    private async Task SaveKey()
    {
        Gemini.UserKey = null;
        Gemini.UserModel = _modelInput;
        try
        {
            await JS.InvokeVoidAsync("localStorage.removeItem", GeminiKeyStorage.KeyStorage);
            await JS.InvokeVoidAsync("localStorage.setItem", GeminiKeyStorage.ModelStorage, _modelInput);
        }
        catch { }
        _showKeyInput = false;
    }

    private async Task ClearKey()
    {
        Gemini.UserKey = null;
        Gemini.UserModel = null;
        _modelInput = GeminiModels.DefaultId;
        try
        {
            await JS.InvokeVoidAsync("localStorage.removeItem", GeminiKeyStorage.KeyStorage);
            await JS.InvokeVoidAsync("localStorage.removeItem", GeminiKeyStorage.ModelStorage);
            foreach (var legacy in GeminiKeyStorage.LegacyKeyStorages)
                await JS.InvokeVoidAsync("localStorage.removeItem", legacy);
            foreach (var legacy in GeminiKeyStorage.LegacyModelStorages)
                await JS.InvokeVoidAsync("localStorage.removeItem", legacy);
        }
        catch { }
        _showKeyInput = false;
    }
}
