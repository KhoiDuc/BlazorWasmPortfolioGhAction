@inject IBrokerGeminiClient Gemini
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResources> L

<div class="ts-panel broker-detail">
    @{
        var pnl = Position.PnlPct(CurrentPrice);
        var pnlAmt = Position.PnlAmount(CurrentPrice);
    }

    <div class="broker-detail-header">
        <div class="broker-detail-header-main">
            <span class="broker-detail-symbol">@Position.Symbol</span>
            @if (_dirty)
            {
                <span class="broker-detail-dirty-dot" title="@L["Trading_BrokerDetail_DirtyDot"].Value" aria-label="@L["Trading_BrokerDetail_DirtyDot"].Value">●</span>
            }
            <div class="broker-detail-meta">
                @if (!string.IsNullOrWhiteSpace(Position.Sector))
                {
                    <span class="broker-detail-sector">@Position.Sector</span>
                }
                @if (Position.Status != BrokerPositionStatus.ChuaQuyet)
                {
                    <span class="broker-status-pill broker-status-@Position.Status">@L[BrokerStatusLabels.Vi(Position.Status)].Value</span>
                }
                @if (Position.HasPartialQtyLots)
                {
                    <span class="broker-partial-qty-warn" title="@L["Trading_BrokerPartialQtyHint"]">⚠</span>
                }
                @if (Position.IsClosed && Position.ClosedAt is not null)
                {
                    <span class="broker-status-pill broker-status-DaDong" title="@L["Trading_BrokerDetail_ClosedAt"].Value">@L["Trading_BrokerDetail_ClosedAt"].Value @Position.ClosedAt.Value.ToString("dd/MM/yyyy")</span>
                }
            </div>
        </div>
        <div class="broker-detail-header-actions">
            @if (Position.IsClosed)
            {
                <button class="ts-btn ts-btn-outline ts-btn-sm" type="button" @onclick="Reopen" aria-label="@L["Trading_BrokerDetail_ReopenAria"].Value">@L["Trading_BrokerReopen"]</button>
                <button class="ts-btn ts-btn-outline ts-btn-sm broker-btn-danger" type="button" @onclick="DeleteClosed" aria-label="@L["Trading_BrokerDetail_DeleteClosedAria"].Value">@L["Trading_BrokerDeleteClosed"]</button>
            }
            <button class="ts-btn ts-btn-outline ts-btn-sm" type="button" @onclick="Delete">@L["Trading_BrokerDeleteSymbol"]</button>
            @if (_dirty)
            {
                <button class="ts-btn ts-btn-primary ts-btn-sm" type="button" disabled="@_saving" @onclick="SaveAll">
                    @(_saving ? L["Trading_BrokerDetail_Saving"].Value : L["Trading_BrokerDetail_Save"].Value)
                </button>
            }
        </div>
    </div>

    <div class="broker-detail-kpis">
        <div class="broker-kpi">
            <span class="broker-kpi-label">@L["Trading_BrokerDetail_KpiAvg"]</span>
            <span class="broker-kpi-value">@(Position.AvgBuy?.ToString("N2") ?? "—")</span>
        </div>
        <div class="broker-kpi">
            <span class="broker-kpi-label">@L["Trading_BrokerDetail_KpiCurrent"]</span>
            <span class="broker-kpi-value">@(CurrentPrice?.ToString("N2") ?? "—")</span>
        </div>
        <div class="broker-kpi">
            <span class="broker-kpi-label">@L["Trading_BrokerDetail_KpiTotalQty"]</span>
            <span class="broker-kpi-value">@BrokerFormat.Quantity(Position.TotalQuantity)</span>
        </div>
        @if (Position.Sells.Count > 0)
        {
            <div class="broker-kpi">
                <span class="broker-kpi-label">@L["Trading_BrokerDetail_KpiRemaining"]</span>
                <span class="broker-kpi-value">@BrokerFormat.Quantity(Position.RemainingQuantity)</span>
            </div>
            <div class="broker-kpi">
                <span class="broker-kpi-label">@L["Trading_BrokerDetail_KpiSold"]</span>
                <span class="broker-kpi-value">@BrokerFormat.Quantity(Position.SoldQuantity)</span>
            </div>
            <div class="broker-kpi broker-kpi-pnl broker-kpi-realized">
                <span class="broker-kpi-label">@L["Trading_BrokerRealized"]</span>
                <span class="broker-kpi-value @(Position.RealizedPnl is > 0 ? "ts-positive" : Position.RealizedPnl is < 0 ? "ts-negative" : "")">
                    @BrokerFormat.Vnd(Position.RealizedPnl)
                </span>
            </div>
        }
        <div class="broker-kpi broker-kpi-pnl">
            <span class="broker-kpi-label">@L["Trading_BrokerDetail_KpiPnlPct"]</span>
            <span class="broker-kpi-value @(pnl is > 0 ? "ts-positive" : pnl is < 0 ? "ts-negative" : "")">
                @(pnl is null ? "—" : $"{pnl.Value:N2}%")
            </span>
        </div>
        <div class="broker-kpi broker-kpi-pnl">
            <span class="broker-kpi-label">@L["Trading_BrokerDetail_KpiPnlAmt"]</span>
            <span class="broker-kpi-value @(pnlAmt is > 0 ? "ts-positive" : pnlAmt is < 0 ? "ts-negative" : "")">
                @BrokerFormat.Vnd(pnlAmt)
            </span>
        </div>
        <div class="broker-kpi">
            <span class="broker-kpi-label">@L["Trading_BrokerDetail_KpiStop"]</span>
            <span class="broker-kpi-value broker-stop">@BrokerLevelHelper.FormatDisplay(Position.StopLoss, Position.StopLossMode, Position.StopLossInput, isStop: true)</span>
        </div>
        <div class="broker-kpi">
            <span class="broker-kpi-label">@L["Trading_BrokerDetail_KpiTarget"]</span>
            <span class="broker-kpi-value broker-target">@BrokerLevelHelper.FormatDisplay(Position.TargetPrice, Position.TargetPriceMode, Position.TargetPriceInput, isStop: false)</span>
        </div>
    </div>

    <div class="broker-detail-tabs" role="tablist">
        <button type="button" role="tab" id="tab-info" aria-selected="@(_tab == "info")" aria-controls="panel-info"
                class="broker-tab @(_tab == "info" ? "active" : "")" @onclick='() => _tab = "info"'>@L["Trading_BrokerDetail_TabInfo"]</button>
        <button type="button" role="tab" id="tab-lots" aria-selected="@(_tab == "lots")" aria-controls="panel-lots"
                class="broker-tab @(_tab == "lots" ? "active" : "")" @onclick='() => _tab = "lots"'>@L["Trading_BrokerDetail_TabBuys"] (@Position.Buys.Count)</button>
        <button type="button" role="tab" id="tab-sells" aria-selected="@(_tab == "sells")" aria-controls="panel-sells"
                class="broker-tab @(_tab == "sells" ? "active" : "")" @onclick='() => _tab = "sells"'>@L["Trading_BrokerDetail_TabSells"] (@Position.Sells.Count)</button>
        <button type="button" role="tab" id="tab-dividends" aria-selected="@(_tab == "dividends")" aria-controls="panel-dividends"
                class="broker-tab @(_tab == "dividends" ? "active" : "")" @onclick='() => _tab = "dividends"'>@L["Trading_BrokerDetail_TabDividends"] (@(Position.Dividends?.Count ?? 0))</button>
        <button type="button" role="tab" id="tab-timeline" aria-selected="@(_tab == "timeline")" aria-controls="panel-timeline"
                class="broker-tab @(_tab == "timeline" ? "active" : "")" @onclick='() => _tab = "timeline"'>@L["Trading_BrokerDetail_TabTimeline"]</button>
        <button type="button" role="tab" id="tab-notes" aria-selected="@(_tab == "notes")" aria-controls="panel-notes"
                class="broker-tab @(_tab == "notes" ? "active" : "")" @onclick='() => _tab = "notes"'>@L["Trading_BrokerDetail_TabNotes"] (@Position.Notes.Count)</button>
    </div>

    <div class="broker-inner broker-detail-body" role="tabpanel" id="panel-info" aria-labelledby="tab-info">
        @if (_tab == "info")
        {
            <section class="broker-block">
                <h3 class="broker-block-title">@L["Trading_BrokerDetail_BlockInfo"]</h3>
                <div class="broker-form-row broker-form-row-2 broker-form-row-align">
                    <div class="broker-field">
                        <label class="broker-field-label" for="pos-sector">@L["Trading_BrokerDetail_Sector"]</label>
                        <input id="pos-sector" class="ts-input" placeholder="@L["Trading_BrokerDetail_SectorPlaceholder"]" @bind="Position.Sector" @bind:event="oninput" @bind:after="Changed" maxlength="80" />
                    </div>
                    <div class="broker-field">
                        <label class="broker-field-label" for="pos-status">@L["Trading_BrokerDetail_Status"]</label>
                        <select id="pos-status" class="ts-select" @bind="Position.Status" @bind:after="Changed">
                            @foreach (var s in Enum.GetValues<BrokerPositionStatus>())
                            {
                                <option value="@s">@L[BrokerStatusLabels.Vi(s)].Value</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="broker-field">
                    <label class="broker-field-label" for="pos-tags">@L["Trading_BrokerTagStrategy"]</label>
                    <div class="broker-tag-input-wrap">
                        @foreach (var tag in Position.Tags.ToList())
                        {
                            <span class="broker-tag-chip">
                                @tag
                                <button type="button" class="broker-tag-remove" aria-label="@L["Trading_BrokerDetail_RemoveTagAria", tag].Value" @onclick="() => RemoveTag(tag)">×</button>
                            </span>
                        }
                        <input id="pos-tags" class="ts-input broker-tag-input"
                               placeholder="@L["Trading_BrokerTagPlaceholder"]"
                               value="@_newTag"
                               @oninput="OnTagInput"
                               @onkeydown="OnTagKeydown" />
                        <button type="button" class="ts-btn ts-btn-primary ts-btn-sm broker-tag-add-btn" aria-label="@L["Trading_BrokerDetail_AddTag"].Value" @onclick="AddTag" disabled="@string.IsNullOrWhiteSpace(_newTag)">+</button>
                    </div>
                    <p class="broker-block-desc">@L["Trading_BrokerDetail_TagDesc"]</p>
                </div>
            </section>

            <section class="broker-block">
                <h3 class="broker-block-title">@L["Trading_BrokerDetail_BlockTarget"]</h3>
                <p class="broker-block-desc">@L["Trading_BrokerDetail_TargetDesc"]</p>
                <div class="broker-level-pair">
                    <BrokerLevelInput Id="pos-target"
                                      CssClass="broker-level-target"
                                      Label="@L["Trading_BrokerDetail_LabelTarget"]"
                                      HintPrice="@L["Trading_BrokerDetail_HintTargetPrice"]"
                                      HintPercent="@L["Trading_BrokerDetail_HintTargetPct"]"
                                      PlaceholderPrice="70.5"
                                      PlaceholderPercent="10"
                                      Compact="true"
                                      @bind-Mode="PositionTargetMode"
                                      @bind-Input="PositionTargetInput"
                                      BuyPrice="PositionRefPrice"
                                      IsStop="false"
                                      Error="@_posTargetErr"
                                      Invalid="@(_posTargetErr is not null)" />
                    <BrokerLevelInput Id="pos-stop"
                                      CssClass="broker-level-stop"
                                      Label="@L["Trading_BrokerDetail_LabelStop"]"
                                      HintPrice="@L["Trading_BrokerDetail_HintStopPrice"]"
                                      HintPercent="@L["Trading_BrokerDetail_HintStopPct"]"
                                      PlaceholderPrice="55.5"
                                      PlaceholderPercent="5"
                                      Compact="true"
                                      @bind-Mode="PositionStopMode"
                                      @bind-Input="PositionStopInput"
                                      BuyPrice="PositionRefPrice"
                                      IsStop="true"
                                      Error="@_posStopErr"
                                      Invalid="@(_posStopErr is not null)" />
                </div>
            </section>
        }
        else if (_tab == "lots")
        {
            @if (Position.Buys.Count == 0)
            {
                <p class="broker-empty-inline">@L["Trading_BrokerDetail_EmptyBuys"]</p>
            }
            @foreach (var lot in Position.Buys.OrderBy(b => b.BoughtAt).Select((b, idx) => (Lot: b, Index: idx + 1)))
            {
                <article class="broker-lot-card">
                    <header class="broker-lot-card-head">
                        <span class="broker-lot-badge">L@(lot.Index)</span>
                        <span class="broker-lot-date">@lot.Lot.BoughtAt.ToString("dd/MM/yyyy")</span>
                        <button class="broker-lot-remove" type="button" title="@L["Trading_BrokerDetail_RemoveLotTitle"].Value" @onclick="() => RemoveLot(lot.Lot)">×</button>
                    </header>
                    <div class="broker-lot-fields">
                        <div class="broker-field">
                            <label class="broker-field-label">@L["Trading_BrokerDetail_LotDate"]</label>
                        </div>
                        <div class="broker-field">
                            <label class="broker-field-label">@L["Trading_BrokerDetail_LotBuyPrice"]</label>
                            <input class="ts-input" type="number" min="0.0001" step="any" @bind="lot.Lot.Price" @bind:after="() => ValidateLot(lot.Lot)" />
                        </div>
                        <div class="broker-field">
                            <label class="broker-field-label">@L["Trading_BrokerColQty"]</label>
                            <input class="ts-input" type="number" min="0.0001" step="any" placeholder="—" @bind="lot.Lot.Quantity" @bind:after="() => ValidateLot(lot.Lot)" />
                        </div>
                    </div>
                    <div class="broker-lot-levels">
                        <div class="broker-lot-level-box broker-level-stop">
                            <span class="broker-lot-level-label">@L["Trading_BrokerDetail_LotStop"]</span>
                            <div class="broker-lot-level-inputs">
                                <select class="ts-select" @bind="lot.Lot.StopLossMode" @bind:after="() => ValidateLot(lot.Lot)">
                                    <option value="@BrokerLevelInputMode.Price">@L["Trading_BrokerDetail_LotModePrice"]</option>
                                    <option value="@BrokerLevelInputMode.Percent">%</option>
                                </select>
                                <input class="ts-input" type="number" min="0.0001" step="any" placeholder="—" @bind="lot.Lot.StopLossInput" @bind:after="() => ValidateLot(lot.Lot)" />
                            </div>
                        </div>
                        <div class="broker-lot-level-box broker-level-target">
                            <span class="broker-lot-level-label">@L["Trading_BrokerDetail_LotTarget"]</span>
                            <div class="broker-lot-level-inputs">
                                <select class="ts-select" @bind="lot.Lot.TargetPriceMode" @bind:after="() => ValidateLot(lot.Lot)">
                                    <option value="@BrokerLevelInputMode.Price">@L["Trading_BrokerDetail_LotModePrice"]</option>
                                    <option value="@BrokerLevelInputMode.Percent">%</option>
                                </select>
                                <input class="ts-input" type="number" min="0.0001" step="any" placeholder="—" @bind="lot.Lot.TargetPriceInput" @bind:after="() => ValidateLot(lot.Lot)" />
                            </div>
                        </div>
                    </div>
                    <div class="broker-field broker-lot-note-field">
                        <label class="broker-field-label">@L["Trading_BrokerDetail_LotNote"]</label>
                        <input class="ts-input" maxlength="@BrokerInputValidation.NoteMaxLen" placeholder="@L["Trading_BrokerDetail_LotNotePlaceholder"]" @bind="lot.Lot.Note" @bind:after="() => LotChanged(lot.Lot)" />
                    </div>
                    <div class="broker-field broker-lot-tags-field">
                        <label class="broker-field-label">@L["Trading_BrokerLotTagLabel"]</label>
                        <div class="broker-tag-input-wrap">
                            @foreach (var tag in lot.Lot.Tags.ToList())
                            {
                                <span class="broker-tag-chip">
                                    @tag
                                    <button type="button" class="broker-tag-remove" aria-label="@L["Trading_BrokerDetail_RemoveTagAria", tag].Value" @onclick="() => RemoveLotTag(lot.Lot, tag)">×</button>
                                </span>
                            }
                            <input class="ts-input broker-tag-input"
                                   placeholder="@L["Trading_BrokerTagPlaceholder"]"
                                   value="@GetLotTagInput(lot.Lot.Id)"
                                   @oninput="@((ChangeEventArgs e) => SetLotTagInput(lot.Lot.Id, (string?)e.Value ?? ""))"
                                   @onkeydown="@((KeyboardEventArgs e) => OnLotTagKeydown(e, lot.Lot))" />
                            <button type="button" class="ts-btn ts-btn-outline ts-btn-sm broker-tag-add-btn" aria-label="@L["Trading_BrokerDetail_AddLotTagAria"].Value" @onclick="() => AddLotTag(lot.Lot)" disabled="@string.IsNullOrWhiteSpace(GetLotTagInput(lot.Lot.Id))">+</button>
                        </div>
                    </div>
                    @if (_lotErrors.TryGetValue(lot.Lot.Id, out var lotErr))
                    {
                        <p class="ts-field-error broker-lot-error">@lotErr</p>
                    }
                </article>
            }
        }
        else if (_tab == "sells")
        {
            @if (!Position.IsClosed && Position.RemainingQuantity is > 0)
            {
                <section class="broker-block broker-sell-form">
                    <h3 class="broker-block-title">@L["Trading_BrokerDetail_BlockSell"]</h3>
                    <div class="broker-form-row broker-form-row-3 broker-form-row-align">
                        <div class="broker-field">
                            <label class="broker-field-label" for="sell-price">@L["Trading_BrokerDetail_SellPrice"]</label>
                            <input id="sell-price" class="ts-input @(_sellErr is not null ? "ts-input-invalid" : "")"
                                   type="number" min="0.0001" step="any" placeholder="60.5"
                                   @bind="_sellPrice" @bind:after='() => _sellErr = null' />
                        </div>
                        <div class="broker-field">
                            <label class="broker-field-label" for="sell-qty">@L["Trading_BrokerDetail_SellQty"]</label>
                            <input id="sell-qty" class="ts-input @(_sellErr is not null ? "ts-input-invalid" : "")"
                                   type="number" min="0.0001" step="any" placeholder="@BrokerFormat.Quantity(Position.RemainingQuantity)"
                                   @bind="_sellQty" @bind:after='() => _sellErr = null' />
                        </div>
                        <div class="broker-field">
                            <label class="broker-field-label" for="sell-date">@L["Trading_BrokerDetail_SellDate"]</label>
                            <input id="sell-date" class="ts-input" type="date" @bind="_sellDate" @bind:format="yyyy-MM-dd" />
                        </div>
                    </div>
                    <div class="broker-form-row broker-form-row-2 broker-form-row-align">
                        <div class="broker-field">
                            <label class="broker-field-label" for="sell-fee">@L["Trading_BrokerDetail_SellFee"] <span class="broker-optional">@L["Trading_BrokerDetail_Optional"]</span></label>
                            <input id="sell-fee" class="ts-input" type="number" min="0" step="any" placeholder="0"
                                   @bind="_sellFee" />
                        </div>
                        <div class="broker-field">
                            <label class="broker-field-label" for="sell-tax">@L["Trading_BrokerDetail_SellTax"] <span class="broker-optional">@L["Trading_BrokerDetail_Optional"]</span></label>
                            <input id="sell-tax" class="ts-input" type="number" min="0" step="any" placeholder="0"
                                   @bind="_sellTax" />
                        </div>
                    </div>
                    <div class="broker-field broker-lot-note-field">
                        <label class="broker-field-label" for="sell-note">@L["Trading_BrokerDetail_SellNote"]</label>
                        <input id="sell-note" class="ts-input" maxlength="@BrokerInputValidation.NoteMaxLen"
                               placeholder="@L["Trading_BrokerDetail_SellNotePlaceholder"]" @bind="_sellNote" />
                    </div>
                    @if (!string.IsNullOrEmpty(_sellErr))
                    {
                        <p class="ts-field-error">@_sellErr</p>
                    }
                    <button class="ts-btn ts-btn-primary ts-btn-sm" type="button" @onclick="AddSell">@L["Trading_BrokerDetail_SellAddBtn"]</button>
                </section>
            }

            @if (Position.Sells.Count == 0)
            {
                <p class="broker-empty-inline">@L["Trading_BrokerDetail_EmptySells"]</p>
            }
            @foreach (var sell in Position.Sells.OrderBy(s => s.SoldAt).Select((s, idx) => (Sell: s, Index: idx + 1)))
            {
                <article class="broker-lot-card broker-sell-card">
                    <header class="broker-lot-card-head">
                        <span class="broker-lot-badge broker-sell-badge">B@(sell.Index)</span>
                        <span class="broker-lot-date">@sell.Sell.SoldAt.ToString("dd/MM/yyyy")</span>
                        @if (!Position.IsClosed)
                        {
                            <button class="broker-lot-remove" type="button" title="@L["Trading_BrokerDetail_RemoveSellTitle"].Value" @onclick="() => RemoveSell(sell.Sell)">×</button>
                        }
                    </header>
                    <div class="broker-lot-fields">
                        <div class="broker-field">
                            <label class="broker-field-label">@L["Trading_BrokerDetail_LotDate"]</label>
                            <input class="ts-input" type="date" @bind="sell.Sell.SoldAt" @bind:format="yyyy-MM-dd" @bind:after="() => SellChanged(sell.Sell)" />
                        </div>
                        <div class="broker-field">
                            <label class="broker-field-label">@L["Trading_BrokerDetail_SellPrice"]</label>
                            <input class="ts-input" type="number" min="0.0001" step="any" @bind="sell.Sell.Price" @bind:after="() => SellChanged(sell.Sell)" />
                        </div>
                        <div class="broker-field">
                            <label class="broker-field-label">@L["Trading_BrokerColQty"]</label>
                            <input class="ts-input" type="number" min="0.0001" step="any" placeholder="—" @bind="sell.Sell.Quantity" @bind:after="() => SellChanged(sell.Sell)" />
                        </div>
                    </div>
                    <div class="broker-form-row broker-form-row-2 broker-form-row-align">
                        <div class="broker-field">
                            <label class="broker-field-label">@L["Trading_BrokerDetail_SellFeeShort"]</label>
                            <input class="ts-input" type="number" min="0" step="any" placeholder="0" @bind="sell.Sell.Fee" @bind:after="() => SellChanged(sell.Sell)" />
                        </div>
                        <div class="broker-field">
                            <label class="broker-field-label">@L["Trading_BrokerDetail_SellTaxShort"]</label>
                            <input class="ts-input" type="number" min="0" step="any" placeholder="0" @bind="sell.Sell.Tax" @bind:after="() => SellChanged(sell.Sell)" />
                        </div>
                    </div>
                    <div class="broker-field broker-lot-note-field">
                        <label class="broker-field-label">@L["Trading_BrokerDetail_SellNoteShort"]</label>
                        <input class="ts-input" maxlength="@BrokerInputValidation.NoteMaxLen" placeholder="@L["Trading_BrokerDetail_SellNoteInputPlaceholder"]" @bind="sell.Sell.Note" @bind:after="() => SellChanged(sell.Sell)" />
                    </div>
                </article>
            }
        }
        else if (_tab == "dividends")
        {
            <section class="broker-block broker-dividend-form">
                <h3 class="broker-block-title">@L["Trading_BrokerDetail_BlockDividend"]</h3>
                <div class="broker-form-row broker-form-row-3 broker-form-row-align">
                    <div class="broker-field">
                        <label class="broker-field-label" for="div-exdate">@L["Trading_BrokerDetail_DivExDate"]</label>
                        <input id="div-exdate" class="ts-input" type="date" @bind="_divExDate" @bind:format="yyyy-MM-dd" />
                    </div>
                    <div class="broker-field">
                        <label class="broker-field-label" for="div-paydate">@L["Trading_BrokerDetail_DivPayDate"] <span class="broker-optional">@L["Trading_BrokerDetail_Optional"]</span></label>
                        <input id="div-paydate" class="ts-input" type="date" @bind="_divPayDate" @bind:format="yyyy-MM-dd" />
                    </div>
                    <div class="broker-field">
                        <label class="broker-field-label" for="div-amount">@L["Trading_BrokerDetail_DivAmount"]</label>
                        <input id="div-amount" class="ts-input @(_divErr is not null ? "ts-input-invalid" : "")"
                               type="number" min="0" step="any" placeholder="2000"
                               @bind="_divAmount" @bind:after='() => _divErr = null' />
                    </div>
                </div>
                <div class="broker-form-row broker-form-row-2 broker-form-row-align">
                    <div class="broker-field">
                        <label class="broker-field-label" for="div-qty">@L["Trading_BrokerDetail_DivQty"]</label>
                        <input id="div-qty" class="ts-input @(_divErr is not null ? "ts-input-invalid" : "")"
                               type="number" min="1" step="1" placeholder="@BrokerFormat.Quantity(Position.TotalQuantity)"
                               @bind="_divQty" @bind:after='() => _divErr = null' />
                    </div>
                    <div class="broker-field broker-lot-note-field">
                        <label class="broker-field-label" for="div-note">@L["Trading_BrokerDetail_DivNote"]</label>
                        <input id="div-note" class="ts-input" maxlength="@BrokerInputValidation.NoteMaxLen"
                               placeholder="@L["Trading_BrokerDetail_DivNotePlaceholder"]" @bind="_divNote" />
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(_divErr))
                {
                    <p class="ts-field-error">@_divErr</p>
                }
                <button class="ts-btn ts-btn-primary ts-btn-sm" type="button" @onclick="AddDividend">@L["Trading_BrokerDetail_DivAddBtn"]</button>
            </section>

            @if ((Position.Dividends?.Count ?? 0) == 0)
            {
                <p class="broker-empty-inline">@L["Trading_BrokerDetail_EmptyDividends"]</p>
            }
            else
            {
                <div class="broker-dividend-summary">
                    <span class="broker-kpi-label">@L["Trading_BrokerDetail_DivTotal"]</span>
                    <span class="broker-kpi-value ts-positive">@BrokerFormat.Vnd(Position.TotalDividends)</span>
                </div>

                <div class="broker-table-scroll">
                    <table class="ts-table broker-dividend-table">
                        <thead>
                            <tr>
                                <th><span class="broker-dt-th-inner">@L["Trading_BrokerDetail_DivColExDate"]</span></th>
                                <th><span class="broker-dt-th-inner">@L["Trading_BrokerDetail_DivColPayDate"]</span></th>
                                <th><span class="broker-dt-th-inner">@L["Trading_BrokerDetail_DivColPerShare"]</span></th>
                                <th><span class="broker-dt-th-inner">@L["Trading_BrokerColQty"]</span></th>
                                <th><span class="broker-dt-th-inner">@L["Trading_BrokerDetail_DivColTotal"]</span></th>
                                <th><span class="broker-dt-th-inner">@L["Trading_BrokerDetail_DivColNote"]</span></th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in (Position.Dividends ?? []).OrderByDescending(d => d.ExDate))
                            {
                                <tr>
                                    <td>
                                        <input class="ts-input" type="date" @bind="d.ExDate" @bind:format="yyyy-MM-dd" @bind:after="() => DividendChanged(d)" />
                                    </td>
                                    <td>
                                        <input class="ts-input" type="date" @bind="d.PayDate" @bind:format="yyyy-MM-dd" @bind:after="() => DividendChanged(d)" />
                                    </td>
                                    <td class="broker-num">
                                        <input class="ts-input" type="number" min="0" step="any" @bind="d.AmountPerShare" @bind:after="() => DividendChanged(d)" />
                                    </td>
                                    <td class="broker-num">
                                        <input class="ts-input" type="number" min="1" step="1" @bind="d.Quantity" @bind:after="() => DividendChanged(d)" />
                                    </td>
                                    <td class="broker-num ts-positive">@BrokerFormat.VndPlain(d.TotalAmount)</td>
                                    <td>
                                        <input class="ts-input" maxlength="@BrokerInputValidation.NoteMaxLen" @bind="d.Note" @bind:after="() => DividendChanged(d)" />
                                    </td>
                                    <td>
                                        <button type="button" class="broker-lot-remove" title="@L["Trading_BrokerDetail_RemoveDividendTitle"].Value" @onclick="() => RemoveDividend(d)">×</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
        else if (_tab == "timeline")
        {
            @if (Position.Buys.Count == 0 && Position.Sells.Count == 0 && Position.Notes.Count == 0)
            {
                <p class="broker-empty-inline">@L["Trading_BrokerDetail_EmptyTimeline"]</p>
            }
            else
            {
                <div class="broker-timeline-merged">
                    @{
                        var sharesLabel = L["Trading_BrokerDetail_Shares"].Value;
                        var entries = new List<(DateTime Date, string Icon, string Kind, string Text)>();
                        foreach (var b in Position.Buys.OrderBy(b => b.BoughtAt))
                            entries.Add((b.BoughtAt, "▲", "buy",
                                $"{L["Trading_BrokerDetail_TlBuy"].Value} {(b.Quantity is > 0 ? $"{b.Quantity} {sharesLabel} " : "")}@ {b.Price:N2}"
                                + (!string.IsNullOrWhiteSpace(b.Note) ? $" · {b.Note}" : "")));
                        foreach (var s in Position.Sells.OrderBy(s => s.SoldAt))
                            entries.Add((s.SoldAt, "▼", "sell",
                                $"{L["Trading_BrokerDetail_TlSell"].Value} {(s.Quantity is > 0 ? $"{s.Quantity} {sharesLabel} " : "")}@ {s.Price:N2}"
                                + (s.Fee is > 0 ? $" · {L["Trading_BrokerDetail_TlFee"].Value} {s.Fee:N0}đ" : "")
                                + (s.Tax is > 0 ? $" · {L["Trading_BrokerDetail_TlTax"].Value} {s.Tax:N0}đ" : "")
                                + (!string.IsNullOrWhiteSpace(s.Note) ? $" · {s.Note}" : "")));
                        foreach (var n in Position.Notes.OrderBy(n => n.At))
                            entries.Add((n.At, "◆", "note",
                                $"{(n.Kind == BrokerNoteKind.Self ? L["Trading_BrokerDetail_TlSelf"].Value : "Broker")}: {n.Text}"));
                        foreach (var d in (Position.Dividends ?? []).OrderBy(d => d.ExDate))
                            entries.Add((d.PayDate ?? d.ExDate, "★", "dividend",
                                $"{L["Trading_BrokerDetail_TlDividend"].Value}: {d.AmountPerShare:N0}đ/{sharesLabel} × {d.Quantity} = {BrokerFormat.VndPlain(d.TotalAmount)}"
                                + (!string.IsNullOrWhiteSpace(d.Note) ? $" · {d.Note}" : "")));
                        entries = entries.OrderByDescending(e => e.Date).ThenByDescending(e => e.Kind).ToList();
                    }

                    @foreach (var e in entries)
                    {
                        <div class="broker-tl-entry broker-tl-@e.Kind">
                            <span class="broker-tl-icon" aria-hidden="true">@e.Icon</span>
                            <span class="broker-tl-date">@e.Date.ToString("dd/MM/yyyy")</span>
                            <span class="broker-tl-text">@e.Text</span>
                        </div>
                    }
                </div>
            }
        }
        else
        {
            @if (Position.Notes.Count == 0)
            {
                <p class="broker-empty-inline">@L["Trading_BrokerDetail_EmptyNotes"]</p>
            }
            <div class="broker-timeline">
                @foreach (var note in Position.Notes.OrderByDescending(n => n.At).ToList())
                {
                    <article class="broker-timeline-card">
                        <div class="broker-timeline-card-head">
                            <input class="ts-input broker-timeline-date" type="datetime-local" @bind="note.At" @bind:format="yyyy-MM-ddTHH:mm" @bind:after="() => NoteChanged(note)" />
                            <button class="broker-lot-remove" type="button" title="@L["Trading_BrokerDetail_RemoveNoteTitle"].Value" @onclick="() => RemoveNote(note)">×</button>
                        </div>
                        <textarea class="ts-input ts-textarea broker-textarea"
                                  rows="3"
                                  maxlength="@BrokerInputValidation.NoteMaxLen"
                                  placeholder="@L["Trading_BrokerDetail_NotePlaceholder"]"
                                  @bind="note.Text"
                                  @bind:event="oninput"
                                  @bind:after="() => NoteChanged(note)"></textarea>
                        <div class="broker-timeline-actions">
                            <button class="ts-btn ts-btn-outline ts-btn-sm" type="button" disabled="@_explainBusy" @onclick="() => Explain(note)">
                                @(_explainBusy ? L["Trading_BrokerDetail_AiExplainBusy"].Value : L["Trading_BrokerDetail_AiExplainBtn"].Value)
                            </button>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(note.AiExplain))
                        {
                            <div class="broker-ai-out">
                                <span class="broker-ai-label">AI</span>
                                <AiMarkdown Markdown="@note.AiExplain" />
                            </div>
                        }
                    </article>
                }
            </div>

            <div class="broker-add-note">
                <label class="broker-field-label">@L["Trading_BrokerDetail_AddNoteLabel"]</label>
                <textarea class="ts-input ts-textarea broker-textarea @(_noteErr is not null ? "ts-input-invalid" : "")"
                          placeholder="@L["Trading_BrokerDetail_AddNotePlaceholder"]"
                          rows="3"
                          maxlength="@BrokerInputValidation.NoteMaxLen"
                          @bind="_noteText"
                          @bind:after="() => _noteErr = null"></textarea>
                @if (!string.IsNullOrEmpty(_noteErr))
                {
                    <p class="ts-field-error">@_noteErr</p>
                }
                <button class="ts-btn ts-btn-primary ts-btn-sm" type="button" @onclick="AddNote">@L["Trading_BrokerDetail_AddNoteBtn"]</button>
            </div>
        }
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="ts-alert ts-alert-error broker-detail-error">@_error</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public BrokerPosition Position { get; set; } = new();
    [Parameter] public decimal? CurrentPrice { get; set; }
    [Parameter] public EventCallback<BrokerSyncAction> OnSync { get; set; }
    [Parameter] public EventCallback OnLevelsChanged { get; set; }
    [Parameter] public EventCallback OnDeleted { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }
    [Parameter] public EventCallback OnReopen { get; set; }
    [Parameter] public EventCallback OnDeleteClosed { get; set; }

    private string _tab = "info";
    private string _noteText = "";
    private string? _noteErr;
    private string? _posStopErr;
    private string? _posTargetErr;
    private bool _explainBusy;
    private string? _error;
    private bool _dirty;
    private bool _saving;
    private readonly Dictionary<string, string> _lotErrors = new();

    // Sell form state
    private decimal? _sellPrice;
    private decimal? _sellQty;
    private decimal? _sellFee;
    private decimal? _sellTax;
    private DateTime _sellDate = DateTime.Today;
    private string _sellNote = "";
    private string? _sellErr;
    private string _newTag = "";

    // Dividend form state
    private DateTime _divExDate = DateTime.Today;
    private DateTime? _divPayDate;
    private decimal? _divAmount;
    private int? _divQty;
    private string _divNote = "";
    private string? _divErr;
    private readonly Dictionary<string, string> _lotTagInput = new(StringComparer.OrdinalIgnoreCase);

    private decimal? PositionRefPrice =>
        Position.AvgBuy ?? Position.Buys.FirstOrDefault(b => b.Price > 0)?.Price;

    private BrokerLevelInputMode PositionStopMode
    {
        get => Position.StopLossMode ?? BrokerLevelInputMode.Price;
        set { Position.StopLossMode = value; ValidatePositionLevels(); }
    }

    private decimal? PositionStopInput
    {
        get => Position.StopLossInput ?? (Position.StopLossMode is null or BrokerLevelInputMode.Price ? Position.StopLoss : null);
        set { Position.StopLossInput = value; ValidatePositionLevels(); }
    }

    private BrokerLevelInputMode PositionTargetMode
    {
        get => Position.TargetPriceMode ?? BrokerLevelInputMode.Price;
        set { Position.TargetPriceMode = value; ValidatePositionLevels(); }
    }

    private decimal? PositionTargetInput
    {
        get => Position.TargetPriceInput ?? (Position.TargetPriceMode is null or BrokerLevelInputMode.Price ? Position.TargetPrice : null);
        set { Position.TargetPriceInput = value; ValidatePositionLevels(); }
    }

    private Task Changed()
    {
        _dirty = true;
        return Task.CompletedTask;
    }

    private Task TradeChanged()
    {
        _dirty = true;
        return Task.CompletedTask;
    }

    private void ValidatePositionLevels()
    {
        var prevStop = Position.StopLoss;
        var prevTarget = Position.TargetPrice;

        _posStopErr = null;
        _posTargetErr = null;
        var refPrice = PositionRefPrice;
        if (refPrice is not > 0)
        {
            _dirty = true;
            return;
        }

        if (BrokerLevelHelper.TryValidateStop(refPrice.Value, PositionStopMode, PositionStopInput, out var stop, out var stopErr))
            Position.StopLoss = stop;
        else
            _posStopErr = stopErr;

        if (BrokerLevelHelper.TryValidateTarget(refPrice.Value, PositionTargetMode, PositionTargetInput, out var target, out var targetErr))
            Position.TargetPrice = target;
        else
            _posTargetErr = targetErr;

        _dirty = true;

        if (Position.StopLoss != prevStop || Position.TargetPrice != prevTarget)
            _ = NotifyLevelsChangedAsync();
    }

    private async Task NotifyLevelsChangedAsync()
    {
        if (OnLevelsChanged.HasDelegate)
            await OnLevelsChanged.InvokeAsync();
    }

    private void ValidateLot(BrokerLot lot)
    {
        if (lot.Price is not > 0)
        {
            _lotErrors[lot.Id] = L["Trading_BrokerVal_PriceRequired"].Value;
            return;
        }

        if (!BrokerInputValidation.TryValidateQuantity(lot.Quantity, out var qtyErr))
        {
            _lotErrors[lot.Id] = L[qtyErr!].Value;
            return;
        }

        var stopMode = lot.StopLossMode ?? BrokerLevelInputMode.Price;
        var targetMode = lot.TargetPriceMode ?? BrokerLevelInputMode.Price;
        var stopInput = lot.StopLossInput ?? (stopMode == BrokerLevelInputMode.Price ? lot.StopLoss : null);
        var targetInput = lot.TargetPriceInput ?? (targetMode == BrokerLevelInputMode.Price ? lot.TargetPrice : null);

        if (!BrokerLevelHelper.TryValidateStop(lot.Price, stopMode, stopInput, out var resolvedStop, out var stopErr))
        {
            _lotErrors[lot.Id] = L[stopErr!].Value;
            return;
        }

        if (!BrokerLevelHelper.TryValidateTarget(lot.Price, targetMode, targetInput, out var resolvedTarget, out var targetErr))
        {
            _lotErrors[lot.Id] = L[targetErr!].Value;
            return;
        }

        lot.StopLossMode = stopInput is > 0 ? stopMode : null;
        lot.StopLossInput = stopInput is > 0 ? stopInput : null;
        lot.StopLoss = resolvedStop;
        lot.TargetPriceMode = targetInput is > 0 ? targetMode : null;
        lot.TargetPriceInput = targetInput is > 0 ? targetInput : null;
        lot.TargetPrice = resolvedTarget;

        _lotErrors.Remove(lot.Id);
        _ = LotChanged(lot);
    }

    private Task LotChanged(BrokerLot lot)
    {
        _dirty = true;
        return Task.CompletedTask;
    }

    private async Task RemoveLot(BrokerLot lot)
    {
        if (!await JS.InvokeAsync<bool>("tradingAuth.confirm", L["Trading_BrokerConfirmDeleteLot"].Value))
            return;

        Position.Buys.Remove(lot);
        _lotErrors.Remove(lot.Id);
        await OnSync.InvokeAsync(new LotSyncAction("delete", lot));
    }

    private async Task AddSell()
    {
        _sellErr = null;

        if (_sellPrice is not > 0)
        {
            _sellErr = L["Trading_BrokerDetail_ValSellPrice"].Value;
            return;
        }
        if (_sellQty is not > 0)
        {
            _sellErr = L["Trading_BrokerDetail_ValSellQty"].Value;
            return;
        }

        var remaining = Position.RemainingQuantity ?? 0m;
        if (_sellQty.Value > remaining)
        {
            _sellErr = L["Trading_BrokerDetail_ValSellQtyExceed", BrokerFormat.Quantity(remaining)].Value;
            return;
        }

        var sell = new BrokerSell
        {
            SoldAt = _sellDate,
            Price = _sellPrice!.Value,
            Quantity = _sellQty,
            Fee = _sellFee is > 0 ? _sellFee : null,
            Tax = _sellTax is > 0 ? _sellTax : null,
            Note = string.IsNullOrWhiteSpace(_sellNote) ? null : _sellNote.Trim()
        };
        Position.Sells.Add(sell);

        _sellPrice = _sellQty = _sellFee = _sellTax = null;
        _sellNote = "";
        _sellDate = DateTime.Today;

        // Auto-close if no remaining quantity
        if (Position.RemainingQuantity is null or 0)
        {
            await OnSync.InvokeAsync(new SellSyncAction("create", sell));
            await OnClosed.InvokeAsync();
            return;
        }

        await OnSync.InvokeAsync(new SellSyncAction("create", sell));
    }

    private Task SellChanged(BrokerSell sell)
    {
        _dirty = true;
        return Task.CompletedTask;
    }

    private Task NoteChanged(BrokerNote note)
    {
        _dirty = true;
        return Task.CompletedTask;
    }

    private async Task RemoveSell(BrokerSell sell)
    {
        if (!await JS.InvokeAsync<bool>("tradingAuth.confirm", L["Trading_BrokerDetail_ConfirmRemoveSell"].Value))
            return;

        Position.Sells.Remove(sell);
        await OnSync.InvokeAsync(new SellSyncAction("delete", sell));
    }

    private void OnTagInput(ChangeEventArgs e)
    {
        _newTag = e.Value?.ToString() ?? "";
    }

    private void OnTagKeydown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or ",")
            AddTag();
    }

    private async Task AddTag()
    {
        var tag = _newTag.Trim();
        if (string.IsNullOrEmpty(tag)) return;
        if (tag.Length > 30) tag = tag[..30];
        Position.Tags ??= [];
        if (!Position.Tags.Contains(tag, StringComparer.OrdinalIgnoreCase))
            Position.Tags.Add(tag);
        _newTag = "";
        _dirty = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task RemoveTag(string tag)
    {
        Position.Tags?.Remove(tag);
        _dirty = true;
        await InvokeAsync(StateHasChanged);
    }

    private void SetLotTagInput(string lotId, string value) => _lotTagInput[lotId] = value;

    private string GetLotTagInput(string lotId) => _lotTagInput.TryGetValue(lotId, out var v) ? v : "";

    private void OnLotTagKeydown(KeyboardEventArgs e, BrokerLot lot)
    {
        if (e.Key is "Enter" or ",")
            AddLotTag(lot);
    }

    private void AddLotTag(BrokerLot lot)
    {
        var lotId = lot.Id;
        if (!_lotTagInput.TryGetValue(lotId, out var raw)) return;
        var tag = raw.Trim();
        if (string.IsNullOrEmpty(tag)) return;
        if (tag.Length > 30) tag = tag[..30];
        lot.Tags ??= [];
        if (!lot.Tags.Contains(tag, StringComparer.OrdinalIgnoreCase))
            lot.Tags.Add(tag);
        _lotTagInput[lotId] = "";
        _dirty = true;
    }

    private void RemoveLotTag(BrokerLot lot, string tag)
    {
        lot.Tags?.Remove(tag);
        _dirty = true;
    }

    private async Task AddDividend()
    {
        _divErr = null;

        if (_divAmount is not > 0)
        {
            _divErr = L["Trading_BrokerDetail_ValDivAmount"].Value;
            return;
        }
        if (_divQty is not > 0)
        {
            _divErr = L["Trading_BrokerDetail_ValDivQty"].Value;
            return;
        }

        var dividend = new BrokerDividend
        {
            ExDate = _divExDate,
            PayDate = _divPayDate,
            AmountPerShare = _divAmount!.Value,
            Quantity = _divQty!.Value,
            Note = string.IsNullOrWhiteSpace(_divNote) ? null : _divNote.Trim()
        };
        Position.Dividends ??= [];
        Position.Dividends.Add(dividend);

        _divAmount = null;
        _divQty = null;
        _divNote = "";
        _divPayDate = null;
        _divExDate = DateTime.Today;
        _divErr = null;

        await OnSync.InvokeAsync(new DividendSyncAction("create", dividend));
    }

    private Task DividendChanged(BrokerDividend d)
    {
        _dirty = true;
        return Task.CompletedTask;
    }

    private async Task RemoveDividend(BrokerDividend d)
    {
        if (!await JS.InvokeAsync<bool>("tradingAuth.confirm", L["Trading_BrokerDetail_ConfirmRemoveDividend"].Value))
            return;
        Position.Dividends?.Remove(d);
        await OnSync.InvokeAsync(new DividendSyncAction("delete", d));
    }

    private async Task AddNote()
    {
        if (!BrokerInputValidation.TryValidateNote(_noteText, out var noteErr) || noteErr is not null)
        {
            _noteErr = noteErr is not null ? L[noteErr].Value : L["Trading_BrokerVal_NoteInvalid"].Value;
            return;
        }

        if (string.IsNullOrWhiteSpace(_noteText))
        {
            _noteErr = L["Trading_BrokerVal_NoteEmpty"].Value;
            return;
        }

        var note = new BrokerNote
        {
            At = DateTime.Now,
            Kind = BrokerNoteKind.Broker,
            Text = _noteText.Trim()
        };
        Position.Notes.Add(note);
        _noteText = "";
        _noteErr = null;
        _error = null;
        _tab = "notes";
        await OnSync.InvokeAsync(new NoteSyncAction("create", note));
    }

    private async Task RemoveNote(BrokerNote note)
    {
        Position.Notes.Remove(note);
        await OnSync.InvokeAsync(new NoteSyncAction("delete", note));
    }

    private async Task Delete() => await OnDeleted.InvokeAsync();

    private async Task Reopen() => await OnReopen.InvokeAsync();

    private async Task DeleteClosed() => await OnDeleteClosed.InvokeAsync();

    private async Task SaveAll()
    {
        if (!_dirty) return;

        ValidatePositionLevels();
        if (_posStopErr is not null || _posTargetErr is not null)
            return;

        _saving = true;
        try
        {
            // 1 API call — PUT full position, server syncs all nested in 1 transaction
            await OnSync.InvokeAsync(new PositionSyncAction("update", Position));
            _dirty = false;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task Explain(BrokerNote note)
    {
        if (string.IsNullOrWhiteSpace(note.Text))
        {
            _error = L["Trading_BrokerDetail_ValNoteEmpty"].Value;
            return;
        }

        _explainBusy = true;
        _error = null;
        try
        {
            var prior = string.Join("\n---\n",
                Position.Notes
                    .Where(n => n.Id != note.Id && !string.IsNullOrWhiteSpace(n.Text))
                    .OrderBy(n => n.At)
                    .Select(n => $"{n.At:g}: {n.Text}"));

            var prompt = BrokerPromptLibrary.ExplainNote(
                Position.Symbol,
                Position.Sector,
                Position.Status == BrokerPositionStatus.ChuaQuyet ? L["Trading_BrokerStatus_ChuaQuyet"].Value : L[BrokerStatusLabels.Vi(Position.Status)].Value,
                Position.AvgBuy?.ToString("N2"),
                Position.StopLoss?.ToString("N2") ?? "—",
                Position.TargetPrice?.ToString("N2") ?? "—",
                note.Text,
                string.IsNullOrWhiteSpace(prior) ? L["Trading_BrokerDetail_NoPriorNote"].Value : prior);

            var result = await Gemini.ExplainAsync(prompt);
            if (!string.IsNullOrEmpty(result.Error))
            {
                _error = result.Error;
                return;
            }

            if (string.IsNullOrWhiteSpace(result.Text))
            {
                _error = L["Trading_StockAiNoReply"];
                return;
            }

            note.AiExplain = result.Text;
            await OnSync.InvokeAsync(new NoteSyncAction("update", note));
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _explainBusy = false;
        }
    }
}
