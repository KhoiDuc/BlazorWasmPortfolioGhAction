@inject IBrokerGeminiClient Gemini

<div class="ts-panel broker-detail">
    @{
        var pnl = Position.PnlPct(CurrentPrice);
    }

    <div class="broker-detail-hero">
        <div class="broker-detail-hero-main">
            <span class="broker-detail-symbol">@Position.Symbol</span>
            @if (!string.IsNullOrWhiteSpace(Position.Sector))
            {
                <span class="broker-detail-sector">@Position.Sector</span>
            }
            @if (Position.Status != BrokerPositionStatus.ChuaQuyet)
            {
                <span class="broker-status-pill broker-status-@Position.Status">@BrokerStatusLabels.Vi(Position.Status)</span>
            }
        </div>
        <button class="ts-btn ts-btn-outline ts-btn-sm broker-detail-delete" type="button" @onclick="Delete">Xóa mã</button>
    </div>

    <div class="broker-detail-stats">
        <div class="broker-stat">
            <span class="broker-stat-label">Giá TB</span>
            <span class="broker-stat-value">@(Position.AvgBuy?.ToString("N2") ?? "—")</span>
        </div>
        <div class="broker-stat">
            <span class="broker-stat-label">Hiện tại</span>
            <span class="broker-stat-value">@(CurrentPrice?.ToString("N2") ?? "—")</span>
        </div>
        <div class="broker-stat">
            <span class="broker-stat-label">% Lãi/Lỗ</span>
            <span class="broker-stat-value @(pnl is > 0 ? "ts-positive" : pnl is < 0 ? "ts-negative" : "")">
                @(pnl is null ? "—" : $"{pnl.Value:N2}%")
            </span>
        </div>
        <div class="broker-stat">
            <span class="broker-stat-label">Cắt lỗ</span>
            <span class="broker-stat-value broker-stop">@BrokerLevelHelper.FormatDisplay(Position.StopLoss, Position.StopLossMode, Position.StopLossInput, isStop: true)</span>
        </div>
        <div class="broker-stat">
            <span class="broker-stat-label">Mục tiêu</span>
            <span class="broker-stat-value broker-target">@BrokerLevelHelper.FormatDisplay(Position.TargetPrice, Position.TargetPriceMode, Position.TargetPriceInput, isStop: false)</span>
        </div>
    </div>

    <div class="broker-detail-section">
        <h4 class="broker-section-title">Thông tin mã</h4>
        <div class="broker-form-row broker-form-row-2">
            <div class="ts-field">
                <label class="ts-label">Ngành</label>
                <input class="ts-input" placeholder="Ngân hàng, Bán lẻ…" @bind="Position.Sector" @bind:event="oninput" @bind:after="Changed" maxlength="80" />
            </div>
            <div class="ts-field">
                <label class="ts-label">Trạng thái</label>
                <select class="ts-select" @bind="Position.Status" @bind:after="Changed">
                    @foreach (var s in Enum.GetValues<BrokerPositionStatus>())
                    {
                        <option value="@s">@BrokerStatusLabels.Vi(s)</option>
                    }
                </select>
            </div>
        </div>
        <div class="broker-form-row broker-form-row-2">
            <BrokerLevelInput Id="pos-target"
                              Label="Mục tiêu (mã)"
                              HintPrice="Giá chốt lời — để trống nếu chưa có"
                              HintPercent="Broker nói +10% → nhập 10"
                              PlaceholderPrice="70.5"
                              PlaceholderPercent="10"
                              @bind-Mode="PositionTargetMode"
                              @bind-Input="PositionTargetInput"
                              BuyPrice="PositionRefPrice"
                              IsStop="false"
                              Error="@_posTargetErr"
                              Invalid="@(_posTargetErr is not null)" />
            <BrokerLevelInput Id="pos-stop"
                              Label="Cắt lỗ (mã)"
                              HintPrice="Giá cắt lỗ — để trống nếu chưa có"
                              HintPercent="Broker nói -5% → nhập 5"
                              PlaceholderPrice="55.5"
                              PlaceholderPercent="5"
                              @bind-Mode="PositionStopMode"
                              @bind-Input="PositionStopInput"
                              BuyPrice="PositionRefPrice"
                              IsStop="true"
                              Error="@_posStopErr"
                              Invalid="@(_posStopErr is not null)" />
        </div>
    </div>

    <div class="broker-detail-section">
        <h4 class="broker-section-title">Lần mua (@Position.Buys.Count)</h4>
        <div class="broker-lot-list">
            @{ var lotIndex = 0; }
            @foreach (var lot in Position.Buys.OrderBy(b => b.BoughtAt).ToList())
            {
                lotIndex++;
                <div class="broker-lot-card">
                    <div class="broker-lot-card-head">
                        <span class="broker-lot-badge">L@(lotIndex)</span>
                        <button class="ts-btn ts-btn-outline ts-btn-sm" type="button" @onclick="() => RemoveLot(lot)">Xóa</button>
                    </div>
                    <div class="broker-lot-grid">
                        <div class="ts-field">
                            <label class="ts-label">Ngày</label>
                            <input class="ts-input" type="date" @bind="lot.BoughtAt" @bind:format="yyyy-MM-dd" @bind:after="Changed" />
                        </div>
                        <div class="ts-field">
                            <label class="ts-label">Giá</label>
                            <input class="ts-input" type="number" min="0.0001" step="any" @bind="lot.Price" @bind:after="() => ValidateLot(lot)" />
                        </div>
                        <div class="ts-field">
                            <label class="ts-label">KL</label>
                            <input class="ts-input" type="number" min="0.0001" step="any" @bind="lot.Quantity" @bind:after="() => ValidateLot(lot)" />
                        </div>
                        <div class="ts-field">
                            <label class="ts-label">Cắt lỗ</label>
                            <div class="broker-lot-level">
                                <select class="ts-select" @bind="lot.StopLossMode" @bind:after="() => ValidateLot(lot)">
                                    <option value="@BrokerLevelInputMode.Price">Giá</option>
                                    <option value="@BrokerLevelInputMode.Percent">%</option>
                                </select>
                                <input class="ts-input" type="number" min="0.0001" step="any" placeholder="—" @bind="lot.StopLossInput" @bind:after="() => ValidateLot(lot)" />
                            </div>
                        </div>
                        <div class="ts-field">
                            <label class="ts-label">Mục tiêu</label>
                            <div class="broker-lot-level">
                                <select class="ts-select" @bind="lot.TargetPriceMode" @bind:after="() => ValidateLot(lot)">
                                    <option value="@BrokerLevelInputMode.Price">Giá</option>
                                    <option value="@BrokerLevelInputMode.Percent">%</option>
                                </select>
                                <input class="ts-input" type="number" min="0.0001" step="any" placeholder="—" @bind="lot.TargetPriceInput" @bind:after="() => ValidateLot(lot)" />
                            </div>
                        </div>
                        <div class="ts-field broker-lot-note">
                            <label class="ts-label">Note</label>
                            <input class="ts-input" maxlength="@BrokerInputValidation.NoteMaxLen" placeholder="Ghi chú lần mua…" @bind="lot.Note" @bind:after="Changed" />
                        </div>
                    </div>
                    @if (_lotErrors.TryGetValue(lot.Id, out var lotErr))
                    {
                        <p class="ts-field-error broker-lot-error">@lotErr</p>
                    }
                </div>
            }
        </div>
    </div>

    <div class="broker-detail-section">
        <h4 class="broker-section-title">Note broker</h4>
        <div class="broker-timeline">
            @if (Position.Notes.Count == 0)
            {
                <p class="broker-timeline-empty">Chưa có note timeline.</p>
            }
            @foreach (var note in Position.Notes.OrderByDescending(n => n.At).ToList())
            {
                <div class="broker-timeline-item">
                    <div class="broker-timeline-dot"></div>
                    <div class="broker-timeline-body">
                        <div class="broker-timeline-head">
                            <input class="ts-input broker-timeline-date" type="datetime-local" @bind="note.At" @bind:format="yyyy-MM-ddTHH:mm" @bind:after="Changed" />
                            <button class="ts-btn ts-btn-outline ts-btn-sm" type="button" @onclick="() => RemoveNote(note)">Xóa</button>
                        </div>
                        <textarea class="ts-input ts-textarea"
                                  rows="3"
                                  maxlength="@BrokerInputValidation.NoteMaxLen"
                                  placeholder="Nội dung note broker…"
                                  @bind="note.Text"
                                  @bind:event="oninput"
                                  @bind:after="Changed"></textarea>
                        <div class="broker-timeline-actions">
                            <button class="ts-btn ts-btn-outline ts-btn-sm" type="button" disabled="@_explainBusy" @onclick="() => Explain(note)">
                                @(_explainBusy ? "Đang giải thích…" : "AI giải thích")
                            </button>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(note.AiExplain))
                        {
                            <div class="broker-ai-out">@note.AiExplain</div>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="broker-add-note">
            <label class="ts-label">Thêm note mới</label>
            <textarea class="ts-input ts-textarea @(_noteErr is not null ? "ts-input-invalid" : "")"
                      placeholder="Broker cập nhật / khuyên mua thêm…"
                      rows="2"
                      maxlength="@BrokerInputValidation.NoteMaxLen"
                      @bind="_noteText"
                      @bind:after="() => _noteErr = null"></textarea>
            @if (!string.IsNullOrEmpty(_noteErr))
            {
                <p class="ts-field-error">@_noteErr</p>
            }
            <button class="ts-btn ts-btn-primary ts-btn-sm" type="button" @onclick="AddNote">Thêm note</button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="ts-alert ts-alert-error">@_error</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public BrokerPosition Position { get; set; } = new();
    [Parameter] public decimal? CurrentPrice { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public EventCallback OnDeleted { get; set; }

    private string _noteText = "";
    private string? _noteErr;
    private string? _posStopErr;
    private string? _posTargetErr;
    private bool _explainBusy;
    private string? _error;
    private readonly Dictionary<string, string> _lotErrors = new();

    private decimal? PositionRefPrice =>
        Position.AvgBuy ?? Position.Buys.FirstOrDefault(b => b.Price > 0)?.Price;

    private BrokerLevelInputMode PositionStopMode
    {
        get => Position.StopLossMode ?? BrokerLevelInputMode.Price;
        set { Position.StopLossMode = value; ValidatePositionLevels(); }
    }

    private decimal? PositionStopInput
    {
        get => Position.StopLossInput ?? (Position.StopLossMode is null or BrokerLevelInputMode.Price ? Position.StopLoss : null);
        set { Position.StopLossInput = value; ValidatePositionLevels(); }
    }

    private BrokerLevelInputMode PositionTargetMode
    {
        get => Position.TargetPriceMode ?? BrokerLevelInputMode.Price;
        set { Position.TargetPriceMode = value; ValidatePositionLevels(); }
    }

    private decimal? PositionTargetInput
    {
        get => Position.TargetPriceInput ?? (Position.TargetPriceMode is null or BrokerLevelInputMode.Price ? Position.TargetPrice : null);
        set { Position.TargetPriceInput = value; ValidatePositionLevels(); }
    }

    private Task Changed() => OnChanged.InvokeAsync();

    private void ValidatePositionLevels()
    {
        _posStopErr = null;
        _posTargetErr = null;
        var refPrice = PositionRefPrice;
        if (refPrice is not > 0)
        {
            _ = Changed();
            return;
        }

        if (BrokerLevelHelper.TryValidateStop(refPrice.Value, PositionStopMode, PositionStopInput, out var stop, out var stopErr))
            Position.StopLoss = stop;
        else
            _posStopErr = stopErr;

        if (BrokerLevelHelper.TryValidateTarget(refPrice.Value, PositionTargetMode, PositionTargetInput, out var target, out var targetErr))
            Position.TargetPrice = target;
        else
            _posTargetErr = targetErr;

        _ = Changed();
    }

    private void ValidateLot(BrokerLot lot)
    {
        if (lot.Price is not > 0)
        {
            _lotErrors[lot.Id] = "Giá mua > 0.";
            return;
        }

        if (!BrokerInputValidation.TryValidateQuantity(lot.Quantity, out var qtyErr))
        {
            _lotErrors[lot.Id] = qtyErr!;
            return;
        }

        var stopMode = lot.StopLossMode ?? BrokerLevelInputMode.Price;
        var targetMode = lot.TargetPriceMode ?? BrokerLevelInputMode.Price;
        var stopInput = lot.StopLossInput ?? (stopMode == BrokerLevelInputMode.Price ? lot.StopLoss : null);
        var targetInput = lot.TargetPriceInput ?? (targetMode == BrokerLevelInputMode.Price ? lot.TargetPrice : null);

        if (!BrokerLevelHelper.TryValidateStop(lot.Price, stopMode, stopInput, out var resolvedStop, out var stopErr))
        {
            _lotErrors[lot.Id] = stopErr!;
            return;
        }

        if (!BrokerLevelHelper.TryValidateTarget(lot.Price, targetMode, targetInput, out var resolvedTarget, out var targetErr))
        {
            _lotErrors[lot.Id] = targetErr!;
            return;
        }

        lot.StopLossMode = stopInput is > 0 ? stopMode : null;
        lot.StopLossInput = stopInput is > 0 ? stopInput : null;
        lot.StopLoss = resolvedStop;
        lot.TargetPriceMode = targetInput is > 0 ? targetMode : null;
        lot.TargetPriceInput = targetInput is > 0 ? targetInput : null;
        lot.TargetPrice = resolvedTarget;

        _lotErrors.Remove(lot.Id);
        _ = Changed();
    }

    private async Task RemoveLot(BrokerLot lot)
    {
        Position.Buys.Remove(lot);
        _lotErrors.Remove(lot.Id);
        await Changed();
    }

    private async Task AddNote()
    {
        if (!BrokerInputValidation.TryValidateNote(_noteText, out var noteErr) || noteErr is not null)
        {
            _noteErr = noteErr ?? "Note không hợp lệ.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_noteText))
        {
            _noteErr = "Note không được để trống.";
            return;
        }

        Position.Notes.Add(new BrokerNote
        {
            At = DateTime.Now,
            Kind = BrokerNoteKind.Broker,
            Text = _noteText.Trim()
        });
        _noteText = "";
        _noteErr = null;
        _error = null;
        await Changed();
    }

    private async Task RemoveNote(BrokerNote note)
    {
        Position.Notes.Remove(note);
        await Changed();
    }

    private async Task Delete() => await OnDeleted.InvokeAsync();

    private async Task Explain(BrokerNote note)
    {
        if (string.IsNullOrWhiteSpace(note.Text))
        {
            _error = "Note trống.";
            return;
        }

        _explainBusy = true;
        _error = null;
        try
        {
            var prior = string.Join("\n---\n",
                Position.Notes
                    .Where(n => n.Id != note.Id && !string.IsNullOrWhiteSpace(n.Text))
                    .OrderBy(n => n.At)
                    .Select(n => $"{n.At:g}: {n.Text}"));

            var prompt = BrokerPromptLibrary.ExplainNote(
                Position.Symbol,
                Position.Sector,
                Position.Status == BrokerPositionStatus.ChuaQuyet ? "Chưa quyết" : BrokerStatusLabels.Vi(Position.Status),
                Position.AvgBuy?.ToString("N2"),
                Position.StopLoss?.ToString("N2") ?? "—",
                Position.TargetPrice?.ToString("N2") ?? "—",
                note.Text,
                string.IsNullOrWhiteSpace(prior) ? "(chưa có note cũ)" : prior);

            var reply = await Gemini.ExplainAsync(prompt);
            if (string.IsNullOrWhiteSpace(reply))
            {
                _error = "AI không trả lời. Kiểm tra Gemini:ApiKey trong appsettings.";
                return;
            }

            note.AiExplain = reply;
            await Changed();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _explainBusy = false;
        }
    }
}
