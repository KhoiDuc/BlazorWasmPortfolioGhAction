@inject IPriceAlertService Alerts
@implements IDisposable

@code {
    private PeriodicTimer? _timer;
    private CancellationTokenSource? _cts;

    protected override void OnInitialized()
    {
        _cts = new CancellationTokenSource();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        _ = Run(_cts.Token);
    }

    private async Task Run(CancellationToken ct)
    {
        while (await _timer!.WaitForNextTickAsync(ct))
        {
            try
            {
                var alerts = await Alerts.LoadAsync();
                var symbols = alerts.Where(a => a.Status == AlertStatus.Active
                        && !a.AssetType.Equals("stock", StringComparison.OrdinalIgnoreCase))
                    .Select(a => a.Symbol)
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .ToList();
                foreach (var symbol in symbols)
                {
                    if (Alerts.TryGetPrice(symbol, out var price))
                        await Alerts.CheckAlertsAsync(symbol, price);
                }
            }
            catch (OperationCanceledException)
            {
                break;
            }
            catch
            {
                /* keep polling */
            }
        }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _timer?.Dispose();
        _cts?.Dispose();
    }
}
