@inject ITcbsApiClient Tcbs
@inject IStringLocalizer<SharedResources> L

<section class="ts-panel tcbs-panel">
    <div class="tcbs-head">
        <h2 class="ts-panel-title">@L["Trading_Tcbs_ConnectTitle"]</h2>
        <span class="tcbs-pill @(_status?.Connected == true ? "on" : "")">@(_status?.Connected == true ? L["Trading_Tcbs_On"] : L["Trading_Tcbs_Off"])</span>
    </div>
    <p class="ts-muted">@L["Trading_Tcbs_Lead"]</p>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="ts-alert ts-alert-error" role="alert">@_error</div>
    }
    @if (_status?.NeedsReauth == true)
    {
        <div class="ts-alert ts-alert-info" role="status">@L["Trading_Tcbs_Reauth"]</div>
    }

    @if (_status?.Connected == true)
    {
        <p>@L["Trading_Tcbs_AccountLine", _status.AccountNo, _status.CustodyCode]</p>
        <label class="tcbs-check">
            <input type="checkbox" checked="@_status.ReadOnly" @onchange="ToggleReadOnly" disabled="@_busy" />
            @L["Trading_Tcbs_ReadOnly"]
        </label>
        <button type="button" class="ts-btn ts-btn-outline ts-btn-sm" @onclick="Disconnect" disabled="@_busy">@L["Trading_Tcbs_Disconnect"]</button>
    }
    else
    {
        <div class="broker-form-row broker-form-row-2">
            <div class="broker-field">
                <label class="broker-field-label" for="tcbs-key">@L["Trading_Tcbs_ApiKey"]</label>
                <input id="tcbs-key" class="ts-input" type="password" autocomplete="off" @bind="_apiKey" />
            </div>
            <div class="broker-field">
                <label class="broker-field-label" for="tcbs-otp">iOTP</label>
                <input id="tcbs-otp" class="ts-input" inputmode="numeric" maxlength="8" autocomplete="one-time-code" @bind="_otp" />
            </div>
        </div>
        <div class="broker-field">
            <label class="broker-field-label" for="tcbs-custody">@L["Trading_Tcbs_Custody"] <span class="broker-optional">@L["Trading_Tcbs_CustodyHint"]</span></label>
            <input id="tcbs-custody" class="ts-input" @bind="_custody" placeholder="105C..." />
        </div>
        <button type="button" class="ts-btn ts-btn-primary ts-btn-sm" @onclick="Connect" disabled="@_busy">@(_busy ? L["Trading_Tcbs_Connecting"] : L["Trading_Tcbs_Connect"])</button>
    }
</section>

@code {
    [Parameter] public EventCallback OnChanged { get; set; }

    private TcbsStatus? _status;
    private string _apiKey = "";
    private string _otp = "";
    private string _custody = "";
    private string? _error;
    private bool _busy;

    protected override async Task OnInitializedAsync() => await Reload();

    public async Task Reload()
    {
        _status = await Tcbs.GetStatusAsync();
    }

    private async Task Connect()
    {
        _busy = true;
        _error = null;
        var call = await Tcbs.ConnectAsync(_apiKey, _otp, string.IsNullOrWhiteSpace(_custody) ? null : _custody.Trim());
        _busy = false;
        if (!call.Ok)
        {
            _error = call.Error ?? L["Trading_Tcbs_ConnectFail"];
            return;
        }
        _apiKey = "";
        _otp = "";
        await Reload();
        await OnChanged.InvokeAsync();
    }

    private async Task Disconnect()
    {
        _busy = true;
        await Tcbs.DisconnectAsync();
        _busy = false;
        await Reload();
        await OnChanged.InvokeAsync();
    }

    private async Task ToggleReadOnly(ChangeEventArgs e)
    {
        var readOnly = e.Value is bool b && b;
        _busy = true;
        var call = await Tcbs.SetReadOnlyAsync(readOnly);
        _busy = false;
        if (!call.Ok) _error = call.Error;
        await Reload();
    }
}
