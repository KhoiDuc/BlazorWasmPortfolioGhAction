@using BlazorWasmPortfolioGhAction.Models.Trading.VnDesk
@using BlazorWasmPortfolioGhAction.Services.Trading.VnDesk
@inject IVnMarketClient Market
@inject VnSectorService Sectors

<div class="vd-panel">
    <div class="vd-subtabs">
        <button class="vd-subtab @(_sub == "quant" ? "active" : "")" @onclick='() => _sub = "quant"'>Định lượng ngành</button>
        <button class="vd-subtab @(_sub == "overview" ? "active" : "")" @onclick='() => _sub = "overview"'>Tổng quan</button>
        <button class="vd-subtab @(_sub == "sector" ? "active" : "")" @onclick='() => _sub = "sector"'>Heatmap ngành</button>
    </div>
    <div class="vd-controls">
        <button class="vd-btn vd-btn-primary vd-btn-sm" @onclick="LoadAll" disabled="@_busy">@(_market is null ? "Tải thị trường" : "Làm mới")</button>
        @if (_sub == "sector")
        {
            <input class="vd-input" @bind="_sectorFilter" placeholder="Lọc ngành / mã..." disabled="@_busy" />
        }
        @if (_busy) { <span class="vd-spinner"></span> }
    </div>
    @if (!string.IsNullOrEmpty(_error)) { <div class="vd-alert vd-alert-error">@_error</div> }
</div>

@if (_sub == "quant")
{
    <VnSectorQuantPanel OnSymbolSelected="OnSymbolSelected" />
}
else if (_sub == "overview" && _market is not null)
{
    <div class="vd-panel">
        <h4 class="vd-section-title">Chỉ số</h4>
        <table class="vd-grid">
            <thead><tr><th>Chỉ số</th><th>Giá trị</th><th>+/-</th><th>%</th></tr></thead>
            <tbody>
                @foreach (var idx in _market.Indices)
                {
                    <tr>
                        <td><strong>@idx.Name</strong></td>
                        <td>@idx.Index</td>
                        <td class="@(idx.ParsedChange >= 0 ? "vd-pos" : "vd-neg")">@idx.Change</td>
                        <td class="@(idx.ParsedPercent >= 0 ? "vd-pos" : "vd-neg")">@idx.Percent%</td>
                    </tr>
                }
            </tbody>
        </table>
        <p class="ts-updated mt-2">Cập nhật: @_market.LoadedAt.ToLocalTime():HH:mm:ss</p>
    </div>
    <div class="vd-panel">
        <h4 class="vd-section-title">Top tăng</h4>
        <table class="vd-grid">
            <thead><tr><th>Mã</th><th>Giá</th><th>%</th><th>KL</th></tr></thead>
            <tbody>
                @foreach (var s in _market.Stocks.OrderByDescending(x => x.PercentChange).Take(10))
                {
                    <tr @onclick="() => OnSymbolSelected.InvokeAsync(s.Symbol)">
                        <td><strong>@s.Symbol</strong></td>
                        <td>@s.Close.ToString("N2")</td>
                        <td class="vd-pos">@s.PercentChange.ToString("F2")%</td>
                        <td>@s.Volume.ToString("N0")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="vd-panel">
        <h4 class="vd-section-title">Top giảm</h4>
        <table class="vd-grid">
            <thead><tr><th>Mã</th><th>Giá</th><th>%</th><th>KL</th></tr></thead>
            <tbody>
                @foreach (var s in _market.Stocks.OrderBy(x => x.PercentChange).Take(10))
                {
                    <tr @onclick="() => OnSymbolSelected.InvokeAsync(s.Symbol)">
                        <td><strong>@s.Symbol</strong></td>
                        <td>@s.Close.ToString("N2")</td>
                        <td class="vd-neg">@s.PercentChange.ToString("F2")%</td>
                        <td>@s.Volume.ToString("N0")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else if (_sub == "sector" && _sectorData?.Count > 0)
{
    var filtered = string.IsNullOrWhiteSpace(_sectorFilter)
        ? _sectorData.OrderByDescending(x => x.Value.AverageChange)
        : _sectorData.Where(kv => kv.Key.Contains(_sectorFilter, StringComparison.OrdinalIgnoreCase)
            || kv.Value.TopGainer?.Symbol?.Contains(_sectorFilter, StringComparison.OrdinalIgnoreCase) == true);
    <div class="vd-panel">
        <table class="vd-grid">
            <thead><tr><th>Ngành</th><th>Tăng</th><th>Giảm</th><th>TB %</th><th>Top</th><th>Bottom</th></tr></thead>
            <tbody>
                @foreach (var kv in filtered)
                {
                    var s = kv.Value;
                    <tr>
                        <td><strong>@s.Name</strong> <span class="ts-muted">(@s.StockCount)</span></td>
                        <td class="vd-pos">@s.UpCount</td>
                        <td class="vd-neg">@s.DownCount</td>
                        <td class="@(s.AverageChange >= 0 ? "vd-pos" : "vd-neg")">@s.AverageChange.ToString("F2")%</td>
                        <td>@(s.TopGainer is null ? "-" : $"{s.TopGainer.Symbol} {s.TopGainer.PercentChange:F1}%")</td>
                        <td>@(s.TopLoser is null ? "-" : $"{s.TopLoser.Symbol} {s.TopLoser.PercentChange:F1}%")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else if (_sub == "overview" && _market is null && !_busy)
{
    <div class="vd-panel"><p class="ts-muted">Bấm "Tải thị trường" để xem chỉ số và top tăng/giảm.</p></div>
}
else if (_sub == "sector" && (_sectorData is null || _sectorData.Count == 0) && !_busy)
{
    <div class="vd-panel"><p class="ts-muted">Bấm "Tải thị trường" để xem heatmap ngành.</p></div>
}

@code {
    [Parameter] public EventCallback<string> OnSymbolSelected { get; set; }

    private string _sub = "quant";
    private MarketSnapshot? _market;
    private Dictionary<string, SectorAnalysis>? _sectorData;
    private string _sectorFilter = "";
    private string? _error;
    private bool _busy;

    private async Task LoadAll()
    {
        _busy = true;
        _error = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            var indices = await Market.FetchIndicesAsync();
            var symbols = (await Sectors.GetAllSymbolsAsync()).Take(400).ToList();
            if (symbols.Count == 0)
            {
                var lists = await Market.FetchSymbolsAsync();
                symbols = lists.Take(400).ToList();
            }
            var stocks = await Market.GetLatestManyAsync(symbols, new Progress<int>(_ => { }));
            _market = new MarketSnapshot { Indices = indices, Stocks = stocks, LoadedAt = DateTime.Now };

            Market.ClearCache();
            var allSymbols = await Sectors.GetAllSymbolsAsync();
            var allStocks = await Market.GetLatestManyAsync(allSymbols, new Progress<int>(_ => { }));
            _sectorData = await Sectors.AnalyzeAsync(allStocks);

            if (indices.Count == 0 && stocks.Count == 0 && _sectorData.Count == 0)
                _error = "Không tải được dữ liệu (CORS hoặc API). Thử lại sau.";
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; await InvokeAsync(StateHasChanged); }
    }
}