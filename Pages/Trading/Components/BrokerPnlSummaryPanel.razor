@using BlazorWasmPortfolioGhAction.Utils
@inject IStringLocalizer<SharedResources> L

@{
    var s = BrokerPnlSummaryCalculator.Compute(Portfolio, Quotes);
}

@if (s.HasData)
{
    <div class="ts-panel broker-pnl-panel" aria-live="polite">
        <div class="broker-pnl-head">
            <h2 class="ts-panel-title">@L["Trading_BrokerPnl_Title"]</h2>
            <button type="button" class="ts-btn ts-btn-outline ts-btn-sm" @onclick="ToggleExpand">
                @(_expanded ? L["Trading_BrokerPnl_Collapse"].Value : L["Trading_BrokerPnl_Expand"].Value)
            </button>
        </div>

        <div class="broker-portfolio-stats">
            <div class="broker-stat-card broker-stat-card-pnl positive">
                <span class="broker-stat-card-label">@L["Trading_BrokerPnl_TotalWin"]</span>
                <span class="broker-stat-card-value">@BrokerFormat.Vnd(s.TotalWinAmount)</span>
                <span class="broker-stat-card-sub">@L["Trading_BrokerPnl_SymbolsFmt", s.WinCount]</span>
            </div>
            <div class="broker-stat-card broker-stat-card-pnl negative">
                <span class="broker-stat-card-label">@L["Trading_BrokerPnl_TotalLoss"]</span>
                <span class="broker-stat-card-value">@BrokerFormat.Vnd(s.TotalLossAmount)</span>
                <span class="broker-stat-card-sub">@L["Trading_BrokerPnl_SymbolsFmt", s.LossCount]</span>
            </div>
            <div class="broker-stat-card broker-stat-card-primary @(s.NetPnl >= 0 ? "positive" : "negative")">
                <span class="broker-stat-card-label">@L["Trading_BrokerPnl_NetPnl"]</span>
                <span class="broker-stat-card-value">@BrokerFormat.Vnd(s.NetPnl)</span>
                <span class="broker-stat-card-sub">@(s.FlatCount > 0 ? L["Trading_BrokerPnl_FlatFmt", s.FlatCount].Value : "")</span>
            </div>
            <div class="broker-stat-card">
                <span class="broker-stat-card-label">@L["Trading_BrokerPnl_ProfitFactor"]</span>
                <span class="broker-stat-card-value">@(s.ProfitFactor is null ? "—" : s.ProfitFactor.Value.ToString("F2"))</span>
                <span class="broker-stat-card-sub">@L["Trading_BrokerPnl_LaiLos"]</span>
            </div>
            <div class="broker-stat-card">
                <span class="broker-stat-card-label">@L["Trading_BrokerPnl_WinRate"]</span>
                <span class="broker-stat-card-value">@s.WinRate.ToString("N1")%</span>
                <span class="broker-stat-card-sub">@L["Trading_BrokerPnl_WinLossFmt", s.WinCount, s.LossCount]</span>
            </div>
            <div class="broker-stat-card">
                <span class="broker-stat-card-label">@L["Trading_BrokerPnl_AvgWin"]</span>
                <span class="broker-stat-card-value ts-positive">@BrokerFormat.Vnd(s.AvgWin)</span>
            </div>
            <div class="broker-stat-card">
                <span class="broker-stat-card-label">@L["Trading_BrokerPnl_AvgLoss"]</span>
                <span class="broker-stat-card-value ts-negative">@BrokerFormat.Vnd(s.AvgLoss)</span>
            </div>
            <div class="broker-stat-card">
                <span class="broker-stat-card-label">@L["Trading_BrokerPnl_WinLossRatio"]</span>
                <span class="broker-stat-card-value">@(s.WinLossRatio is null ? "—" : s.WinLossRatio.Value.ToString("F2"))</span>
            </div>
            <div class="broker-stat-card @(s.Realized >= 0 ? "positive" : "negative")">
                <span class="broker-stat-card-label">@L["Trading_BrokerPnl_Realized"]</span>
                <span class="broker-stat-card-value">@BrokerFormat.Vnd(s.Realized)</span>
                <span class="broker-stat-card-sub">@L["Trading_BrokerPnl_RealizedSub"]</span>
            </div>
            <div class="broker-stat-card @(s.Unrealized >= 0 ? "positive" : "negative")">
                <span class="broker-stat-card-label">@L["Trading_BrokerPnl_Unrealized"]</span>
                <span class="broker-stat-card-value">@BrokerFormat.Vnd(s.Unrealized)</span>
                <span class="broker-stat-card-sub">@L["Trading_BrokerPnl_UnrealizedSub"]</span>
            </div>
        </div>

        @if (_expanded)
        {
            <div class="broker-pnl-lists">
                <div class="broker-pnl-list-col">
                    <h3 class="ts-panel-title broker-pnl-list-title ts-positive">@L["Trading_BrokerPnl_Winners"] (@s.Winners.Count)</h3>
                    <div class="broker-table-scroll">
                        <table class="ts-table broker-pnl-table">
                            <thead>
                                <tr>
                                    <th><span class="broker-dt-th-inner">@L["Trading_BrokerColSymbol"]</span></th>
                                    <th><span class="broker-dt-th-inner">@L["Trading_BrokerColSector"]</span></th>
                                    <th><span class="broker-dt-th-inner">@L["Trading_BrokerPnl_ColPrice"]</span></th>
                                    <th><span class="broker-dt-th-inner">@L["Trading_BrokerPnl_ColPnlPct"]</span></th>
                                    <th><span class="broker-dt-th-inner">@L["Trading_BrokerPnl_ColPnlAmt"]</span></th>
                                    <th><span class="broker-dt-th-inner">@L["Trading_BrokerRealized"]</span></th>
                                    <th><span class="broker-dt-th-inner">@L["Trading_BrokerPnl_ColStatus"]</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var e in s.Winners)
                                {
                                    <tr>
                                        <td><span class="broker-symbol">@e.Symbol</span></td>
                                        <td class="broker-sector">@(string.IsNullOrWhiteSpace(e.Sector) ? "—" : e.Sector)</td>
                                        <td class="broker-num">@(e.CurrentPrice?.ToString("N2") ?? "—")</td>
                                        <td class="broker-num ts-positive">@BrokerFormat.Pct(e.PnlPct)</td>
                                        <td class="broker-num ts-positive">@BrokerFormat.Vnd(e.PnlAmount)</td>
                                        <td class="broker-num">@(e.RealizedPnl is null ? "—" : BrokerFormat.Vnd(e.RealizedPnl))</td>
                                        <td>@StatusBadge(e.IsClosed)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="broker-pnl-list-col">
                    <h3 class="ts-panel-title broker-pnl-list-title ts-negative">@L["Trading_BrokerPnl_Losers"] (@s.Losers.Count)</h3>
                    <div class="broker-table-scroll">
                        <table class="ts-table broker-pnl-table">
                            <thead>
                                <tr>
                                    <th><span class="broker-dt-th-inner">@L["Trading_BrokerColSymbol"]</span></th>
                                    <th><span class="broker-dt-th-inner">@L["Trading_BrokerColSector"]</span></th>
                                    <th><span class="broker-dt-th-inner">@L["Trading_BrokerPnl_ColPrice"]</span></th>
                                    <th><span class="broker-dt-th-inner">@L["Trading_BrokerPnl_ColPnlPct"]</span></th>
                                    <th><span class="broker-dt-th-inner">@L["Trading_BrokerPnl_ColPnlAmt"]</span></th>
                                    <th><span class="broker-dt-th-inner">@L["Trading_BrokerRealized"]</span></th>
                                    <th><span class="broker-dt-th-inner">@L["Trading_BrokerPnl_ColStatus"]</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var e in s.Losers)
                                {
                                    <tr>
                                        <td><span class="broker-symbol">@e.Symbol</span></td>
                                        <td class="broker-sector">@(string.IsNullOrWhiteSpace(e.Sector) ? "—" : e.Sector)</td>
                                        <td class="broker-num">@(e.CurrentPrice?.ToString("N2") ?? "—")</td>
                                        <td class="broker-num ts-negative">@BrokerFormat.Pct(e.PnlPct)</td>
                                        <td class="broker-num ts-negative">@BrokerFormat.Vnd(e.PnlAmount)</td>
                                        <td class="broker-num">@(e.RealizedPnl is null ? "—" : BrokerFormat.Vnd(e.RealizedPnl))</td>
                                        <td>@StatusBadge(e.IsClosed)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="broker-pnl-top">
                <div class="broker-pnl-top-col">
                    <h3 class="ts-panel-title broker-pnl-list-title ts-positive">@L["Trading_BrokerPnl_TopWinners"]</h3>
                    <div class="broker-pnl-top-grid">
                        @foreach (var e in s.Winners.Take(5))
                        {
                            <div class="broker-stat-card broker-stat-card-pnl positive">
                                <span class="broker-stat-card-label">@e.Symbol @TopBadge(e.IsClosed)</span>
                                <span class="broker-stat-card-value">@BrokerFormat.Vnd(e.PnlAmount)</span>
                                <span class="broker-stat-card-sub ts-positive">@BrokerFormat.Pct(e.PnlPct)</span>
                            </div>
                        }
                    </div>
                </div>
                <div class="broker-pnl-top-col">
                    <h3 class="ts-panel-title broker-pnl-list-title ts-negative">@L["Trading_BrokerPnl_TopLosers"]</h3>
                    <div class="broker-pnl-top-grid">
                        @foreach (var e in s.Losers.Take(5))
                        {
                            <div class="broker-stat-card broker-stat-card-pnl negative">
                                <span class="broker-stat-card-label">@e.Symbol @TopBadge(e.IsClosed)</span>
                                <span class="broker-stat-card-value">@BrokerFormat.Vnd(e.PnlAmount)</span>
                                <span class="broker-stat-card-sub ts-negative">@BrokerFormat.Pct(e.PnlPct)</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            @if (s.SectorBreakdown.Count > 0)
            {
                <div class="broker-pnl-sector">
                    <h3 class="ts-panel-title">@L["Trading_BrokerPnl_SectorTitle"]</h3>
                    <div class="broker-table-scroll">
                        <table class="ts-table broker-pnl-table">
                            <thead>
                                <tr>
                                    <th><span class="broker-dt-th-inner">@L["Trading_BrokerColSector"]</span></th>
                                    <th><span class="broker-dt-th-inner">@L["Trading_BrokerPnl_ColSymbolCount"]</span></th>
                                    <th><span class="broker-dt-th-inner">@L["Trading_BrokerPnl_ColTotalPnl"]</span></th>
                                    <th><span class="broker-dt-th-inner">@L["Trading_BrokerPnl_ColPnlPct"]</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var sec in s.SectorBreakdown)
                                {
                                    <tr>
                                        <td>@sec.Sector</td>
                                        <td class="broker-num">@sec.SymbolCount</td>
                                        <td class="broker-num @(sec.TotalPnl > 0 ? "ts-positive" : sec.TotalPnl < 0 ? "ts-negative" : "")">
                                            @BrokerFormat.Vnd(sec.TotalPnl)
                                        </td>
                                        <td class="broker-num @(sec.PnlPct > 0 ? "ts-positive" : sec.PnlPct < 0 ? "ts-negative" : "")">
                                            @BrokerFormat.Pct(sec.PnlPct)
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public BrokerPortfolio Portfolio { get; set; } = new();
    [Parameter] public Dictionary<string, decimal> Quotes { get; set; } = new();

    private bool _expanded;

    private void ToggleExpand() => _expanded = !_expanded;

    private MarkupString StatusBadge(bool isClosed) =>
        isClosed
            ? new MarkupString($"<span class=\"broker-pnl-badge broker-pnl-badge-closed\" title=\"{L["Trading_BrokerPnl_BadgeClosedTitle"].Value}\">{L["Trading_BrokerPnl_BadgeClosed"].Value}</span>")
            : new MarkupString($"<span class=\"broker-pnl-badge broker-pnl-badge-open\" title=\"{L["Trading_BrokerPnl_BadgeOpenTitle"].Value}\">{L["Trading_BrokerPnl_BadgeOpen"].Value}</span>");

    private MarkupString TopBadge(bool isClosed) =>
        isClosed
            ? new MarkupString($"<span class=\"broker-pnl-badge-mini\" title=\"{L["Trading_BrokerPnl_BadgeClosedTitle"].Value}\">{L["Trading_BrokerPnl_BadgeClosed"].Value}</span>")
            : new MarkupString("");
}