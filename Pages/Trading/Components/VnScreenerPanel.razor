@using BlazorWasmPortfolioGhAction.Models.Trading.VnDesk
@using BlazorWasmPortfolioGhAction.Services.Trading.VnDesk
@inject IVnMarketClient Market
@inject VnScreenerService Screener
@inject VnDeskOptions Options
@inject IndicatorService Indicators
@inject WatchlistScorer Scorer
@inject IVnDeskStore Store
@inject IStringLocalizer<SharedResources> L
@inject ILogger<VnScreenerPanel> Logger
@using Microsoft.Extensions.Logging

<div class="vd-panel">
    <div class="vd-subtabs">
        <button class="vd-subtab @(_sub == "screen" ? "active" : "")" @onclick='() => _sub = "screen"'>@L["Trading_Screener_TabScreen"]</button>
        <button class="vd-subtab @(_sub == "watch" ? "active" : "")" @onclick='() => _sub = "watch"'>@L["Trading_Screener_TabWatch"]</button>
        <button class="vd-subtab @(_sub == "rsi" ? "active" : "")" @onclick='() => _sub = "rsi"'>@L["Trading_Screener_TabRsi"]</button>
    </div>
    @if (_sub == "screen")
    {
        <div class="vd-controls">
            <label class="ts-label">@L["Trading_Screener_List"]</label>
            <select class="vd-select" @bind="_listKey" disabled="@_busy">
                <option value="VN30">VN30</option>
                <option value="HOSE">HOSE</option>
                <option value="HNX30">HNX30</option>
                <option value="UPCOM">UPCOM</option>
                <option value="NganHang">Ngân hàng</option>
            </select>
            <button class="vd-btn vd-btn-primary vd-btn-sm" @onclick="RunScreener" disabled="@_busy">@L["Trading_Screener_ScanBtn", _listKey]</button>
        </div>
        @if (_progress > 0) { <p class="ts-muted mt-1" style="font-size:0.82rem">@_progress / @_progressTotal</p> }
    }
    else if (_sub == "watch")
    {
        <div class="vd-section">
            <label class="ts-label">@L["Trading_Screener_WatchSymbols"]</label>
            <input class="vd-input" @bind="_watchSymbols" placeholder="VNM,FPT,MWB..." disabled="@_busy" />
        </div>
        <button class="vd-btn vd-btn-primary vd-btn-sm" @onclick="RunWatchlist" disabled="@_busy">@L["Trading_Screener_ScoreBtn"]</button>
    }
    else if (_sub == "rsi")
    {
        <div class="vd-controls">
            <label class="ts-label">@L["Trading_Screener_List"]</label>
            <select class="vd-select" @bind="_rsiListKey" disabled="@_busy">
                <option value="VN30">VN30</option>
                <option value="HOSE">HOSE</option>
                <option value="HNX30">HNX30</option>
                <option value="UPCOM">UPCOM</option>
                <option value="NganHang">Ngân hàng</option>
            </select>
            <button class="vd-btn vd-btn-primary vd-btn-sm" @onclick="RunRsiScan" disabled="@_busy">@L["Trading_Screener_RsiScanBtn", _rsiListKey]</button>
        </div>
        @if (_progress > 0) { <p class="ts-muted mt-1" style="font-size:0.82rem">@_progress / @_progressTotal</p> }
    }
    @if (_busy) { <span class="vd-spinner mt-2"></span> }
    @if (!string.IsNullOrEmpty(_error)) { <div class="vd-alert vd-alert-error mt-2">@_error</div> }
</div>

@if (_sub == "screen" && _screenResults.Count > 0)
{
    <div class="vd-panel">
        <div class="vd-grid-wrap">
        <table class="vd-grid">
            <thead><tr><th>Mã</th><th>Giá</th><th>%</th><th>Score</th><th>@L["Trading_Screener_Reason"]</th></tr></thead>
            <tbody>
                @foreach (var s in _screenResults.Take(30))
                {
                    <tr @onclick="() => OnSymbolSelected.InvokeAsync(s.Symbol)">
                        <td><strong>@s.Symbol</strong></td>
                        <td>@s.LastPrice.ToString("N2")</td>
                        <td class="@(s.PriceChange >= 0 ? "vd-pos" : "vd-neg")">@s.PriceChange.ToString("F2")%</td>
                        <td>@s.PotentialScore.ToString("F1")</td>
                        <td style="font-size:0.75rem">@s.Reason</td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </div>
}
else if (_sub == "screen" && _screenScanned && !_busy)
{
    <div class="vd-panel">
        <p class="ts-muted" style="font-size:0.82rem">Scan hoàn tất — không có mã nào thỏa điều kiện.</p>
    </div>
}
else if (_sub == "watch" && _watchScores.Count > 0)
{
    <div class="vd-panel">
        <p class="ts-muted" style="font-size:0.82rem">@L["Trading_Screener_Criteria"] @string.Join(" | ", _criteria.Select(c => L[c].Value))</p>
    </div>
    <div class="vd-panel">
        <div class="vd-grid-wrap">
        <table class="vd-grid">
            <thead><tr><th>Mã</th><th>LQ</th><th>Trend</th><th>RSI</th><th>Support</th><th>Vol</th><th>Tổng</th><th></th></tr></thead>
            <tbody>
                @foreach (var s in _watchScores)
                {
                    <tr @onclick="() => OnSymbolSelected.InvokeAsync(s.Symbol)">
                        <td><strong>@s.Symbol</strong></td>
                        <td>@s.Liquidity</td>
                        <td>@s.Trend</td>
                        <td>@s.Rsi</td>
                        <td>@s.NearSupport</td>
                        <td>@s.Volume</td>
                        <td><strong>@s.Total</strong></td>
                        <td><span class="ts-signal @(s.Pass ? "ts-signal-near_ath" : "")">@s.Note</span></td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </div>
}
else if (_sub == "watch" && _watchScanned && !_busy)
{
    <div class="vd-panel">
        <p class="ts-muted" style="font-size:0.82rem">Score hoàn tất — không có mã nào hợp lệ (cần ≥ 200 phiên data).</p>
    </div>
}
else if (_sub == "rsi" && _rsiRows.Count > 0)
{
    var zoneGroups = new (string Label, RsiZone Zone, string Css)[]
    {
        (L["Trading_Rsi_OverboughtStrong"].Value, RsiZone.OverboughtStrong, "vd-neg"),
        (L["Trading_Rsi_OverboughtMild"].Value, RsiZone.OverboughtMild, "vd-neg"),
        (L["Trading_Rsi_Neutral"].Value, RsiZone.Neutral, ""),
        (L["Trading_Rsi_OversoldMild"].Value, RsiZone.OversoldMild, "vd-pos"),
        (L["Trading_Rsi_OversoldStrong"].Value, RsiZone.OversoldStrong, "vd-pos")
    };
    foreach (var g in zoneGroups)
    {
        var rows = _rsiRows.Where(r => r.Zone == g.Zone).OrderBy(r => r.Rsi).ToList();
        if (rows.Count == 0) continue;
        <div class="vd-panel">
            <h2 class="vd-section-title">@g.Label <span class="vd-badge">@rows.Count</span></h2>
            <div class="vd-grid-wrap">
            <table class="vd-grid">
                <thead><tr><th>Mã</th><th>RSI</th><th>RSI trước</th><th>Giá</th><th>%</th><th>Trend</th><th>Signal</th><th>Vol xTB</th></tr></thead>
                <tbody>
                    @foreach (var r in rows)
                    {
                        <tr @onclick="() => OnSymbolSelected.InvokeAsync(r.Symbol)">
                            <td><strong>@r.Symbol</strong></td>
                            <td class="@g.Css">@r.Rsi.ToString("F1")</td>
                            <td>@r.PreviousRsi.ToString("F1")</td>
                            <td>@r.LastPrice.ToString("N2")</td>
                            <td class="@(r.PriceChange >= 0 ? "vd-pos" : "vd-neg")">@r.PriceChange.ToString("F2")%</td>
                            <td>@r.TrendLabel</td>
                            <td><span class="ts-signal">@r.Signal</span></td>
                            <td>@r.VolumeRatio.ToString("F2")</td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        </div>
    }
}

@code {
    [Parameter] public EventCallback<string> OnSymbolSelected { get; set; }

    private string _sub = "screen";
    private string _listKey = "VN30";
    private string _rsiListKey = "VN30";
    private string _watchSymbols = "";
    private List<PotentialStock> _screenResults = [];
    private List<WatchlistScore> _watchScores = [];
    private List<RsiScanRow> _rsiRows = [];
    private List<string> _criteria = [];
    private int _progress;
    private int _progressTotal;
    private string? _error;
    private bool _busy;
    private bool _rsiScanned;
    private bool _screenScanned;
    private bool _watchScanned;

    private async Task RunScreener()
    {
        _busy = true;
        _error = null;
        _screenResults = [];
        _screenScanned = false;
        _progress = 0;
        await InvokeAsync(StateHasChanged);
        try
        {
            var lists = await Screener.GetListsAsync();
            if (!lists.TryGetValue(_listKey, out var symbols) || symbols.Count == 0)
            {
                _error = L["Trading_Screener_Empty"];
                return;
            }
            _progressTotal = symbols.Count;
            var histAll = new List<StockData>();
            foreach (var sym in symbols)
            {
                var h = await Market.GetHistoricalAsync(sym, Options.ScreenerDays);
                histAll.AddRange(h);
                _progress++;
                if (_progress % 3 == 0) await InvokeAsync(StateHasChanged);
            }
            _screenResults = Screener.Scan(histAll);
            _screenScanned = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Screener scan failed for {List}", _listKey);
            _error = ex.Message;
        }
        finally { _busy = false; _progress = 0; await InvokeAsync(StateHasChanged); }
    }

    private async Task RunWatchlist()
    {
        _busy = true;
        _error = null;
        _watchScores = [];
        _watchScanned = false;
        await InvokeAsync(StateHasChanged);
        try
        {
            var state = await Store.GetWatchlistAsync();
            _criteria = state.Criteria;
            var symbols = string.IsNullOrWhiteSpace(_watchSymbols)
                ? (await Screener.GetListsAsync()).GetValueOrDefault("VN30")?.Take(10).ToList() ?? []
                : _watchSymbols.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                    .Select(s => s.ToUpperInvariant()).Take(10).ToList();
            _progressTotal = symbols.Count;
            _progress = 0;
            foreach (var sym in symbols)
            {
                try
                {
                    var hist = await Market.GetHistoricalAsync(sym, 250);
                    var ta = Indicators.Calculate(sym, hist);
                    if (ta is not null)
                        _watchScores.Add(Scorer.Score(ta));
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Watchlist score skipped {Symbol}", sym);
                }
                _progress++;
                await InvokeAsync(StateHasChanged);
            }
            state.LastScores = _watchScores;
            state.UpdatedAt = DateTime.Now;
            await Store.SaveWatchlistAsync(state);
            _watchScanned = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Watchlist scoring failed");
            _error = ex.Message;
        }
        finally { _busy = false; _progress = 0; await InvokeAsync(StateHasChanged); }
    }

    private async Task RunRsiScan()
    {
        _busy = true;
        _error = null;
        _rsiRows = [];
        _progress = 0;
        _rsiScanned = false;
        await InvokeAsync(StateHasChanged);
        try
        {
            var lists = await Screener.GetListsAsync();
            if (!lists.TryGetValue(_rsiListKey, out var symbols) || symbols.Count == 0)
            {
                _error = L["Trading_Screener_Empty"];
                return;
            }
            _progressTotal = symbols.Count;
            foreach (var sym in symbols)
            {
                try
                {
                    var hist = await Market.GetHistoricalAsync(sym, 250);
                    var ta = Indicators.Calculate(sym, hist);
                    if (ta is not null)
                        _rsiRows.Add(Scorer.RsiScan(ta));
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "RSI scan skipped {Symbol}", sym);
                }
                _progress++;
                if (_progress % 5 == 0) await InvokeAsync(StateHasChanged);
            }
            _rsiRows = _rsiRows.OrderByDescending(r => r.Zone).ThenBy(r => r.Rsi).ToList();
            _rsiScanned = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "RSI scan failed for {List}", _rsiListKey);
            _error = ex.Message;
        }
        finally { _busy = false; _progress = 0; await InvokeAsync(StateHasChanged); }
    }
}