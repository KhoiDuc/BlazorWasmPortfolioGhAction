@inject ITradingApiClient Api

<div class="ts-panel">
    <div class="ts-header">
        <div><h3 style="margin:0">Gold Spread: World vs Vietnam</h3><p class="ts-updated" style="margin:0">Compare international spot (XAUUSD) with VN retail (SJC / Phú Quý)</p></div>
        <button class="ts-btn ts-btn-outline" @onclick="Load" disabled="@_loading">Refresh</button>
    </div>
    @if (_loading) { <div class="ts-spinner"></div> }
    else
    {
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px;margin-bottom:1rem">
            <div class="ts-panel" style="margin:0">
                <span class="ts-updated">World (XAUUSD proxy)</span>
                <p style="font-size:1.4rem;font-weight:700;margin:0.25rem 0">@(_worldPrice ?? "—")</p>
            </div>
            <div class="ts-panel" style="margin:0">
                <span class="ts-updated">VN SJC (retail)</span>
                <p style="font-size:1.4rem;font-weight:700;margin:0.25rem 0">@(_vnPrice ?? "—")</p>
            </div>
            @if (_spreadPct.HasValue)
            {
                <div class="ts-panel" style="margin:0">
                    <span class="ts-updated">Spread estimate</span>
                    <p class="@(_spreadPct >= 0 ? "ts-positive" : "ts-negative")" style="font-size:1.4rem;font-weight:700;margin:0.25rem 0">@_spreadPct.Value.ToString("F2")%</p>
                </div>
            }
        </div>
    }
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
        <iframe src="@Api.ProxyUrl("goldprice/services/priceservice.ashx")" style="width:100%;height:180px;border:none;border-radius:8px" title="SJC gold" loading="lazy"></iframe>
        <iframe src="@Api.ProxyUrl("phuquygold")" style="width:100%;height:180px;border:none;border-radius:8px" title="Phu Quy gold" loading="lazy"></iframe>
    </div>
</div>

@code {
    private bool _loading;
    private string? _worldPrice;
    private string? _vnPrice;
    private double? _spreadPct;

    protected override void OnInitialized() => _ = Load();

    private async Task Load()
    {
        _loading = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var world = await Api.GetProxyJsonAsync("yahoo/v8/finance/chart/GC=F");
            if (world.HasValue && world.Value.TryGetProperty("chart", out var chart)
                && chart.TryGetProperty("result", out var results) && results.GetArrayLength() > 0)
            {
                var meta = results[0].GetProperty("meta");
                if (meta.TryGetProperty("regularMarketPrice", out var p))
                {
                    _worldPrice = $"${p.GetDouble():N2}/oz";
                }
            }
        }
        catch { _worldPrice = "N/A"; }

        _vnPrice = "See SJC iframe →";
        _spreadPct = null;
        _loading = false;
        await InvokeAsync(StateHasChanged);
    }
}
