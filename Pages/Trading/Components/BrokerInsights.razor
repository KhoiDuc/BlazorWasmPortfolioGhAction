@inject IBrokerApiClient Api
@inject IBrokerDeskStore Store
@inject ITcbsApiClient Tcbs
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResources> L

<section id="broker-tools" class="ts-panel broker-insights">
    <h2 class="ts-panel-title">@L["Trading_BrokerInsights_Title"]</h2>
    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="ts-alert ts-alert-info" role="status">@_message</div>
    }
    <div class="broker-header-actions">
        <button type="button" class="ts-btn ts-btn-outline ts-btn-sm" @onclick="LoadSnapshots">@L["Trading_BrokerInsights_LoadNav"]</button>
        <button type="button" class="ts-btn ts-btn-outline ts-btn-sm" @onclick="TakeSnapshot">@L["Trading_BrokerInsights_Record"]</button>
        <button type="button" class="ts-btn ts-btn-outline ts-btn-sm" @onclick="DownloadServerCsv">@L["Trading_BrokerInsights_DownloadCsv"]</button>
        <button type="button" class="ts-btn ts-btn-outline ts-btn-sm" @onclick="LoadAudit">@L["Trading_BrokerInsights_Audit"]</button>
        <button type="button" class="ts-btn ts-btn-outline ts-btn-sm" @onclick="RefreshToken">@L["Trading_BrokerInsights_Refresh"]</button>
    </div>

    @if (_snapshots.Count > 0)
    {
        <ul>
            @foreach (var row in _snapshots.TakeLast(12))
            {
                <li>@L["Trading_BrokerInsights_Line", row.TakenAt, row.Nav.ToString("N0"), row.RealizedPnl.ToString("N0"), row.DividendIncome.ToString("N0")]</li>
            }
        </ul>
    }

    <h3 class="ts-panel-title">@L["Trading_BrokerInsights_PriceAlert"]</h3>
    <div class="broker-header-actions">
        <div class="broker-field">
            <label class="broker-field-label" for="insights-symbol">@L["Trading_BrokerInsights_Symbol"]</label>
            <input id="insights-symbol" class="ts-input" @bind="_symbol" placeholder="VNM" />
        </div>
        <div class="broker-field">
            <label class="broker-field-label" for="insights-dir">@L["Trading_BrokerInsights_Direction"]</label>
            <select id="insights-dir" class="ts-select" @bind="_direction">
                <option value="above">@L["Trading_BrokerInsights_Above"]</option>
                <option value="below">@L["Trading_BrokerInsights_Below"]</option>
            </select>
        </div>
        <div class="broker-field">
            <label class="broker-field-label" for="insights-price">@L["Trading_BrokerInsights_Price"]</label>
            <input id="insights-price" class="ts-input" type="number" @bind="_price" />
        </div>
        <button type="button" class="ts-btn ts-btn-primary ts-btn-sm" @onclick="CreateAlert">@L["Trading_BrokerInsights_Add"]</button>
        <button type="button" class="ts-btn ts-btn-outline ts-btn-sm" @onclick="LoadAlerts">@L["Trading_BrokerInsights_RefreshList"]</button>
    </div>
    <ul>
        @foreach (var alert in _alerts)
        {
            <li>
                @alert.Symbol @alert.Direction @alert.Price
                <button type="button" class="ts-btn ts-btn-outline ts-btn-sm" @onclick="() => DeleteAlert(alert.Id)">@L["Trading_BrokerInsights_Delete"]</button>
            </li>
        }
    </ul>

    <h3 class="ts-panel-title">@L["Trading_BrokerInsights_Csv"]</h3>
    <div class="broker-field">
        <label class="broker-field-label" for="insights-csv">CSV</label>
        <textarea id="insights-csv" class="ts-input" rows="4" @bind="_csv"></textarea>
    </div>
    <button type="button" class="ts-btn ts-btn-outline ts-btn-sm" @onclick="PreviewCsv">@L["Trading_BrokerInsights_Preview"]</button>
    @if (_import?.Diff is not null)
    {
        <p>@L["Trading_BrokerInsights_AddedRemoved", string.Join(", ", _import.Diff.Added), string.Join(", ", _import.Diff.Removed)]</p>
        <ul>
            @foreach (var row in _import.Diff.Details)
            {
                <li>@L["Trading_BrokerInsights_Detail", row.Symbol, row.Before.Buys, row.After.Buys, row.Before.Sells, row.After.Sells, row.Before.Dividends, row.After.Dividends]</li>
            }
        </ul>
        <button type="button" class="ts-btn ts-btn-primary ts-btn-sm" @onclick="ApplyCsv">@L["Trading_BrokerInsights_Apply"]</button>
    }
    @if (!string.IsNullOrEmpty(_audit))
    {
        <h3 class="ts-panel-title">@L["Trading_BrokerInsights_Audit"]</h3>
        <pre>@_audit</pre>
    }
    <div class="broker-field">
        <label class="broker-field-label" for="tcbs-refresh-otp">@L["Trading_BrokerInsights_Otp"]</label>
        <input id="tcbs-refresh-otp" class="ts-input" @bind="_otp" autocomplete="one-time-code" />
    </div>
</section>

@code {
    private string? _message;
    private string _symbol = "";
    private string _direction = "above";
    private decimal _price;
    private string _csv = "";
    private ImportPreview? _import;
    private string? _audit;
    private string _otp = "";
    private List<SnapshotRow> _snapshots = [];
    private List<AlertRow> _alerts = [];

    protected override async Task OnInitializedAsync() => await LoadAlerts();

    private async Task LoadSnapshots()
    {
        var call = await Api.GetTextAsync("/api/portfolio/snapshots");
        _message = call.Error;
        if (!call.Ok || string.IsNullOrWhiteSpace(call.Body)) return;
        _snapshots = System.Text.Json.JsonSerializer.Deserialize<List<SnapshotRow>>(call.Body, JsonOpts) ?? [];
    }

    private async Task TakeSnapshot()
    {
        var call = await Api.SendTextAsync(HttpMethod.Post, "/api/portfolio/snapshots", "{}", "application/json");
        _message = call.Ok ? L["Trading_BrokerInsights_SnapshotOk"] : call.Error;
        if (call.Ok) await LoadSnapshots();
    }

    private async Task DownloadServerCsv()
    {
        var call = await Api.GetTextAsync("/api/portfolio/export");
        if (!call.Ok || call.Body is null)
        {
            _message = call.Error;
            return;
        }
        await JS.InvokeVoidAsync("tradingAuth.downloadText", "portfolio-server.csv", call.Body, "text/csv");
    }

    private async Task PreviewCsv()
    {
        _import = null;
        var call = await Api.SendTextAsync(HttpMethod.Post, "/api/portfolio/import?dryRun=true", _csv, "text/csv");
        if (!call.Ok || string.IsNullOrWhiteSpace(call.Body))
        {
            _message = call.Error;
            return;
        }
        _import = System.Text.Json.JsonSerializer.Deserialize<ImportPreview>(call.Body, JsonOpts);
        _message = _import is null ? L["Trading_BrokerInsights_DiffFail"] : null;
    }

    private async Task ApplyCsv()
    {
        if (_import?.PreviewHash is null) return;
        var confirmed = await JS.InvokeAsync<bool>("confirm", L["Trading_BrokerInsights_Confirm"].Value);
        if (!confirmed) return;
        var call = await Api.SendTextAsync(HttpMethod.Post, $"/api/portfolio/import?dryRun=false&previewHash={Uri.EscapeDataString(_import.PreviewHash)}", _csv, "text/csv");
        _message = call.Ok ? L["Trading_BrokerInsights_Applied"] : call.Error;
        if (!call.Ok) return;
        await Store.LoadFromApiAsync();
        _import = null;
    }

    private async Task LoadAlerts()
    {
        var call = await Api.GetTextAsync("/api/alerts");
        if (!call.Ok || string.IsNullOrWhiteSpace(call.Body))
        {
            _message = call.Error;
            return;
        }
        _alerts = System.Text.Json.JsonSerializer.Deserialize<List<AlertRow>>(call.Body, JsonOpts) ?? [];
    }

    private async Task CreateAlert()
    {
        var body = System.Text.Json.JsonSerializer.Serialize(new { symbol = _symbol, direction = _direction, price = _price, channel = "discord" });
        var call = await Api.SendTextAsync(HttpMethod.Post, "/api/alerts", body, "application/json");
        _message = call.Ok ? L["Trading_BrokerInsights_AlertOk"] : call.Error;
        if (call.Ok) await LoadAlerts();
    }

    private async Task DeleteAlert(string id)
    {
        var call = await Api.SendTextAsync(HttpMethod.Delete, $"/api/alerts/{id}", null, null);
        _message = call.Error;
        await LoadAlerts();
    }

    private async Task LoadAudit()
    {
        var call = await Tcbs.GetAsync("audit");
        _audit = call.Ok ? call.Json : call.Error;
        _message = call.Ok ? null : call.Error;
    }

    private async Task RefreshToken()
    {
        var call = await Tcbs.SendAsync(HttpMethod.Post, "refresh", new { otp = _otp });
        _message = call.Ok ? L["Trading_BrokerInsights_TokenOk"] : call.Error;
        _otp = "";
    }

    private static readonly System.Text.Json.JsonSerializerOptions JsonOpts = new() { PropertyNameCaseInsensitive = true };

    private sealed class SnapshotRow
    {
        public string TakenAt { get; set; } = "";
        public decimal Nav { get; set; }
        public decimal RealizedPnl { get; set; }
        public decimal DividendIncome { get; set; }
    }

    private sealed class ImportPreview
    {
        public string? PreviewHash { get; set; }
        public ImportDiff Diff { get; set; } = new();
    }

    private sealed class ImportDiff
    {
        public List<string> Added { get; set; } = [];
        public List<string> Removed { get; set; } = [];
        public List<ImportDetail> Details { get; set; } = [];
    }

    private sealed class ImportDetail
    {
        public string Symbol { get; set; } = "";
        public ImportCounts Before { get; set; } = new();
        public ImportCounts After { get; set; } = new();
    }

    private sealed class ImportCounts
    {
        public int Buys { get; set; }
        public int Sells { get; set; }
        public int Dividends { get; set; }
    }

    private sealed class AlertRow
    {
        public string Id { get; set; } = "";
        public string Symbol { get; set; } = "";
        public string Direction { get; set; } = "";
        public decimal Price { get; set; }
    }
}
