<div class="ts-panel">
    <h3 style="margin:0 0 1rem">Forex Trading Sessions (UTC+7)</h3>
    @{
        var now = DateTime.UtcNow.AddHours(7);
        var hour = now.Hour;
        var openCount = new[] {
            hour >= 5 && hour < 14,
            hour >= 6 && hour < 15,
            hour >= 14 && hour < 23,
            hour >= 19 || hour < 4
        }.Count(x => x);
        var volPct = openCount switch { 0 => 15, 1 => 45, 2 => 75, _ => 95 };
    }
    <div style="margin-bottom:1rem">
        <div style="display:flex;justify-content:space-between;font-size:0.82rem;margin-bottom:4px">
            <span>Volatility meter</span>
            <span class="ts-updated">@volPct% — @(openCount) session(s) open</span>
        </div>
        <div class="ts-vol-meter"><div class="ts-vol-meter-fill" style="width:@(volPct)%"></div></div>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px">
        @{
            var sessions = new[] {
                ("Sydney", "#3b82f6", hour >= 5 && hour < 14),
                ("Tokyo", "#10b981", hour >= 6 && hour < 15),
                ("London", "#f59e0b", hour >= 14 && hour < 23),
                ("New York", "#8b5cf6", hour >= 19 || hour < 4)
            };
        }
        @foreach (var (name, color, open) in sessions)
        {
            <div class="ts-panel" style="margin:0;border-left:4px solid @color;opacity:@(open ? "1" : "0.55")">
                <strong>@name</strong>
                <p style="font-size:0.85rem;margin:4px 0" class="@(open ? "ts-positive" : "")">@(open ? "OPEN" : "Closed")</p>
            </div>
        }
    </div>
    <p class="ts-updated mt-3">Current time (UTC+7): @now.ToString("HH:mm:ss")</p>
</div>
