@inject IBrokerGeminiClient Gemini
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResources> L

<div class="ts-panel broker-ai-card">
    <div class="broker-ai-head">
        <span class="broker-ai-icon" aria-hidden="true">✦</span>
        <div class="broker-ai-head-text">
            <h3 class="ts-panel-title broker-ai-title">@L["Trading_BrokerAiTitle"]</h3>
            <span class="broker-ai-sub">@L["Trading_BrokerAiSub"]</span>
        </div>
    </div>

    <div class="broker-ai-body">
        <GeminiKeyBox IdPrefix="broker-ai" />

        <div class="broker-ai-input-wrap">
            <label class="broker-field-label" for="broker-ai-input">@L["Trading_BrokerAiInputLabel"]</label>
            <textarea id="broker-ai-input"
                      class="ts-input ts-textarea broker-ai-input @(_aiErr is not null ? "ts-input-invalid" : "")"
                      placeholder="@L["Trading_BrokerAiPlaceholder"]"
                      rows="6"
                      aria-invalid="@(_aiErr is not null)"
                      aria-describedby="@(_aiErr is not null ? "broker-ai-error" : null)"
                      @bind="_raw"
                      @bind:event="oninput"
                      @bind:after="ClearErr"
                      @onkeydown="OnInputKeydown"></textarea>
            <div class="broker-ai-actions">
                <button class="ts-btn ts-btn-primary ts-btn-sm"
                        type="button"
                        disabled="@(_aiBusy || string.IsNullOrWhiteSpace(_raw))"
                        @onclick="Explain">
                    @(_aiBusy ? L["Trading_BrokerAiAnalyzing"] : L["Trading_BrokerAiExplain"])
                </button>
                @if (_aiBusy)
                {
                    <button class="ts-btn ts-btn-outline ts-btn-sm" type="button" @onclick="CancelExplain">@L["Trading_StockAiCancel"]</button>
                }
                @if (!string.IsNullOrWhiteSpace(_raw) && !_aiBusy)
                {
                    <button class="ts-btn ts-btn-outline ts-btn-sm" type="button" @onclick="Clear">@L["Trading_StockAiClearInput"]</button>
                }
            </div>
        </div>

        @if (_aiBusy)
        {
            <div class="broker-ai-result broker-ai-loading" role="status" aria-live="polite">
                <div class="ts-spinner"></div>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_aiResult))
        {
            <div class="broker-ai-result" aria-live="polite">
                <div class="broker-ai-result-bar">
                    <span class="broker-ai-result-label">@L["Trading_BrokerAiResultLabel"]</span>
                    <button class="ts-btn ts-btn-outline ts-btn-sm" type="button" @onclick="CopyResult">@L["Trading_StockAiCopy"]</button>
                </div>
                <AiMarkdown Markdown="@_aiResult" />
            </div>
        }
        @if (_aiErr is not null)
        {
            <div id="broker-ai-error" class="ts-alert ts-alert-error broker-ai-err" role="alert">@_aiErr</div>
        }
    </div>
</div>

@code {
    private string _raw = "";
    private string? _aiResult;
    private string? _aiErr;
    private bool _aiBusy;
    private CancellationTokenSource? _explainCts;

    private async Task Explain()
    {
        if (string.IsNullOrWhiteSpace(_raw)) return;

        _explainCts?.Cancel();
        _explainCts = new CancellationTokenSource();
        var ct = _explainCts.Token;

        _aiBusy = true;
        _aiErr = null;
        try
        {
            var prompt = BrokerPromptLibrary.ExplainRecommendation(_raw.Trim());
            var result = await Gemini.ExplainAsync(prompt, ct);
            if (!string.IsNullOrEmpty(result.Error))
            {
                _aiErr = result.Error;
                return;
            }

            if (string.IsNullOrWhiteSpace(result.Text))
            {
                _aiErr = L["Trading_StockAiNoReply"];
                return;
            }

            _aiResult = result.Text;
        }
        catch (OperationCanceledException)
        {
            _aiErr = L["Trading_StockAiCancelled"];
        }
        catch (Exception ex)
        {
            _aiErr = ex.Message;
        }
        finally
        {
            _aiBusy = false;
        }
    }

    private void CancelExplain()
    {
        _explainCts?.Cancel();
        _aiBusy = false;
    }

    private async Task OnInputKeydown(KeyboardEventArgs e)
    {
        if (e.CtrlKey && e.Key == "Enter" && !_aiBusy && !string.IsNullOrWhiteSpace(_raw))
            await Explain();
    }

    private void Clear()
    {
        _raw = "";
        _aiResult = null;
        _aiErr = null;
    }

    private void ClearErr() => _aiErr = null;

    private async Task CopyResult()
    {
        if (string.IsNullOrWhiteSpace(_aiResult)) return;
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", _aiResult); }
        catch { }
    }
}
