@using BlazorWasmPortfolioGhAction.Services.Trading
@using BlazorWasmPortfolioGhAction.Utils
@inject IStringLocalizer<SharedResources> L
@inject ITcbsApiClient Tcbs

@{
    var report = BrokerCashFlowCalculator.Compute(Portfolio);
}

@if (_tcbsCash is not null || _tcbsRows.Count > 0)
{
    <div class="ts-panel broker-cashflow-panel">
        <h2 class="ts-panel-title">@L["Trading_BrokerCash_Statement"]</h2>
        <p>@L["Trading_BrokerCash_BalanceLine", BrokerFormat.Vnd(_tcbsCash?.CashBalance), BrokerFormat.Vnd(_tcbsCash?.BodBalance)]</p>
        @foreach (var row in _tcbsRows.Take(8))
        {
            <div>@(row.Date == DateTime.MinValue ? "—" : row.Date.ToString("dd/MM")) @row.Name @BrokerFormat.Vnd(row.Debit - row.Credit)</div>
        }
    </div>
}

@if (report.HasData)
{
    <div class="ts-panel broker-cashflow-panel">
        <div class="broker-cashflow-head">
            <h2 class="ts-panel-title">@L["Trading_BrokerCash_Title"]</h2>
            <button type="button" class="ts-btn ts-btn-outline ts-btn-sm" @onclick="ToggleExpand">
                @(_expanded ? L["Trading_BrokerPnl_Collapse"] : L["Trading_BrokerPnl_Expand"])
            </button>
        </div>

        <div class="broker-cashflow-stats">
            <div class="broker-stat-card">
                <span class="broker-stat-card-label">@L["Trading_BrokerCash_Invested"]</span>
                <span class="broker-stat-card-value">@BrokerFormat.VndPlain(report.TotalInvested)</span>
            </div>
            <div class="broker-stat-card">
                <span class="broker-stat-card-label">@L["Trading_BrokerCash_Received"]</span>
                <span class="broker-stat-card-value">@BrokerFormat.VndPlain(report.TotalReceived)</span>
            </div>
            <div class="broker-stat-card">
                <span class="broker-stat-card-label">@L["Trading_BrokerCash_Fee"]</span>
                <span class="broker-stat-card-value">@BrokerFormat.VndPlain(report.TotalFees)</span>
            </div>
            <div class="broker-stat-card">
                <span class="broker-stat-card-label">@L["Trading_BrokerCash_Tax"]</span>
                <span class="broker-stat-card-value">@BrokerFormat.VndPlain(report.TotalTaxes)</span>
            </div>
            <div class="broker-stat-card">
                <span class="broker-stat-card-label">@L["Trading_BrokerCash_Dividend"]</span>
                <span class="broker-stat-card-value ts-positive">@BrokerFormat.VndPlain(report.TotalDividends)</span>
            </div>
            <div class="broker-stat-card broker-stat-card-primary @(report.NetCashFlow >= 0 ? "positive" : "negative")">
                <span class="broker-stat-card-label">@L["Trading_BrokerCash_Net"]</span>
                <span class="broker-stat-card-value">@BrokerFormat.Vnd(report.NetCashFlow)</span>
            </div>
        </div>

        @{
            var calendar = VnSettlementCalendar.Build(Portfolio, DateTime.Now);
        }
        @if (calendar.Count > 0)
        {
            <h3 class="ts-panel-title">@L["Trading_BrokerCash_Calendar"]</h3>
            <div class="broker-table-scroll">
                <table class="ts-table broker-cashflow-table">
                    <thead>
                        <tr>
                            <th>@L["Trading_BrokerCash_Date"]</th>
                            <th class="broker-num">@L["Trading_BrokerCash_DayTotal"]</th>
                            <th>@L["Trading_BrokerCash_Detail"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var day in calendar)
                        {
                            <tr>
                                <td>@day.Day.ToString("dd/MM/yyyy")</td>
                                <td class="broker-num">@BrokerFormat.Vnd(day.Total)</td>
                                <td>
                                    @foreach (var row in day.Rows)
                                    {
                                        <div>@row.Symbol · @CalendarKind(row.Kind) · @BrokerFormat.Vnd(row.Amount) @row.Note</div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (_expanded)
        {
            <div class="broker-cashflow-filter">
                <label class="broker-dt-label" for="cashflow-month">@L["Trading_BrokerCash_Month"]</label>
                <select id="cashflow-month" class="ts-select" @bind="_monthFilter">
                    <option value="">@L["Trading_Filter_All"]</option>
                    @foreach (var m in AvailableMonths)
                    {
                        <option value="@m">@m</option>
                    }
                </select>
            </div>

            <div class="broker-table-scroll">
                <table class="ts-table broker-cashflow-table">
                    <thead>
                        <tr>
                            <th><span class="broker-dt-th-inner">@L["Trading_BrokerCash_Date"]</span></th>
                            <th><span class="broker-dt-th-inner">@L["Trading_BrokerCash_Symbol"]</span></th>
                            <th><span class="broker-dt-th-inner">@L["Trading_BrokerCash_Kind"]</span></th>
                            <th><span class="broker-dt-th-inner">@L["Trading_BrokerCash_Amount"]</span></th>
                            <th><span class="broker-dt-th-inner">@L["Trading_BrokerNote"]</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in FilteredEntries)
                        {
                            <tr class="broker-cashflow-row broker-cashflow-@e.Kind.ToString().ToLowerInvariant()">
                                <td>@e.Date.ToString("dd/MM/yyyy")</td>
                                <td><span class="broker-symbol">@e.Symbol</span></td>
                                <td>
                                    <span class="broker-cashflow-kind">@KindLabel(e.Kind)</span>
                                </td>
                                <td class="broker-num @(e.Amount > 0 ? "ts-positive" : e.Amount < 0 ? "ts-negative" : "")">
                                    @BrokerFormat.Vnd(e.Amount)
                                </td>
                                <td>@(string.IsNullOrEmpty(e.Note) ? "—" : L[e.Note].Value)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public BrokerPortfolio Portfolio { get; set; } = new();

    private bool _expanded;
    private string _monthFilter = "";
    private TcbsCash? _tcbsCash;
    private List<TcbsStatementRow> _tcbsRows = [];

    protected override async Task OnInitializedAsync()
    {
        var status = await Tcbs.GetStatusAsync();
        if (!status.Connected) return;
        var q = string.IsNullOrWhiteSpace(status.AccountNo) ? "" : "?accountNo=" + Uri.EscapeDataString(status.AccountNo);
        var cash = await Tcbs.GetAsync("cash" + q);
        var from = DateTime.Today.AddMonths(-1).ToString("yyyy-MM-dd");
        var to = DateTime.Today.ToString("yyyy-MM-dd");
        var joiner = string.IsNullOrEmpty(q) ? "?" : "&";
        var statement = await Tcbs.GetAsync($"statement{q}{joiner}fromDate={from}&toDate={to}");
        if (cash.Ok) _tcbsCash = TcbsMapper.ReadCash(cash.Json);
        if (statement.Ok) _tcbsRows = TcbsMapper.ReadStatement(statement.Json);
    }

    private List<BrokerCashFlowEntry> AllEntries =>
        BrokerCashFlowCalculator.Compute(Portfolio).Entries;

    private IReadOnlyList<BrokerCashFlowEntry> FilteredEntries =>
        string.IsNullOrEmpty(_monthFilter)
            ? AllEntries
            : AllEntries.Where(e => $"{e.Date.Year}-{e.Date.Month:D2}" == _monthFilter).ToList();

    private IReadOnlyList<string> AvailableMonths =>
        AllEntries
            .Select(e => $"{e.Date.Year}-{e.Date.Month:D2}")
            .Distinct()
            .OrderByDescending(m => m)
            .ToList();

    private void ToggleExpand() => _expanded = !_expanded;

    private string CalendarKind(string kind) => kind switch
    {
        "Hàng về" => L["Trading_BrokerCash_SettleShares"],
        "Tiền bán về" => L["Trading_BrokerCash_SettleCash"],
        "Cổ tức" => L["Trading_BrokerDetail_TlDividend"],
        _ => kind
    };

    private string KindLabel(CashFlowKind kind) => kind switch
    {
        CashFlowKind.Buy => L["Trading_BrokerDetail_TlBuy"],
        CashFlowKind.Sell => L["Trading_BrokerDetail_TlSell"],
        CashFlowKind.Fee => L["Trading_BrokerDetail_TlFee"],
        CashFlowKind.Tax => L["Trading_BrokerDetail_TlTax"],
        CashFlowKind.Dividend => L["Trading_BrokerDetail_TlDividend"],
        _ => kind.ToString()
    };
}