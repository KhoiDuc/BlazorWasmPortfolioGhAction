@using System.Text.Json
@using System.Text.RegularExpressions
@inject ITradingApiClient Api
@inject HttpClient Http
@inject IPriceAlertService Alerts
@inject IStringLocalizer<SharedResources> L

<div class="ts-panel">
    <p class="ts-muted" style="margin:0 0 0.75rem">@L["Trading_CommoditiesLead"]</p>
    <div class="ts-tabs">
        <button type="button" class="ts-tab @(_tab == "gold" ? "active" : "")" @onclick='() => SetTab("gold")'>Gold</button>
        <button type="button" class="ts-tab @(_tab == "silver" ? "active" : "")" @onclick='() => SetTab("silver")'>Silver</button>
        <button type="button" class="ts-tab @(_tab == "oil" ? "active" : "")" @onclick='() => SetTab("oil")'>Oil</button>
    </div>
</div>

@if (_tab == "gold")
{
    <CommoditySpreadCards Title="@L["Trading_Commodities_GoldSpread"]" Data="@_goldSpread" Loading="@_goldSpreadLoading" />

    <TradingViewChart Symbol="OANDA:XAUUSD" />
    <PriceAlertWidget Symbol="XAUUSD" AssetType="gold" />

    <div class="ts-panel">
        <div class="ts-header">
            <div>
                <h2>Vietnam Gold Price (SJC)</h2>
                <p class="ts-muted">@_goldUpdated</p>
            </div>
            <button type="button" class="ts-btn ts-btn-outline" @onclick="RefreshGold" disabled="@_goldLoading">
                @(_goldLoading ? "..." : "Refresh")
            </button>
        </div>
        @if (_goldError is not null)
        {
            <p class="ts-alert ts-alert-error">@_goldError</p>
        }
        else if (_goldRows.Count > 0)
        {
            <div class="ts-table-wrap">
                <table class="ts-table">
                    <thead><tr><th>Type</th><th>Branch</th><th>Buy</th><th>Sell</th><th>Spread</th></tr></thead>
                    <tbody>
                        @foreach (var r in _goldRows)
                        {
                            <tr>
                                <td><strong>@r.Type</strong></td>
                                <td>@r.Branch</td>
                                <td class="ts-positive">@r.BuyDisplay</td>
                                <td class="ts-negative">@r.SellDisplay</td>
                                <td>@r.Spread</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}
else if (_tab == "silver")
{
    <CommoditySpreadCards Title="@L["Trading_Commodities_SilverSpread"]" Data="@_silverSpread" Loading="@_silverSpreadLoading" />

    <TradingViewChart Symbol="OANDA:XAGUSD" />
    <PriceAlertWidget Symbol="XAGUSD" AssetType="silver" />

    <div class="ts-panel">
        <div class="ts-header">
            <div>
                <h2>Vietnam Silver Price (Phu Quy)</h2>
                <p class="ts-muted">@_silverUpdated</p>
            </div>
            <button type="button" class="ts-btn ts-btn-outline" @onclick="RefreshSilver" disabled="@_silverLoading">
                @(_silverLoading ? "..." : "Refresh")
            </button>
        </div>
        @if (_silverError is not null)
        {
            <p class="ts-alert ts-alert-error">@_silverError</p>
        }
        else if (_silverHtml is not null)
        {
            <div class="ts-silver-html">@((MarkupString)_silverHtml)</div>
        }
    </div>
}
else
{
    <div class="ts-tabs" style="margin-bottom:0.5rem">
        <button type="button" class="ts-tab @(_oilChart == "wti" ? "active" : "")" @onclick='() => SetOilChart("wti")'>WTI</button>
        <button type="button" class="ts-tab @(_oilChart == "brent" ? "active" : "")" @onclick='() => SetOilChart("brent")'>Brent</button>
    </div>
    @if (_oilChart == "wti")
    {
        <TradingViewChart Symbol="TVC:USOIL" />
        <PriceAlertWidget Symbol="USOIL" AssetType="oil" />
    }
    else
    {
        <TradingViewChart Symbol="TVC:UKOIL" />
        <PriceAlertWidget Symbol="UKOIL" AssetType="oil" />
    }
}

@code {
    private const double TaelOzFactor = 1.20565;

    private string _tab = "gold";
    private string _oilChart = "wti";

    private List<GoldRow> _goldRows = [];
    private string? _goldUpdated;
    private string? _goldError;
    private bool _goldLoading;
    private CommoditySpreadCards.SpreadSnapshot? _goldSpread;
    private bool _goldSpreadLoading;

    private string? _silverHtml;
    private string? _silverUpdated;
    private string? _silverError;
    private bool _silverLoading;
    private CommoditySpreadCards.SpreadSnapshot? _silverSpread;
    private bool _silverSpreadLoading;

    private void SetTab(string tab)
    {
        _tab = tab;
        if (tab == "silver" && _silverHtml is null && !_silverLoading)
            _ = RefreshSilver();
    }

    private void SetOilChart(string chart) => _oilChart = chart;

    protected override void OnInitialized() => _ = RefreshGold();

    private async Task RefreshGold()
    {
        await LoadGold();
        await LoadGoldSpread();
    }

    private async Task RefreshSilver()
    {
        await LoadSilver();
        await LoadSilverSpread();
    }

    private async Task LoadGold()
    {
        _goldLoading = true;
        _goldError = null;
        try
        {
            var json = await Api.GetProxyJsonAsync("goldprice/services/priceservice.ashx");
            if (json is not null && json.Value.TryGetProperty("data", out var data) && data.ValueKind == JsonValueKind.Array)
            {
                _goldRows.Clear();
                foreach (var item in data.EnumerateArray())
                {
                    _goldRows.Add(new GoldRow(
                        item.GetProperty("TypeName").GetString() ?? "",
                        item.GetProperty("BranchName").GetString() ?? "",
                        item.GetProperty("BuyValue").GetDouble(),
                        item.GetProperty("SellValue").GetDouble()));
                }
                _goldUpdated = json.Value.TryGetProperty("latestDate", out var d) ? d.GetString() : DateTime.Now.ToString("g");
            }
        }
        catch (Exception ex) { _goldError = ex.Message; }
        finally { _goldLoading = false; await InvokeAsync(StateHasChanged); }
    }

    private async Task LoadGoldSpread()
    {
        _goldSpreadLoading = true;
        try
        {
            var usdVnd = await GetUsdVndRateAsync();
            var worldUsd = await GetRateOrYahooAsync("XAUUSD", "GC=F") ?? await FetchYahooPriceAsync("GC=F") ?? 2350;
            var sjc = _goldRows.FirstOrDefault(r => r.Type.Contains("SJC", StringComparison.OrdinalIgnoreCase) && r.Branch.Contains("HCM", StringComparison.OrdinalIgnoreCase))
                ?? _goldRows.FirstOrDefault(r => r.Type.Contains("SJC", StringComparison.OrdinalIgnoreCase));
            if (sjc is null) { _goldSpread = null; return; }

            var worldVnd = worldUsd * TaelOzFactor * usdVnd;
            var spread = sjc.Sell - worldVnd;
            _goldSpread = BuildSpread("Vàng SJC", sjc.Buy, sjc.Sell, worldUsd, worldVnd, spread, usdVnd, "lượng", "oz");
            Alerts.RememberPrice("XAUUSD", worldUsd);
        }
        finally { _goldSpreadLoading = false; await InvokeAsync(StateHasChanged); }
    }

    private async Task LoadSilver()
    {
        _silverLoading = true;
        _silverError = null;
        try
        {
            var url = Api.ProxyUrl("silverprice/silverpricePartial");
            var resp = await Http.GetAsync(url);
            if (resp.IsSuccessStatusCode)
            {
                _silverHtml = await resp.Content.ReadAsStringAsync();
                _silverUpdated = DateTime.Now.ToString("g");
            }
            else _silverError = "Unable to load silver prices.";
        }
        catch (Exception ex) { _silverError = ex.Message; }
        finally { _silverLoading = false; await InvokeAsync(StateHasChanged); }
    }

    private async Task LoadSilverSpread()
    {
        _silverSpreadLoading = true;
        try
        {
            var (buy, sell) = ParseSilverPrices(_silverHtml);
            if (buy is null || sell is null) { _silverSpread = null; return; }

            var usdVnd = await GetUsdVndRateAsync();
            var worldUsd = await GetRateOrYahooAsync("XAGUSD", "SI=F") ?? await FetchYahooPriceAsync("SI=F") ?? 30.5;
            var worldVnd = worldUsd * TaelOzFactor * usdVnd;
            var spread = sell.Value - worldVnd;
            _silverSpread = BuildSpread("Bạc Phú Quý", buy.Value, sell.Value, worldUsd, worldVnd, spread, usdVnd, "lượng", "oz");
            Alerts.RememberPrice("XAGUSD", worldUsd);
        }
        finally { _silverSpreadLoading = false; await InvokeAsync(StateHasChanged); }
    }

    private CommoditySpreadCards.SpreadSnapshot BuildSpread(
        string vnLabel, double buy, double sell, double worldUsd, double worldVnd, double spread, double usdVnd, string unit, string worldUnit) =>
        new(vnLabel, sell, buy, sell, sell, worldUsd, worldVnd, spread,
            worldVnd > 0 ? spread / worldVnd * 100 : 0, usdVnd, unit, worldUnit, SpreadUpdatedAt());

    private static (double? Buy, double? Sell) ParseSilverPrices(string? html)
    {
        if (string.IsNullOrWhiteSpace(html)) return (null, null);
        var match = Regex.Match(html, @"BẠC MIẾNG[\s\S]*?<td[^>]*>([\d,\.]+)</td>\s*<td[^>]*>([\d,\.]+)</td>", RegexOptions.IgnoreCase);
        if (!match.Success) return (null, null);
        static double? Parse(string s) => double.TryParse(s.Replace(",", ""), out var v) ? v : null;
        return (Parse(match.Groups[1].Value), Parse(match.Groups[2].Value));
    }

    private async Task<double> GetUsdVndRateAsync()
    {
        var fromRates = await GetRateFromLiveRatesAsync("USDVND");
        if (fromRates > 0) return fromRates;
        return await FetchYahooPriceAsync("VND=X") ?? 25450;
    }

    private async Task<double?> GetRateOrYahooAsync(string rateCode, string yahooSymbol)
    {
        var fromRates = await GetRateFromLiveRatesAsync(rateCode);
        if (fromRates > 0) return fromRates;
        return await FetchYahooPriceAsync(yahooSymbol);
    }

    private async Task<double> GetRateFromLiveRatesAsync(string code)
    {
        try
        {
            var json = await Api.GetFxRatesAsync();
            if (json is null || json.Value.ValueKind != JsonValueKind.Array) return 0;
            foreach (var item in json.Value.EnumerateArray())
            {
                var cur = (item.TryGetProperty("currency", out var c) ? c.GetString()
                    : item.TryGetProperty("symbol", out var s) ? s.GetString()
                    : item.TryGetProperty("pair", out var p) ? p.GetString() : "") ?? "";
                var normalized = Regex.Replace(cur.ToUpperInvariant(), "[^A-Z]", "");
                if (normalized != code) continue;
                foreach (var prop in new[] { "rate", "close", "bid", "ask" })
                {
                    if (item.TryGetProperty(prop, out var val) && val.TryGetDouble(out var d) && d > 0)
                        return d;
                }
            }
        }
        catch { }
        return 0;
    }

    private async Task<double?> FetchYahooPriceAsync(string symbol)
    {
        try
        {
            var json = await Api.GetProxyJsonAsync($"yahoo-finance/v8/finance/chart/{Uri.EscapeDataString(symbol)}?interval=1d&range=1d");
            if (json is null) return null;
            if (!json.Value.TryGetProperty("chart", out var chart)) return null;
            if (!chart.TryGetProperty("result", out var results) || results.GetArrayLength() == 0) return null;
            if (!results[0].TryGetProperty("meta", out var meta)) return null;
            if (meta.TryGetProperty("regularMarketPrice", out var price) && price.TryGetDouble(out var d) && d > 0)
                return d;
        }
        catch { }
        return null;
    }

    private static string SpreadUpdatedAt() =>
        DateTime.Now.ToString("HH:mm:ss", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) + " (UTC+7)";

    private record GoldRow(string Type, string Branch, double Buy, double Sell)
    {
        public string BuyDisplay => Buy.ToString("N0");
        public string SellDisplay => Sell.ToString("N0");
        public string Spread => (Sell - Buy).ToString("N0");
    }

}
