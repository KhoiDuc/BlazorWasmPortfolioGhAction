@using BlazorWasmPortfolioGhAction.Utils
@using Blazored.LocalStorage
@inject IStringLocalizer<SharedResources> L
@inject ILocalStorageService LocalStorage

<div class="ts-panel ts-table-wrap broker-watchlist">
    <div class="broker-table-head">
        <div>
            <h3 class="ts-panel-title broker-table-title">@L["Trading_BrokerWatchlistTitle"]</h3>
            @if ((Portfolio.Positions?.Count ?? 0) > 0)
            {
                <span class="broker-table-count">@L["Trading_BrokerWatchlistCount", Portfolio.Positions!.Count]</span>
            }
        </div>
        @if (PriceBusy)
        {
            <span class="broker-table-sync" role="status">@L["Trading_BrokerSyncingPrices"]</span>
        }
    </div>

    @if ((Portfolio.Positions?.Count ?? 0) == 0)
    {
        <div class="broker-empty">
            <p class="broker-empty-title">Chưa có mã nào</p>
            <p class="broker-empty-sub">Ghi khuyến nghị phía trên hoặc tải lại từ server — bảng sẽ hiện sau lần đầu.</p>
        </div>
    }
    else
    {
        var stats = BrokerPortfolioStatsCalculator.Compute(Portfolio, Quotes);
        var filtered = GetFilteredPositions().ToList();
        var sorted = GetSortedPositions(filtered).ToList();
        var totalRows = sorted.Count;
        var pageSize = _pageSize == 0 ? totalRows : _pageSize;
        var totalPages = pageSize > 0 ? Math.Max(1, (int)Math.Ceiling(totalRows / (double)pageSize)) : 1;
        var effectivePage = Math.Clamp(_page, 1, totalPages);
        var pageRows = GetPageRows(sorted, pageSize, effectivePage);
        var rangeStart = totalRows == 0 ? 0 : ((effectivePage - 1) * pageSize) + 1;
        var rangeEnd = totalRows == 0 ? 0 : Math.Min(effectivePage * pageSize, totalRows);

        <div class="broker-portfolio-stats">
            @if (stats.HasMoneyStats)
            {
                <div class="broker-stat-card">
                    <span class="broker-stat-card-label">Giá trị vốn</span>
                    <span class="broker-stat-card-value">@BrokerFormat.VndPlain(stats.TotalCost)</span>
                </div>
                <div class="broker-stat-card broker-stat-card-primary">
                    <span class="broker-stat-card-label">Giá trị hiện tại</span>
                    <span class="broker-stat-card-value">@BrokerFormat.VndPlain(stats.TotalMarketValue)</span>
                </div>
                <div class="broker-stat-card broker-stat-card-pnl @(stats.TotalPnl > 0 ? "positive" : stats.TotalPnl < 0 ? "negative" : "")">
                    <span class="broker-stat-card-label">Lãi/Lỗ tổng</span>
                    <span class="broker-stat-card-value">@BrokerFormat.Vnd(stats.TotalPnl)</span>
                    <span class="broker-stat-card-sub">@BrokerFormat.Pct(stats.TotalPnlPct) trên vốn</span>
                </div>
                <div class="broker-stat-card">
                    <span class="broker-stat-card-label">KL tổng</span>
                    <span class="broker-stat-card-value">@BrokerFormat.Quantity(stats.TotalQuantity)</span>
                    <span class="broker-stat-card-sub">CP</span>
                </div>
                <div class="broker-stat-card">
                    <span class="broker-stat-card-label">Mã lãi / lỗ / hòa</span>
                    <span class="broker-stat-card-value">
                        <span class="ts-positive">@stats.WinningCount</span>
                        <span class="broker-stat-sep">/</span>
                        <span class="ts-negative">@stats.LosingCount</span>
                        <span class="broker-stat-sep">/</span>
                        <span>@stats.FlatCount</span>
                    </span>
                    <span class="broker-stat-card-sub">trong @stats.TrackedCount mã có KL + giá</span>
                </div>
            }
            else
            {
                <div class="broker-stat-card broker-stat-card-wide">
                    <span class="broker-stat-card-label">Thống kê tiền</span>
                    <span class="broker-stat-card-value broker-stat-muted">Chưa tính được — cần nhập KL và làm mới giá</span>
                </div>
            }
            @if (stats.MissingQtyCount > 0)
            {
                <div class="broker-stat-card broker-stat-card-wide broker-stat-warn">
                    <span class="broker-stat-card-label">Lưu ý</span>
                    <span class="broker-stat-card-value broker-stat-muted">@stats.MissingQtyCount mã chưa có đủ KL/giá — chưa gộp vào tổng</span>
                </div>
            }
            @if (stats.HasRealized)
            {
                <div class="broker-stat-card broker-stat-card-realized @(stats.TotalRealized > 0 ? "positive" : stats.TotalRealized < 0 ? "negative" : "")">
                    <span class="broker-stat-card-label">Realized tổng</span>
                    <span class="broker-stat-card-value">@BrokerFormat.Vnd(stats.TotalRealized)</span>
                    <span class="broker-stat-card-sub">@stats.ClosedCount vị thế đã đóng</span>
                </div>
            }
        </div>

        <div class="broker-dt-toolbar">
            <div class="broker-dt-toolbar-left">
                <label class="broker-dt-label" for="broker-dt-search">Tìm kiếm</label>
                <input id="broker-dt-search"
                       class="ts-input broker-dt-search"
                       type="search"
                       placeholder="Mã, ngành, trạng thái, note…"
                       @bind="_search"
                       @bind:event="oninput"
                       @bind:after="ResetPage" />
            </div>
            <div class="broker-dt-toolbar-right">
                <label class="broker-dt-label" for="broker-dt-tag">Tag</label>
                <select id="broker-dt-tag" class="ts-select broker-dt-tag-filter" @bind="_tagFilter" @bind:after="ResetPage">
                    <option value="">Tất cả</option>
                    @foreach (var t in AllTags)
                    {
                        <option value="@t">@t</option>
                    }
                </select>
                <label class="broker-dt-label" for="broker-dt-length">Hiển thị</label>
                <select id="broker-dt-length" class="ts-select broker-dt-length" @bind="_pageSize" @bind:after="ResetPage">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="0">Tất cả</option>
                </select>
                <span class="broker-dt-label">dòng</span>
                <div class="broker-col-toggle-wrap">
                    <button type="button"
                            class="ts-btn ts-btn-outline ts-btn-sm broker-col-toggle-btn"
                            aria-label="Ẩn/hiện cột"
                            aria-expanded="@(_colToggleOpen.ToString().ToLowerInvariant())"
                            aria-controls="broker-col-toggle-menu"
                            @onclick="ToggleColMenu">
                        <i class="bi bi-layout-three-columns" aria-hidden="true"></i>
                        <span> Cột</span>
                    </button>
                    @if (_colToggleOpen)
                    {
                        <div id="broker-col-toggle-menu" class="broker-col-toggle-menu" role="group" aria-label="Hiển thị cột">
                            <div class="broker-col-toggle-item" style="background:#ffecb3;padding:0.3rem 0.4rem;border-radius:4px;font-size:0.7rem;border:1px dashed #f5a623;">
                                DEBUG hidden: [@string.Join(",", _hiddenCols.Select(c => c.ToString()))] | classes: [@HiddenColClasses()]
                            </div>
                            <label class="broker-col-toggle-item">
                                <input type="checkbox" checked="@IsColVisible(BrokerCol.Symbol)" @onchange="@(e => ToggleCol(BrokerCol.Symbol, e.Value))" />
                                Mã
                            </label>
                            <label class="broker-col-toggle-item">
                                <input type="checkbox" checked="@IsColVisible(BrokerCol.Sector)" @onchange="@(e => ToggleCol(BrokerCol.Sector, e.Value))" />
                                Ngành
                            </label>
                            <label class="broker-col-toggle-item">
                                <input type="checkbox" checked="@IsColVisible(BrokerCol.Buys)" @onchange="@(e => ToggleCol(BrokerCol.Buys, e.Value))" />
                                Lần mua
                            </label>
                            <label class="broker-col-toggle-item">
                                <input type="checkbox" checked="@IsColVisible(BrokerCol.Quantity)" @onchange="@(e => ToggleCol(BrokerCol.Quantity, e.Value))" />
                                KL
                            </label>
                            <label class="broker-col-toggle-item">
                                <input type="checkbox" checked="@IsColVisible(BrokerCol.SoldQty)" @onchange="@(e => ToggleCol(BrokerCol.SoldQty, e.Value))" />
                                Đã bán
                            </label>
                            <label class="broker-col-toggle-item">
                                <input type="checkbox" checked="@IsColVisible(BrokerCol.Remaining)" @onchange="@(e => ToggleCol(BrokerCol.Remaining, e.Value))" />
                                Còn lại
                            </label>
                            <label class="broker-col-toggle-item">
                                <input type="checkbox" checked="@IsColVisible(BrokerCol.AvgBuy)" @onchange="@(e => ToggleCol(BrokerCol.AvgBuy, e.Value))" />
                                Giá TB
                            </label>
                            <label class="broker-col-toggle-item">
                                <input type="checkbox" checked="@IsColVisible(BrokerCol.Current)" @onchange="@(e => ToggleCol(BrokerCol.Current, e.Value))" />
                                Hiện tại
                            </label>
                            <label class="broker-col-toggle-item">
                                <input type="checkbox" checked="@IsColVisible(BrokerCol.PnlPct)" @onchange="@(e => ToggleCol(BrokerCol.PnlPct, e.Value))" />
                                L/L %
                            </label>
                            <label class="broker-col-toggle-item">
                                <input type="checkbox" checked="@IsColVisible(BrokerCol.PnlAmount)" @onchange="@(e => ToggleCol(BrokerCol.PnlAmount, e.Value))" />
                                L/L (đ)
                            </label>
                            <label class="broker-col-toggle-item">
                                <input type="checkbox" checked="@IsColVisible(BrokerCol.Stop)" @onchange="@(e => ToggleCol(BrokerCol.Stop, e.Value))" />
                                Cắt lỗ
                            </label>
                            <label class="broker-col-toggle-item">
                                <input type="checkbox" checked="@IsColVisible(BrokerCol.Target)" @onchange="@(e => ToggleCol(BrokerCol.Target, e.Value))" />
                                Mục tiêu
                            </label>
                            <label class="broker-col-toggle-item">
                                <input type="checkbox" checked="@IsColVisible(BrokerCol.Tag)" @onchange="@(e => ToggleCol(BrokerCol.Tag, e.Value))" />
                                Tag
                            </label>
                            <label class="broker-col-toggle-item">
                                <input type="checkbox" checked="@IsColVisible(BrokerCol.Status)" @onchange="@(e => ToggleCol(BrokerCol.Status, e.Value))" />
                                Trạng thái
                            </label>
                            <label class="broker-col-toggle-item">
                                <input type="checkbox" checked="@IsColVisible(BrokerCol.Note)" @onchange="@(e => ToggleCol(BrokerCol.Note, e.Value))" />
                                Ghi chú
                            </label>
                            <button type="button" class="ts-btn ts-btn-outline ts-btn-sm broker-col-reset-btn" @onclick="ResetCols">Mặc định</button>
                        </div>
                    }
                </div>
            </div>
        </div>

        @if (totalRows == 0)
        {
            <div class="broker-dt-empty-filter">
                Không có dòng nào khớp “@_search”. <button type="button" class="ts-btn ts-btn-outline ts-btn-sm" @onclick="ClearSearch">Xóa bộ lọc</button>
            </div>
        }
        else
        {
            <div class="broker-table-scroll @HiddenColClasses()">
                <table class="ts-table broker-table">
                    <thead>
                        <tr>
                            <th class="broker-dt-sortable broker-col-symbol @SortClass(SortColumn.Symbol)"
                                tabindex="0"
                                aria-sort="@SortAria(SortColumn.Symbol)"
                                @onclick='() => ToggleSort(SortColumn.Symbol)'
                                @onkeydown='(e) => OnSortKeydown(e, SortColumn.Symbol)'
                                @onclick:stopPropagation="true">
                                <span class="broker-dt-th-inner">@L["Trading_BrokerColSymbol"] @SortIcon(SortColumn.Symbol)</span>
                            </th>
                            <th class="broker-dt-sortable broker-col-sector @SortClass(SortColumn.Sector)"
                                tabindex="0"
                                aria-sort="@SortAria(SortColumn.Sector)"
                                @onclick='() => ToggleSort(SortColumn.Sector)'
                                @onkeydown='(e) => OnSortKeydown(e, SortColumn.Sector)'
                                @onclick:stopPropagation="true">
                                <span class="broker-dt-th-inner">@L["Trading_BrokerColSector"] @SortIcon(SortColumn.Sector)</span>
                            </th>
                            <th class="broker-col-buys"><span class="broker-dt-th-inner">@L["Trading_BrokerColBuys"]</span></th>
                            <th class="broker-dt-sortable broker-col-quantity @SortClass(SortColumn.Quantity)"
                                tabindex="0"
                                aria-sort="@SortAria(SortColumn.Quantity)"
                                @onclick='() => ToggleSort(SortColumn.Quantity)'
                                @onkeydown='(e) => OnSortKeydown(e, SortColumn.Quantity)'
                                @onclick:stopPropagation="true">
                                <span class="broker-dt-th-inner">@L["Trading_BrokerColQty"] @SortIcon(SortColumn.Quantity)</span>
                            </th>
                            <th class="broker-dt-sortable broker-col-soldqty @SortClass(SortColumn.SoldQty)"
                                tabindex="0"
                                aria-sort="@SortAria(SortColumn.SoldQty)"
                                @onclick='() => ToggleSort(SortColumn.SoldQty)'
                                @onkeydown='(e) => OnSortKeydown(e, SortColumn.SoldQty)'
                                @onclick:stopPropagation="true">
                                <span class="broker-dt-th-inner">@L["Trading_BrokerColSoldQty"] @SortIcon(SortColumn.SoldQty)</span>
                            </th>
                            <th class="broker-dt-sortable broker-col-remaining @SortClass(SortColumn.Remaining)"
                                tabindex="0"
                                aria-sort="@SortAria(SortColumn.Remaining)"
                                @onclick='() => ToggleSort(SortColumn.Remaining)'
                                @onkeydown='(e) => OnSortKeydown(e, SortColumn.Remaining)'
                                @onclick:stopPropagation="true">
                                <span class="broker-dt-th-inner">@L["Trading_BrokerColRemaining"] @SortIcon(SortColumn.Remaining)</span>
                            </th>
                            <th class="broker-dt-sortable broker-col-avgbuy @SortClass(SortColumn.AvgBuy)"
                                tabindex="0"
                                aria-sort="@SortAria(SortColumn.AvgBuy)"
                                @onclick='() => ToggleSort(SortColumn.AvgBuy)'
                                @onkeydown='(e) => OnSortKeydown(e, SortColumn.AvgBuy)'
                                @onclick:stopPropagation="true">
                                <span class="broker-dt-th-inner">@L["Trading_BrokerColAvgBuy"] @SortIcon(SortColumn.AvgBuy)</span>
                            </th>
                            <th class="broker-dt-sortable broker-col-current @SortClass(SortColumn.Current)"
                                tabindex="0"
                                aria-sort="@SortAria(SortColumn.Current)"
                                @onclick='() => ToggleSort(SortColumn.Current)'
                                @onkeydown='(e) => OnSortKeydown(e, SortColumn.Current)'
                                @onclick:stopPropagation="true">
                                <span class="broker-dt-th-inner">@L["Trading_BrokerColCurrent"] @SortIcon(SortColumn.Current)</span>
                            </th>
                            <th class="broker-dt-sortable broker-col-pnlpct @SortClass(SortColumn.PnlPct)"
                                tabindex="0"
                                aria-sort="@SortAria(SortColumn.PnlPct)"
                                @onclick='() => ToggleSort(SortColumn.PnlPct)'
                                @onkeydown='(e) => OnSortKeydown(e, SortColumn.PnlPct)'
                                @onclick:stopPropagation="true">
                                <span class="broker-dt-th-inner">@L["Trading_BrokerColPnlPct"] @SortIcon(SortColumn.PnlPct)</span>
                            </th>
                            <th class="broker-dt-sortable broker-col-pnlamt @SortClass(SortColumn.PnlAmount)"
                                tabindex="0"
                                aria-sort="@SortAria(SortColumn.PnlAmount)"
                                @onclick='() => ToggleSort(SortColumn.PnlAmount)'
                                @onkeydown='(e) => OnSortKeydown(e, SortColumn.PnlAmount)'
                                @onclick:stopPropagation="true">
                                <span class="broker-dt-th-inner">@L["Trading_BrokerColPnlAmt"] @SortIcon(SortColumn.PnlAmount)</span>
                            </th>
                            <th class="broker-col-stop"><span class="broker-dt-th-inner">@L["Trading_BrokerStop"]</span></th>
                            <th class="broker-col-target"><span class="broker-dt-th-inner">@L["Trading_BrokerTarget"]</span></th>
                            <th class="broker-col-tag"><span class="broker-dt-th-inner">Tag</span></th>
                            <th class="broker-dt-sortable broker-col-status @SortClass(SortColumn.Status)"
                                tabindex="0"
                                aria-sort="@SortAria(SortColumn.Status)"
                                @onclick='() => ToggleSort(SortColumn.Status)'
                                @onkeydown='(e) => OnSortKeydown(e, SortColumn.Status)'
                                @onclick:stopPropagation="true">
                                <span class="broker-dt-th-inner">@L["Trading_BrokerColStatus"] @SortIcon(SortColumn.Status)</span>
                            </th>
                            <th class="broker-col-note"><span class="broker-dt-th-inner">@L["Trading_BrokerNote"]</span></th>
                            <th class="broker-col-action"><span class="broker-dt-th-inner">Thao tác</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in pageRows)
                        {
                            var current = Quote(p.Symbol);
                            var pnl = p.PnlPct(current);
                            var pnlAmt = p.PnlAmount(current);
                            var selected = p.Symbol.Equals(SelectedSymbol, StringComparison.OrdinalIgnoreCase);
                            var hitSl = !p.IsClosed && p.StopLoss is > 0 && current is > 0 && current <= p.StopLoss.Value;
                            var hitTp = !p.IsClosed && p.TargetPrice is > 0 && current is > 0 && current >= p.TargetPrice.Value;
                            var rowClass = new List<string>();
                            if (selected) rowClass.Add("selected");
                            if (hitSl) rowClass.Add("broker-row-alert-sl");
                            if (hitTp) rowClass.Add("broker-row-alert-tp");
                            <tr class="@(string.Join(" ", rowClass))"
                                role="button"
                                tabindex="0"
                                @onclick="() => OnSelect.InvokeAsync(p.Symbol)"
                                @onkeydown='(e) => OnRowKeydown(e, p.Symbol)'>
                                <td class="broker-col-symbol">
                                    <span class="broker-symbol">@p.Symbol</span>
                                    @if (p.HasPartialQtyLots)
                                    {
                                        <span class="broker-partial-qty-warn" title="@L["Trading_BrokerPartialQtyHint"]">⚠</span>
                                    }
                                    @if (hitSl)
                                    {
                                        <span class="broker-alert-icon" title="Chạm cắt lỗ" aria-label="Chạm cắt lỗ">🔴</span>
                                    }
                                    @if (hitTp)
                                    {
                                        <span class="broker-alert-icon" title="Chạm mục tiêu" aria-label="Chạm mục tiêu">🟢</span>
                                    }
                                </td>
                                <td class="broker-sector broker-col-sector">@DisplaySector(p.Sector)</td>
                                <td class="broker-col-buys">
                                    <div class="broker-lots">
                                        @foreach (var (lot, idx) in p.Buys.OrderBy(b => b.BoughtAt).Select((b, idx) => (b, idx)))
                                        {
                                            <span class="broker-lot-chip" title="@LotTitle(lot)">@LotLabel(lot, idx + 1)</span>
                                        }
                                    </div>
                                </td>
                                <td class="broker-num broker-qty broker-col-quantity">@BrokerFormat.Quantity(p.TotalQuantity)</td>
                                <td class="broker-num broker-sold-qty broker-col-soldqty">@BrokerFormat.Quantity(p.SoldQuantity)</td>
                                <td class="broker-num broker-remaining broker-col-remaining">@BrokerFormat.Quantity(p.RemainingQuantity)</td>
                                <td class="broker-num broker-col-avgbuy">@(p.AvgBuy?.ToString("N2") ?? "—")</td>
                                <td class="broker-num broker-col-current">@(current?.ToString("N2") ?? "—")</td>
                                <td class="broker-num broker-col-pnlpct @(pnl is > 0 ? "ts-positive" : pnl is < 0 ? "ts-negative" : "")">
                                    @(pnl is null ? "—" : $"{pnl.Value:N2}%")
                                </td>
                                <td class="broker-num broker-pnl-amt broker-col-pnlamt @(pnlAmt is > 0 ? "ts-positive" : pnlAmt is < 0 ? "ts-negative" : "")">
                                    @BrokerFormat.Vnd(pnlAmt)
                                </td>
                                <td class="broker-num broker-stop broker-col-stop">@BrokerLevelHelper.FormatDisplay(p.StopLoss, p.StopLossMode, p.StopLossInput, isStop: true)</td>
                                <td class="broker-num broker-target broker-col-target">@BrokerLevelHelper.FormatDisplay(p.TargetPrice, p.TargetPriceMode, p.TargetPriceInput, isStop: false)</td>
                                <td class="broker-tag-cell broker-col-tag">
                                    @if (p.Tags is { Count: > 0 })
                                    {
                                        @foreach (var t in p.Tags)
                                        {
                                            <span class="broker-tag-chip-sm">@t</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="broker-status-muted">—</span>
                                    }
                                </td>
                                <td class="broker-col-status">
                                    @if (p.Status == BrokerPositionStatus.ChuaQuyet)
                                    {
                                        <span class="broker-status-pill broker-status-muted">—</span>
                                    }
                                    else
                                    {
                                        <span class="broker-status-pill broker-status-@p.Status">@L[BrokerStatusLabels.Vi(p.Status)].Value</span>
                                    }
                                </td>
                                <td class="broker-note-cell broker-col-note">@DisplayLatestNote(p)</td>
                                <td class="broker-row-action broker-col-action">
                                    @if (!p.IsClosed && p.RemainingQuantity is > 0)
                                    {
                                        <button type="button" class="ts-btn ts-btn-outline ts-btn-sm broker-quick-sell-btn"
                                                aria-label="Bán nhanh @p.Symbol"
                                                @onclick="() => OnQuickSell.InvokeAsync(p.Symbol)"
                                                @onclick:stopPropagation="true">Bán</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="broker-dt-toolbar broker-dt-footer">
                <span class="broker-dt-info">
                    Hiển thị @rangeStart–@rangeEnd / @totalRows mã
                    @if (!string.IsNullOrWhiteSpace(_search))
                    {
                        <text> (lọc từ @Portfolio.Positions!.Count)</text>
                    }
                </span>
                <div class="broker-dt-pager">
                    <button type="button"
                            class="ts-btn ts-btn-outline ts-btn-sm broker-dt-page-btn"
                            disabled="@(effectivePage <= 1)"
                            @onclick="PrevPage">Trước</button>
                    <span class="broker-dt-info">Trang @effectivePage / @totalPages</span>
                    <button type="button"
                            class="ts-btn ts-btn-outline ts-btn-sm broker-dt-page-btn"
                            disabled="@(effectivePage >= totalPages)"
                            @onclick="NextPage">Sau</button>
                </div>
            </div>
        }

        <p class="broker-table-foot">Giá CP theo nghìn đồng (×1.000 đ) · Lãi/Lỗ (đ) = (giá hiện tại − giá TB) × KL × 1.000 · Cần KL để tính tiền.</p>

        @if ((Portfolio.ClosedPositions?.Count ?? 0) > 0)
        {
            <div class="broker-sold-panel ts-panel">
                <div class="broker-sold-panel-head">
                    <div class="broker-sold-panel-title">
                        <h3 class="ts-panel-title">@L["Trading_BrokerClosedPanelTitle"]</h3>
                        <span class="broker-sold-panel-count">@Portfolio.ClosedPositions!.Count vị thế · lịch sử giao dịch đã chốt</span>
                    </div>
                    <div class="broker-sold-panel-realized @(_closedRealized >= 0 ? "ts-positive" : "ts-negative")">
                        <span class="broker-sold-panel-realized-label">Tổng realized</span>
                        <span class="broker-sold-panel-realized-value">@BrokerFormat.Vnd(_closedRealized)</span>
                    </div>
                </div>

                <div id="broker-closed-table" class="broker-table-scroll broker-closed-table">
                    <table class="ts-table broker-table">
                        <thead>
                            <tr>
                                <th><span class="broker-dt-th-inner">Mã</span></th>
                                <th><span class="broker-dt-th-inner">@L["Trading_BrokerColSector"]</span></th>
                                <th><span class="broker-dt-th-inner">Lần mua</span></th>
                                <th><span class="broker-dt-th-inner">Lần bán</span></th>
                                <th><span class="broker-dt-th-inner">KL bán</span></th>
                                <th><span class="broker-dt-th-inner">Giá TB</span></th>
                                <th><span class="broker-dt-th-inner">Ngày đóng</span></th>
                                <th><span class="broker-dt-th-inner">Realized</span></th>
                                <th><span class="broker-dt-th-inner">%</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Portfolio.ClosedPositions!
                                                            .OrderByDescending(x => x.ClosedAt ?? DateTime.MinValue)
                                                            .ThenBy(x => x.Symbol, StringComparer.OrdinalIgnoreCase))
                            {
                                var selected = p.Symbol.Equals(SelectedSymbol, StringComparison.OrdinalIgnoreCase);
                                <tr class="@(selected ? "selected" : "")"
                                    role="button"
                                    tabindex="0"
                                    @onclick="() => OnSelectClosed.InvokeAsync(p.Symbol)"
                                    @onkeydown='(e) => OnRowKeydownClosed(e, p.Symbol)'>
                                    <td><span class="broker-symbol">@p.Symbol</span></td>
                                    <td class="broker-sector">@DisplaySector(p.Sector)</td>
                                    <td>@p.Buys.Count</td>
                                    <td>@p.Sells.Count</td>
                                    <td class="broker-num">@BrokerFormat.Quantity(p.SoldQuantity)</td>
                                    <td class="broker-num">@(p.AvgBuy?.ToString("N2") ?? "—")</td>
                                    <td class="broker-num">@(p.ClosedAt?.ToString("dd/MM/yyyy") ?? "—")</td>
                                    <td class="broker-num @(p.RealizedPnl is > 0 ? "ts-positive" : p.RealizedPnl is < 0 ? "ts-negative" : "")">
                                        @BrokerFormat.Vnd(p.RealizedPnl)
                                    </td>
                                    <td class="broker-num @(p.RealizedPnlPct is > 0 ? "ts-positive" : p.RealizedPnlPct is < 0 ? "ts-negative" : "")">
                                        @BrokerFormat.Pct(p.RealizedPnlPct)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="broker-sold-panel-foot">Bấm dòng để xem chi tiết vị thế đã đóng (chỉ đọc). Mua lại cùng mã sẽ tạo position mới trong danh mục khuyến nghị.</p>
            </div>
        }
    }
</div>

@code {
    private enum SortColumn
    {
        Symbol,
        Sector,
        Quantity,
        SoldQty,
        Remaining,
        AvgBuy,
        Current,
        PnlPct,
        PnlAmount,
        Status
    }

    private enum BrokerCol
    {
        Symbol,
        Sector,
        Buys,
        Quantity,
        SoldQty,
        Remaining,
        AvgBuy,
        Current,
        PnlPct,
        PnlAmount,
        Stop,
        Target,
        Tag,
        Status,
        Note,
        Action
    }

    [Parameter] public BrokerPortfolio Portfolio { get; set; } = new();
    [Parameter] public Dictionary<string, decimal> Quotes { get; set; } = new();
    [Parameter] public string? SelectedSymbol { get; set; }
    [Parameter] public bool PriceBusy { get; set; }
    [Parameter] public EventCallback<string> OnSelect { get; set; }
    [Parameter] public EventCallback<string> OnSelectClosed { get; set; }
    [Parameter] public EventCallback<string> OnQuickSell { get; set; }

    private string _search = "";
    private string _tagFilter = "";
    private SortColumn _sortColumn = SortColumn.Symbol;
    private bool _sortDesc;
    private int _page = 1;
    private int _pageSize = 10;
    private bool _colToggleOpen;
    private HashSet<BrokerCol> _hiddenCols = new();

    private const string ColStorageKey = "broker-watchlist-hidden-cols";

    // ponytail: default hidden columns for all viewports — upgrade by adding per-breakpoint defaults
    private static readonly BrokerCol[] DefaultMobileHidden =
    [
        BrokerCol.Stop, BrokerCol.Target, BrokerCol.Note
    ];

    private decimal _closedRealized =>
        (Portfolio.ClosedPositions ?? []).Sum(p => p.RealizedPnl ?? 0m);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var saved = await LocalStorage.GetItemAsync<List<BrokerCol>>(ColStorageKey);
            // #region agent log
            fetch('http://127.0.0.1:7871/ingest/bb30d1f2-958d-4bc3-8a5d-74824153bd63',{method:'POST',headers:{'Content-Type':'application/json','X-Debug-Session-Id':'659b14'},body:JSON.stringify({sessionId:'659b14',location:'BrokerWatchlistTable.razor:OnInitializedAsync',message:'loaded saved cols',data:{savedCount:saved?.Count ?? 0,savedList:saved is null ? 'null' : string.Join(',',saved.Select(c=>c.ToString()))},timestamp:Date.now(),hypothesisId:'H4'})}).catch(()=>{});
            // #endregion
            if (saved is { Count: > 0 })
                _hiddenCols = [.. saved];
            else
                _hiddenCols = [.. DefaultMobileHidden];
        }
        catch
        {
            _hiddenCols = [.. DefaultMobileHidden];
        }
    }

    private bool IsColVisible(BrokerCol col)
    {
        var visible = !_hiddenCols.Contains(col);
        // #region agent log
        fetch('http://127.0.0.1:7871/ingest/bb30d1f2-958d-4bc3-8a5d-74824153bd63',{method:'POST',headers:{'Content-Type':'application/json','X-Debug-Session-Id':'659b14'},body:JSON.stringify({sessionId:'659b14',location:'BrokerWatchlistTable.razor:IsColVisible',message:'col visibility check',data:{col:col.ToString(),visible:visible,hiddenCount:_hiddenCols.Count,hiddenList:string.Join(',',_hiddenCols.Select(c=>c.ToString()))},timestamp:Date.now(),hypothesisId:'H5'})}).catch(()=>{});
        // #endregion
        return visible;
    }

    private string ColClass(BrokerCol col) => IsColVisible(col) ? "" : "broker-col-hidden";

    private string HiddenColClasses()
    {
        var classes = string.Join(" ", _hiddenCols.Select(c => $"hide-col-{c.ToString().ToLowerInvariant()}"));
        // #region agent log
        fetch('http://127.0.0.1:7871/ingest/bb30d1f2-958d-4bc3-8a5d-74824153bd63',{method:'POST',headers:{'Content-Type':'application/json','X-Debug-Session-Id':'659b14'},body:JSON.stringify({sessionId:'659b14',location:'BrokerWatchlistTable.razor:HiddenColClasses',message:'generated hide classes',data:{classes:classes,hiddenCount:_hiddenCols.Count},timestamp:Date.now(),hypothesisId:'H2'})}).catch(()=>{});
        // #endregion
        return classes;
    }

    private async Task ToggleCol(BrokerCol col, object? value)
    {
        // #region agent log
        fetch('http://127.0.0.1:7871/ingest/bb30d1f2-958d-4bc3-8a5d-74824153bd63',{method:'POST',headers:{'Content-Type':'application/json','X-Debug-Session-Id':'659b14'},body:JSON.stringify({sessionId:'659b14',location:'BrokerWatchlistTable.razor:ToggleCol',message:'toggle col entry',data:{col:col.ToString(),valueType:value?.GetType().Name ?? 'null',value:value?.ToString() ?? 'null',hiddenBefore:_hiddenCols.Contains(col)},timestamp:Date.now(),hypothesisId:'H1'})}).catch(()=>{});
        // #endregion
        if (value is bool b && b)
            _hiddenCols.Remove(col);
        else
            _hiddenCols.Add(col);
        // #region agent log
        fetch('http://127.0.0.1:7871/ingest/bb30d1f2-958d-4bc3-8a5d-74824153bd63',{method:'POST',headers:{'Content-Type':'application/json','X-Debug-Session-Id':'659b14'},body:JSON.stringify({sessionId:'659b14',location:'BrokerWatchlistTable.razor:ToggleCol',message:'toggle col exit',data:{col:col.ToString(),hiddenAfter:_hiddenCols.Contains(col),hiddenCount:_hiddenCols.Count},timestamp:Date.now(),hypothesisId:'H1'})}).catch(()=>{});
        // #endregion
        await SaveCols();
    }

    private async Task ResetCols()
    {
        _hiddenCols = [.. DefaultMobileHidden];
        await SaveCols();
    }

    private void ToggleColMenu() => _colToggleOpen = !_colToggleOpen;

    private async Task SaveCols()
    {
        try { await LocalStorage.SetItemAsync(ColStorageKey, _hiddenCols.ToList()); }
        catch { /* localStorage unavailable */ }
    }

    private IReadOnlyList<string> AllTags =>
        (Portfolio.Positions ?? [])
            .SelectMany(p => p.Tags ?? [])
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(t => t, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private decimal? Quote(string symbol) =>
        Quotes.TryGetValue(symbol, out var v) ? v : null;

    private IEnumerable<BrokerPosition> GetFilteredPositions()
    {
        var positions = Portfolio.Positions ?? [];
        IEnumerable<BrokerPosition> result = positions;

        if (!string.IsNullOrWhiteSpace(_search))
        {
            var q = _search.Trim();
            result = result.Where(p => MatchesSearch(p, q));
        }

        if (!string.IsNullOrWhiteSpace(_tagFilter))
        {
            var tf = _tagFilter.Trim();
            result = result.Where(p => p.Tags is not null && p.Tags.Contains(tf, StringComparer.OrdinalIgnoreCase));
        }

        return result;
    }

    private bool MatchesSearch(BrokerPosition p, string q)
    {
        if (p.Symbol.Contains(q, StringComparison.OrdinalIgnoreCase))
            return true;
        if (!string.IsNullOrWhiteSpace(p.Sector) && p.Sector.Contains(q, StringComparison.OrdinalIgnoreCase))
            return true;
        if (L[BrokerStatusLabels.Vi(p.Status)].Value.Contains(q, StringComparison.OrdinalIgnoreCase))
            return true;

        var note = DisplayLatestNote(p);
        if (!note.Equals("—", StringComparison.Ordinal) && note.Contains(q, StringComparison.OrdinalIgnoreCase))
            return true;

        foreach (var lot in p.Buys)
        {
            if (!string.IsNullOrWhiteSpace(lot.Note) && lot.Note.Contains(q, StringComparison.OrdinalIgnoreCase))
                return true;
        }

        return false;
    }

    private IOrderedEnumerable<BrokerPosition> GetSortedPositions(IReadOnlyList<BrokerPosition> rows)
    {
        IEnumerable<BrokerPosition> source = rows;

        return _sortColumn switch
        {
            SortColumn.Sector => OrderBy(source, p => p.Sector ?? "", StringComparer.OrdinalIgnoreCase),
            SortColumn.Quantity => OrderBy(source, p => p.TotalQuantity),
            SortColumn.SoldQty => OrderBy(source, p => p.SoldQuantity),
            SortColumn.Remaining => OrderBy(source, p => p.RemainingQuantity),
            SortColumn.AvgBuy => OrderBy(source, p => p.AvgBuy),
            SortColumn.Current => OrderBy(source, p => Quote(p.Symbol)),
            SortColumn.PnlPct => OrderBy(source, p => p.PnlPct(Quote(p.Symbol))),
            SortColumn.PnlAmount => OrderBy(source, p => p.PnlAmount(Quote(p.Symbol))),
            SortColumn.Status => OrderBy(source, p => (int)p.Status),
            _ => OrderBy(source, p => p.Symbol, StringComparer.OrdinalIgnoreCase)
        };
    }

    private IOrderedEnumerable<BrokerPosition> OrderBy<T>(
        IEnumerable<BrokerPosition> source,
        Func<BrokerPosition, T> key,
        IComparer<T>? comparer = null)
    {
        comparer ??= Comparer<T>.Default;
        return _sortDesc
            ? source.OrderByDescending(key, comparer)
            : source.OrderBy(key, comparer);
    }

    private static List<BrokerPosition> GetPageRows(IEnumerable<BrokerPosition> sorted, int pageSize, int page)
    {
        var list = sorted.ToList();
        if (pageSize <= 0 || pageSize >= list.Count)
            return list;

        var skip = Math.Max(0, (page - 1) * pageSize);
        return list.Skip(skip).Take(pageSize).ToList();
    }

    private string SortAria(SortColumn column)
    {
        if (_sortColumn != column) return "none";
        return _sortDesc ? "descending" : "ascending";
    }

    private void OnSortKeydown(KeyboardEventArgs e, SortColumn column)
    {
        if (e.Key is "Enter" or " ")
            ToggleSort(column);
    }

    private void OnRowKeydown(KeyboardEventArgs e, string symbol)
    {
        if (e.Key is "Enter" or " ")
            _ = OnSelect.InvokeAsync(symbol);
    }

    private void OnRowKeydownClosed(KeyboardEventArgs e, string symbol)
    {
        if (e.Key is "Enter" or " ")
            _ = OnSelectClosed.InvokeAsync(symbol);
    }


    private void ToggleSort(SortColumn column)
    {
        if (_sortColumn == column)
            _sortDesc = !_sortDesc;
        else
        {
            _sortColumn = column;
            _sortDesc = column is SortColumn.PnlPct or SortColumn.PnlAmount or SortColumn.Current;
        }

        ResetPage();
    }

    private string SortClass(SortColumn column) =>
        _sortColumn == column ? "broker-dt-sorted" : "";

    private MarkupString SortIcon(SortColumn column)
    {
        if (_sortColumn != column)
            return new MarkupString("");

        return new MarkupString(_sortDesc
            ? "<span class=\"broker-dt-sort-icon\" aria-hidden=\"true\">▼</span>"
            : "<span class=\"broker-dt-sort-icon\" aria-hidden=\"true\">▲</span>");
    }

    private void ResetPage() => _page = 1;

    private void ClearSearch()
    {
        _search = "";
        ResetPage();
    }

    private void PrevPage()
    {
        if (_page > 1) _page--;
    }

    private void NextPage() => _page++;

    private static string DisplaySector(string sector) =>
        string.IsNullOrWhiteSpace(sector) ? "—" : sector;

    private static string LotLabel(BrokerLot lot, int index)
    {
        var price = lot.Price.ToString("N2");
        return lot.Quantity is > 0
            ? $"L{index} {price} ×{BrokerFormat.Quantity(lot.Quantity)}"
            : $"L{index} {price}";
    }

    private static string LotTitle(BrokerLot lot)
    {
        var parts = new List<string> { lot.BoughtAt.ToString("d"), $"@{lot.Price:N2}" };
        if (lot.Quantity is > 0) parts.Add($"KL {BrokerFormat.Quantity(lot.Quantity)}");
        if (lot.StopLoss is > 0) parts.Add($"SL {lot.StopLoss:N2}");
        if (lot.TargetPrice is > 0) parts.Add($"TP {lot.TargetPrice:N2}");
        if (!string.IsNullOrWhiteSpace(lot.Note)) parts.Add(lot.Note);
        return string.Join(" · ", parts);
    }

    private static string DisplayLatestNote(BrokerPosition p)
    {
        var lotNote = p.Buys.OrderByDescending(b => b.BoughtAt).FirstOrDefault(b => !string.IsNullOrWhiteSpace(b.Note))?.Note;
        var timeline = p.LatestNote?.Text;
        var text = lotNote ?? timeline;
        return string.IsNullOrWhiteSpace(text) ? "—" : TextUtils.Truncate(text, 48);
    }
}
