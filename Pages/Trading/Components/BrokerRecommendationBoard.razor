@using BlazorWasmPortfolioGhAction.Utils
@inject IStringLocalizer<SharedResources> L

@{
    var recs = GetRecommendations();
}

@if (recs.Count > 0)
{
    <div class="ts-panel broker-rec-board">
        <div class="broker-rec-head">
            <div>
                <h2 class="ts-panel-title">@L["Trading_BrokerRec_Title"]</h2>
                <span class="broker-rec-sub">@L["Trading_BrokerRec_Count", recs.Count]</span>
            </div>
            <div class="broker-rec-filter-bar">
                <label class="broker-dt-label" for="rec-filter">@L["Trading_BrokerRec_Filter"]</label>
                <select id="rec-filter" class="ts-select" @bind="_filter">
                    <option value="all">@L["Trading_Filter_All"]</option>
                    <option value="cho-mua">@L["Trading_BrokerRec_WaitBuy"]</option>
                    <option value="bo-theo-doi">@L["Trading_BrokerRec_Dropped"]</option>
                </select>
            </div>
        </div>

        <div class="broker-rec-table-scroll">
            <table class="ts-table broker-rec-table">
                <thead>
                    <tr>
                        <th class="broker-dt-sortable @SortClass(SortColumn.Symbol)"
                            tabindex="0"
                            aria-sort="@SortAria(SortColumn.Symbol)"
                            @onclick='() => ToggleSort(SortColumn.Symbol)'
                            @onkeydown='(e) => OnSortKeydown(e, SortColumn.Symbol)'
                            @onclick:stopPropagation="true">
                            <span class="broker-dt-th-inner">@L["Trading_Tcbs_Symbol"] @SortIcon(SortColumn.Symbol)</span>
                        </th>
                        <th class="broker-dt-sortable @SortClass(SortColumn.Sector)"
                            tabindex="0"
                            aria-sort="@SortAria(SortColumn.Sector)"
                            @onclick='() => ToggleSort(SortColumn.Sector)'
                            @onkeydown='(e) => OnSortKeydown(e, SortColumn.Sector)'
                            @onclick:stopPropagation="true">
                            <span class="broker-dt-th-inner">@L["Trading_BrokerColSector"] @SortIcon(SortColumn.Sector)</span>
                        </th>
                        <th class="broker-dt-sortable @SortClass(SortColumn.Zone)"
                            tabindex="0"
                            aria-sort="@SortAria(SortColumn.Zone)"
                            @onclick='() => ToggleSort(SortColumn.Zone)'
                            @onkeydown='(e) => OnSortKeydown(e, SortColumn.Zone)'
                            @onclick:stopPropagation="true">
                            <span class="broker-dt-th-inner">@L["Trading_BrokerRec_Zone"] @SortIcon(SortColumn.Zone)</span>
                        </th>
                        <th class="broker-num broker-dt-sortable @SortClass(SortColumn.Stop)"
                            tabindex="0"
                            aria-sort="@SortAria(SortColumn.Stop)"
                            @onclick='() => ToggleSort(SortColumn.Stop)'
                            @onkeydown='(e) => OnSortKeydown(e, SortColumn.Stop)'
                            @onclick:stopPropagation="true">
                            <span class="broker-dt-th-inner">@L["Trading_BrokerRec_Stop"] @SortIcon(SortColumn.Stop)</span>
                        </th>
                        <th class="broker-num broker-dt-sortable @SortClass(SortColumn.Target)"
                            tabindex="0"
                            aria-sort="@SortAria(SortColumn.Target)"
                            @onclick='() => ToggleSort(SortColumn.Target)'
                            @onkeydown='(e) => OnSortKeydown(e, SortColumn.Target)'
                            @onclick:stopPropagation="true">
                            <span class="broker-dt-th-inner">@L["Trading_BrokerRec_Target"] @SortIcon(SortColumn.Target)</span>
                        </th>
                        <th><span class="broker-dt-th-inner">@L["Trading_BrokerNote"]</span></th>
                        <th class="broker-dt-sortable @SortClass(SortColumn.Status)"
                            tabindex="0"
                            aria-sort="@SortAria(SortColumn.Status)"
                            @onclick='() => ToggleSort(SortColumn.Status)'
                            @onkeydown='(e) => OnSortKeydown(e, SortColumn.Status)'
                            @onclick:stopPropagation="true">
                            <span class="broker-dt-th-inner">@L["Trading_BrokerRec_Status"] @SortIcon(SortColumn.Status)</span>
                        </th>
                        <th class="broker-rec-table-actions"><span class="broker-dt-th-inner">@L["Trading_BrokerRec_Action"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in recs)
                    {
                        <tr class="broker-rec-row broker-rec-status-@r.StatusBadge" @onclick="() => OnSelect.InvokeAsync(r.Symbol)" style="cursor: pointer;">
                            <td><span class="broker-symbol">@r.Symbol</span></td>
                            <td>@(string.IsNullOrWhiteSpace(r.Sector) ? "—" : r.Sector)</td>
                            <td>
                                @if (r.EntryLow is > 0 || r.EntryHigh is > 0)
                                {
                                    @(r.EntryLow is > 0 ? r.EntryLow.Value.ToString("N2") : "—")
                                    @if (r.EntryHigh is > 0 && r.EntryHigh != r.EntryLow)
                                    {
                                        <span> – @r.EntryHigh.Value.ToString("N2")</span>
                                    }
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                            <td>@(r.StopLoss is > 0 ? r.StopLoss.Value.ToString("N2") : "—")</td>
                            <td>@(r.TargetPrice is > 0 ? r.TargetPrice.Value.ToString("N2") : "—")</td>
                            <td class="broker-rec-note">
                                @if (!string.IsNullOrWhiteSpace(r.RecommendationText))
                                {
                                    <span class="broker-rec-text-preview" title="@r.RecommendationText">
                                        @if (r.RecommendationText.Length > 30)
                                        {
                                            @r.RecommendationText.Substring(0, 30)@("…")
                                        }
                                        else
                                        {
                                            @r.RecommendationText
                                        }
                                    </span>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                            <td><span class="broker-status-pill broker-status-@r.StatusBadge">@L[BrokerStatusLabels.Vi(r.StatusBadge)].Value</span></td>
                            <td class="broker-rec-table-actions" @onclick:stopPropagation="true">
                                @if (r.StatusBadge != BrokerPositionStatus.BoTheoDoi)
                                {
                                    <button type="button" class="ts-btn ts-btn-primary ts-btn-xs"
                                            @onclick="() => OnBuy.InvokeAsync(r.Symbol)" title="@L["Trading_BrokerRec_Buy"]">@L["Trading_BrokerRec_Buy"]</button>
                                    <button type="button" class="ts-btn ts-btn-outline ts-btn-xs"
                                            @onclick="() => OnPlaceOrder.InvokeAsync(r.Symbol)">@L["Trading_BrokerRec_Place"]</button>
                                    <button type="button" class="ts-btn ts-btn-outline ts-btn-xs broker-btn-danger"
                                            @onclick="() => OnDrop.InvokeAsync(r.Symbol)" title="@L["Trading_BrokerRec_Dropped"]">@L["Trading_BrokerRec_Drop"]</button>
                                }
                                else
                                {
                                    <button type="button" class="ts-btn ts-btn-outline ts-btn-xs"
                                            @onclick="() => OnReactivate.InvokeAsync(r.Symbol)" title="@L["Trading_BrokerRec_Reactivate"]">@L["Trading_BrokerRec_Reactivate"]</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public BrokerPortfolio Portfolio { get; set; } = new();
    [Parameter] public EventCallback<string> OnBuy { get; set; }
    [Parameter] public EventCallback<string> OnPlaceOrder { get; set; }
    [Parameter] public EventCallback<string> OnSelect { get; set; }
    [Parameter] public EventCallback<string> OnDrop { get; set; }
    [Parameter] public EventCallback<string> OnReactivate { get; set; }

    private string _filter = "all";
    private SortColumn _sortColumn = SortColumn.Symbol;
    private bool _sortDesc;

    private enum SortColumn
    {
        Symbol,
        Sector,
        Zone,
        Stop,
        Target,
        Status
    }

    private string SortClass(SortColumn column) =>
        _sortColumn == column ? "broker-dt-sorted" : "";

    private string SortAria(SortColumn column)
    {
        if (_sortColumn != column) return "none";
        return _sortDesc ? "descending" : "ascending";
    }

    private MarkupString SortIcon(SortColumn column)
    {
        if (_sortColumn != column)
            return new MarkupString("");

        return new MarkupString(_sortDesc
            ? "<span class=\"broker-dt-sort-icon\" aria-hidden=\"true\">▼</span>"
            : "<span class=\"broker-dt-sort-icon\" aria-hidden=\"true\">▲</span>");
    }

    private void OnSortKeydown(KeyboardEventArgs e, SortColumn column)
    {
        if (e.Key is "Enter" or " ")
            ToggleSort(column);
    }

    private void ToggleSort(SortColumn column)
    {
        if (_sortColumn == column)
            _sortDesc = !_sortDesc;
        else
        {
            _sortColumn = column;
            _sortDesc = false;
        }
    }

    private IOrderedEnumerable<RecEntry> SortDecimal(
        List<RecEntry> entries, Func<RecEntry, decimal?> key)
    {
        static decimal SortKey(RecEntry r, Func<RecEntry, decimal?> k, bool desc) =>
            k(r) is { } v && v > 0 ? v : (desc ? decimal.MinValue : decimal.MaxValue);

        return _sortDesc
            ? entries.OrderByDescending(r => SortKey(r, key, true))
            : entries.OrderBy(r => SortKey(r, key, false));
    }

    private record RecEntry(
        string Symbol,
        string Sector,
        BrokerPositionStatus StatusBadge,
        decimal? EntryLow,
        decimal? EntryHigh,
        decimal? StopLoss,
        decimal? TargetPrice,
        string? RecommendationText);

    private List<RecEntry> GetRecommendations()
    {
        var positions = Portfolio.Positions ?? [];

        IEnumerable<BrokerPosition> filtered = _filter switch
        {
            "cho-mua" => positions.Where(p => p.Status == BrokerPositionStatus.ChoMua),
            "bo-theo-doi" => positions.Where(p => p.Status == BrokerPositionStatus.BoTheoDoi),
            _ => positions.Where(p => p.Status != BrokerPositionStatus.DaDong
                                   && (p.Status == BrokerPositionStatus.ChoMua
                                       || p.Status == BrokerPositionStatus.BoTheoDoi
                                       || !string.IsNullOrWhiteSpace(p.RecommendationText)))
        };

        var entries = filtered
            .Select(p => new RecEntry(
                p.Symbol,
                p.Sector,
                p.Status,
                p.EntryLow,
                p.EntryHigh,
                p.StopLoss,
                p.TargetPrice,
                p.RecommendationText))
            .ToList();

        IOrderedEnumerable<RecEntry> ordered = _sortColumn switch
        {
            SortColumn.Sector => _sortDesc
                ? entries.OrderByDescending(r => r.Sector ?? "", StringComparer.OrdinalIgnoreCase)
                : entries.OrderBy(r => r.Sector ?? "", StringComparer.OrdinalIgnoreCase),
            SortColumn.Zone => SortDecimal(entries, r => r.EntryLow),
            SortColumn.Stop => SortDecimal(entries, r => r.StopLoss),
            SortColumn.Target => SortDecimal(entries, r => r.TargetPrice),
            SortColumn.Status => _sortDesc
                ? entries.OrderByDescending(r => (int)r.StatusBadge)
                : entries.OrderBy(r => (int)r.StatusBadge),
            _ => _sortDesc
                ? entries.OrderByDescending(r => r.Symbol, StringComparer.OrdinalIgnoreCase)
                : entries.OrderBy(r => r.Symbol, StringComparer.OrdinalIgnoreCase)
        };

        return ordered.ToList();
    }
}