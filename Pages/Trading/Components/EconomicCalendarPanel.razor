@using BlazorWasmPortfolioGhAction.Models.Trading
@using System.Text.Json
@inject ITradingApiClient Api

<div class="ts-panel">
    <div class="ts-header">
        <h3 style="margin:0">Economic Calendar (This Week)</h3>
        <button class="ts-btn ts-btn-outline" @onclick="Load" disabled="@_loading">Refresh</button>
    </div>
    @if (_loading) { <div class="ts-spinner"></div> }
    else if (_events.Count > 0)
    {
        <div class="ts-table-wrap" style="max-height:400px;overflow:auto">
            <table class="ts-table">
                <thead><tr><th>Time</th><th>Country</th><th>Event</th><th>Impact</th><th>Actual</th><th>Forecast</th></tr></thead>
                <tbody>
                    @foreach (var e in _events)
                    {
                        <tr>
                            <td>@(e.DateTime?.ToLocalTime().ToString("ddd HH:mm") ?? "—")</td>
                            <td>@e.Country</td>
                            <td><strong>@e.Title</strong></td>
                            <td><span class="ts-signal ts-signal-@ImpactClass(e.Impact)">@e.Impact</span></td>
                            <td>@e.Actual</td>
                            <td>@e.Forecast</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else { <p class="ts-updated">No calendar data.</p> }
</div>

@code {
    private List<CalendarEvent> _events = [];
    private bool _loading;

    protected override void OnInitialized() => _ = Load();

    private async Task Load()
    {
        _loading = true;
        await InvokeAsync(StateHasChanged);
        _events.Clear();
        try
        {
            var json = await Api.GetCalendarAsync();
            if (json.HasValue) Parse(json.Value);
        }
        catch { }
        _loading = false;
        await InvokeAsync(StateHasChanged);
    }

    private void Parse(JsonElement root)
    {
        IEnumerable<JsonElement> items = root.ValueKind == JsonValueKind.Array
            ? root.EnumerateArray()
            : root.TryGetProperty("events", out var ev) ? ev.EnumerateArray()
            : root.TryGetProperty("data", out var d) && d.ValueKind == JsonValueKind.Array ? d.EnumerateArray() : [];

        foreach (var el in items)
        {
            _events.Add(new CalendarEvent(
                el.TryGetProperty("title", out var t) ? t.GetString() : el.TryGetProperty("event", out var ev2) ? ev2.GetString() : null,
                el.TryGetProperty("country", out var co) ? co.GetString() : null,
                el.TryGetProperty("currency", out var cu) ? cu.GetString() : null,
                el.TryGetProperty("impact", out var im) ? im.GetString() : null,
                el.TryGetProperty("actual", out var ac) ? ac.ToString() : null,
                el.TryGetProperty("forecast", out var fo) ? fo.ToString() : null,
                el.TryGetProperty("previous", out var pr) ? pr.ToString() : null,
                TryDate(el)));
        }
    }

    private static DateTime? TryDate(JsonElement el)
    {
        foreach (var key in new[] { "date", "datetime", "time", "timestamp" })
        {
            if (!el.TryGetProperty(key, out var d)) continue;
            if (d.ValueKind == JsonValueKind.String && DateTime.TryParse(d.GetString(), out var dt)) return dt;
            if (d.TryGetInt64(out var unix)) return DateTimeOffset.FromUnixTimeSeconds(unix).UtcDateTime;
        }
        return null;
    }

    private static string ImpactClass(string? impact) => impact?.ToLowerInvariant() switch
    {
        "high" or "red" => "near_ath",
        "medium" or "orange" => "near_52w_ath",
        _ => "ema9_above_ema21"
    };
}
