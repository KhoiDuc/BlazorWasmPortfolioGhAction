@inject IStringLocalizer<SharedResources> L
@inject IJSRuntime JS

@if (_show)
{
    <div class="broker-qs-overlay" @onclick="Close" @onkeydown="OnOverlayKeydown"
         role="dialog" aria-modal="true" aria-labelledby="broker-qs-title">
        <div class="broker-qs-modal" @onclick:stopPropagation="true">
            <div class="broker-qs-head">
                <h2 id="broker-qs-title" class="ts-panel-title">@L["Trading_BrokerQuickSell_Title", Position?.Symbol]</h2>
                <button type="button" class="broker-lot-remove broker-qs-close" aria-label="@L["Trading_BrokerClose"]" @onclick="Close">×</button>
            </div>

            @if (Position is not null)
            {
                <div class="broker-qs-summary">
                    <span>@L["Trading_BrokerDetail_KpiRemaining"]: <strong>@BrokerFormat.Quantity(Position.RemainingQuantity)</strong></span>
                    <span>@L["Trading_BrokerQuickSell_Sellable"]: <strong>@BrokerFormat.Quantity(Position.SellableQuantity)</strong></span>
                    @if (Position.PendingQuantity > 0)
                    {
                        <span>@L["Trading_BrokerQuickSell_Pending"]: <strong>@BrokerFormat.Quantity(Position.PendingQuantity)</strong></span>
                    }
                    @if (CurrentPrice is not null)
                    {
                        <span>@L["Trading_BrokerDetail_KpiCurrent"]: <strong>@CurrentPrice.Value.ToString("N2")</strong></span>
                    }
                </div>

                <div class="broker-qs-form">
                    <div class="broker-form-row broker-form-row-2 broker-form-row-align">
                        <div class="broker-field">
                            <label class="broker-field-label" for="qs-price">@L["Trading_BrokerDetail_SellPrice"]</label>
                            <input id="qs-price" class="ts-input @(_err is not null ? "ts-input-invalid" : "")"
                                   type="number" min="0.0001" step="any" placeholder="60.5"
                                   @bind="_price" @bind:after='() => _err = null' />
                        </div>
                        <div class="broker-field">
                            <label class="broker-field-label" for="qs-qty">@L["Trading_BrokerDetail_SellQty"]</label>
                            <input id="qs-qty" class="ts-input @(_err is not null ? "ts-input-invalid" : "")"
                                   type="number" min="0.0001" step="any"
                                   placeholder="@BrokerFormat.Quantity(Position.RemainingQuantity)"
                                   @bind="_qty" @bind:after='() => _err = null' />
                        </div>
                    </div>
                    <div class="broker-form-row broker-form-row-2 broker-form-row-align">
                        <div class="broker-field">
                            <label class="broker-field-label" for="qs-date">@L["Trading_BrokerDetail_SellDate"]</label>
                            <input id="qs-date" class="ts-input" type="date" @bind="_date" @bind:format="yyyy-MM-dd" />
                        </div>
                        <div class="broker-field">
                            <label class="broker-field-label" for="qs-note">@L["Trading_BrokerNote"]</label>
                            <input id="qs-note" class="ts-input" maxlength="@BrokerInputValidation.NoteMaxLen"
                                   placeholder="@L["Trading_BrokerDetail_SellNotePlaceholder"]" @bind="_note" />
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(_err))
                    {
                        <p class="ts-field-error">@_err</p>
                    }
                    <div class="broker-qs-actions">
                        <button class="ts-btn ts-btn-outline ts-btn-sm" type="button" @onclick="Close">@L["Trading_BrokerCancel"]</button>
                        <button class="ts-btn ts-btn-primary ts-btn-sm" type="button" @onclick="Submit">@L["Trading_BrokerDetail_SellAddBtn"]</button>
                        <button class="ts-btn ts-btn-outline ts-btn-sm" type="button" @onclick="PlaceTcbs">@L["Trading_BrokerQuickSell_PlaceTcbs"]</button>
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public BrokerPosition? Position { get; set; }
    [Parameter] public decimal? CurrentPrice { get; set; }
    [Parameter] public EventCallback<BrokerSell> OnSubmitSell { get; set; }
    [Parameter] public EventCallback<BrokerPosition> OnPlaceOrder { get; set; }

    private bool _show;
    private decimal? _price;
    private decimal? _qty;
    private DateTime _date = DateTime.Today;
    private string _note = "";
    private string? _err;

    public async Task Open(BrokerPosition position, decimal? currentPrice)
    {
        Position = position;
        CurrentPrice = currentPrice;
        _price = currentPrice;
        _qty = position.SellableQuantity;
        _date = DateTime.Today;
        _note = "";
        _err = null;
        _show = true;
        await InvokeAsync(StateHasChanged);
        try { await JS.InvokeVoidAsync("tradingAuth.trapFocus", ".broker-qs-overlay"); }
        catch { /* JS not ready */ }
    }

    public async Task Close()
    {
        _show = false;
        try { await JS.InvokeVoidAsync("tradingAuth.releaseFocus"); }
        catch { /* JS not ready */ }
    }

    private async Task OnOverlayKeydown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await Close();
    }

    private async Task Submit()
    {
        _err = null;

        if (Position is null) return;
        if (_price is not > 0)
        {
            _err = L["Trading_BrokerDetail_ValSellPrice"];
            return;
        }
        if (_qty is not > 0)
        {
            _err = L["Trading_BrokerDetail_ValSellQty"];
            return;
        }

        var remaining = Position.RemainingQuantity ?? 0m;
        var sellable = Position.SellableQuantity;
        if (_qty.Value > remaining)
        {
            _err = L["Trading_BrokerDetail_ValSellQtyExceed", BrokerFormat.Quantity(remaining)];
            return;
        }
        if (_qty.Value > sellable)
        {
            _err = L["Trading_BrokerDetail_ValSellQtyT2", BrokerFormat.Quantity(sellable), BrokerFormat.Quantity(Position.PendingQuantity)];
            return;
        }

        var sell = new BrokerSell
        {
            SoldAt = _date,
            Price = _price!.Value,
            Quantity = _qty,
            Note = string.IsNullOrWhiteSpace(_note) ? null : _note.Trim()
        };

        await Close();
        await OnSubmitSell.InvokeAsync(sell);
    }

    private async Task PlaceTcbs()
    {
        if (Position is null) return;
        var pos = Position;
        await Close();
        await OnPlaceOrder.InvokeAsync(pos);
    }
}