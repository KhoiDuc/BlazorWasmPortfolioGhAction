@page "/trading/portfolio"
@layout TradingLayout
@using BlazorWasmPortfolioGhAction.Models.Trading
@using System.Text.Json
@inject ITradingApiClient Api
@inject ITradingAuthService Auth
@inject NavigationManager Nav

<div class="ts-page">
    @if (!_authorized)
    {
        <div class="ts-panel ts-alert ts-alert-info">
            Please <NavLink href="trading/login">login</NavLink> to view your portfolio.
        </div>
    }
    else
    {
        <div class="ts-panel">
            <div class="ts-header">
                <div><h2>My Portfolio</h2><p>Balance, journal, deals &amp; orders</p></div>
            </div>
            <div class="ts-tabs">
                <button class="ts-tab @(_tab == "balance" ? "active" : "")" @onclick='() => _tab = "balance"'>Balance</button>
                <button class="ts-tab @(_tab == "journal" ? "active" : "")" @onclick='() => _tab = "journal"'>Journal</button>
                <button class="ts-tab @(_tab == "deals" ? "active" : "")" @onclick='() => _tab = "deals"'>Deals</button>
                <button class="ts-tab @(_tab == "orders" ? "active" : "")" @onclick='() => _tab = "orders"'>Place Order</button>
            </div>
        </div>

        @if (_tab == "balance")
        {
            @if (!string.IsNullOrEmpty(_error)) { <div class="ts-alert ts-alert-error">@_error</div> }
            @if (_loading) { <div class="ts-spinner"></div> }
            else if (_balanceJson is not null)
            {
                <div class="ts-panel"><pre style="font-size:0.82rem;overflow:auto">@_balanceJson</pre></div>
            }
            else if (_isDemo)
            {
                <div class="ts-panel">
                    <h3>Demo Portfolio</h3>
                    <p>Net Asset Value: <strong>1,250,000,000 VND</strong></p>
                    <p>Cash: 350,000,000 VND | Stocks: 900,000,000 VND</p>
                </div>
            }
            else { <p class="ts-empty">Connect DNSE account to view balances.</p> }
        }
        else if (_tab == "journal")
        {
            <JournalComponent UserId="@(_userId ?? "")" />
        }
        else if (_tab == "deals")
        {
            @if (_dealsJson.HasValue)
            {
                <div class="ts-panel"><pre style="font-size:0.82rem;overflow:auto">@_dealsJson.Value.ToString()</pre></div>
            }
            else { <p class="ts-empty">No deals data.</p> }
        }
        else
        {
            <div class="ts-panel">
                <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:8px">
                    <input class="ts-input" @bind="_orderSymbol" placeholder="Symbol (VNM)" />
                    <input type="number" class="ts-input" @bind="_orderQty" placeholder="Quantity" />
                    <input type="number" class="ts-input" @bind="_orderPrice" placeholder="Price" step="any" />
                    <select class="ts-select" @bind="_orderSide">
                        <option value="NB">Buy</option>
                        <option value="NS">Sell</option>
                    </select>
                    <button class="ts-btn ts-btn-primary" @onclick="PlaceOrder" disabled="@_orderBusy">Submit</button>
                </div>
                @if (!string.IsNullOrEmpty(_orderMsg))
                {
                    <p class="ts-alert ts-alert-info mt-2">@_orderMsg</p>
                }
                @if (_showOtp)
                {
                    <div class="ts-field mt-3">
                        <label class="ts-label">OTP confirmation</label>
                        <div style="display:flex;gap:8px">
                            <input class="ts-input" @bind="_otp" placeholder="Enter OTP" />
                            <button class="ts-btn ts-btn-primary" @onclick="ConfirmOtp">Confirm</button>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private bool _authorized;
    private bool _loading;
    private bool _isDemo;
    private string? _userId;
    private string _tab = "balance";
    private string? _error;
    private string? _balanceJson;
    private JsonElement? _dealsJson;
    private string _orderSymbol = "VNM";
    private int _orderQty = 100;
    private double _orderPrice;
    private string _orderSide = "NB";
    private bool _orderBusy;
    private bool _showOtp;
    private string _otp = "";
    private string? _orderSessionId;
    private string? _orderMsg;

    protected override void OnInitialized() => _ = InitAsync();

    private async Task InitAsync()
    {
        try { _authorized = await Auth.IsLoggedInAsync(); } catch { }
        if (!_authorized) { await InvokeAsync(StateHasChanged); return; }
        _userId = await Auth.GetUserIdAsync();
        _isDemo = await Auth.GetTokenAsync() == "demo-token";
        await InvokeAsync(StateHasChanged);
        if (!_isDemo) _ = LoadDnseDataAsync();
    }

    private async Task LoadDnseDataAsync()
    {
        _loading = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var client = await Api.CreateAuthorizedClientAsync();
            var accResp = await client.GetAsync(Api.ProxyUrl("dnse-order-service/accounts"));
            if (accResp.IsSuccessStatusCode)
                _balanceJson = await accResp.Content.ReadAsStringAsync();
            else _error = "Could not load DNSE accounts.";
            _dealsJson = await Api.GetDnseDealsAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; await InvokeAsync(StateHasChanged); }
    }

    private async Task PlaceOrder()
    {
        if (_isDemo) { _orderMsg = "Demo mode — order simulated."; return; }
        _orderBusy = true;
        _orderMsg = null;
        var result = await Api.PlaceDnseOrderAsync(new DnseOrderRequest(_orderSymbol, _orderQty, _orderPrice, _orderSide));
        if (result.HasValue)
        {
            if (result.Value.TryGetProperty("session_id", out var sid))
                _orderSessionId = sid.GetString();
            if (result.Value.TryGetProperty("require_otp", out var otp) && otp.GetBoolean())
                _showOtp = true;
            _orderMsg = result.Value.ToString();
        }
        else _orderMsg = "Order failed.";
        _orderBusy = false;
    }

    private async Task ConfirmOtp()
    {
        var result = await Api.ConfirmDnseOtpAsync(_otp, _orderSessionId);
        _orderMsg = result?.ToString() ?? "OTP confirmed or failed.";
        _showOtp = false;
        await LoadDnseDataAsync();
    }
}
