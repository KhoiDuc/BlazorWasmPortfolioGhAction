@page "/trading/stock"
@page "/{lang:regex(^(en|vn)$)}/trading/stock"
@layout TradingLayout
@inherits CultureAwareComponent
@using BlazorWasmPortfolioGhAction.Models.Trading
@using BlazorWasmPortfolioGhAction.Services.Trading
@using System.Text.Json
@inject ITradingApiClient Api
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResources> L

<div class="ts-page">
    <div class="ts-panel">
        <div class="ts-header">
            <div>
                <h2>@L["Trading_StockTitle"]</h2>
                <p>@L["Trading_StockLead"]</p>
            </div>
        </div>
        <div class="ts-field">
            <label for="stock-symbol" class="ts-label">@L["Trading_StockChooseSymbol"]</label>
            <div class="ts-stock-select" style="max-width:320px">
                <input id="stock-symbol" class="ts-input ts-stock-select__input"
                       @bind="_searchText" @bind:event="oninput"
                       @onfocus="OpenDropdown"
                       @onblur="CloseDropdownDelayed"
                       @onkeydown="OnKeydown"
                       placeholder="VNM, FPT, VNINDEX..." autocomplete="off"
                       role="combobox" aria-expanded="@_dropdownOpen.ToString().ToLowerInvariant()"
                       aria-controls="stock-select-list" aria-autocomplete="list" />
                @if (_dropdownOpen && _filteredCodes.Count > 0)
                {
                    <ul id="stock-select-list" class="ts-stock-dropdown" role="listbox">
                        @foreach (var pair in _filteredCodes.Select((c, i) => (Symbol: c, Index: i)))
                        {
                            <li role="option" aria-selected="@(_highlightIndex == pair.Index)"
                               class="@(_highlightIndex == pair.Index ? "ts-stock-dropdown__item--active" : "")"
                               @onmousedown="() => SelectCode(pair.Symbol)">
                                @pair.Symbol
                            </li>
                        }
                    </ul>
                }
            </div>
            @if (_loadingCodes)
            {
                <p class="ts-muted" style="margin:0.35rem 0 0;font-size:0.82rem" role="status">@L["Trading_StockLoadingCodes"]</p>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_selectedStock))
    {
        <TradingViewChart Symbol="@_selectedStock" />
        <div class="ts-stock-actions">
            <button type="button" class="ts-btn ts-btn-outline" @onclick="() => _showPriceAlert = !_showPriceAlert"
                    aria-expanded="@_showPriceAlert.ToString().ToLowerInvariant()" aria-controls="stock-price-alert">
                <i class="bi bi-bell" aria-hidden="true"></i> @L["Trading_StockPriceAlert"]
            </button>
            <button type="button" class="ts-btn ts-btn-outline" @onclick="ViewChart">
                <i class="bi bi-graph-up" aria-hidden="true"></i> @L["Trading_StockViewChart"]
            </button>
        </div>
        @if (_showPriceAlert)
        {
            <div id="stock-price-alert">
                <PriceAlertWidget Symbol="@_selectedStock" AssetType="stock" />
            </div>
        }
    }
</div>

@code {
    private string _selectedStock = "VNM";
    private string _searchText = "VNM";
    private List<string> _stockCodes = [];
    private List<string> _filteredCodes = [];
    private bool _loadingCodes;
    private bool _showPriceAlert;
    private bool _dropdownOpen;
    private int _highlightIndex = -1;

    protected override void OnInitialized() => _ = LoadStockCodesAsync();

    private void OpenDropdown()
    {
        _dropdownOpen = true;
        FilterCodes();
    }

    private async Task CloseDropdownDelayed()
    {
        await Task.Delay(150);
        _dropdownOpen = false;
        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            var upper = _searchText.Trim().ToUpperInvariant();
            if (_stockCodes.Contains(upper, StringComparer.OrdinalIgnoreCase))
            {
                _selectedStock = upper;
                _searchText = upper;
            }
        }
        await InvokeAsync(StateHasChanged);
    }

    private void FilterCodes()
    {
        if (_stockCodes.Count == 0) { _filteredCodes = []; return; }
        var q = _searchText.Trim();
        _filteredCodes = (string.IsNullOrWhiteSpace(q)
            ? _stockCodes
            : _stockCodes.Where(c => c.Contains(q, StringComparison.OrdinalIgnoreCase)))
            .Take(100)
            .ToList();
        _highlightIndex = -1;
    }

    private void SelectCode(string code)
    {
        _selectedStock = code.ToUpperInvariant();
        _searchText = _selectedStock;
        _dropdownOpen = false;
    }

    private void OnKeydown(KeyboardEventArgs e)
    {
        if (!_dropdownOpen || _filteredCodes.Count == 0) return;
        switch (e.Key)
        {
            case "ArrowDown":
                _highlightIndex = Math.Min(_highlightIndex + 1, _filteredCodes.Count - 1);
                break;
            case "ArrowUp":
                _highlightIndex = Math.Max(_highlightIndex - 1, 0);
                break;
            case "Enter":
                if (_highlightIndex >= 0 && _highlightIndex < _filteredCodes.Count)
                    SelectCode(_filteredCodes[_highlightIndex]);
                else if (_filteredCodes.Count > 0)
                    SelectCode(_filteredCodes[0]);
                break;
            case "Escape":
                _dropdownOpen = false;
                break;
        }
    }

    private async Task LoadStockCodesAsync()
    {
        _loadingCodes = true;
        try
        {
            var json = await Api.GetProxyJsonAsync("v4/stocks?q=type:STOCK~status:LISTED&fields=code&size=3000");
            if (json is not null && json.Value.TryGetProperty("data", out var data) && data.ValueKind == JsonValueKind.Array)
            {
                _stockCodes = data.EnumerateArray()
                    .Select(e => e.TryGetProperty("code", out var c) ? c.GetString() : null)
                    .Where(c => !string.IsNullOrWhiteSpace(c))
                    .Select(c => c!)
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .OrderBy(c => c, StringComparer.OrdinalIgnoreCase)
                    .ToList();
            }
        }
        catch { }
        finally
        {
            _loadingCodes = false;
            FilterCodes();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ViewChart()
    {
        if (string.IsNullOrWhiteSpace(_selectedStock)) return;
        await JS.InvokeVoidAsync("open", $"https://stockchart.vietstock.vn/?stockcode={_selectedStock}", "_blank");
    }
}