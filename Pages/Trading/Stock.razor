@page "/trading/stock"
@page "/{lang:regex(^(en|vn)$)}/trading/stock"
@inject NavigationManager Nav
@inject ICultureService CultureService

@code {
    [Parameter] public string? Lang { get; set; }

    protected override void OnInitialized()
    {
        var prefix = Lang ?? CultureService.UrlLang;
        Nav.NavigateTo($"{prefix}/trading/vndesk?group=vn&tab=analyze", replace: true);
    }
}
