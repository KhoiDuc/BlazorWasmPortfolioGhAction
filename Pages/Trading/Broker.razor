@page "/trading/broker"
@page "/{lang:regex(^(en|vn)$)}/trading/broker"
@layout TradingLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Broker")]
@inherits CultureAwareComponent
@implements IDisposable
@inject IBrokerDeskStore Store
@inject IVnMarketClient Market
@inject VnSectorService Sectors
@inject MoneyFlowScanService MoneyFlowScan
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResources> L
@using BlazorWasmPortfolioGhAction.Models.Trading.VnDesk
@using Microsoft.AspNetCore.WebUtilities

<div class="ts-page broker-page">
    <div class="ts-panel broker-hero">
        <div class="broker-hero-text">
            <h1>@L["TradingNav_Broker"]</h1>
            <p>@L["Trading_BrokerLead"]</p>
        </div>
        <div class="broker-header-actions">
            <button class="ts-btn ts-btn-outline ts-btn-sm" @onclick="RefreshAllPrices" disabled="@_priceBusy">
                @( _priceBusy ? L["Trading_RefreshingPrices"] : L["Trading_RefreshPrices"] )
            </button>
            @if (_priceUpdatedAt is not null)
            {
                <span class="broker-price-updated">@L["Trading_BrokerPriceUpdated", _priceUpdatedAt.Value.ToString("HH:mm:ss")]</span>
            }
            @if (_priceBusy && _priceProgressTotal > 0)
            {
                <span class="broker-price-progress" role="status">@L["Trading_BrokerPriceProgress", _priceProgressDone, _priceProgressTotal]</span>
            }
            <button class="ts-btn ts-btn-outline ts-btn-sm" @onclick="ScanPortfolioMoneyFlow" disabled="@_moneyFlowBusy">
                @( _moneyFlowBusy ? L["Trading_RefreshingPrices"] : L["Trading_MF_ScanHoldings"] )
            </button>
            <button class="ts-btn ts-btn-outline ts-btn-sm" @onclick="ExportCsv">@L["Trading_BrokerExportCsv"]</button>
            <label class="ts-btn ts-btn-outline ts-btn-sm broker-file-btn" for="broker-import-json">@L["Trading_BrokerImportJson"]</label>
            <InputFile @key="_importInputKey"
                       id="broker-import-json"
                       class="broker-file-input"
                       OnChange="ImportJson"
                       accept=".json,application/json" />
            <button class="ts-btn ts-btn-outline ts-btn-sm" @onclick="ReloadFromServer" disabled="@_loading">@L["Trading_BrokerReloadFile"]</button>
            <button class="ts-btn ts-btn-outline ts-btn-sm" @onclick="OpenTcbsSync" disabled="@_loading">Đồng bộ từ TCBS</button>
            <button class="ts-btn ts-btn-outline ts-btn-sm" @onclick="ExportJson">@L["Trading_SaveJson"]</button>
        </div>
    </div>

    @if (_dirty)
    {
        <div class="ts-alert ts-alert-info broker-alert">
            @L["Trading_BrokerDirtyHint"]
        </div>
    }
    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="ts-alert @(_messageError ? "ts-alert-error" : "ts-alert-info") broker-alert broker-alert-flash" role="@(_messageError ? "alert" : "status")">
            <span>@_message</span>
            <button type="button" class="broker-alert-close" aria-label="@L["Trading_BrokerDismiss"]" @onclick="DismissMessage">×</button>
        </div>
    }

    <TcbsConnectPanel />
    <div class="tcbs-tabs" role="tablist" aria-label="Broker desk">
        <button type="button" class="ts-btn ts-btn-sm @(_deskTab == "portfolio" ? "ts-btn-primary" : "ts-btn-outline")" @onclick='() => _deskTab = "portfolio"'>Danh mục</button>
        <button type="button" class="ts-btn ts-btn-sm @(_deskTab == "account" ? "ts-btn-primary" : "ts-btn-outline")" @onclick='() => _deskTab = "account"'>Tài khoản TCBS</button>
        <button type="button" class="ts-btn ts-btn-sm @(_deskTab == "orders" ? "ts-btn-primary" : "ts-btn-outline")" @onclick='() => _deskTab = "orders"'>Sổ lệnh</button>
        <button type="button" class="ts-btn ts-btn-sm @(_deskTab == "ticket" ? "ts-btn-primary" : "ts-btn-outline")" @onclick='() => _deskTab = "ticket"'>Đặt lệnh</button>
    </div>

    @if (_deskTab == "account")
    {
        <TcbsAccountPanel />
    }
    else if (_deskTab == "orders")
    {
        <TcbsOrderBook OnAmend="StartAmend" />
    }
    else if (_deskTab == "ticket")
    {
        <TcbsOrderTicket @key="_ticketKey" InitialSymbol="@_ticketSymbol" InitialSide="@_ticketSide" InitialPrice="@_ticketPrice" InitialQty="@_ticketQty" AmendOrderId="@_amendId" />
    }
    else
    {
    <div class="broker-stack">
        <section class="ts-panel broker-form-card">
            <div class="broker-form-card-head">
                <span class="broker-form-icon" aria-hidden="true">+</span>
                <div>
                    <h2 class="ts-panel-title">@L["Trading_BrokerFormTitle"]</h2>
                    <span class="broker-form-card-sub">@L["Trading_BrokerFormSub"]</span>
                </div>
            </div>

            <div class="broker-form-blocks">
                <section class="broker-block">
                    <h3 class="broker-block-title">@L["Trading_BrokerBuyInfo"]</h3>
                    <div class="broker-field broker-field-symbol">
                        <label class="broker-field-label" for="broker-symbol">@L["Trading_BrokerSymbol"]</label>
                        <input id="broker-symbol"
                               class='ts-input broker-input-symbol @FieldClass("symbol")'
                               placeholder="VD: VNM, HPG"
                               @bind="_newSymbol"
                               @bind:event="oninput"
                               @bind:after="OnSymbolInput"
                               maxlength="@BrokerInputValidation.SymbolMaxLen"
                               minlength="@BrokerInputValidation.SymbolMinLen"
                               pattern="[A-Za-z0-9]{3,10}"
                               required
                               autocomplete="off"
                               inputmode="text" />
                        @if (_fieldErrors.TryGetValue("symbol", out var errSymbol))
                        {
                            <p class="ts-field-error">@errSymbol</p>
                        }
                    </div>
                    <div class="broker-form-row broker-form-row-2 broker-form-row-align">
                        <div class="broker-field">
                            <label class="broker-field-label" for="broker-price">@L["Trading_BrokerBuyPrice"]</label>
                            <input id="broker-price"
                                   class='ts-input @FieldClass("price")'
                                   placeholder="60.5"
                                   type="number"
                                   min="0.0001"
                                   step="any"
                                   required
                                   @bind="_newPrice"
                                   @bind:after='() => ClearFieldError("price")' />
                            @if (_fieldErrors.TryGetValue("price", out var errPrice))
                            {
                                <div class="broker-field-footer">
                                    <p class="ts-field-error">@errPrice</p>
                                </div>
                            }
                        </div>
                        <div class="broker-field">
                            <label class="broker-field-label" for="broker-qty">
                                @L["Trading_BrokerQuantity"]
                                <span class="broker-optional">@L["Trading_BrokerOptional"]</span>
                            </label>
                            <input id="broker-qty"
                                   class='ts-input @FieldClass("qty")'
                                   placeholder="100"
                                   type="number"
                                   min="0.0001"
                                   step="any"
                                   @bind="_newQty"
                                   @bind:after='() => ClearFieldError("qty")' />
                            @if (_fieldErrors.TryGetValue("qty", out var errQty))
                            {
                                <div class="broker-field-footer">
                                    <p class="ts-field-error">@errQty</p>
                                </div>
                            }
                        </div>
                    </div>
                </section>

                <section class="broker-block">
                    <h3 class="broker-block-title">@L["Trading_BrokerTargetStop"]</h3>
                    <p class="broker-block-desc">@L["Trading_BrokerTargetStopHint"]</p>
                    <div class="broker-level-stack">
                        <BrokerLevelInput Id="broker-target"
                                          CssClass="broker-level-target"
                                          Label="@L["Trading_BrokerTarget"]"
                                          HintPrice="@L["Trading_BrokerTargetPriceHint"]"
                                          HintPercent="@L["Trading_BrokerTargetPctHint"]"
                                          PlaceholderPrice="65.5"
                                          PlaceholderPercent="10"
                                          Compact="true"
                                          @bind-Mode="_targetMode"
                                          @bind-Input="_targetInput"
                                          @bind-Input:after='() => ClearFieldError("target")'
                                          BuyPrice="_newPrice"
                                          IsStop="false"
                                          Error="@(_fieldErrors.GetValueOrDefault("target"))"
                                          Invalid="@_fieldErrors.ContainsKey("target")" />
                        <BrokerLevelInput Id="broker-stop"
                                          CssClass="broker-level-stop"
                                          Label="@L["Trading_BrokerStop"]"
                                          HintPrice="@L["Trading_BrokerStopPriceHint"]"
                                          HintPercent="@L["Trading_BrokerStopPctHint"]"
                                          PlaceholderPrice="55.5"
                                          PlaceholderPercent="5"
                                          Compact="true"
                                          @bind-Mode="_stopMode"
                                          @bind-Input="_stopInput"
                                          @bind-Input:after='() => ClearFieldError("stop")'
                                          BuyPrice="_newPrice"
                                          IsStop="true"
                                          Error="@(_fieldErrors.GetValueOrDefault("stop"))"
                                          Invalid="@_fieldErrors.ContainsKey("stop")" />
                    </div>
                </section>

                <section class="broker-block broker-block-note">
                    <h3 class="broker-block-title">@L["Trading_BrokerNote"]</h3>
                    <div class="broker-field broker-field-grow">
                        <textarea id="broker-note"
                                  class='ts-input ts-textarea broker-textarea @FieldClass("note")'
                                  placeholder="@L["Trading_BrokerNotePlaceholder"]"
                                  rows="5"
                                  maxlength="@BrokerInputValidation.NoteMaxLen"
                                  @bind="_newNote"
                                  @bind:after='() => ClearFieldError("note")'></textarea>
                        @if (_fieldErrors.TryGetValue("note", out var errNote))
                        {
                            <p class="ts-field-error">@errNote</p>
                        }
                    </div>
                    <button class="ts-btn ts-btn-primary broker-submit" @onclick="AddRecommendation" disabled="@_busy">
                        @( _busy ? L["Trading_BrokerSaving"] : L["Trading_BrokerAddRec"] )
                    </button>
                </section>
            </div>
        </section>

        <BrokerRecommendationBoard Portfolio="_portfolio"
                                    OnBuy="PrefillBuyForm"
                                    OnPlaceOrder="PlaceFromRecommendation"
                                    OnSelect="SelectSymbol"
                                    OnDrop="DropRecommendation"
                                    OnReactivate="ReactivateRecommendation" />

        <BrokerAlertBoard Portfolio="_portfolio"
                          Quotes="_quotes"
                          OnSelect="SelectSymbol"
                          OnQuickSell="OpenQuickSell" />

        <BrokerPnlSummaryPanel Portfolio="_portfolio" Quotes="_quotes" />

        @if (_loading)
        {
            <div class="vd-loading-overlay" role="status" aria-live="polite">
                <div class="vd-loading-bars"><span></span><span></span><span></span><span></span></div>
                <span class="vd-loading-label">Đang tải danh mục…</span>
            </div>
        }
        else
        {
            <BrokerWatchlistTable Portfolio="_portfolio"
                                  Quotes="_quotes"
                                  SelectedSymbol="@_selected"
                                  PriceBusy="_priceBusy"
                                  MoneyFlowBySymbol="_moneyFlowBySymbol"
                                  MoneyFlowScanned="_moneyFlowScanned"
                                  OnSelect="SelectSymbol"
                                  OnSelectClosed="SelectClosed"
                                  OnQuickSell="OpenQuickSell" />
        }

        @{
            var perf = BrokerPortfolioStatsCalculator.ComputePerformance(_portfolio);
        }
        @if (perf.HasData)
        {
            <div class="broker-perf-panel ts-panel">
                <div class="broker-perf-head">
                    <h2 class="ts-panel-title">Hiệu suất theo tháng</h2>
                    <div class="broker-perf-summary">
                        <span class="broker-perf-stat @(perf.TotalRealized >= 0 ? "ts-positive" : "ts-negative")">
                            Tổng realized: @BrokerFormat.Vnd(perf.TotalRealized)
                        </span>
                        <span class="broker-perf-stat">Win rate: @perf.WinRate.ToString("N1")%</span>
                        <span class="broker-perf-stat">@perf.TotalTrades lệnh · @perf.TotalWins thắng / @perf.TotalLosses thua</span>
                    </div>
                </div>

                <div class="broker-table-scroll">
                    <table class="ts-table broker-perf-table">
                        <thead>
                            <tr>
                                <th><span class="broker-dt-th-inner">Kỳ</span></th>
                                <th><span class="broker-dt-th-inner">Lệnh</span></th>
                                <th><span class="broker-dt-th-inner">Thắng</span></th>
                                <th><span class="broker-dt-th-inner">Thua</span></th>
                                <th><span class="broker-dt-th-inner">Realized</span></th>
                                <th><span class="broker-dt-th-inner">Avg thắng</span></th>
                                <th><span class="broker-dt-th-inner">Avg thua</span></th>
                                <th><span class="broker-dt-th-inner">Tốt nhất</span></th>
                                <th><span class="broker-dt-th-inner">Tệ nhất</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in perf.Months)
                            {
                                <tr>
                                    <td>@m.Period</td>
                                    <td class="broker-num">@m.TradeCount</td>
                                    <td class="broker-num ts-positive">@m.WinCount</td>
                                    <td class="broker-num ts-negative">@m.LossCount</td>
                                    <td class="broker-num @(m.Realized > 0 ? "ts-positive" : m.Realized < 0 ? "ts-negative" : "")">
                                        @BrokerFormat.Vnd(m.Realized)
                                    </td>
                                    <td class="broker-num ts-positive">@(m.WinCount > 0 ? BrokerFormat.Vnd(m.AvgWin) : "—")</td>
                                    <td class="broker-num ts-negative">@(m.LossCount > 0 ? BrokerFormat.Vnd(m.AvgLoss) : "—")</td>
                                    <td>@(string.IsNullOrEmpty(m.BestSymbol) ? "—" : m.BestSymbol)</td>
                                    <td>@(string.IsNullOrEmpty(m.WorstSymbol) ? "—" : m.WorstSymbol)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <BrokerCashFlowPanel Portfolio="_portfolio" />

        <BrokerAiExplain Portfolio="_portfolio" />
    </div>
    }

    <BrokerQuickSellModal @ref="_quickSellModal"
                          Position="@(_quickSellPosition)"
                          CurrentPrice="@(_quickSellPosition is not null ? Quote(_quickSellPosition.Symbol) : null)"
                          OnSubmitSell="SubmitQuickSell"
                          OnPlaceOrder="PlaceFromQuickSell" />
    <TcbsSyncDialog @ref="_tcbsSync" OnApply="ApplyTcbsSync" />

    @if (Selected is not null)
    {
        <div id="broker-detail-panel">
            <BrokerPositionEditor @key="Selected.Symbol"
                                  Position="Selected"
                                  CurrentPrice="@Quote(Selected.Symbol)"
                                  OnSync="OnEditorSync"
                                  OnLevelsChanged="RefreshPriceAlerts"
                                  OnDeleted="DeleteSelected"
                                  OnClosed="OnPositionClosed"
                                  OnReopen="OnPositionReopened"
                                  OnDeleteClosed="DeleteClosedSelected" />

            <div class="ts-chart-wrap">
                <iframe src="@($"https://stockchart.vietstock.vn/?stockcode={Selected.Symbol}")"
                        width="100%" height="380" frameborder="0" loading="lazy"
                        title="@L["Trading_BrokerChartTitle", Selected.Symbol]"></iframe>
            </div>
            <PriceAlertWidget Symbol="@Selected.Symbol" AssetType="stock" />
        </div>
    }
</div>

@code {
    private BrokerPortfolio _portfolio = new();
    private Dictionary<string, decimal> _quotes = new(StringComparer.OrdinalIgnoreCase);
    private string? _selected;
    private BrokerQuickSellModal? _quickSellModal;
    private BrokerPosition? _quickSellPosition;
    private bool _loading = true;
    private bool _busy;
    private bool _priceBusy;
    private bool _dirty;
    private bool _messageError;
    private string? _message;
    private int _importInputKey;
    private DateTime? _priceUpdatedAt;
    private int _priceProgressDone;
    private int _priceProgressTotal;
    private Timer? _persistTimer;
    private Timer? _flashTimer;
    private bool _activeSlTpFlash;
    private CancellationTokenSource? _priceCts;

    private string _newSymbol = "";
    private decimal? _newPrice;
    private decimal? _newQty;
    private BrokerLevelInputMode _stopMode = BrokerLevelInputMode.Price;
    private BrokerLevelInputMode _targetMode = BrokerLevelInputMode.Price;
    private decimal? _stopInput;
    private decimal? _targetInput;
    private string _newNote = "";
    private readonly Dictionary<string, string> _fieldErrors = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, MoneyFlowSnapshot> _moneyFlowBySymbol = new(StringComparer.OrdinalIgnoreCase);
    private bool _moneyFlowScanned;
    private bool _moneyFlowBusy;
    private string _deskTab = "portfolio";
    private string? _ticketSymbol;
    private string _ticketSide = "NB";
    private decimal? _ticketPrice;
    private decimal? _ticketQty;
    private string? _amendId;
    private int _ticketKey;
    private TcbsSyncDialog? _tcbsSync;

    private BrokerPosition? Selected =>
        string.IsNullOrEmpty(_selected)
            ? null
            : _portfolio.Positions.FirstOrDefault(p => p.Symbol.Equals(_selected, StringComparison.OrdinalIgnoreCase))
              ?? _portfolio.ClosedPositions.FirstOrDefault(p => p.Symbol.Equals(_selected, StringComparison.OrdinalIgnoreCase));

    private bool SelectedIsClosed =>
        Selected is not null && _portfolio.ClosedPositions.Contains(Selected);

    private decimal? Quote(string symbol) =>
        _quotes.TryGetValue(symbol, out var v) ? v : null;

    protected override async Task OnInitializedAsync()
    {
        _portfolio = await Store.LoadAsync();
        foreach (var p in _portfolio.Positions.Where(x => string.IsNullOrWhiteSpace(x.Sector)))
            p.Sector = await Sectors.FindSectorAsync(p.Symbol);
        _loading = false;
        if (_portfolio.Positions.Count > 0)
            await RefreshPrices();
    }

    private async Task SelectSymbol(string symbol)
    {
        _selected = symbol;
        await JS.InvokeVoidAsync("eval", "document.getElementById('broker-detail-panel')?.scrollIntoView({behavior:'smooth',block:'start'})");
    }

    private async Task SelectClosed(string symbol)
    {
        _selected = symbol;
        await JS.InvokeVoidAsync("eval", "document.getElementById('broker-detail-panel')?.scrollIntoView({behavior:'smooth',block:'start'})");
    }

    private async Task OnPositionClosed()
    {
        if (Selected is null) return;
        var pos = Selected;
        pos.Status = BrokerPositionStatus.DaDong;
        _portfolio.Positions.Remove(pos);
        _portfolio.ClosedPositions ??= [];
        _portfolio.ClosedPositions.Add(pos);
        _selected = null;
        await SyncArchivePosition(pos, isArchived: true, BrokerPositionStatus.DaDong);
        var realized = pos.RealizedPnl ?? 0m;
        Flash(realized >= 0
            ? $"Đã đóng {pos.Symbol}, realized {BrokerFormat.Vnd(realized)}"
            : $"Đã đóng {pos.Symbol}, realized {BrokerFormat.Vnd(realized)}");
        await Task.CompletedTask;
    }

    private async Task OnPositionReopened()
    {
        if (Selected is null) return;
        var pos = Selected;
        if (_portfolio.ClosedPositions?.Contains(pos) != true) return;
        pos.Status = BrokerPositionStatus.NamGiu;
        _portfolio.ClosedPositions.Remove(pos);
        _portfolio.Positions.Add(pos);
        await SyncArchivePosition(pos, isArchived: false, BrokerPositionStatus.NamGiu);
        Flash($"Đã mở lại {pos.Symbol} — có thể sửa lệnh bán rồi đóng lại.");
        await Task.CompletedTask;
    }

    private async Task DeleteClosedSelected()
    {
        if (Selected is null) return;
        if (!await JS.InvokeAsync<bool>("tradingAuth.confirm", $"Xóa vĩnh viễn vị thế đã đóng {Selected.Symbol}? Hành động này không thể hoàn tác."))
            return;
        var symbol = Selected.Symbol;
        _portfolio.ClosedPositions?.Remove(Selected);
        _selected = null;
        MarkDirty();
        var (ok, error) = await Store.DeletePositionAsync(symbol);
        if (ok) _dirty = false;
        else Flash($"Sync fail: {error}", error: true);
    }

    private async Task OpenTcbsSync()
    {
        if (_tcbsSync is null) return;
        var error = await _tcbsSync.Open(_portfolio);
        if (!string.IsNullOrEmpty(error)) Flash(error, error: true);
    }

    private async Task ApplyTcbsSync(BrokerPortfolio portfolio)
    {
        _portfolio = portfolio;
        var (ok, err) = await Store.ImportAsync(portfolio);
        Flash(ok ? "Đã ghi danh mục đồng bộ từ TCBS." : $"Sync fail: {err}", error: !ok);
    }

    private void PlaceFromRecommendation(string symbol)
    {
        var pos = _portfolio.Positions.FirstOrDefault(p => p.Symbol.Equals(symbol, StringComparison.OrdinalIgnoreCase));
        _ticketSymbol = symbol;
        _ticketSide = "NB";
        _ticketPrice = pos?.EntryLow ?? pos?.AvgBuy;
        _ticketQty = 100;
        _amendId = null;
        _ticketKey++;
        _deskTab = "ticket";
    }

    private void PlaceFromQuickSell(BrokerPosition pos)
    {
        _ticketSymbol = pos.Symbol;
        _ticketSide = "NS";
        _ticketPrice = Quote(pos.Symbol) ?? pos.AvgBuy;
        _ticketQty = pos.RemainingQuantity;
        _amendId = null;
        _ticketKey++;
        _deskTab = "ticket";
    }

    private void StartAmend(TcbsOrder order)
    {
        _ticketSymbol = order.Symbol;
        _ticketSide = order.ExecType is "NS" or "S" ? "NS" : "NB";
        _ticketPrice = order.Price;
        _ticketQty = order.Quantity;
        _amendId = order.OrderId;
        _ticketKey++;
        _deskTab = "ticket";
    }

    private async Task OpenQuickSell(string symbol)
    {
        var pos = _portfolio.Positions.FirstOrDefault(p => p.Symbol.Equals(symbol, StringComparison.OrdinalIgnoreCase));
        if (pos is null || pos.IsClosed || pos.RemainingQuantity is null or 0) return;
        _quickSellPosition = pos;
        await _quickSellModal!.Open(pos, Quote(symbol));
    }

    private async Task SubmitQuickSell(BrokerSell sell)
    {
        if (_quickSellPosition is null) return;
        var pos = _quickSellPosition;
        pos.Sells.Add(sell);
        MarkDirty();

        var (ok, error) = await Store.AddSellAsync(pos.Symbol, sell);
        if (ok) _dirty = false;
        else Flash($"Sync fail: {error}", error: true);

        if (pos.RemainingQuantity is null or 0)
        {
            await OnPositionClosedCore(pos);
        }
        else
        {
            var realized = pos.RealizedPnl ?? 0m;
            Flash($"Đã ghi lệnh bán {pos.Symbol} @ {sell.Price:N2} ×{sell.Quantity}. Realized: {BrokerFormat.Vnd(realized)}");
        }
        _quickSellPosition = null;
        await Task.CompletedTask;
    }

    private async Task OnPositionClosedCore(BrokerPosition pos)
    {
        pos.Status = BrokerPositionStatus.DaDong;
        _portfolio.Positions.Remove(pos);
        _portfolio.ClosedPositions ??= [];
        _portfolio.ClosedPositions.Add(pos);
        if (_selected?.Equals(pos.Symbol, StringComparison.OrdinalIgnoreCase) == true)
            _selected = null;
        await SyncArchivePosition(pos, isArchived: true, BrokerPositionStatus.DaDong);
        var realized = pos.RealizedPnl ?? 0m;
        Flash($"Đã đóng {pos.Symbol}, realized {BrokerFormat.Vnd(realized)}");
        await Task.CompletedTask;
    }

    private void MarkDirty()
    {
        _dirty = true;
        _portfolio.UpdatedAt = DateTime.Now;
        SchedulePersistDraft();
    }

    private void SchedulePersistDraft()
    {
        _persistTimer?.Dispose();
        _persistTimer = new Timer(_ =>
        {
            try
            {
                _ = InvokeAsync(PersistDraftAsync);
            }
            catch
            {
                // Component may be disposed.
            }
        }, null, 500, Timeout.Infinite);
    }

    private async Task PersistDraftAsync()
    {
        try
        {
            await Store.SaveDraftAsync(_portfolio);
        }
        catch
        {
            // Ignore localStorage failures (private mode, quota, etc.).
        }
    }

    // ── Direct CRUD sync (no debounce, no full-portfolio PUT) ──

    private async Task SyncPositionUpdate(BrokerPosition pos)
    {
        MarkDirty();
        var (ok, error) = await Store.UpdatePositionAsync(pos.Symbol, pos);
        if (ok) _dirty = false;
        else Flash($"Sync fail: {error}", error: true);
    }

    private async Task SyncArchivePosition(BrokerPosition pos, bool isArchived, BrokerPositionStatus status)
    {
        MarkDirty();
        var (ok, error) = await Store.ArchivePositionAsync(pos.Symbol, isArchived, status);
        if (ok) _dirty = false;
        else Flash($"Sync fail: {error}", error: true);
    }

    private async Task OnEditorSync(BrokerSyncAction action)
    {
        if (Selected is null) return;
        var symbol = Selected.Symbol;
        MarkDirty();

        try
        {
            var (ok, error) = action switch
            {
                PositionSyncAction posAction => posAction.Action switch
                {
                    "create" => await Store.CreatePositionAsync(posAction.Position),
                    "update" => await Store.UpdatePositionAsync(symbol, posAction.Position),
                    _ => (false, $"Unknown position action: {posAction.Action}")
                },
                LotSyncAction lotAction => lotAction.Action switch
                {
                    "create" => await Store.AddLotAsync(symbol, lotAction.Lot),
                    "update" => await Store.UpdateLotAsync(symbol, lotAction.Lot),
                    "delete" => await Store.DeleteLotAsync(symbol, lotAction.Lot.Id),
                    _ => (false, $"Unknown lot action: {lotAction.Action}")
                },
                SellSyncAction sellAction => sellAction.Action switch
                {
                    "create" => await Store.AddSellAsync(symbol, sellAction.Sell),
                    "update" => await Store.UpdateSellAsync(symbol, sellAction.Sell),
                    "delete" => await Store.DeleteSellAsync(symbol, sellAction.Sell.Id),
                    _ => (false, $"Unknown sell action: {sellAction.Action}")
                },
                NoteSyncAction noteAction => noteAction.Action switch
                {
                    "create" => await Store.AddNoteAsync(symbol, noteAction.Note),
                    "update" => await Store.UpdateNoteAsync(symbol, noteAction.Note),
                    "delete" => await Store.DeleteNoteAsync(symbol, noteAction.Note.Id),
                    _ => (false, $"Unknown note action: {noteAction.Action}")
                },
                DividendSyncAction divAction => divAction.Action switch
                {
                    "create" => await Store.AddDividendAsync(symbol, divAction.Dividend),
                    "update" => await Store.UpdateDividendAsync(symbol, divAction.Dividend),
                    "delete" => await Store.DeleteDividendAsync(symbol, divAction.Dividend.Id),
                    _ => (false, $"Unknown dividend action: {divAction.Action}")
                },
                _ => (false, $"Unknown sync action: {action.GetType().Name}")
            };

            if (ok)
            {
                _dirty = false;
                RefreshPriceAlerts();
            }
            else Flash($"Sync fail: {error}", error: true);
        }
        catch (Exception ex)
        {
            Flash($"Sync exception: {ex.GetType().Name}: {ex.Message}", error: true);
        }
    }

