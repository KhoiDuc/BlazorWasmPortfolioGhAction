    private void ClearFieldError(string field)
    {
        if (_fieldErrors.Remove(field) && _fieldErrors.Count == 0 && _messageError)
            _message = null;
    }

    private void SetFieldError(string field, string message) => _fieldErrors[field] = L[message].Value;

    private string FieldClass(string field) =>
        _fieldErrors.ContainsKey(field) ? "ts-input-invalid" : "";

    private bool ValidateForm(out string symbol)
    {
        _fieldErrors.Clear();
        symbol = "";

        if (!BrokerInputValidation.TryNormalizeSymbol(_newSymbol, out symbol, out var symErr))
            SetFieldError("symbol", symErr!);
        if (!BrokerInputValidation.TryValidateBuyPrice(_newPrice, out var priceErr))
            SetFieldError("price", priceErr!);
        if (!BrokerInputValidation.TryValidateQuantity(_newQty, out var qtyErr))
            SetFieldError("qty", qtyErr!);
        if (!BrokerInputValidation.TryValidateNote(_newNote, out var noteErr))
            SetFieldError("note", noteErr!);

        if (_newPrice is > 0)
        {
            if (!BrokerLevelHelper.TryValidateStop(_newPrice.Value, _stopMode, _stopInput, out _, out var stopErr))
                SetFieldError("stop", stopErr!);
            if (!BrokerLevelHelper.TryValidateTarget(_newPrice.Value, _targetMode, _targetInput, out _, out var targetErr))
                SetFieldError("target", targetErr!);
        }

        return _fieldErrors.Count == 0;
    }

    private async Task PrefillBuyForm(string symbol)
    {
        var pos = _portfolio.Positions.FirstOrDefault(p => p.Symbol.Equals(symbol, StringComparison.OrdinalIgnoreCase));
        if (pos is null) return;

        _newSymbol = pos.Symbol;
        if (pos.EntryLow is > 0)
            _newPrice = pos.EntryLow;
        if (pos.StopLoss is > 0)
        {
            _stopMode = BrokerLevelInputMode.Price;
            _stopInput = pos.StopLoss;
        }
        if (pos.TargetPrice is > 0)
        {
            _targetMode = BrokerLevelInputMode.Price;
            _targetInput = pos.TargetPrice;
        }
        if (!string.IsNullOrWhiteSpace(pos.RecommendationText))
            _newNote = pos.RecommendationText;
        await JS.InvokeVoidAsync("eval", "document.getElementById('broker-symbol')?.focus()");
    }

    private async Task DropRecommendation(string symbol)
    {
        var pos = _portfolio.Positions.FirstOrDefault(p => p.Symbol.Equals(symbol, StringComparison.OrdinalIgnoreCase));
        if (pos is null) return;
        pos.Status = BrokerPositionStatus.BoTheoDoi;
        await SyncPositionUpdate(pos);
    }

    private async Task ReactivateRecommendation(string symbol)
    {
        var pos = _portfolio.Positions.FirstOrDefault(p => p.Symbol.Equals(symbol, StringComparison.OrdinalIgnoreCase));
        if (pos is null) return;
        pos.Status = pos.Buys.Count > 0 ? BrokerPositionStatus.NamGiu : BrokerPositionStatus.ChoMua;
        await SyncPositionUpdate(pos);
    }

    private async Task AddRecommendation()
    {
        if (!ValidateForm(out var symbol))
        {
            Flash(L["Trading_BrokerCheckFields"], error: true);
            return;
        }

        decimal? resolvedStop = null;
        decimal? resolvedTarget = null;
        if (_newPrice is > 0)
        {
            BrokerLevelHelper.TryValidateStop(_newPrice.Value, _stopMode, _stopInput, out resolvedStop, out _);
            BrokerLevelHelper.TryValidateTarget(_newPrice.Value, _targetMode, _targetInput, out resolvedTarget, out _);
        }

        _busy = true;
        try
        {
            var isNew = false;
            var existing = _portfolio.Positions.FirstOrDefault(p => p.Symbol.Equals(symbol, StringComparison.OrdinalIgnoreCase));
            if (existing is null)
            {
                isNew = true;
                existing = new BrokerPosition
                {
                    Symbol = symbol,
                    Sector = await Sectors.FindSectorAsync(symbol)
                };
                _portfolio.Positions.Add(existing);
            }

            // Chuyển từ ChờMua → NắmGiữ khi có lần mua đầu tiên
            if (existing.Status == BrokerPositionStatus.ChoMua)
                existing.Status = BrokerPositionStatus.NamGiu;

            var lot = new BrokerLot
            {
                BoughtAt = DateTime.Today,
                Price = _newPrice!.Value,
                Quantity = _newQty is > 0 ? _newQty : null,
                StopLossMode = _stopInput is > 0 ? _stopMode : null,
                StopLossInput = _stopInput is > 0 ? _stopInput : null,
                StopLoss = resolvedStop,
                TargetPriceMode = _targetInput is > 0 ? _targetMode : null,
                TargetPriceInput = _targetInput is > 0 ? _targetInput : null,
                TargetPrice = resolvedTarget,
                Note = string.IsNullOrWhiteSpace(_newNote) ? null : _newNote.Trim()
            };
            existing.Buys.Add(lot);

            var refPrice = existing.AvgBuy ?? _newPrice.Value;
            if (resolvedStop is > 0)
            {
                existing.StopLossMode = _stopMode;
                existing.StopLossInput = _stopInput;
                existing.StopLoss = BrokerLevelHelper.ResolveStop(refPrice, _stopMode, _stopInput) ?? resolvedStop;
            }
            if (resolvedTarget is > 0)
            {
                existing.TargetPriceMode = _targetMode;
                existing.TargetPriceInput = _targetInput;
                existing.TargetPrice = BrokerLevelHelper.ResolveTarget(refPrice, _targetMode, _targetInput) ?? resolvedTarget;
            }

            BrokerNote? newNote = null;
            if (!string.IsNullOrWhiteSpace(_newNote))
            {
                newNote = new BrokerNote
                {
                    At = DateTime.Now,
                    Kind = BrokerNoteKind.Broker,
                    Text = $"Mua @ {_newPrice.Value:N2}: {_newNote.Trim()}"
                };
                existing.Notes.Add(newNote);
            }

            _selected = existing.Symbol;
            var lotNo = existing.Buys.Count;
            _newSymbol = "";
            _newPrice = _newQty = _stopInput = _targetInput = null;
            _stopMode = _targetMode = BrokerLevelInputMode.Price;
            _newNote = "";
            _fieldErrors.Clear();
            MarkDirty();

            // Sync to API — create position (with nested lot+note) OR add lot to existing
            if (isNew)
            {
                var (ok, error) = await Store.CreatePositionAsync(existing);
                if (ok) _dirty = false;
                else Flash($"Sync fail: {error}", error: true);
            }
            else
            {
                var allOk = true;
                var (ok, error) = await Store.AddLotAsync(symbol, lot);
                if (!ok) { allOk = false; Flash($"Sync fail: {error}", error: true); }
                if (newNote is not null)
                {
                    var (okN, errN) = await Store.AddNoteAsync(symbol, newNote);
                    if (!okN) { allOk = false; Flash($"Sync note fail: {errN}", error: true); }
                }
                // Update position-level stop/target/sector/status
                var (okP, errP) = await Store.UpdatePositionAsync(symbol, existing);
                if (!okP) { allOk = false; Flash($"Sync position fail: {errP}", error: true); }
                if (allOk) _dirty = false;
            }

            var avg = existing.AvgBuy;
            Flash(lotNo > 1
                ? L["Trading_BrokerAddedLot", lotNo, existing.Symbol, lot.Price, avg ?? lot.Price]
                : L["Trading_BrokerAddedSymbol", existing.Symbol, lot.Price]);

            await RefreshPrices(isNew ? [symbol] : null);
            await SelectSymbol(existing.Symbol);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteSelected()
    {
        if (Selected is null) return;
        if (!await JS.InvokeAsync<bool>("tradingAuth.confirm", L["Trading_BrokerConfirmDeleteSymbol", Selected.Symbol].Value))
