    private async Task ReloadFromServer()
    {
        try
        {
            if (!await JS.InvokeAsync<bool>("tradingAuth.confirm", L["Trading_BrokerConfirmReload"].Value))
                return;

            _persistTimer?.Dispose();
            _persistTimer = null;
            _priceCts?.Cancel();

            _selected = null;
            await InvokeAsync(StateHasChanged);

            var fromApi = await Store.LoadFromApiAsync();
            if (fromApi is null)
            {
                Flash(L["Trading_BrokerReloadFailed"], error: true);
                return;
            }

            _portfolio = fromApi;

            foreach (var p in _portfolio.Positions.Where(x => string.IsNullOrWhiteSpace(x.Sector)))
                p.Sector = await Sectors.FindSectorAsync(p.Symbol);

            _dirty = false;
            _quotes.Clear();
            var count = _portfolio.Positions.Count + (_portfolio.ClosedPositions?.Count ?? 0);
            Flash(L["Trading_BrokerReloadedFile", count]);

            if (_portfolio.Positions.Count > 0)
                await RefreshPrices();
        }
        catch (Exception ex)
        {
            Flash(L["Trading_BrokerImportError", ex.Message], error: true);
        }
    }

    private async Task ImportJson(InputFileChangeEventArgs e)
    {
        var file = e.File;
        try
        {
            if (file is null)
            {
                Flash(L["Trading_BrokerImportNoFile"], error: true);
                return;
            }

            await using var stream = file.OpenReadStream(maxAllowedSize: 2_000_000);
            using var reader = new StreamReader(stream);
            var json = await reader.ReadToEndAsync();
            if (string.IsNullOrWhiteSpace(json))
            {
                Flash(L["Trading_BrokerImportEmpty"], error: true);
                return;
            }

            _portfolio = Store.ParseJson(json);
            _selected = null;

            foreach (var p in _portfolio.Positions.Where(x => string.IsNullOrWhiteSpace(x.Sector)))
                p.Sector = await Sectors.FindSectorAsync(p.Symbol);

            await Store.SaveDraftAsync(_portfolio);

            if (_portfolio.Positions.Count == 0 && (_portfolio.ClosedPositions?.Count ?? 0) == 0)
            {
                Flash(L["Trading_BrokerImportNoPositions"], error: true);
                return;
            }

            var (synced, syncError) = await Store.ImportAsync(_portfolio);
            _dirty = !synced;

            Flash(synced
                ? $"Đã import {(_portfolio.Positions.Count + (_portfolio.ClosedPositions?.Count ?? 0))} mã và đồng bộ lên server."
                : L["Trading_BrokerImportOk", _portfolio.Positions.Count].Value + $" — sync fail: {syncError}",
                error: !synced);

            await RefreshPrices();
        }
        catch (Exception ex)
        {
            Flash(L["Trading_BrokerImportError", ex.Message], error: true);
        }
        finally
        {
            _importInputKey++;
        }
    }

    private async Task ScanPortfolioMoneyFlow()
    {
        var symbols = _portfolio.Positions?
            .Select(p => p.Symbol)
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList() ?? [];

        if (symbols.Count == 0)
        {
            Flash("Chưa có mã trong danh mục.", error: false);
            return;
        }

        _moneyFlowBusy = true;
        StateHasChanged();
        try
        {
            var results = await MoneyFlowScan.ScanManyAsync(symbols);
            _moneyFlowBySymbol = results.ToDictionary(r => r.Symbol, r => r, StringComparer.OrdinalIgnoreCase);
            _moneyFlowScanned = true;
            var waveCount = results.Count(r => r.MediumWaveSignal);
            Flash(waveCount > 0
                ? $"Đo xong {results.Count} mã — {waveCount} mã có sóng trung hạn."
                : $"Đo xong {results.Count} mã — chưa có sóng trung hạn.", error: false);
        }
        catch (Exception ex)
        {
            Flash(ex.Message, error: true);
        }
        finally
        {
            _moneyFlowBusy = false;
        }
    }

    private Task RefreshAllPrices() => RefreshPrices();

    private async Task RefreshPrices(IReadOnlyList<string>? symbolsOnly = null)
    {
        var symbols = (symbolsOnly ?? _portfolio.Positions.Select(p => p.Symbol).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct().ToList())
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        if (symbols.Count == 0) return;

        _priceCts?.Cancel();
        _priceCts = new CancellationTokenSource();
        var ct = _priceCts.Token;

        _priceBusy = true;
        _priceProgressDone = 0;
        _priceProgressTotal = symbols.Count;
        try
        {
            var progress = new Progress<int>(done =>
            {
                _priceProgressDone = done;
                try
                {
                    _ = InvokeAsync(StateHasChanged);
                }
                catch
                {
                    // Component may be disposed.
                }
            });
            var rows = await Market.GetLatestManyAsync(symbols, progress, ct: ct, forceRefresh: true);
            var updated = new Dictionary<string, decimal>(_quotes, StringComparer.OrdinalIgnoreCase);
            foreach (var row in rows.GroupBy(s => s.Symbol, StringComparer.OrdinalIgnoreCase))
                updated[row.Key] = row.First().Close;
            _quotes = updated;
            _priceUpdatedAt = DateTime.Now;
        }
        catch (OperationCanceledException)
        {
            // User navigated away or started a new refresh.
        }
        catch (Exception ex)
        {
            Flash(L["Trading_BrokerPriceError", ex.Message], error: true);
        }
        finally
        {
            _priceBusy = false;
            _priceProgressDone = 0;
            _priceProgressTotal = 0;
            CheckAlerts();
            await InvokeAsync(StateHasChanged);
        }
    }

    private void CheckAlerts()
    {
        var alerts = new List<string>();
        foreach (var p in _portfolio.Positions)
        {
            if (p.IsClosed) continue;
            if (!_quotes.TryGetValue(p.Symbol, out var current) || current <= 0) continue;

            if (p.StopLoss is > 0 && current <= p.StopLoss.Value)
                alerts.Add($"{p.Symbol} chạm cắt lỗ @ {current:N2} (SL {p.StopLoss.Value:N2})");
            if (p.TargetPrice is > 0 && current >= p.TargetPrice.Value)
                alerts.Add($"{p.Symbol} chạm mục tiêu @ {current:N2} (TP {p.TargetPrice.Value:N2})");
        }

        if (alerts.Count > 0)
        {
            _activeSlTpFlash = true;
            Flash(string.Join(" · ", alerts), error: alerts.Count > 0 && !alerts.All(a => a.Contains("mục tiêu")));
        }
        else if (_activeSlTpFlash)
        {
            _activeSlTpFlash = false;
            DismissMessage();
        }
    }

    private void Flash(string text, bool error = false)
    {
        _flashTimer?.Dispose();
        _message = text;
        _messageError = error;
        if (!error)
        {
            _flashTimer = new Timer(_ =>
            {
                try
                {
                    _ = InvokeAsync(() =>
                    {
                        _message = null;
                        StateHasChanged();
                        return Task.CompletedTask;
                    });
                }
                catch
                {
                    // Component may be disposed.
                }
            }, null, 5000, Timeout.Infinite);
        }
    }

    private void DismissMessage()
    {
        _flashTimer?.Dispose();
        _message = null;
        _messageError = false;
        _activeSlTpFlash = false;
    }

    public override void Dispose()
    {
        _persistTimer?.Dispose();
        _flashTimer?.Dispose();
        _priceCts?.Cancel();
        _priceCts?.Dispose();

        if (_dirty)
        {
            try
            {
                _ = FlushPendingSavesAsync();
            }
            catch
            {
                // Component may be disposed.
            }
        }

        base.Dispose();
    }
