@page "/trading/broker"
@layout TradingLayout
@inject IBrokerDeskStore Store
@inject IVnMarketClient Market
@inject VnSectorService Sectors
@inject BrokerOptions GeminiOptions

<div class="ts-page">
    <div class="ts-panel">
        <div class="ts-header">
            <div>
                <h2>Broker Desk</h2>
                <p>Ghi từng lần broker khuyến nghị — bảng danh mục tự hình thành. VD: VNM @@ 60 (không cắt lỗ) → lần 2 @@ 58 → giá TB &amp; %L/L cập nhật theo giá hiện tại.</p>
            </div>
            <div class="broker-header-actions">
                <button class="ts-btn ts-btn-outline" @onclick="RefreshPrices" disabled="@_priceBusy">Làm mới giá</button>
                <button class="ts-btn ts-btn-outline" @onclick="ExportCsv">Export CSV</button>
                <label class="ts-btn ts-btn-outline broker-file-btn">
                    Import JSON
                    <InputFile OnChange="ImportJson" accept=".json" />
                </label>
                <button class="ts-btn ts-btn-primary" @onclick="SaveJson">Lưu file JSON</button>
            </div>
        </div>
        @if (_dirty)
        {
            <div class="ts-alert ts-alert-info">Có thay đổi chưa tải file. Bấm <strong>Lưu file JSON</strong> rồi thay <code>wwwroot/trading/broker/portfolio.json</code>.</div>
        }
        @if (!string.IsNullOrEmpty(_message))
        {
            <div class="ts-alert @(_messageError ? "ts-alert-error" : "ts-alert-info") mt-2">@_message</div>
        }
    </div>

    <div class="ts-panel">
        <h3 class="ts-panel-title">Ghi khuyến nghị broker</h3>
        <div class="broker-form-stack">
            <div class="ts-field">
                <label class="ts-label" for="broker-symbol">Mã CP</label>
                <span class="ts-field-hint">3–10 ký tự, chữ và số. VD: VNM, VCB</span>
                <input id="broker-symbol"
                       class='ts-input @FieldClass("symbol")'
                       placeholder="VNM"
                       @bind="_newSymbol"
                       @bind:event="oninput"
                       @bind:after="OnSymbolInput"
                       maxlength="@BrokerInputValidation.SymbolMaxLen"
                       minlength="@BrokerInputValidation.SymbolMinLen"
                       pattern="[A-Za-z0-9]{3,10}"
                       required
                       autocomplete="off"
                       inputmode="text" />
                @if (_fieldErrors.TryGetValue("symbol", out var errSymbol))
                {
                    <p class="ts-field-error">@errSymbol</p>
                }
            </div>
            <div class="ts-field">
                <label class="ts-label" for="broker-price">Giá mua</label>
                <span class="ts-field-hint">Giá broker khuyên mua, &gt; 0. Có thể nhập thập phân (VD: 58.5)</span>
                <input id="broker-price"
                       class='ts-input @FieldClass("price")'
                       placeholder="60.5"
                       type="number"
                       min="0.0001"
                       step="any"
                       required
                       @bind="_newPrice"
                       @bind:after='() => ClearFieldError("price")' />
                @if (_fieldErrors.TryGetValue("price", out var errPrice))
                {
                    <p class="ts-field-error">@errPrice</p>
                }
            </div>
            <div class="ts-field">
                <label class="ts-label" for="broker-qty">KL (tùy chọn)</label>
                <span class="ts-field-hint">Tùy chọn, &gt; 0. Có thể nhập thập phân</span>
                <input id="broker-qty"
                       class='ts-input @FieldClass("qty")'
                       placeholder="100, 250.5…"
                       type="number"
                       min="0.0001"
                       step="any"
                       @bind="_newQty"
                       @bind:after='() => ClearFieldError("qty")' />
                @if (_fieldErrors.TryGetValue("qty", out var errQty))
                {
                    <p class="ts-field-error">@errQty</p>
                }
            </div>
            <BrokerLevelInput Id="broker-target"
                              Label="Mục tiêu"
                              HintPrice="Để trống nếu chưa có. Nhập giá (VD: 65.5)"
                              HintPercent="Broker nói +10% → chọn %, nhập 10"
                              PlaceholderPrice="65.5"
                              PlaceholderPercent="10"
                              @bind-Mode="_targetMode"
                              @bind-Input="_targetInput"
                              @bind-Input:after='() => ClearFieldError("target")'
                              BuyPrice="_newPrice"
                              IsStop="false"
                              Error="@(_fieldErrors.GetValueOrDefault("target"))"
                              Invalid="@_fieldErrors.ContainsKey("target")" />
            <BrokerLevelInput Id="broker-stop"
                              Label="Cắt lỗ"
                              HintPrice="Để trống nếu chưa có. Nhập giá (VD: 55.5)"
                              HintPercent="Broker nói -5% → chọn %, nhập 5"
                              PlaceholderPrice="55.5"
                              PlaceholderPercent="5"
                              @bind-Mode="_stopMode"
                              @bind-Input="_stopInput"
                              @bind-Input:after='() => ClearFieldError("stop")'
                              BuyPrice="_newPrice"
                              IsStop="true"
                              Error="@(_fieldErrors.GetValueOrDefault("stop"))"
                              Invalid="@_fieldErrors.ContainsKey("stop")" />
        </div>
        <div class="ts-field">
            <label class="ts-label" for="broker-note">Note broker</label>
            <span class="ts-field-hint">Ghi đúng lời broker; lần 2, 3… thêm note mới khi khuyên mua tiếp</span>
            <textarea id="broker-note"
                      class='ts-input ts-textarea @FieldClass("note")'
                      placeholder="VD: Tích lũy vùng 58–60, canh mua dần…"
                      rows="2"
                      maxlength="@BrokerInputValidation.NoteMaxLen"
                      @bind="_newNote"
                      @bind:after='() => ClearFieldError("note")'></textarea>
            @if (_fieldErrors.TryGetValue("note", out var errNote))
            {
                <p class="ts-field-error">@errNote</p>
            }
        </div>
        <button class="ts-btn ts-btn-primary" @onclick="AddRecommendation" disabled="@_busy">Thêm</button>
    </div>

    @if (_loading)
    {
        <div class="ts-panel"><div class="ts-spinner"></div></div>
    }
    else
    {
        <BrokerWatchlistTable Portfolio="_portfolio"
                              Quotes="_quotes"
                              SelectedSymbol="@_selected"
                              PriceBusy="_priceBusy"
                              OnSelect="SelectSymbol" />
    }

    @if (Selected is not null)
    {
        <BrokerPositionEditor Position="Selected"
                              OnChanged="MarkDirty"
                              OnDeleted="DeleteSelected" />

        <div class="ts-chart-wrap">
            <iframe src="@($"https://stockchart.vietstock.vn/?stockcode={Selected.Symbol}")" width="100%" height="380" frameborder="0" title="Vietstock chart"></iframe>
        </div>
        <PriceAlertWidget Symbol="@Selected.Symbol" AssetType="stock" />
    }
</div>

@code {
    private BrokerPortfolio _portfolio = new();
    private Dictionary<string, decimal> _quotes = new(StringComparer.OrdinalIgnoreCase);
    private string? _selected;
    private bool _loading = true;
    private bool _busy;
    private bool _priceBusy;
    private bool _dirty;
    private bool _messageError;
    private string? _message;

    private string _newSymbol = "";
    private decimal? _newPrice;
    private decimal? _newQty;
    private BrokerLevelInputMode _stopMode = BrokerLevelInputMode.Price;
    private BrokerLevelInputMode _targetMode = BrokerLevelInputMode.Price;
    private decimal? _stopInput;
    private decimal? _targetInput;
    private string _newNote = "";
    private readonly Dictionary<string, string> _fieldErrors = new(StringComparer.OrdinalIgnoreCase);

    private BrokerPosition? Selected =>
        string.IsNullOrEmpty(_selected)
            ? null
            : _portfolio.Positions.FirstOrDefault(p => p.Symbol.Equals(_selected, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        _portfolio = await Store.LoadAsync();
        foreach (var p in _portfolio.Positions.Where(x => string.IsNullOrWhiteSpace(x.Sector)))
            p.Sector = await Sectors.FindSectorAsync(p.Symbol);
        _loading = false;
        if (_portfolio.Positions.Count > 0)
            await RefreshPrices();
    }

    private void SelectSymbol(string symbol) => _selected = symbol;

    private void MarkDirty()
    {
        _dirty = true;
        _portfolio.UpdatedAt = DateTime.Now;
    }

    private void OnSymbolInput()
    {
        _newSymbol = _newSymbol.Trim().ToUpperInvariant();
        ClearFieldError("symbol");
    }

    private void ClearFieldError(string field)
    {
        if (_fieldErrors.Remove(field) && _fieldErrors.Count == 0 && _messageError)
            _message = null;
    }

    private void SetFieldError(string field, string message) => _fieldErrors[field] = message;

    private string FieldClass(string field) =>
        _fieldErrors.ContainsKey(field) ? "ts-input-invalid" : "";

    private bool ValidateForm(out string symbol)
    {
        _fieldErrors.Clear();
        symbol = "";

        if (!BrokerInputValidation.TryNormalizeSymbol(_newSymbol, out symbol, out var symErr))
            SetFieldError("symbol", symErr!);
        if (!BrokerInputValidation.TryValidateBuyPrice(_newPrice, out var priceErr))
            SetFieldError("price", priceErr!);
        if (!BrokerInputValidation.TryValidateQuantity(_newQty, out var qtyErr))
            SetFieldError("qty", qtyErr!);
        if (!BrokerInputValidation.TryValidateNote(_newNote, out var noteErr))
            SetFieldError("note", noteErr!);

        if (_newPrice is > 0)
        {
            if (!BrokerLevelHelper.TryValidateStop(_newPrice.Value, _stopMode, _stopInput, out _, out var stopErr))
                SetFieldError("stop", stopErr!);
            if (!BrokerLevelHelper.TryValidateTarget(_newPrice.Value, _targetMode, _targetInput, out _, out var targetErr))
                SetFieldError("target", targetErr!);
        }

        return _fieldErrors.Count == 0;
    }

    private async Task AddRecommendation()
    {
        if (!ValidateForm(out var symbol))
        {
            Flash("Kiểm tra lại các ô được đánh dấu.", error: true);
            return;
        }

        decimal? resolvedStop = null;
        decimal? resolvedTarget = null;
        if (_newPrice is > 0)
        {
            BrokerLevelHelper.TryValidateStop(_newPrice.Value, _stopMode, _stopInput, out resolvedStop, out _);
            BrokerLevelHelper.TryValidateTarget(_newPrice.Value, _targetMode, _targetInput, out resolvedTarget, out _);
        }

        _busy = true;
        try
        {
            var existing = _portfolio.Positions.FirstOrDefault(p => p.Symbol.Equals(symbol, StringComparison.OrdinalIgnoreCase));
            if (existing is null)
            {
                existing = new BrokerPosition
                {
                    Symbol = symbol,
                    Sector = await Sectors.FindSectorAsync(symbol)
                };
                _portfolio.Positions.Add(existing);
            }

            var lot = new BrokerLot
            {
                BoughtAt = DateTime.Today,
                Price = _newPrice!.Value,
                Quantity = _newQty is > 0 ? _newQty : null,
                StopLossMode = _stopInput is > 0 ? _stopMode : null,
                StopLossInput = _stopInput is > 0 ? _stopInput : null,
                StopLoss = resolvedStop,
                TargetPriceMode = _targetInput is > 0 ? _targetMode : null,
                TargetPriceInput = _targetInput is > 0 ? _targetInput : null,
                TargetPrice = resolvedTarget,
                Note = string.IsNullOrWhiteSpace(_newNote) ? null : _newNote.Trim()
            };
            existing.Buys.Add(lot);

            if (resolvedStop is > 0)
            {
                existing.StopLoss = resolvedStop;
                existing.StopLossMode = _stopMode;
                existing.StopLossInput = _stopInput;
            }
            if (resolvedTarget is > 0)
            {
                existing.TargetPrice = resolvedTarget;
                existing.TargetPriceMode = _targetMode;
                existing.TargetPriceInput = _targetInput;
            }

            if (!string.IsNullOrWhiteSpace(_newNote))
            {
                existing.Notes.Add(new BrokerNote
                {
                    At = DateTime.Now,
                    Kind = BrokerNoteKind.Broker,
                    Text = $"Mua @ {_newPrice.Value:N2}: {_newNote.Trim()}"
                });
            }

            _selected = existing.Symbol;
            var lotNo = existing.Buys.Count;
            _newSymbol = "";
            _newPrice = _newQty = _stopInput = _targetInput = null;
            _stopMode = _targetMode = BrokerLevelInputMode.Price;
            _newNote = "";
            _fieldErrors.Clear();
            MarkDirty();

            var avg = existing.AvgBuy;
            Flash(lotNo > 1
                ? $"Đã ghi lần {lotNo} — {existing.Symbol} @ {lot.Price:N2}. Giá TB: {avg:N2}."
                : $"Đã thêm {existing.Symbol} @ {lot.Price:N2} vào danh mục.");
            await RefreshPrices();
        }
        finally
        {
            _busy = false;
        }
    }

    private void DeleteSelected()
    {
        if (Selected is null) return;
        _portfolio.Positions.Remove(Selected);
        _selected = null;
        MarkDirty();
    }

    private async Task SaveJson()
    {
        await Store.DownloadJsonAsync(_portfolio);
        _dirty = false;
        Flash("Đã tải portfolio.json — thay file wwwroot/trading/broker/portfolio.json rồi commit.");
    }

    private async Task ExportCsv() => await Store.DownloadCsvAsync(_portfolio);

    private async Task ImportJson(InputFileChangeEventArgs e)
    {
        try
        {
            await using var stream = e.File.OpenReadStream(maxAllowedSize: 2_000_000);
            using var reader = new StreamReader(stream);
            var json = await reader.ReadToEndAsync();
            _portfolio = Store.ParseJson(json);
            _selected = null;
            _dirty = false;
            Flash($"Đã nạp {_portfolio.Positions.Count} mã từ JSON.");
            await RefreshPrices();
        }
        catch (Exception ex)
        {
            Flash($"Import lỗi: {ex.Message}", error: true);
        }
    }

    private async Task RefreshPrices()
    {
        var symbols = _portfolio.Positions.Select(p => p.Symbol).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct().ToList();
        if (symbols.Count == 0) return;

        _priceBusy = true;
        try
        {
            var rows = await Market.GetLatestManyAsync(symbols);
            _quotes = rows
                .GroupBy(s => s.Symbol, StringComparer.OrdinalIgnoreCase)
                .ToDictionary(g => g.Key, g => g.First().Close, StringComparer.OrdinalIgnoreCase);
        }
        catch (Exception ex)
        {
            Flash($"Không lấy được giá: {ex.Message}", error: true);
        }
        finally
        {
            _priceBusy = false;
        }
    }

    private void Flash(string text, bool error = false)
    {
        _message = text;
        _messageError = error;
    }
}
