@page "/trading/others"
@layout TradingLayout

<div class="ts-page">
    <div class="ts-panel">
        <h2>Useful Links &amp; Resources</h2>
        <p style="color:#64748b">Curated macro, charting, and financial portals.</p>
    </div>

    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px">
        @foreach (var link in Links)
        {
            <a href="@link.Url" target="_blank" rel="noopener" style="text-decoration:none;color:inherit">
                <div class="ts-panel" style="height:100%;transition:box-shadow 0.2s">
                    <div style="font-size:1.5rem;margin-bottom:8px">@link.Icon</div>
                    <strong>@link.Title</strong>
                    <p style="font-size:0.85rem;color:#64748b;margin:8px 0">@link.Description</p>
                    <span style="font-size:0.78rem;color:#3b82f6">Visit ↗</span>
                </div>
            </a>
        }
    </div>
</div>

@code {
    private record ResourceLink(string Icon, string Title, string Description, string Url, string Category);

    private static readonly ResourceLink[] Links =
    [
        new("📊", "TradingView", "Advanced charting platform", "https://www.tradingview.com", "Charts"),
        new("🏦", "Forex Factory", "Economic calendar & news", "https://www.forexfactory.com", "Macro"),
        new("📈", "FRED", "Federal Reserve economic data", "https://fred.stlouisfed.org", "Macro"),
        new("🌍", "Investing.com", "Global markets overview", "https://www.investing.com", "Markets"),
        new("💰", "CoinGecko", "Crypto market data", "https://www.coingecko.com", "Crypto"),
        new("📰", "Bloomberg", "Financial news", "https://www.bloomberg.com", "News"),
        new("🏠", "Batdongsan.com.vn", "VN real estate listings", "https://batdongsan.com.vn", "Real Estate"),
        new("🇻🇳", "TCBS", "VN stock analysis", "https://tcbs.com.vn", "VN Stocks"),
        new("📉", "Yahoo Finance", "Stock quotes & news", "https://finance.yahoo.com", "Markets"),
        new("🔗", "Central Bank Watch", "Rate probability tracker", "https://centralbank.watch", "Macro"),
    ];
}
