@page "/trading/crypto"
@layout TradingLayout
@using BlazorWasmPortfolioGhAction.Models.Trading
@inject ITradingApiClient Api

<div class="ts-page">
    <div class="ts-tabs">
        <button class="ts-tab @(_tab == "coins" ? "active" : "")" @onclick='() => _tab = "coins"'>Potential Coins</button>
        <button class="ts-tab @(_tab == "rrg" ? "active" : "")" @onclick='() => _tab = "rrg"'>RRG Chart</button>
    </div>

    @if (_tab == "coins")
    {
        <div class="ts-panel">
            <div class="ts-header">
                <div>
                    <h2>Crypto Scanner</h2>
                    <p>Discover potential coins near highs &amp; with EMA9 ≥ EMA21</p>
                </div>
                @if (_data?.LatestUpdated is not null)
                {
                    <span class="ts-updated">Updated: @_data.LatestUpdated.Value.ToLocalTime().ToString("g")</span>
                }
            </div>
            <div class="ts-field">
                <label class="ts-label">Search symbol</label>
                <div style="display:flex;gap:8px">
                    <input class="ts-input" @bind="_symbolInput" @bind:event="oninput" placeholder="BTCUSDT" />
                    <button class="ts-btn ts-btn-primary" @onclick="SelectInput">View</button>
                </div>
            </div>
            <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:1rem">
                <input class="ts-input" style="max-width:200px" @bind="_filter" placeholder="Filter..." />
                <select class="ts-select" style="max-width:200px" @bind="_signalFilter">
                    <option value="">All Signals</option>
                    <option value="near_52w_ath">Near 52W High</option>
                    <option value="near_ath">Near ATH</option>
                    <option value="ema9_above_ema21">Uptrend</option>
                </select>
                <button class="ts-btn ts-btn-primary" @onclick="Scan" disabled="@_scanning">
                    <i class="bi bi-search"></i> Start Scanning
                </button>
            </div>
        </div>

        <TradingViewChart Symbol="@_selectedSymbol" />

        <PriceAlertWidget Symbol="@_selectedSymbol" AssetType="crypto" />

        @if (_loading)
        {
            <div class="ts-panel ts-empty"><div class="ts-spinner"></div><span>Đang tải watchlist...</span></div>
        }
        else if (FilteredCoins.Length > 0)
        {
            <div class="ts-panel ts-table-wrap">
                <table class="ts-table">
                    <thead>
                        <tr>
                            <th>Coin</th>
                            <th>Market Cap</th>
                            <th>Score Diff</th>
                            <th>Signal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in FilteredCoins)
                        {
                            <tr class="@(_selectedSymbol == c.Crypto ? "selected" : "")" @onclick="() => Select(c.Crypto)">
                                <td><strong>@c.Crypto</strong></td>
                                <td>@FormatCap(c.MarketCap)</td>
                                <td class="@(c.ScoreDiff >= 0 ? "ts-positive" : "ts-negative")">@(c.ScoreDiff >= 0 ? "+" : "")@c.ScoreDiff.ToString("F2")%</td>
                                <td><span class="ts-signal ts-signal-@c.SignalType">@c.SignalLabel</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="ts-empty">No coins found. Run a scan to populate watchlist.</div>
        }
    }
    else
    {
        <div class="ts-panel">
            <h3 style="margin:0 0 1rem">Crypto RRG Chart</h3>
            <img src="@Api.ProxyUrl("crypto_rrgchart")" alt="Crypto RRG" class="ts-rrg-img" loading="lazy" />
            <button class="ts-btn ts-btn-primary mt-3" @onclick="ScanRrg" disabled="@_scanning">Refresh RRG</button>
        </div>
    }
</div>

@code {
    private string _tab = "coins";
    private WatchlistResponse<CryptoSignal>? _data;
    private string _selectedSymbol = "BTCUSDT";
    private string _symbolInput = "BTCUSDT";
    private string _filter = "";
    private string _signalFilter = "";
    private bool _loading;
    private bool _scanning;

    private CryptoSignal[] FilteredCoins => (_data?.Data ?? [])
        .Where(c => string.IsNullOrEmpty(_filter) || c.Crypto.Contains(_filter, StringComparison.OrdinalIgnoreCase))
        .Where(c => string.IsNullOrEmpty(_signalFilter) || c.SignalType == _signalFilter)
        .ToArray();

    protected override void OnInitialized() => _ = LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        await InvokeAsync(StateHasChanged);
        try { _data = await Api.GetPotentialCoinsAsync(); }
        catch { /* API offline — chart & search vẫn dùng được */ }
        finally { _loading = false; await InvokeAsync(StateHasChanged); }
    }

    private void Select(string sym) { _selectedSymbol = sym; _symbolInput = sym; }
    private void SelectInput() { if (!string.IsNullOrWhiteSpace(_symbolInput)) _selectedSymbol = _symbolInput.Trim().ToUpperInvariant(); }

    private async Task Scan()
    {
        _scanning = true;
        await Api.RunSshScriptAsync("crypto_potential");
        await LoadAsync();
        _scanning = false;
    }

    private async Task ScanRrg()
    {
        _scanning = true;
        await Api.RunSshScriptAsync("crypto_rrg");
        _scanning = false;
    }

    private static string FormatCap(double cap) =>
        cap >= 1e9 ? $"${cap / 1e9:F2}B" : cap >= 1e6 ? $"${cap / 1e6:F2}M" : $"${cap:F0}";
}
