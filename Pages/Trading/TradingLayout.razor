@inherits LayoutComponentBase

<div class="ts-app">
    <TradingNav />
    <div class="ts-body">
        @Body
    </div>
    @if (_overlaysReady)
    {
        <TradingNewsPanel />
        <TradingChatbox />
        <TradingAlertOverlay />
    }
</div>

@code {
    private bool _overlaysReady;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Defer floating widgets until after first paint so navigation feels instant.
            await Task.Delay(300);
            _overlaysReady = true;
            StateHasChanged();
        }
    }
}
