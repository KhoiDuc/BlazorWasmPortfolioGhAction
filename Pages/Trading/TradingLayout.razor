@inherits LayoutComponentBase

<div class="ts-app">
    <TradingNav />
    <div class="ts-body">
        @Body
    </div>
    @if (_overlaysReady)
    {
        <TradingNewsPanel />
        <TradingChatbox />
        <TradingAlertOverlay />
    }
</div>

@code {
    private bool _overlaysReady;

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            _ = EnableOverlaysAfterIdleAsync();
        return Task.CompletedTask;
    }

    private async Task EnableOverlaysAfterIdleAsync()
    {
        // Let the page paint first; widgets are optional and load later.
        await Task.Delay(3000);
        _overlaysReady = true;
        await InvokeAsync(StateHasChanged);
    }
}
