@page "/trading/real-estate"
@layout TradingLayout
@using BlazorWasmPortfolioGhAction.Models.Trading
@inject ITradingApiClient Api

<div class="ts-page">
    <div class="ts-panel">
        <div class="ts-header">
            <div>
                <h2>Real Estate Market Intelligence</h2>
                <p>Track regional property prices in Vietnam</p>
            </div>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px">
            <div class="ts-field">
                <label class="ts-label">Region</label>
                <select class="ts-select" @bind="_region">
                    <option value="">All</option>
                    @foreach (var r in _regions) { <option value="@r">@r</option> }
                </select>
            </div>
            <div class="ts-field">
                <label class="ts-label">Type</label>
                <select class="ts-select" @bind="_type">
                    <option value="">All</option>
                    @foreach (var t in _types) { <option value="@t">@t</option> }
                </select>
            </div>
            <div class="ts-field">
                <label class="ts-label">Location</label>
                <input class="ts-input" @bind="_location" placeholder="Search..." />
            </div>
            <div class="ts-field" style="display:flex;align-items:flex-end">
                <button class="ts-btn ts-btn-primary w-100" @onclick="Load">Refresh</button>
            </div>
        </div>
    </div>

    @if (_loading)
    {
        <div class="ts-panel ts-empty"><div class="ts-spinner"></div><span>Đang tải dữ liệu...</span></div>
    }
    else if (_items?.Length > 0)
    {
        <div class="ts-panel ts-table-wrap">
            <table class="ts-table">
                <thead>
                    <tr><th>Date</th><th>Region</th><th>Type</th><th>Location</th><th>Area</th><th>Price</th></tr>
                </thead>
                <tbody>
                    @foreach (var i in _items.Take(100))
                    {
                        <tr>
                            <td>@i.FetchedAt.ToLocalTime().ToString("d")</td>
                            <td>@i.Region</td>
                            <td>@i.PropertyType</td>
                            <td>@i.Location</td>
                            <td>@i.Area m²</td>
                            <td>@i.PriceText</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="ts-empty">Chưa có dữ liệu — thử Refresh hoặc đổi bộ lọc.</div>
    }
</div>

@code {
    private RealEstatePrice[]? _items;
    private string _region = "";
    private string _type = "";
    private string _location = "";
    private bool _loading;
    private string[] _regions = [];
    private string[] _types = [];

    protected override void OnInitialized() => _ = Load();

    private async Task Load()
    {
        _loading = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            _items = await Api.GetRealEstateAsync(
                string.IsNullOrEmpty(_region) ? null : _region,
                string.IsNullOrEmpty(_type) ? null : _type,
                string.IsNullOrEmpty(_location) ? null : _location);
            if (_items?.Length > 0)
            {
                _regions = _items.Select(i => i.Region).Distinct().OrderBy(x => x).ToArray();
                _types = _items.Select(i => i.PropertyType).Distinct().OrderBy(x => x).ToArray();
            }
        }
        catch { }
        finally { _loading = false; await InvokeAsync(StateHasChanged); }
    }
}
