@page "/trading/forex-sessions"
@page "/{lang:regex(^(en|vn)$)}/trading/forex-sessions"
@inject NavigationManager Nav
@inject ICultureService CultureService

@code {
    [Parameter] public string? Lang { get; set; }

    protected override void OnInitialized()
    {
        var prefix = Lang ?? CultureService.UrlLang;
        Nav.NavigateTo($"{prefix}/trading/vndesk?group=macro&tab=forex-sessions", replace: true);
    }
}
