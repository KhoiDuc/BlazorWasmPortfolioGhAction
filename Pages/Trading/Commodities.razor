@page "/trading/commodities"
@layout TradingLayout
@inject ITradingApiClient Api

<div class="ts-page">
    <div class="ts-tabs">
        <button class="ts-tab @(_tab == "gold" ? "active" : "")" @onclick='() => _tab = "gold"'>Gold</button>
        <button class="ts-tab @(_tab == "silver" ? "active" : "")" @onclick='() => _tab = "silver"'>Silver</button>
        <button class="ts-tab @(_tab == "oil" ? "active" : "")" @onclick='() => _tab = "oil"'>Oil</button>
        <button class="ts-tab @(_tab == "fuel" ? "active" : "")" @onclick='() => _tab = "fuel"'>Petrolimex</button>
    </div>

    <div class="ts-panel">
        <div class="ts-header">
            <div><h2>Commodities Terminal</h2><p>Gold • Silver • Crude Oil • Fuel</p></div>
        </div>
    </div>

    @if (_tab == "gold")
    {
        <TradingViewChart Symbol="OANDA:XAUUSD" />
        <PriceAlertWidget Symbol="XAUUSD" AssetType="gold" />
        <GoldSpreadPanel />
    }
    else if (_tab == "silver")
    {
        <TradingViewChart Symbol="OANDA:XAGUSD" />
        <PriceAlertWidget Symbol="XAGUSD" AssetType="silver" />
    }
    else if (_tab == "oil")
    {
        <TradingViewChart Symbol="TVC:USOIL" />
        <PriceAlertWidget Symbol="USOIL" AssetType="oil" />
    }
    else
    {
        <div class="ts-panel">
            <h3>Petrolimex Fuel Prices (VN)</h3>
            <iframe src="@Api.ProxyUrl("petrolimex")" style="width:100%;height:480px;border:none;border-radius:12px" title="Petrolimex" loading="lazy"></iframe>
        </div>
    }
</div>

@code {
    private string _tab = "gold";
}
