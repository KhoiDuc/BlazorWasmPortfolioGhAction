@page "/MyResume"
@page "/resume"
@page "/{lang}/resume"
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@using BlazorWasmPortfolioGhAction.Data
@implements IAsyncDisposable

<div class="language-toggle">
    <button @onclick="ToggleLanguage" class="btn-lang">
        @(IsEn ? "🇻🇳 Tiếng Việt" : "🇺🇸 English")
    </button>
</div>

<section class="resume-hero">
    <div class="container">
        <div class="resume-hero-layout">
            <div class="resume-hero-content">
                <p class="section-label">RESUME</p>
                <h1>@Resume.Profile.NameEn <span class="chinese-name">(@Resume.Profile.FullName)</span></h1>
                <p class="resume-hero-role">@(IsEn ? Resume.Profile.RoleEn : Resume.Profile.RoleVn)</p>
                <div class="resume-contact-info">
                    @foreach (var phone in Resume.Profile.PhoneNumbers)
                    {
                        <p><span class="icon">📞</span> <a href="tel:@phone.Replace(" ", "")">(+84) @phone</a></p>
                    }
                    @foreach (var email in Resume.Profile.Emails)
                    {
                        <p><span class="icon">✉️</span> <a href="mailto:@email">@email</a></p>
                    }
                    <p><span class="icon">💬</span> <a href="@Resume.Profile.FacebookUrl" target="_blank">Facebook</a></p>
                    <p><span class="icon">🔗</span> <a href="@Resume.Profile.LinkedInUrl" target="_blank">LinkedIn</a></p>
                    <p><span class="icon">📬</span> <a href="https://t.me/@Resume.Profile.TelegramHandle" target="_blank">Telegram @@@Resume.Profile.TelegramHandle</a></p>
                </div>
                <div class="resume-hero-links">
                    <a href="@Resume.Profile.GitHubUrl" target="_blank" class="resume-btn">GitHub</a>
                    <a href="@Resume.Profile.PdfResumeUrl" target="_blank" class="resume-btn">@(IsEn ? "PDF Resume" : "CV PDF")</a>
                    <a href="@Resume.Profile.CertificateUrl" target="_blank" class="resume-btn">@(IsEn ? "Certificate" : "Chứng chỉ")</a>
                    <a href="@Resume.Profile.TranscriptUrl" target="_blank" class="resume-btn">@(IsEn ? "Transcript" : "Bảng điểm")</a>
                </div>
            </div>
            <div class="carousel-container">
                <img src="images/photo2.jpg" class="carousel-image active" alt="Khoi Duc Photo 1">
                <img src="images/photo3.jpg" class="carousel-image" alt="Khoi Duc Photo 2">
                <img src="images/photo1.jpg" class="carousel-image" alt="Khoi Duc Photo 3">
                <a class="prev" @onclick="() => ChangeSlide(-1)">&#10094;</a>
                <a class="next" @onclick="() => ChangeSlide(1)">&#10095;</a>
            </div>
        </div>
    </div>
</section>

<section class="resume-about">
    <div class="container">
        <div class="section-heading">
            <p class="section-label">ABOUT</p>
            <h2>@(IsEn ? "Profile" : "Hồ sơ")</h2>
        </div>
        <div class="about-content">
            @foreach (var para in IsEn ? Resume.Profile.AboutEn : Resume.Profile.AboutVn)
            {
                <p>@para</p>
            }
        </div>
    </div>
</section>

<section class="resume-education">
    <div class="container">
        <div class="section-heading">
            <p class="section-label">EDUCATION</p>
            <h2>@(IsEn ? "Academic background" : "Học vấn")</h2>
        </div>
        <div class="experience-list">
            @foreach (var edu in Resume.Education)
            {
                <div class="experience-item">
                    <div class="experience-meta">@edu.Period</div>
                    <div class="experience-content">
                        <h3>@(IsEn ? edu.NameEn : edu.NameVn)</h3>
                        <p class="experience-company">@(IsEn ? edu.ProgramEn : edu.ProgramVn)</p>
                        <p class="experience-description">
                            <a href="@edu.Url" target="_blank">@edu.Gpa</a>
                        </p>
                        <div class="technology-list">
                            <span><a target="_blank" href="@edu.DocumentUrl" class="resume-btn">@(IsEn ? edu.DocumentLabelEn : edu.DocumentLabelVn)</a></span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section class="resume-experience">
    <div class="container">
        <div class="section-heading">
            <p class="section-label">EXPERIENCE</p>
            <h2>@(IsEn ? "Work projects" : "Dự án làm việc")</h2>
        </div>
        <div class="experience-list">
            @foreach (var exp in Resume.Experience)
            {
                <div class="experience-item">
                    <div class="experience-meta">@(IsEn ? exp.PeriodEn : exp.PeriodVn)</div>
                    <div class="experience-content">
                        <h3>@exp.Title</h3>
                        <p class="experience-company">@exp.Company · @exp.Role</p>
                        <p class="experience-description">@(IsEn ? exp.DescriptionEn : exp.DescriptionVn)</p>
                        <div class="technology-list">
                            @foreach (var tech in exp.TechStack) { <span>@tech</span> }
                        </div>
                        @if (!string.IsNullOrEmpty(exp.DetailLink))
                        {
                            <div class="project-links">
                                <a href="@exp.DetailLink" class="resume-btn">@(IsEn ? "View Details" : "Xem chi tiết")</a>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section class="resume-projects">
    <div class="container">
        <div class="section-heading">
            <p class="section-label">PROJECTS</p>
            <h2>@(IsEn ? "Personal & school projects" : "Dự án cá nhân & học tập")</h2>
        </div>
        <div class="projects-grid">
            @foreach (var proj in Resume.Projects)
            {
                <article class="project-card">
                    <div class="project-header">
                        <span class="project-type">@proj.Type</span>
                        <span class="project-number">@proj.Number.ToString("00")</span>
                    </div>
                    <div class="project-content">
                        <h3>@proj.Name</h3>
                        <p>@(IsEn ? proj.DescriptionEn : proj.DescriptionVn)</p>
                    </div>
                    <div class="project-links">
                        <a href="@proj.RepoUrl" target="_blank" rel="noopener noreferrer">
                            <i class="bi bi-github" aria-hidden="true"></i> Repository
                        </a>
                        @if (!string.IsNullOrEmpty(proj.DetailLink))
                        {
                            <a href="@proj.DetailLink">
                                <i class="bi bi-info-circle" aria-hidden="true"></i> @(IsEn ? "Details" : "Chi tiết")
                            </a>
                        }
                    </div>
                    <div class="technology-list">
                        @foreach (var tech in proj.TechStack) { <span>@tech</span> }
                    </div>
                </article>
            }
        </div>
    </div>
</section>

<section class="resume-skills">
    <div class="container">
        <div class="section-heading">
            <p class="section-label">TECHNOLOGIES</p>
            <h2>@(IsEn ? "Skills" : "Kỹ năng")</h2>
        </div>
        <div class="technology-grid">
            @{ var i = 0; }
            @foreach (var cat in Resume.Skills)
            {
                <div class="technology-group" style="--reveal-delay: @(i * 90)ms">
                    <p class="technology-category">@(IsEn ? cat.NameEn : cat.NameVn)</p>
                    @if (cat.UseMeters && cat.Skills != null)
                    {
                        <div class="skill-meter-list">
                            @foreach (var skill in cat.Skills)
                            {
                                <div class="skill-meter" role="meter" aria-valuenow="@skill.Level" aria-valuemin="0" aria-valuemax="100" aria-label="@skill.Name">
                                    <div class="skill-meter-header">
                                        <span class="skill-meter-name">@skill.Name</span>
                                        <span class="skill-meter-value">@skill.Level%</span>
                                    </div>
                                    <div class="skill-meter-track">
                                        <div class="skill-meter-fill" style="--level: @(skill.Level)%"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else if (cat.Tags != null)
                    {
                        <div class="technology-items">
                            @foreach (var tag in cat.Tags) { <span>@tag</span> }
                        </div>
                    }
                </div>
                i++;
            }
        </div>
    </div>
</section>

<section class="resume-certifications">
    <div class="container">
        <div class="section-heading">
            <p class="section-label">CERTIFICATIONS</p>
            <h2>@(IsEn ? "TOEIC & Courses" : "TOEIC & Khóa học")</h2>
        </div>
        <div class="education-grid">
            <div class="education-column">
                <p class="column-title">TOEIC SCORES</p>
                @foreach (var toeic in Resume.ToeicScores)
                {
                    <div class="education-item">
                        <div class="education-header">
                            <div><h3>TOEIC</h3></div>
                            <span class="status">@toeic.Year</span>
                        </div>
                        <p class="education-description">Score: @toeic.Score</p>
                    </div>
                }
            </div>
            <div class="education-column">
                <p class="column-title">@(IsEn ? "RELEVANT COURSES" : "KHÓA HỌC LIÊN QUAN")</p>
                @foreach (var course in Resume.Courses)
                {
                    <div class="education-item">
                        <div class="education-header">
                            <div><h3>@course.Code @(IsEn ? course.TitleEn : course.TitleVn)</h3></div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<ContactSection />

<footer class="resume-footer">
    <div class="container">
        <p>
            &copy; @DateTime.Now.Year @Resume.Profile.NameEn. @(IsEn ? "All rights reserved." : "Mọi quyền được bảo lưu.")
            <a href="https://github.com/KhoiDuc/BlazorWasmPortfolioGhAction" target="_blank">@(IsEn ? "Repository" : "Kho lưu trữ")</a>
        </p>
    </div>
</footer>

@code {
    private IJSObjectReference? carouselInstance;
    private string currentLanguage = "en";
    private Resume Resume => ResumeData.Current;
    private bool IsEn => currentLanguage == "en";

    [Parameter]
    public string? Lang { get; set; }

    protected override void OnParametersSet()
    {
        if (string.IsNullOrEmpty(Lang))
        {
            NavigationManager.NavigateTo("en/resume");
        }
        else if (Lang != "en" && Lang != "vn")
        {
            NavigationManager.NavigateTo("en/resume");
        }
        else
        {
            currentLanguage = Lang;
        }
    }

    private void ToggleLanguage()
    {
        var newLang = currentLanguage == "en" ? "vn" : "en";
        NavigationManager.NavigateTo($"{newLang}/resume");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            carouselInstance = await JS.InvokeAsync<IJSObjectReference>("carouselFunctions.initializeCarousel");
            await JS.InvokeVoidAsync("initializeScrollProgress");
            await JS.InvokeVoidAsync("initializeStarfield");
        }
    }

    private async Task ChangeSlide(int direction)
    {
        if (carouselInstance != null)
        {
            await carouselInstance.InvokeVoidAsync("changeSlide", direction);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (carouselInstance != null)
            await carouselInstance.DisposeAsync();
    }
}