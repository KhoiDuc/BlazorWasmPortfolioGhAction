@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@implements IAsyncDisposable

<div class="language-toggle">
    <button @onclick="ToggleLanguage" class="btn-lang">
        @(currentLanguage == "en" ? "🇻🇳 Tiếng Việt" : "🇺🇸 English")
