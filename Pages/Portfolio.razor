@page "/MyResume"
@page "/resume"
@page "/{lang:regex(^(en|vn)$)}/resume"
@inherits CultureAwareComponent
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@inject IStringLocalizer<SharedResources> L
@implements IAsyncDisposable

<section class="resume-hero">
    <div class="container">
        <div class="resume-hero-layout">
            <div class="resume-hero-content">
                <p class="section-label">RESUME</p>
                <h1>@Resume.Profile.Name.Get(CultureService.Current)</h1>
                <p class="resume-fullname-name">@Resume.Profile.FullName</p>
                <p class="resume-hero-role">@Resume.Profile.Role.Get(CultureService.Current)</p>
                <ul class="resume-contact-info">
                    @foreach (var phone in Resume.Profile.PhoneNumbers)
                    {
                        <li>
                            <i class="bi bi-telephone" aria-hidden="true"></i>
                            <a href="tel:@phone.Replace(" ", "")">@FormatPhone(phone)</a>
                        </li>
                    }
                    @foreach (var email in Resume.Profile.Emails)
                    {
                        <li>
                            <i class="bi bi-envelope" aria-hidden="true"></i>
                            <a href="mailto:@email">@email</a>
                        </li>
                    }
                    <li>
                        <i class="bi bi-facebook" aria-hidden="true"></i>
                        <a href="@Resume.Profile.FacebookUrl" target="_blank" rel="noopener noreferrer">Facebook</a>
                    </li>
                    <li>
                        <i class="bi bi-linkedin" aria-hidden="true"></i>
                        <a href="@Resume.Profile.LinkedInUrl" target="_blank" rel="noopener noreferrer">LinkedIn</a>
                    </li>
                    <li>
                        <i class="bi bi-telegram" aria-hidden="true"></i>
                        <a href="https://t.me/@Resume.Profile.TelegramHandle" target="_blank" rel="noopener noreferrer">Telegram @@@Resume.Profile.TelegramHandle</a>
                    </li>
                </ul>
                <div class="resume-hero-links">
                    <a href="@Resume.Profile.PdfResumeUrl" target="_blank" class="resume-btn resume-btn-primary">@L["Resume_Pdf"]</a>
                    <a href="@Resume.Profile.GitHubUrl" target="_blank" rel="noopener noreferrer" class="resume-btn resume-btn-ghost">GitHub</a>
                    <a href="@Resume.Profile.CertificateUrl" target="_blank" rel="noopener noreferrer" class="resume-btn resume-btn-ghost">@L["Resume_Certificate"]</a>
                    <a href="@Resume.Profile.TranscriptUrl" target="_blank" class="resume-btn resume-btn-ghost">@L["Resume_Transcript"]</a>
                </div>
            </div>
            <div class="carousel-container">
                <div class="carousel-skeleton skeleton" aria-hidden="true"></div>
                <img src="images/photo2.jpg" class="carousel-image active" alt="Khoi Duc Photo 1" loading="lazy" decoding="async" @onload="OnImageLoaded" @onerror="OnImageError">
                <img src="images/photo3.jpg" class="carousel-image" alt="Khoi Duc Photo 2" loading="lazy" decoding="async" @onload="OnImageLoaded" @onerror="OnImageError">
                <img src="images/photo1.jpg" class="carousel-image" alt="Khoi Duc Photo 3" loading="lazy" decoding="async" @onload="OnImageLoaded" @onerror="OnImageError">
                <button type="button" class="carousel-nav prev" @onclick="() => ChangeSlide(-1)" aria-label="Previous slide">&#10094;</button>
                <button type="button" class="carousel-nav next" @onclick="() => ChangeSlide(1)" aria-label="Next slide">&#10095;</button>
            </div>
        </div>
    </div>
</section>

<section class="resume-about">
    <div class="container">
        <div class="section-heading">
            <p class="section-label">ABOUT</p>
            <h2>@L["Resume_Profile"]</h2>
        </div>
        <div class="about-content">
            @foreach (var para in Resume.Profile.About.Get(CultureService.Current))
            {
                <p>@para</p>
            }
        </div>
    </div>
</section>

<section class="resume-education">
    <div class="container">
        <div class="section-heading">
            <p class="section-label">EDUCATION</p>
            <h2>@L["Resume_Academic"]</h2>
        </div>
        <div class="experience-list">
            @foreach (var edu in Resume.Education)
            {
                <div class="experience-item">
                    <div class="experience-meta">@edu.Period</div>
                    <div class="experience-content">
                        <h3>@edu.Name.Get(CultureService.Current)</h3>
                        <p class="experience-company">@edu.Program.Get(CultureService.Current)</p>
                        <p class="experience-description">
                            <a href="@edu.Url" target="_blank">@edu.Gpa</a>
                        </p>
                        <div class="technology-list">
                            <a target="_blank" href="@edu.DocumentUrl" class="resume-btn">@edu.DocumentLabel.Get(CultureService.Current)</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section class="resume-experience">
    <div class="container">
        <div class="section-heading">
            <p class="section-label">EXPERIENCE</p>
            <h2>@L["Resume_WorkProjects"]</h2>
        </div>
        <div class="experience-list">
            @foreach (var exp in Resume.Experience)
            {
                <div class="experience-item">
                    <div class="experience-meta">@exp.Period.Get(CultureService.Current)</div>
                    <div class="experience-content">
                        <h3>@exp.Title</h3>
                        <p class="experience-company">@exp.Company · @exp.Role</p>
                        <p class="experience-description">@exp.Description.Get(CultureService.Current)</p>
                        <div class="technology-list">
                            @foreach (var tech in exp.TechStack) { <span>@tech</span> }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section class="resume-projects">
    <div class="container">
        <div class="section-heading">
            <p class="section-label">PROJECTS</p>
            <h2>@L["Resume_PersonalProjects"]</h2>
        </div>
        <div class="projects-grid">
            @foreach (var proj in Resume.Projects)
            {
                <article class="project-card">
                    <div class="project-header">
                        <span class="project-type">@LocalizeProjectType(proj.Type)</span>
                        <span class="project-number">@proj.Number.ToString("00")</span>
                    </div>
                    <div class="project-content">
                        <h3>@proj.Name</h3>
                        <p>@proj.Description.Get(CultureService.Current)</p>
                    </div>
                    <div class="project-links">
                        <a href="@proj.RepoUrl" target="_blank" rel="noopener noreferrer">
                            <i class="bi bi-github" aria-hidden="true"></i> @L["Resume_Repository"]
                        </a>
                    </div>
                    <div class="technology-list">
                        @foreach (var tech in proj.TechStack) { <span>@tech</span> }
                    </div>
                </article>
            }
        </div>
    </div>
</section>

<section class="resume-skills">
    <div class="container">
        <div class="section-heading">
            <p class="section-label">TECHNOLOGIES</p>
            <h2>@L["Resume_Skills"]</h2>
        </div>
        <div class="technology-grid">
            @{ var i = 0; }
            @foreach (var cat in Resume.Skills)
            {
                <div class="technology-group" style="--reveal-delay: @(i * 90)ms">
                    <p class="technology-category">@cat.Name.Get(CultureService.Current)</p>
                    @if (cat.UseMeters && cat.Skills != null)
                    {
                        <div class="skill-meter-list">
                            @foreach (var skill in cat.Skills)
                            {
                                <div class="skill-meter" role="meter" aria-valuenow="@skill.Level" aria-valuemin="0" aria-valuemax="100" aria-label="@skill.Name">
                                    <div class="skill-meter-header">
                                        <span class="skill-meter-name">@skill.Name</span>
                                        <span class="skill-meter-value">@skill.Level%</span>
                                    </div>
                                    <div class="skill-meter-track">
                                        <div class="skill-meter-fill" style="--level: @(skill.Level)%"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else if (cat.Tags != null)
                    {
                        <div class="technology-items">
                            @foreach (var tag in cat.Tags) { <span>@tag</span> }
                        </div>
                    }
                </div>
                i++;
            }
        </div>
    </div>
</section>

<section class="resume-certifications">
    <div class="container">
        <div class="section-heading">
            <p class="section-label">CERTIFICATIONS</p>
            <h2>@L["Resume_ToeicCourses"]</h2>
        </div>
        <div class="education-grid">
            <div class="education-column">
                <p class="column-title">TOEIC SCORES</p>
                @foreach (var toeic in Resume.ToeicScores)
                {
                    <div class="education-item">
                        <div class="education-header">
                            <div><h3>TOEIC</h3></div>
                            <span class="status">@toeic.Year</span>
                        </div>
                        <p class="education-description">Score: @toeic.Score</p>
                    </div>
                }
            </div>
            <div class="education-column">
                <p class="column-title">@L["Resume_RelevantCourses"]</p>
                @foreach (var course in Resume.Courses)
                {
                    <div class="education-item">
                        <div class="education-header">
                            <div><h3>@course.Code @course.Title.Get(CultureService.Current)</h3></div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<ContactSection />

<footer class="resume-footer">
    <div class="container">
        <p>
            &copy; @DateTime.Now.Year @Resume.Profile.Name.Get(CultureService.Current). @L["Resume_AllRights"]
            <a href="https://github.com/KhoiDuc/BlazorWasmPortfolioGhAction" target="_blank">@L["Resume_Repository"]</a>
        </p>
    </div>
</footer>

@code {
    private IJSObjectReference? carouselInstance;
    private Resume Resume => ResumeData.Current;
    private int _imagesLoaded;
    private bool _imagesReady => _imagesLoaded >= 3;

    protected override async Task OnParametersSetAsync()
    {
        // /resume and /MyResume (no lang) => Vietnamese, no redirect
        // /vn/resume => Vietnamese
        // /en/resume => English
        // invalid lang => treat as Vietnamese without forcing navigation away from /resume
        if (string.IsNullOrEmpty(Lang) || Lang.Equals("vn", StringComparison.OrdinalIgnoreCase))
        {
            await CultureService.SetCultureAsync("vi");
        }
        else if (Lang.Equals("en", StringComparison.OrdinalIgnoreCase))
        {
            await CultureService.SetCultureAsync("en");
        }
        else
        {
            await CultureService.SetCultureAsync("vi");
        }
    }

    private string LocalizeProjectType(string type) =>
        type.Equals("Personal", StringComparison.OrdinalIgnoreCase)
            ? L["Home_ProjectTypePersonal"]
            : type.Equals("School", StringComparison.OrdinalIgnoreCase)
                ? L["Home_ProjectTypeSchool"]
                : type;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            carouselInstance = await JS.InvokeAsync<IJSObjectReference>("carouselFunctions.initializeCarousel");
            await JS.InvokeVoidAsync("initializeStarfield");
        }
    }

    private async Task ChangeSlide(int direction)
    {
        if (carouselInstance != null)
        {
            await carouselInstance.InvokeAsync<object>("changeSlide", direction);
        }
    }

    private static string FormatPhone(string phone)
    {
        var digits = new string(phone.Where(char.IsDigit).ToArray());
        if (digits.StartsWith("84") && digits.Length >= 11)
            return $"(+84) {digits[2..]}";
        if (digits.StartsWith("0") && digits.Length >= 10)
            return $"(+84) {digits[1..]}";
        return phone;
    }

    private void OnImageLoaded() => _imagesLoaded++;
    private void OnImageError() => _imagesLoaded++;

    public async ValueTask DisposeAsync()
    {
        if (carouselInstance != null)
            await carouselInstance.DisposeAsync();
    }
}
