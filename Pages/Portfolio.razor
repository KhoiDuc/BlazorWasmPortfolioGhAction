        <div class="resume-hero-layout">
            <div class="resume-hero-content">
                <p class="section-label">RESUME</p>
                <h1>@(currentLanguage == "en" ? "Khoi Duc" : "Khoi Duc") <span class="chinese-name">(Nguyen Minh Duc Khoi)</span></h1>
                <p class="resume-hero-role">@(currentLanguage == "en" ? "Junior Developer" : "Lập trình viên")</p>
                <div class="resume-contact-info">
                    <p><span class="icon">📞</span> <a href="tel:+84938751116">(+84) 0938751116</a> &amp; <a href="tel:+84384223897">(+84) 0384223897</a></p>
                    <p><span class="icon">✉️</span> <a href="mailto:khoi.duc.dev@gmail.com">khoi.duc.dev@gmail.com</a> &amp; <a href="mailto:khoimessi99@gmail.com">khoimessi99@gmail.com</a></p>
                    <p><span class="icon">💬</span> <a href="https://www.facebook.com/messi.khoi.9" target="_blank">Facebook</a></p>
                    <p><span class="icon">🔗</span> <a href="https://www.linkedin.com/in/%C4%91%E1%BB%A9c-kh%C3%B4i-354b77269/" target="_blank">LinkedIn</a></p>
                    <p><span class="icon">📬</span> <a href="https://t.me/warman99" target="_blank">Telegram @@warman99</a></p>
                </div>
                <div class="resume-hero-links">
                    <a href="https://github.com/KhoiDuc" target="_blank" class="resume-btn">GitHub</a>
                    <a href="files/resume.pdf" target="_blank" class="resume-btn">@(currentLanguage == "en" ? "PDF Resume" : "CV PDF")</a>
                    <a href="https://drive.google.com/file/d/17NgDYao2f84W4U346hyuSWZkDIkg612e/view?usp=sharing" target="_blank" class="resume-btn">@(currentLanguage == "en" ? "Certificate" : "Chứng chỉ")</a>
