@using BlazorWasmPortfolioGhAction.Store.Services
@inject QRCodeService _qrService
@inject IJSRuntime JS

<ToolShell Title="QR Code Generator" Icon="bi-qr-code" Description="Generate customizable SVG QR codes with optional logo overlay.">

    @if (!string.IsNullOrEmpty(validationError))
    {
        <div class="tool-alert tool-alert-danger">@validationError</div>
    }

    @if (isLoading)
    {
        <div class="tool-alert tool-alert-info">Generating QR code...</div>
    }

    <div class="qr-layout">
        <div class="qr-preview">
            @if (!string.IsNullOrEmpty(QRImage))
            {
                <img src="@QRImage" width="250" height="250" alt="Generated QR code preview" />
            }
            else
            {
                <div class="qr-preview-empty">QR preview will appear here</div>
            }
        </div>

        <div class="tool-form">
            <div class="tool-field">
                <label class="tool-label" for="select-box">QR Type</label>
                <select class="tool-input" id="select-box" value="@Request.QRType" @onchange="OnSelectChange">
                    @foreach (var qr in Enum.GetValues<EnumQrType>())
                    {
                        <option value="@qr">@qr</option>
                    }
                </select>
            </div>

            <div class="tool-field">
                <label class="tool-label" for="qr-value">QR Value</label>
                <input type="text" @onchange="OnInputChange" value="@Request.QRValue" class="tool-input" id="qr-value" placeholder="Enter QR code content..." />
            </div>

            <div class="tool-field">
                <label class="tool-label" for="white-color">QR Color</label>
                <div class="qr-color-row">
                    <input type="color" @onchange="OnWhiteColorHexChange" value="@Request.WhiteColorHex" class="qr-color-swatch" id="white-color" aria-label="QR foreground color" />
                    <input type="text" @onchange="OnWhiteColorHexChange" value="@Request.WhiteColorHex" class="tool-input" />
                </div>
            </div>

            <div class="tool-field">
                <label class="tool-label" for="dark-color">Background Color</label>
                <div class="qr-color-row">
                    <input type="color" @onchange="OnDarkColorHexChange" value="@Request.DarkColorHex" class="qr-color-swatch" id="dark-color" aria-label="QR background color" />
                    <input type="text" @onchange="OnDarkColorHexChange" value="@Request.DarkColorHex" class="tool-input" />
                </div>
            </div>

            <div class="tool-field">
                <label class="tool-label" for="logo">Logo</label>
                <InputFile accept="image/jpeg,image/png" OnChange="OnLogoChange" class="tool-input" id="logo" />
            </div>

            @if (!string.IsNullOrEmpty(LogoPreview))
            {
                <div class="qr-logo-preview">
                    <img src="@LogoPreview" alt="Selected logo preview" />
                    <button type="button" @onclick="RemoveLogo" class="tool-btn tool-btn-danger">Remove logo</button>
                </div>
            }

            <div class="tool-actions">
                <button type="button" @onclick="DownloadImage" class="tool-btn tool-btn-primary">
                    <i class="bi bi-download" aria-hidden="true"></i> Download
                </button>
            </div>
        </div>
    </div>
</ToolShell>
