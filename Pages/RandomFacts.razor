@inject RandomFactsService RandomFactsService
@using BlazorWasmPortfolioGhAction.Store.Services

<div class="tool-card">
    <div class="tool-header">
        <h3><i class="bi bi-lightbulb" aria-hidden="true"></i> Random Facts</h3>
        <p>Fetch a random fact from uselessfacts.jsph.pl.</p>
    </div>

    @if (isLoading)
    {
        <div class="tool-alert tool-alert-info">Loading fact...</div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="tool-alert tool-alert-danger">@errorMessage</div>
    }
    else if (randomFact != null)
    {
        <div class="tool-inspect-card">
            <p>@randomFact.text</p>
            @if (!string.IsNullOrEmpty(randomFact.source))
            {
                <p class="tool-hint">Source: @randomFact.source</p>
            }
        </div>
    }

    <div class="tool-actions">
        <button type="button" class="tool-btn tool-btn-primary" @onclick="ShowRandomFact" disabled="@isLoading">
            @(isLoading ? "Loading..." : "Show me a random fact")
        </button>
    </div>
</div>

@code {
    private RandomFact? randomFact;
    private bool isLoading = false;
    private string errorMessage = string.Empty;

    private async Task ShowRandomFact()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;
            randomFact = await RandomFactsService.GetRandomFact();
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to load fact. Please try again later.";
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }
}
