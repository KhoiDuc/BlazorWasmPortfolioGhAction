@inject RandomFactsService RandomFactsService
@inject IStringLocalizer<SharedResources> L
@using BlazorWasmPortfolioGhAction.Store.Services
@using BlazorWasmPortfolioGhAction.Shared

<ToolShell Title="Random Facts" Icon="bi-lightbulb" Description="Fetch a random fact from uselessfacts.jsph.pl.">

    @if (isLoading)
    {
        <LoadingSpinner LabelKey="Common_LoadingData" />
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="tool-alert tool-alert-danger">@errorMessage</div>
    }
    else if (randomFact != null)
    {
        <div class="tool-inspect-card">
            <p>@randomFact.text</p>
            @if (!string.IsNullOrEmpty(randomFact.source))
            {
                <p class="tool-hint">Source: @randomFact.source</p>
            }
        </div>
    }

    <div class="tool-actions">
        <button type="button" class="tool-btn tool-btn-primary" @onclick="ShowRandomFact" disabled="@isLoading">
            @(isLoading ? L["Common_Loading"].Value : "Show me a random fact")
        </button>
    </div>
</ToolShell>

@code {
    private RandomFact? randomFact;
    private bool isLoading = false;
    private string errorMessage = string.Empty;

    private async Task ShowRandomFact()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;
            randomFact = await RandomFactsService.GetRandomFact();
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to load fact. Please try again later.";
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }
}
