    private RenderFragment RenderEditableHeader() => __builder =>
    {
        var item = contentState.Value.Contents[indexParsed];
        var isEditing = contentState.Value.IsEditing[indexParsed];
        var showSection = type == "all" || type == "Search" || (!matchTypeSections && matchType);
        var showSubOnly = !matchTypeSectionsSubSections && matchTypeSections;

        if (!showSection && !showSubOnly && matchTypeSectionsSubSections)
            return;

        __builder.OpenElement(0, "header");
        __builder.AddAttribute(1, "class", "wiki-article-header");

        if (showSection)
        {
            __builder.OpenElement(2, "span");
            __builder.AddAttribute(3, "class", "wiki-article-badge");
            __builder.AddContent(4, "Section");
            __builder.CloseElement();

            __builder.OpenElement(5, "h3");
            __builder.AddAttribute(6, "class", "wiki-article-title");
            if (!isEditing)
            {
                __builder.AddAttribute(7, "onclick", EventCallback.Factory.Create(this, () => Edit(indexParsed)));
                __builder.AddContent(8, (MarkupString)Sanitizer.ToSafeMarkup(item.section ?? string.Empty));
            }
            else
            {
                __builder.OpenComponent<Editor>(9);
                __builder.AddAttribute(10, "Id", $"{indexParsed}-section");
                __builder.AddAttribute(11, "Inline", true);
                __builder.AddAttribute(12, "CloudChannel", "5");
                __builder.AddAttribute(13, "Disable", false);
                __builder.AddAttribute(14, "Conf", GetEditorConfHeaders($"{indexParsed}-section"));
                __builder.AddAttribute(15, "ApiKey", TinyAPIKey);
                __builder.AddAttribute(16, "ClassName", "counterEditor");
                __builder.AddAttribute(17, "Value", tempContent!.section);
                __builder.AddAttribute(18, "ValueChanged", EventCallback.Factory.Create<string?>(this, v => tempContent.section = v));
                __builder.AddAttribute(19, "ValueExpression", (System.Linq.Expressions.Expression<Func<string?>>)(() => tempContent.section));
                __builder.CloseComponent();
            }
            __builder.CloseElement();

            if (!string.IsNullOrWhiteSpace(item.subSection) || isEditing)
            {
                __builder.OpenElement(20, "p");
                __builder.AddAttribute(21, "class", "wiki-article-subtitle");
                if (!isEditing)
                {
                    __builder.AddContent(22, (MarkupString)Sanitizer.ToSafeMarkup(item.subSection ?? string.Empty));
                }
                else
                {
                    __builder.OpenComponent<Editor>(23);
                    __builder.AddAttribute(24, "Id", $"{indexParsed}-subSection");
                    __builder.AddAttribute(25, "Inline", true);
                    __builder.AddAttribute(26, "CloudChannel", "5");
                    __builder.AddAttribute(27, "Disable", false);
                    __builder.AddAttribute(28, "Conf", GetEditorConfHeaders($"{indexParsed}-subSection"));
                    __builder.AddAttribute(29, "ApiKey", TinyAPIKey);
                    __builder.AddAttribute(30, "ClassName", "counterEditor");
                    __builder.AddAttribute(31, "Value", tempContent!.subSection);
                    __builder.AddAttribute(32, "ValueChanged", EventCallback.Factory.Create<string?>(this, v => tempContent.subSection = v));
                    __builder.AddAttribute(33, "ValueExpression", (System.Linq.Expressions.Expression<Func<string?>>)(() => tempContent.subSection));
                    __builder.CloseComponent();
                }
                __builder.CloseElement();
            }
        }
        else if (showSubOnly)
        {
            __builder.OpenElement(34, "h3");
            __builder.AddAttribute(35, "class", "wiki-article-title");
            if (!isEditing)
            {
                __builder.AddAttribute(36, "onclick", EventCallback.Factory.Create(this, () => Edit(indexParsed)));
                __builder.AddContent(37, (MarkupString)Sanitizer.ToSafeMarkup(item.subSection ?? string.Empty));
            }
            else
            {
                __builder.OpenComponent<Editor>(38);
                __builder.AddAttribute(39, "Id", $"{indexParsed}-subSection");
                __builder.AddAttribute(40, "Inline", true);
                __builder.AddAttribute(41, "CloudChannel", "5");
                __builder.AddAttribute(42, "Disable", false);
                __builder.AddAttribute(43, "Conf", GetEditorConfHeaders($"{indexParsed}-subSection"));
                __builder.AddAttribute(44, "ApiKey", TinyAPIKey);
                __builder.AddAttribute(45, "ClassName", "counterEditor");
                __builder.AddAttribute(46, "Value", tempContent!.subSection);
                __builder.AddAttribute(47, "ValueChanged", EventCallback.Factory.Create<string?>(this, v => tempContent.subSection = v));
                __builder.AddAttribute(48, "ValueExpression", (System.Linq.Expressions.Expression<Func<string?>>)(() => tempContent.subSection));
                __builder.CloseComponent();
            }
            __builder.CloseElement();
        }

        __builder.CloseElement();
    };

    protected override async Task OnInitializedAsync()
    {
        tempContent = CloneContentHolder(contentState.Value.Contents![indexParsed]);
        contentState.StateChanged += HandleStateChanged;
    }
    private void HandleStateChanged(object? sender, EventArgs e)
    {
        if (contentState.Value.FileCount == contentState.Value.LoadedFilesCount)
        {
            if (indexParsed >= 0 && indexParsed < contentState.Value.Contents.Count
                && indexParsed < contentState.Value.IsEditing.Count
                && !contentState.Value.IsEditing[indexParsed])
            {
                tempContent = CloneContentHolder(contentState.Value.Contents[indexParsed]);
            }
            InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose() => contentState.StateChanged -= HandleStateChanged;
    private async Task Edit(int globalSectionNo)
    {
        StateHasChanged();
        Console.WriteLine($"IsEditing size: {contentState.Value.IsEditing.Count}, updating index: {globalSectionNo}");
        Dispatcher.Dispatch(new UpdateIsEditingAction(globalSectionNo, true));
    }

    @* Method to clear specific sections content *@
    private void ClearContent(int globalSectionNo)
    {
        tempContent.content = "";
        Dispatcher.Dispatch(new UpdateIsEditingAction(globalSectionNo, false));
    }

    // Creates a deep copy of a content holder
    private ContentHolder CloneContentHolder(ContentHolder original)
    {
        return JsonConvert.DeserializeObject<ContentHolder>(JsonConvert.SerializeObject(original));
    }

    private void Save(bool newSec)
    {
        Dispatcher.Dispatch(new ResetIsEditingAction());

        if (!newSec)
        {
            Dispatcher.Dispatch(new SaveContentAction(username, indexParsed, tempContent));

            // Getting the current state after dispatching the SaveContentAction
            var currentState = contentState.Value;

            // Console.WriteLine("Current SHA Dictionary: " + currentState.ShaDictionary.ToString());

            // Identifying the updated contents
            var updatedContent = currentState.Contents[indexParsed];
            var matchingSectionContents = currentState.Contents.Where(ch => ch.page == updatedContent.page && ch.section == updatedContent.section).ToList();

            // Dispatching UpdateGitHubContentAction
            Dispatcher.Dispatch(new UpdateGitHubContentAction(matchingSectionContents, $"Content change made by: {username}", updatedContent.page, updatedContent.section, currentState.ShaDictionary));
        }

        Console.WriteLine("Test save, updated content: " + tempContent.content.ToString());

        tempContent = CloneContentHolder(contentState.Value.Contents![indexParsed]);
        StateHasChanged();
    }


    private void Cancel()
    {
        Dispatcher.Dispatch(new ResetIsEditingAction());
        tempContent = CloneContentHolder(contentState.Value.Contents![indexParsed]);
        StateHasChanged();
    }

