@inject IHtmlSanitizerService Sanitizer
@using BlazorWasmPortfolioGhAction.Services
@inject IState<ContentState> contentState
@inject IDispatcher Dispatcher
@using Markdig
@using ReverseMarkdown
@using Newtonsoft.Json;
@using BlazorWasmPortfolioGhAction.Shared.Model;
@using BlazorWasmPortfolioGhAction.Store.Actions;
@using BlazorWasmPortfolioGhAction.Store.State;
@using Fluxor;
@implements IDisposable

@if (contentState.Value.Contents[indexParsed] != null)
{
    var anchorId = $"wiki-section-{indexParsed}";
    var isEditing = contentState.Value.IsEditing[indexParsed];

    @if (type == "add")
    {
        if (inline == true)
        {
            <tr>
                <td>
                    <h3 class="kudosTextInline">New Section: </h3>
                    @if (!isEditing)
                    {
                        <div class="dotted-lines" @onclick="(() => Edit(indexParsed))">@RenderContent(contentState.Value.Contents.Last().content)</div>
                    }
                    else
                    {
                        <div class="dotted-lines">
                            <MarkdownEditor Value="@tempContent?.content"
                                            ValueChanged="@(EventCallback.Factory.Create<string?>(this, v => tempContent!.content = v))"
                                            ShowPreview="false" Rows="4" />
                        </div>
                    }
                </td>
            </tr>
        }
        else
        {
            <article class="wiki-article wiki-article-editable is-new" id="@anchorId">
                <header class="wiki-article-header">
                    <span class="wiki-article-badge">New</span>
                    <h3 class="wiki-article-title">New section</h3>
                </header>
                <div class="wiki-article-body dotted-lines">
                    @if (!isEditing)
                    {
                        <div @onclick="(() => Edit(indexParsed))">@RenderContent(contentState.Value.Contents.Last().content)</div>
                    }
                    else
                    {
                        <MarkdownEditor Value="@tempContent?.content"
                                        ValueChanged="@(EventCallback.Factory.Create<string?>(this, v => tempContent!.content = v))" />
                    }
                </div>
                <footer class="wiki-article-toolbar">
                    @{
                        var clearText = "";
                    }
                    <button type="button" class="tool-btn tool-btn-secondary" @onclick="()=> contentState.Value.Contents.Last().content = clearText">Clear</button>
                    <button type="button" class="tool-btn tool-btn-primary" @onclick="(() => Save(true))" hidden="@(!isEditing)">Save</button>
                    <button type="button" class="tool-btn tool-btn-secondary" @onclick="(() => Cancel())" hidden="@(!isEditing)">Cancel</button>
                </footer>
            </article>
        }
    }
    else if (inline == true)
    {
        <tr>
            <td>
                @RenderEditableHeader()
                @if (!isEditing)
                {
                    <div class="wiki-article-body dotted-lines" @onclick="(() => Edit(indexParsed))">@RenderContent(contentState.Value.Contents[indexParsed].content)</div>
                }
                else
                {
                    <div class="wiki-article-body dotted-lines">
                        <MarkdownEditor Value="@tempContent?.content"
                                        ValueChanged="@(EventCallback.Factory.Create<string?>(this, v => tempContent!.content = v))"
                                        ShowPreview="false" Rows="4" />
                        <button type="button" class="tool-btn tool-btn-danger inlineBTN" @onclick="(() => RemoveSection(indexParsed, username!))">Delete</button>
                    </div>
                }
            </td>
        </tr>
    }
    else
    {
        <article class="wiki-article wiki-article-editable @(isEditing ? "is-editing" : "")" id="@anchorId">
            @RenderEditableHeader()
            <div class="wiki-article-body dotted-lines">
                @if (!isEditing)
                {
                    @RenderContent(contentState.Value.Contents[indexParsed].content)
                }
                else
                {
                    <MarkdownEditor Value="@tempContent?.content"
                                    ValueChanged="@(EventCallback.Factory.Create<string?>(this, v => tempContent!.content = v))" />
                }
            </div>
            <footer class="wiki-article-toolbar">
                <button type="button" class="tool-btn tool-btn-secondary" @onclick="(() => ClearContent(indexParsed))">Clear</button>
                <button type="button" class="tool-btn tool-btn-danger" @onclick="(() => RemoveSection(indexParsed, username!))">Delete</button>
                <button type="button" class="tool-btn tool-btn-primary" @onclick="(() => Edit(indexParsed))" hidden="@isEditing">Edit</button>
                <button type="button" class="tool-btn tool-btn-primary" @onclick="(() => Save(false))" hidden="@(!isEditing)">Save</button>
                <button type="button" class="tool-btn tool-btn-secondary" @onclick="(() => Cancel())" hidden="@(!isEditing)">Cancel</button>
            </footer>
        </article>
    }
}

@code {
    private static readonly MarkdownPipeline Pipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .UseEmojiAndSmiley(true)
        .Build();

    [Parameter] public bool? inline { get; set; }
    [Parameter] public bool matchTypeSectionsSubSections { get; set; }
    [Parameter] public bool matchTypeSections { get; set; }
    [Parameter] public bool matchType { get; set; }
    [Parameter] public string type { get; set; }
    [Parameter] public string sections { get; set; }
    [Parameter] public string subSections { get; set; }
    [Parameter] public int count { get; set; }
    [Parameter] public int indexParsed { get; set; }
    [Parameter] public string username { get; set; }

    private ContentHolder? tempContent;

    private static bool IsHtml(string? raw) =>
        !string.IsNullOrWhiteSpace(raw) && raw.TrimStart().StartsWith('<');

    private MarkupString RenderContent(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return new(string.Empty);
        var html = IsHtml(raw) ? raw : Markdown.ToHtml(raw, Pipeline);
        return Sanitizer.ToSafeMarkup(html);
    }

    private RenderFragment RenderEditableHeader() => __builder =>
    {
        var item = contentState.Value.Contents[indexParsed];
        var isEditing = contentState.Value.IsEditing[indexParsed];
        var showSection = type == "all" || type == "Search" || (!matchTypeSections && matchType);
        var showSubOnly = !matchTypeSectionsSubSections && matchTypeSections;

        if (!showSection && !showSubOnly && matchTypeSectionsSubSections)
            return;

        __builder.OpenElement(0, "header");
        __builder.AddAttribute(1, "class", "wiki-article-header");

        if (showSection)
        {
            __builder.OpenElement(2, "span");
            __builder.AddAttribute(3, "class", "wiki-article-badge");
            __builder.AddContent(4, "Section");
            __builder.CloseElement();

            __builder.OpenElement(5, "h3");
            __builder.AddAttribute(6, "class", "wiki-article-title");
            if (!isEditing)
            {
                __builder.AddAttribute(7, "onclick", EventCallback.Factory.Create(this, () => Edit(indexParsed)));
                __builder.AddContent(8, Sanitizer.ToSafeMarkup(item.section));
            }
            else
            {
                __builder.OpenElement(9, "input");
                __builder.AddAttribute(10, "class", "tool-input wiki-header-input");
                __builder.AddAttribute(11, "type", "text");
                __builder.AddAttribute(12, "value", tempContent!.section);
                __builder.AddAttribute(13, "oninput", EventCallback.Factory.Create<ChangeEventArgs>(this, e => tempContent.section = e.Value?.ToString()));
                __builder.CloseElement();
            }
            __builder.CloseElement();

            if (!string.IsNullOrWhiteSpace(item.subSection) || isEditing)
            {
                __builder.OpenElement(20, "p");
                __builder.AddAttribute(21, "class", "wiki-article-subtitle");
                if (!isEditing)
                {
                    __builder.AddContent(22, Sanitizer.ToSafeMarkup(item.subSection));
                }
                else
                {
                    __builder.OpenElement(23, "input");
                    __builder.AddAttribute(24, "class", "tool-input wiki-header-input");
                    __builder.AddAttribute(25, "type", "text");
                    __builder.AddAttribute(26, "value", tempContent!.subSection);
                    __builder.AddAttribute(27, "oninput", EventCallback.Factory.Create<ChangeEventArgs>(this, e => tempContent.subSection = e.Value?.ToString()));
                    __builder.CloseElement();
                }
                __builder.CloseElement();
            }
        }
        else if (showSubOnly)
        {
            __builder.OpenElement(34, "h3");
            __builder.AddAttribute(35, "class", "wiki-article-title");
            if (!isEditing)
            {
                __builder.AddAttribute(36, "onclick", EventCallback.Factory.Create(this, () => Edit(indexParsed)));
                __builder.AddContent(37, Sanitizer.ToSafeMarkup(item.subSection));
            }
            else
            {
                __builder.OpenElement(38, "input");
                __builder.AddAttribute(39, "class", "tool-input wiki-header-input");
                __builder.AddAttribute(40, "type", "text");
                __builder.AddAttribute(41, "value", tempContent!.subSection);
                __builder.AddAttribute(42, "oninput", EventCallback.Factory.Create<ChangeEventArgs>(this, e => tempContent.subSection = e.Value?.ToString()));
                __builder.CloseElement();
            }
            __builder.CloseElement();
        }

        __builder.CloseElement();
    };

    protected override async Task OnInitializedAsync()
    {
        tempContent = CloneContentHolder(contentState.Value.Contents![indexParsed]);
        contentState.StateChanged += HandleStateChanged;
    }

    private void HandleStateChanged(object? sender, EventArgs e)
    {
        if (contentState.Value.FileCount == contentState.Value.LoadedFilesCount)
        {
            if (indexParsed >= 0 && indexParsed < contentState.Value.Contents.Count
                && indexParsed < contentState.Value.IsEditing.Count
                && !contentState.Value.IsEditing[indexParsed])
            {
                tempContent = CloneContentHolder(contentState.Value.Contents[indexParsed]);
            }
            InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose() => contentState.StateChanged -= HandleStateChanged;

    private async Task Edit(int globalSectionNo)
    {
        // ponytail: lazy HTML→Markdown convert on first edit. Old HTML content becomes Markdown.
        if (IsHtml(tempContent?.content))
        {
            var converter = new Converter();
            tempContent!.content = converter.Convert(tempContent.content);
        }
        if (IsHtml(tempContent?.section))
        {
            var converter = new Converter();
            tempContent!.section = converter.Convert(tempContent.section);
        }
        if (IsHtml(tempContent?.subSection))
        {
            var converter = new Converter();
            tempContent!.subSection = converter.Convert(tempContent.subSection);
        }

        StateHasChanged();
        Dispatcher.Dispatch(new UpdateIsEditingAction(globalSectionNo, true));
    }

    private void ClearContent(int globalSectionNo)
    {
        tempContent.content = "";
        Dispatcher.Dispatch(new UpdateIsEditingAction(globalSectionNo, false));
    }

    private ContentHolder CloneContentHolder(ContentHolder original)
    {
        return JsonConvert.DeserializeObject<ContentHolder>(JsonConvert.SerializeObject(original));
    }

    private void Save(bool newSec)
    {
        Dispatcher.Dispatch(new ResetIsEditingAction());

        if (!newSec)
        {
            Dispatcher.Dispatch(new SaveContentAction(username, indexParsed, tempContent));

            var currentState = contentState.Value;
            var updatedContent = currentState.Contents[indexParsed];
            var matchingSectionContents = currentState.Contents.Where(ch => ch.page == updatedContent.page && ch.section == updatedContent.section).ToList();

            Dispatcher.Dispatch(new UpdateGitHubContentAction(matchingSectionContents, $"Content change made by: {username}", updatedContent.page, updatedContent.section, currentState.ShaDictionary));
        }

        tempContent = CloneContentHolder(contentState.Value.Contents![indexParsed]);
        StateHasChanged();
    }

    private void Cancel()
    {
        Dispatcher.Dispatch(new ResetIsEditingAction());
        tempContent = CloneContentHolder(contentState.Value.Contents![indexParsed]);
        StateHasChanged();
    }

    private async Task RemoveSection(int sectionNo, string username)
    {
        // ponytail: placeholder — logic removed previously, re-enable when needed.
    }
}