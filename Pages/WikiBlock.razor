@inject IHtmlSanitizerService Sanitizer
@using BlazorWasmPortfolioGhAction.Services
@inject IState<ContentState> contentState
@inject IDispatcher Dispatcher
@inject IJSRuntime JSRuntime;
@using Newtonsoft.Json;
@using BlazorWasmPortfolioGhAction.Shared.Model;
@using BlazorWasmPortfolioGhAction.Store.Actions;
@using BlazorWasmPortfolioGhAction.Store.State;
@using Fluxor;
@implements IDisposable

@if (contentState.Value.Contents[indexParsed] != null)
{
    var anchorId = $"wiki-section-{indexParsed}";
    var isEditing = contentState.Value.IsEditing[indexParsed];

    @if (type == "add")
    {
        if (inline == true)
        {
            <tr>
                <td>
                    <h3 class="kudosTextInline">New Section: </h3>
                    @if (!isEditing)
                    {
                        <div class="dotted-lines" @onclick="(() => Edit(indexParsed))">@(Sanitizer.ToSafeMarkup(contentState.Value.Contents.Last().content!))</div>
                    }
                    else
                    {
                        <div class="dotted-lines" @onclick="(() => Edit(indexParsed))">
                            <Editor Id="@($"{indexParsed}-content")"
                                    Inline=true
                                    CloudChannel="5"
                                    Disable=false
                                    Conf="@GetEditorConfInline($"{indexParsed}-content")"
                                    ApiKey="@TinyAPIKey"
                                    ClassName="counterEditor"
                                    @bind-Value="@tempContent.content" />
                        </div>
                    }
                </td>
            </tr>
        }
        else
        {
            <article class="wiki-article wiki-article-editable is-new" id="@anchorId">
                <header class="wiki-article-header">
                    <span class="wiki-article-badge">New</span>
                    <h3 class="wiki-article-title">New section</h3>
                </header>
                <div class="wiki-article-body dotted-lines tinymce-editor">
                    @if (!isEditing)
                    {
                        <div @onclick="(() => Edit(indexParsed))">@(Sanitizer.ToSafeMarkup(contentState.Value.Contents.Last().content!))</div>
                    }
                    else
                    {
                        <Editor Id="@($"{indexParsed}-content")"
                                Inline=false
                                CloudChannel="5"
                                Disable=false
                                Conf="@GetEditorConf($"{indexParsed}-content")"
                                ApiKey="@TinyAPIKey"
                                ClassName="counterEditor"
                                @bind-Value="@tempContent.content" />
                    }
                </div>
                <footer class="wiki-article-toolbar">
                    @{
                        var clearText = "";
                    }
                    <button type="button" class="tool-btn tool-btn-secondary" @onclick="()=> contentState.Value.Contents.Last().content = clearText">Clear</button>
                    <button type="button" class="tool-btn tool-btn-primary" @onclick="(() => Save(true))" hidden="@(!isEditing)">Save</button>
                    <button type="button" class="tool-btn tool-btn-secondary" @onclick="(() => Cancel())" hidden="@(!isEditing)">Cancel</button>
                </footer>
            </article>
        }
    }
    else if (inline == true)
    {
        <tr>
            <td>
                @RenderEditableHeader()
                @if (!isEditing)
                {
                    <div class="wiki-article-body dotted-lines" @onclick="(() => Edit(indexParsed))">@(Sanitizer.ToSafeMarkup(contentState.Value.Contents[indexParsed].content))</div>
                }
                else
                {
                    <div class="wiki-article-body dotted-lines">
                        <Editor Id="@($"{indexParsed}-content")"
                                Inline=true
                                CloudChannel="5"
                                Disable=false
                                Conf="@GetEditorConfInline($"{indexParsed}-content")"
                                ApiKey="@TinyAPIKey"
                                ClassName="counterEditor"
                                @bind-Value="@tempContent.content" />
                        <button type="button" class="tool-btn tool-btn-danger inlineBTN" @onclick="(() => RemoveSection(indexParsed, username!))">Delete</button>
                    </div>
                }
            </td>
        </tr>
    }
    else
    {
        <article class="wiki-article wiki-article-editable @(isEditing ? "is-editing" : "")" id="@anchorId">
            @RenderEditableHeader()
            <div class="wiki-article-body dotted-lines @(isEditing ? "tinymce-editor" : "")">
                @if (!isEditing)
                {
                    @((MarkupString)Sanitizer.ToSafeMarkup(contentState.Value.Contents[indexParsed].content!))
                }
                else
                {
                    <Editor Id="@($"{indexParsed}-content")"
                            Inline=false
                            CloudChannel="5"
                            Disable=false
                            Conf="@GetEditorConf($"{indexParsed}-content")"
                            ApiKey="@TinyAPIKey"
                            ClassName="counterEditor"
                            @bind-Value="@tempContent.content" />
                }
            </div>
            <footer class="wiki-article-toolbar">
                <button type="button" class="tool-btn tool-btn-secondary" @onclick="(() => ClearContent(indexParsed))">Clear</button>
                <button type="button" class="tool-btn tool-btn-danger" @onclick="(() => RemoveSection(indexParsed, username!))">Delete</button>
                <button type="button" class="tool-btn tool-btn-primary" @onclick="(() => Edit(indexParsed))" hidden="@isEditing">Edit</button>
                <button type="button" class="tool-btn tool-btn-primary" @onclick="(() => Save(false))" hidden="@(!isEditing)">Save</button>
                <button type="button" class="tool-btn tool-btn-secondary" @onclick="(() => Cancel())" hidden="@(!isEditing)">Cancel</button>
            </footer>
        </article>
    }
}



