@page "/project/{ProjectId}"
@inject NavigationManager NavigationManager

<div class="project-detail-container">
    @if (Project == null)
    {
        <div class="project-not-found">
            <h2>Project not found</h2>
            <p>The project "@ProjectId" doesn't exist.</p>
            <a href="/MyResume" class="btn btn-primary">Back to Resume</a>
        </div>
    }
    else
    {
        <div class="project-header">
            <button class="btn btn-secondary btn-sm back-btn" @onclick="GoBack">← Back</button>
            <h1>@Project.Title</h1>
            <p class="project-subtitle">@Project.Role</p>
            <div class="project-meta">
                <span class="meta-item">📅 @Project.Period</span>
                @if (!string.IsNullOrEmpty(Project.Company))
                {
                    <span class="meta-item">🏢 @Project.Company</span>
                }
                @if (!string.IsNullOrEmpty(Project.RepoUrl))
                {
                    <a href="@Project.RepoUrl" target="_blank" rel="noopener" class="meta-item repo-link">🔗 Repository</a>
                }
            </div>
        </div>

        <div class="project-body">
            <section class="project-section">
                <h3>Overview</h3>
                <p>@Project.Description</p>
            </section>

            <section class="project-section">
                <h3>Key Features</h3>
                <ul>
                    @foreach (var feature in Project.Features)
                    {
                        <li>@feature</li>
                    }
                </ul>
            </section>

            <section class="project-section">
                <h3>Tech Stack</h3>
                <div class="tech-stack">
                    @foreach (var tech in Project.Technologies)
                    {
                        <span class="tech-badge">@tech</span>
                    }
                </div>
            </section>

            @if (Project.Highlights?.Count > 0)
            {
                <section class="project-section">
                    <h3>Highlights</h3>
                    <ul>
                        @foreach (var highlight in Project.Highlights)
                        {
                            <li>@highlight</li>
                        }
                    </ul>
                </section>
            }
        </div>
    }
</div>

