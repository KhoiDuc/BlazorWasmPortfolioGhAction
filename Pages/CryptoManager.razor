@page "/cryptoManager"
@inject IJSRuntime JSRuntime
@using BlazorWasmPortfolioGhAction.Pages.CryptoManagerComponents
@using BlazorWasmPortfolioGhAction.Services
@inject IScriptLoaderService ScriptLoader

<div class="page-section crypto-page">
    <section>
        <div class="container">
            <div class="section-heading">
                <p class="section-label">CRYPTO</p>
                <h2>Live ticker dashboard</h2>
                <p class="crypto-lead">Stream Binance tickers, compare volume, and inspect price history.</p>
            </div>

            <div class="crypto-dashboard">
                <aside class="crypto-sidebar">
                    <div class="tool-card crypto-controls-card">
                        <div class="tool-form crypto-controls-form">
                            <div class="tool-field">
                                <label class="tool-label" for="tickerCount">Tickers</label>
                                <input id="tickerCount" type="number" class="tool-input tool-input-sm" @bind="settings.NumberOfTickers" min="1" max="100" />
                            </div>
                            <div class="tool-field">
                                <label class="tool-label" for="quoteUnit">Quote</label>
                                <select id="quoteUnit" class="tool-select tool-input-sm" @bind="settings.QuoteUnit">
                                    <option value="USDT">USDT</option>
                                    <option value="BTC">BTC</option>
                                    <option value="ETH">ETH</option>
                                </select>
                            </div>
                            <button type="button" class="tool-btn tool-btn-primary w-100" @onclick="UpdateSettings">
                                <i class="bi bi-arrow-repeat" aria-hidden="true"></i> Refresh
                            </button>
                        </div>
                    </div>

                    <div class="crypto-ticker-list" aria-label="Ticker list">
                        @if (cryptos.Count == 0)
                        {
                            <div class="crypto-empty-inline">
                                <div class="tool-spinner" role="status"></div>
                                <span>Connecting...</span>
                            </div>
                        }
                        @foreach (var crypto in cryptos)
                        {
                            <CryptoCard Crypto="crypto"
                                        IsSelected="@(SelectedCrypto?.Id == crypto.Id)"
                                        OnCryptoSelected="SelectCrypto" />
                        }
                    </div>
                </aside>

                <main class="crypto-main-panel">
                    @if (SelectedCrypto is null)
                    {
                        <div class="crypto-empty-dashboard tool-card">
                            <i class="bi bi-graph-up-arrow" aria-hidden="true"></i>
                            <h3>Select a ticker</h3>
                            <p>Choose a coin from the list to view live price, 24h stats, and chart history.</p>
                        </div>
                    }
                    else
                    {
                        <CryptoDetails Crypto="SelectedCrypto" OnClose="ClearSelection" />
                    }
                </main>
            </div>
        </div>
    </section>
</div>

@implements IAsyncDisposable

@code {
    private List<Crypto> cryptos = new();
    private Crypto? SelectedCrypto;
    private Settings settings = new();
    private DotNetObjectReference<CryptoManager>? objRef;

    protected override async Task OnInitializedAsync()
    {
        await ScriptLoader.EnsureChartJsAsync();
        objRef = DotNetObjectReference.Create(this);
        await JSRuntime.InvokeVoidAsync("initializeInterop", objRef);
        await JSRuntime.InvokeVoidAsync("fetchCryptoList", objRef, settings);
    }

    [JSInvokable]
    public void UpdateCryptoData(Crypto crypto)
    {
        var existing = cryptos.FirstOrDefault(c => c.Id == crypto.Id);
        if (existing != null)
        {
            existing.CurrentPrice = crypto.CurrentPrice;
            existing.PriceHistory = crypto.PriceHistory;
            existing.VolumeInBaseCurrency = crypto.VolumeInBaseCurrency;
            existing.VolumeInQuoteCurrency = crypto.VolumeInQuoteCurrency;
            existing.High24h = crypto.High24h;
            existing.Low24h = crypto.Low24h;
            existing.Change24h = crypto.Change24h;
            existing.LastUpdate = crypto.LastUpdate;

            if (SelectedCrypto?.Id == crypto.Id)
                SelectedCrypto = existing;
        }
        else if (cryptos.Count >= settings.NumberOfTickers)
        {
            var minVolume = cryptos.OrderBy(c => c.VolumeInQuoteCurrency).First();
            if (crypto.VolumeInQuoteCurrency > minVolume.VolumeInQuoteCurrency)
            {
                if (SelectedCrypto?.Id == minVolume.Id) SelectedCrypto = null;
                cryptos.Remove(minVolume);
                AddCrypto(crypto);
            }
        }
        else
        {
            AddCrypto(crypto);
        }

        cryptos = cryptos.OrderByDescending(c => c.VolumeInQuoteCurrency).ToList();
        StateHasChanged();
    }

    private void AddCrypto(Crypto crypto)
    {
        if (crypto.Symbol.EndsWith(settings.QuoteUnit, StringComparison.OrdinalIgnoreCase))
            cryptos.Add(crypto);
    }

    private async Task UpdateSettings()
    {
        cryptos.Clear();
        SelectedCrypto = null;
        await JSRuntime.InvokeVoidAsync("fetchCryptoList", objRef, settings);
    }

    private void SelectCrypto(Crypto crypto) => SelectedCrypto = crypto;
    private void ClearSelection() => SelectedCrypto = null;

    public async ValueTask DisposeAsync()
    {
        await JSRuntime.InvokeVoidAsync("destroyAllCryptoCharts");
        objRef?.Dispose();
    }
}
