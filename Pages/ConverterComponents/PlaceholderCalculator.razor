@inherits ConverterBase

<div class="tool-card calc-panel">
    <button type="button" class="calc-close-btn" @onclick="Close" aria-label="Close calculator">&times;</button>
    <div class="tool-header">
        <h3>@Name</h3>
        <span class="calc-badge calc-badge-soon">Coming Soon</span>
    </div>
    <p class="calc-soon-text">This calculator is planned but not implemented yet. Check back in a future update.</p>
</div>

@code {
    public override string Name => "Placeholder Calculator";
}
