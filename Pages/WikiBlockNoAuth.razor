@inject IState<ContentState> contentState
@inject IHtmlSanitizerService Sanitizer
@using BlazorWasmPortfolioGhAction.Services
@using Markdig
@inject IDispatcher Dispatcher
@using BlazorWasmPortfolioGhAction.Shared.Model;
@using BlazorWasmPortfolioGhAction.Store.Actions;
@using BlazorWasmPortfolioGhAction.Store.State;
@using Fluxor;

@if (contentState.Value.Contents != null && indexParsed >= 0 && indexParsed < contentState.Value.Contents.Count)
{
    var item = contentState.Value.Contents[indexParsed];
    var anchorId = $"wiki-section-{indexParsed}";

    @if (inline == true)
    {
        <tr>
            <td>
                @RenderSectionHeader(item, editable: false)
                <div class="wiki-article-body dotted-lines">
                    @RenderContent(item.content)
                </div>
            </td>
        </tr>
    }
    else
    {
        <article class="wiki-article" id="@anchorId">
            @RenderSectionHeader(item, editable: false)
            <div class="wiki-article-body dotted-lines">
                @RenderContent(item.content)
            </div>
        </article>
    }
}
else
{
    <p class="wiki-article-empty">Content unavailable.</p>
}

@code {
    private static readonly MarkdownPipeline Pipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .UseEmojiAndSmiley(true)
        .Build();

    [Parameter] public bool? inline { get; set; }
    [Parameter] public bool matchTypeSectionsSubSections { get; set; }
    [Parameter] public bool matchTypeSections { get; set; }
    [Parameter] public bool matchType { get; set; }
    [Parameter] public string type { get; set; } = string.Empty;
    [Parameter] public string sections { get; set; } = string.Empty;
    [Parameter] public string subSections { get; set; } = string.Empty;
    [Parameter] public int count { get; set; }
    [Parameter] public int localCount { get; set; }
    [Parameter] public int indexParsed { get; set; }

    private static bool IsHtml(string? raw) =>
        !string.IsNullOrWhiteSpace(raw) && raw.TrimStart().StartsWith('<');

    private MarkupString RenderContent(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return new(string.Empty);
        var html = IsHtml(raw) ? raw : Markdown.ToHtml(raw, Pipeline);
        return Sanitizer.ToSafeMarkup(html);
    }

    private MarkupString RenderField(string? raw) => Sanitizer.ToSafeMarkup(raw);

    private RenderFragment RenderSectionHeader(ContentHolder item, bool editable) => __builder =>
    {
        var showSection = type == "all" || type == "Search" || (!matchTypeSections && matchType);
        var showSubOnly = !matchTypeSectionsSubSections && matchTypeSections;

        if (!showSection && !showSubOnly && matchTypeSectionsSubSections)
            return;

        __builder.OpenElement(0, "header");
        __builder.AddAttribute(1, "class", "wiki-article-header");

        if (showSection && !string.IsNullOrWhiteSpace(item.section))
        {
            __builder.OpenElement(2, "span");
            __builder.AddAttribute(3, "class", "wiki-article-badge");
            __builder.AddContent(4, "Section");
            __builder.CloseElement();

            __builder.OpenElement(5, "h3");
            __builder.AddAttribute(6, "class", "wiki-article-title");
            __builder.AddContent(7, RenderField(item.section));
            __builder.CloseElement();
        }

        if (!string.IsNullOrWhiteSpace(item.subSection) && (showSection || showSubOnly))
        {
            __builder.OpenElement(8, "p");
            __builder.AddAttribute(9, "class", "wiki-article-subtitle");
            __builder.AddContent(10, RenderField(item.subSection));
            __builder.CloseElement();
        }
        else if (showSubOnly && !string.IsNullOrWhiteSpace(item.subSection))
        {
            __builder.OpenElement(11, "h3");
            __builder.AddAttribute(12, "class", "wiki-article-title");
            __builder.AddContent(13, RenderField(item.subSection));
            __builder.CloseElement();
        }

        __builder.CloseElement();
    };

    protected override async Task OnInitializedAsync()
    {
        contentState.StateChanged += HandleStateChanged;
    }

    private void HandleStateChanged(object? sender, EventArgs e)
    {
        if (contentState.Value.FileCount == contentState.Value.LoadedFilesCount)
            InvokeAsync(StateHasChanged);
    }
}